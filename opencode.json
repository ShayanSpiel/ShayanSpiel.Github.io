{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "director",
  "plugin": [
    "./.opencode/plugins/spielos-notifications.ts"
  ],
  "mcp": {
    "activepieces": {
      "type": "remote",
      "url": "http://localhost:8080/mcp",
      "enabled": true,
      "oauth": true
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp",
      "oauth": true,
      "enabled": true
    },
    "attio": {
      "type": "remote",
      "url": "https://mcp.attio.com/mcp",
      "enabled": true,
      "oauth": true
    }
  }
}
