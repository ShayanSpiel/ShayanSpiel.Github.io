# SpielOS company Connections — environment configuration
# Copy to `.spielos/.env` and fill in. The real file is ignored. Every setting can also be
# exported as a real env var; values in .env take precedence via setdefault.

# ── Provider ──────────────────────────────────────────────────────────────────
# Which sender API to use: resend | sendgrid | mailgun | smtp
EMAIL_PROVIDER=resend

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# SendGrid (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=

# Mailgun (https://app.mailgun.com/app/account/security/api_keys)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Generic SMTP relay (Gmail, Brevo, SMTP2GO, your own mail server, ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true

# ── Sender identity ───────────────────────────────────────────────────────────
EMAIL_FROM=shayan@spielos.xyz
EMAIL_FROM_NAME=Shayan Spiel
SIGNATURE_TITLE=Founder of SpielOS · Agent Harness Architect
SIGNATURE_AVATAR_URL=https://spielos.xyz/assets/avatars/avatar.jpg
SIGNATURE_LINKEDIN=https://linkedin.com/in/shayantawabi
SIGNATURE_X=https://x.com/ShayanSpiel
SIGNATURE_SERVICES=https://spielos.xyz/services/?utm_source=outbound-email&utm_medium=email&utm_campaign=outbound-sig

# ── Data ──────────────────────────────────────────────────────────────────────
# Path to the lead spreadsheet (xlsx, first sheet column order = COL_MAP in outbound.py)
EMAIL_LIST_PATH=leads.xlsx
EMAIL_SHEET_NAME=Master Outreach
# Where send history is stored (JSON: {sent: [], failed: []}) — inside
# .spielos/state/outbound (the Department's runtime state directory)
SENT_LOG_PATH=sent.json

# ── Behavior ──────────────────────────────────────────────────────────────────
# Seconds between emails. Owner cadence 2026-08-08: 50 emails in 2 hours = 144s.
# (Resend free plan: max 100/day, 3000/month)
THROTTLE_SECONDS=144
# Pipeline block size (one block ≈ THROTTLE × BLOCK_SIZE — a 50-block is ~2h
# per `once` EXECUTE).
BLOCK_SIZE=50
# Rotate to the next template variant every N emails
VARIANT_ROTATE=10

# ── Email Data (feedback loop) ────────────────────────────────────────────────
# Reply-To on outbound emails. For automatic capture, this MUST use a domain
# whose Resend capability says receiving=enabled (prefer an isolated subdomain,
# e.g. runs@reply.spielos.xyz). Merely verifying spielos.xyz for sending does
# not enable inbound mail. Empty = replies land in the From inbox and must be
# recorded through a separate inbox adapter.
REPLY_TO=
# Comma-separated subject markers for auto-replies (excluded from reply rate)
AUTO_REPLY_KEYWORDS=out of office,out of the office,automatic reply,auto reply,auto-reply,vacation
# How often `metrics` re-checks provider status (hours). Cron-friendly: the
# command exits early when the last check is fresher than this. 6, 12, or 24.
METRICS_INTERVAL_HOURS=12
# Where per-email provider status + recorded replies are stored
METRICS_PATH=metrics.json
# Active content banks (subjects/bodies/CTAs per segment) — Department-owned
CONTENT_PATH=content_variables.json

# ── Send cadence (deterministic rules, see SKILL.md Part 4) ──────────────────
# One block = BLOCK_SIZE emails spaced THROTTLE_SECONDS apart.
BATCH_SIZE=50
# Warmup daily cap: day <=14 -> WARMUP_DAILY_CAP, day 15-28 -> RAMP, day 29+
# -> STEADY. Topped up 2026-08-08 to 200/day (resend 100 + mailgun 100;
# +300 Brevo once its IP allowlist is set). The Department never exceeds the
# sum of the ENABLED providers' caps (PROVIDER_DAILY_TOTAL).
WARMUP_DAILY_CAP=200
RAMP_DAILY_CAP=200
STEADY_DAILY_CAP=200

# ── Multi-provider send (scaling volume) ─────────────────────────────────────
# Ordered list; every provider needs credentials + its own verified sending
# domain. Rotation picks the provider with the most daily headroom; a provider
# with >=2 transport failures in a UTC day is auto-skipped (returns next day).
SEND_PROVIDERS=resend,mailgun,brevo
# Mailgun: account API key + verified subdomain (DNS records set once via
# Cloudflare; the tracking CNAME is idempotently ensured by the workflow).
#MAILGUN_API_KEY=
#MAILGUN_DOMAIN=mg.spielos.xyz
# Postmark: SERVER token. Sending works; the sending domain must be added in
# the dashboard and its DKIM TXT pasted here/added to DNS before enabling.
#POSTMARK_API_TOKEN=
#POSTMARK_DOMAIN=pm.spielos.xyz
# Per-provider From addresses (each provider must use its own verified domain).
#PROVIDER_FROM_EMAILS=mailgun:shayan@mg.spielos.xyz,postmark:shayan@pm.spielos.xyz
# Per-provider free-tier daily ceilings:
#   resend 100/day · sendgrid 100/day · mailgun 500/day · smtp discretionary
PROVIDER_DAILY_CAPS=resend:100,sendgrid:100,mailgun:700,smtp:200

# ── Goals ─────────────────────────────────────────────────────────────────────
# The feedback loop keeps working until these are met (see `outbound.py review`).
# The GOALS table in config.py defines workflow targets; add new goals
# by editing that table.
GOAL_REPLY_RATE=0.30        # replies / sent — THE goal
GOAL_OPEN_RATE=0.80         # opened / delivered
GOAL_CLICK_RATE=0.05        # clicked / delivered
GOAL_DELIVERED_RATE=0.99    # delivered / sent
# Provider/free-plan safety limits (ceiling goals)
MAX_BOUNCE_RATE=0.02        # bounced / sent (industry: <2%)
MAX_SPAM_RATE=0.0008        # complained / sent (Resend free limit)

# ── Analytics behavior ────────────────────────────────────────────────────────
# Minimum sample before rates are trusted / variants compared
MIN_TOTAL_SAMPLE=10
MIN_VARIANT_SAMPLE=5
# IP cache for provider hosts (bypasses flaky VPN/DNS). Auto-maintained.
IP_CACHE_PATH=ip_cache.json

# ── Cloudflare DNS ─────────────────────────────────────────────────────────────────
CF_API_TOKEN=cfat_xxx          # Cloudflare API token (Zone > DNS edit permission)
CF_ACCOUNT_ID=xxx              # Cloudflare account ID
OWNER_EMAIL=shayan@spielos.xyz
POSTMARK_ACCOUNT_TOKEN=
EMAILOCTOPUS_API_KEY=

# Optional direct credentials are only needed for unattended execution.
# Interactive work should use the active Codex Connection or OpenCode MCP.
BUFFER_API_KEY=
# Optional explicit routing. Buffer media is passed as a stable public HTTPS URL;
# it is never uploaded from this repository.
BUFFER_ORGANIZATION_ID=
BUFFER_THREADS_CHANNEL_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
SEARCH_CONSOLE_ACCESS_TOKEN=
SEARCH_CONSOLE_SITE_URL=sc-domain:spielos.xyz
