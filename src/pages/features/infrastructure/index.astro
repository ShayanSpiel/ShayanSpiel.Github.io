---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";
import { SITE } from "../../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const layers = [
  {
    icon: "server",
    iconColor: "success",
    titleKey: "features.infrastructure.providers.title",
    descKey: "features.infrastructure.providers.desc",
    linkKey: "features.infrastructure.providers.link",
    href: "/features/infrastructure/providers/",
  },
  {
    icon: "link",
    iconColor: "accent",
    titleKey: "features.infrastructure.connections.title",
    descKey: "features.infrastructure.connections.desc",
    linkKey: "features.infrastructure.connections.link",
    href: "/features/infrastructure/connections/",
  },
];

---

<FeaturesLayout
  title={t(locale, "features.infrastructure.pageTitle")}
  description={t(locale, "features.infrastructure.pageDesc")}
  image="/assets/og/features-infrastructure.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[{ label: t(locale, "nav.features"), href: "/features/" }, { label: t(locale, "features.infrastructure.label") }]}
    label={t(locale, "features.infrastructure.label")}
    title={t(locale, "features.infrastructure.hero.title")}
    description={t(locale, "features.infrastructure.hero.desc")}
  />

  <!-- Real Infrastructure UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.infrastructure.mock.window")}</span>
          </div>

          <!-- Settings Content -->
          <div class="flex min-h-[360px]">
            <!-- Sidebar Nav -->
            <div class="w-1/4 border-e border-border bg-panel-raised p-3">
              <span class="text-2xs font-medium text-foreground-strong mb-2 block">{t(locale, "features.infrastructure.mock.settings")}</span>
              <div class="space-y-0.5">
                <div class="flex items-center gap-2 rounded-sm bg-primary-soft px-2 py-1.5">
                  <i class="bx bx-server text-primary icon-sm"></i>
                  <span class="text-2xs text-primary font-medium">{t(locale, "features.infrastructure.providers.mock.window")}</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5 cursor-pointer hover:bg-panel-raised transition-colors">
                  <i class="bx bx-link text-muted-foreground icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.connections.mock.window")}</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5 cursor-pointer hover:bg-panel-raised transition-colors">
                  <i class="bx bx-slider text-muted-foreground icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.mock.apiKeys")}</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5 cursor-pointer hover:bg-panel-raised transition-colors">
                  <i class="bx bx-data text-muted-foreground icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.mock.usage")}</span>
                </div>
              </div>
            </div>

            <!-- Main Content: Providers -->
            <div class="flex-1 p-4">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="text-xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.modelProviders")}</h3>
                  <p class="text-2xs text-muted-foreground mt-0.5">{t(locale, "features.infrastructure.mock.configureDesc")}</p>
                </div>
                <button type="button" class="inline-flex items-center rounded-sm bg-primary px-2 py-1 text-2xs font-medium text-primary-foreground">
                  <i class="bx bx-plus icon-xs"></i> {t(locale, "features.infrastructure.mock.addProvider")}
                </button>
              </div>

              <div class="space-y-2">
                <!-- Provider Row 1 -->
                <div class="flex items-center gap-3 rounded-md border border-border bg-background px-3 py-2.5">
                  <div class="flex h-8 w-8 items-center justify-center rounded-sm bg-panel-raised">
                    <i class="bx bx-server text-success icon-md"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.openai")}</span>
                      <span class="inline-flex items-center gap-1 rounded-sm px-1 py-0.5 text-2xs" style="background: var(--success-soft); color: var(--success);">{t(locale, "features.infrastructure.mock.connected")}</span>
                    </div>
                    <span class="text-2xs text-muted-foreground">gpt-5.6, gpt-5.7, gpt-6</span>
                  </div>
                  <span class="text-2xs text-muted-foreground font-mono">sk-...a4f2</span>
                </div>

                <!-- Provider Row 2 -->
                <div class="flex items-center gap-3 rounded-md border border-border bg-background px-3 py-2.5">
                  <div class="flex h-8 w-8 items-center justify-center rounded-sm bg-panel-raised">
                    <i class="bx bx-server text-primary icon-md"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.anthropic")}</span>
                      <span class="inline-flex items-center gap-1 rounded-sm px-1 py-0.5 text-2xs" style="background: var(--success-soft); color: var(--success);">{t(locale, "features.infrastructure.mock.connected")}</span>
                    </div>
                    <span class="text-2xs text-muted-foreground">Claude Sonnet 5, Claude Opus 5, Claude Haiku 4.5</span>
                  </div>
                  <span class="text-2xs text-muted-foreground font-mono">sk-...b8e1</span>
                </div>

                <!-- Provider Row 3 -->
                <div class="flex items-center gap-3 rounded-md border border-border bg-background px-3 py-2.5">
                  <div class="flex h-8 w-8 items-center justify-center rounded-sm bg-panel-raised">
                    <i class="bx bx-server text-accent icon-md"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.google")}</span>
                      <span class="inline-flex items-center gap-1 rounded-sm px-1 py-0.5 text-2xs" style="background: var(--warning-soft); color: var(--warning);">{t(locale, "features.infrastructure.mock.pending")}</span>
                    </div>
                    <span class="text-2xs text-muted-foreground">Mistral Small, Mistral Medium 3.5</span>
                  </div>
                  <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.infrastructure.mock.setupRequired")}</span>
                </div>

                <!-- Provider Row 4 -->
                <div class="flex items-center gap-3 rounded-md border border-border border-dashed bg-panel px-3 py-2.5 cursor-pointer hover:border-border-strong transition-all">
                  <div class="flex h-8 w-8 items-center justify-center rounded-sm bg-panel-raised">
                    <i class="bx bx-plus text-muted-foreground icon-md"></i>
                  </div>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.mock.addCustom")}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.infrastructure.layers.label")}
        title={t(locale, "features.infrastructure.layers.title")}
        description={t(locale, "features.infrastructure.layers.desc")}
      />

      <div class="grid gap-4 sm:grid-cols-2" data-aos="fade-up">
        {layers.map((layer) => (
          <a href={localizePath(layer.href, locale)} class="group block">
            <div class="relative rounded-md border border-border bg-panel p-5 transition-all group-hover:border-border-strong group-hover:bg-panel-raised">
              <div class={`flex h-9 w-9 items-center justify-center rounded-md bg-${layer.iconColor}-soft mb-3`}>
                <i class={`bx bx-${layer.icon} text-${layer.iconColor} icon-xl`}></i>
              </div>
              <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, layer.titleKey)}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, layer.descKey)}</p>
              <span class="mt-3 inline-block text-xs text-primary font-medium">{t(locale, layer.linkKey)}</span>
              <span class="absolute top-5 start-5 text-2xs text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100">
                <i class="bx bx-chevron-right rtl-flip icon-md"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.related.title")}
    description={t(locale, "features.infrastructure.hero.desc")}
  />
</FeaturesLayout>
