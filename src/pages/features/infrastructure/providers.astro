---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";
import { SITE } from "../../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const steps = [
  {
    num: "01",
    icon: "plus-circle",
    titleKey: "features.infrastructure.providers.how.step1.title",
    descKey: "features.infrastructure.providers.how.step1.desc",
  },
  {
    num: "02",
    icon: "slider",
    titleKey: "features.infrastructure.providers.how.step2.title",
    descKey: "features.infrastructure.providers.how.step2.desc",
  },
  {
    num: "03",
    icon: "lock",
    titleKey: "features.infrastructure.providers.how.step3.title",
    descKey: "features.infrastructure.providers.how.step3.desc",
  },
];

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: t(locale, "features.infrastructure.providers.how.title"),
  description: t(locale, "features.infrastructure.providers.hero.desc"),
  url: SITE.url + "/features/infrastructure/providers/",
  step: steps.map((step) => ({
    "@type": "HowToStep",
    position: parseInt(step.num, 10),
    name: t(locale, step.titleKey),
    text: t(locale, step.descKey),
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: t(locale, "features.infrastructure.providers.problem.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.infrastructure.providers.problem.desc"),
      },
    },
    {
      "@type": "Question",
      name: t(locale, "features.infrastructure.providers.what.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.infrastructure.providers.what.desc"),
      },
    },
  ],
};
---

<FeaturesLayout
  robots="noindex, follow"
  title={t(locale, "features.infrastructure.providers.pageTitle")}
  description={t(locale, "features.infrastructure.providers.pageDesc")}
  image="/assets/og/features-infrastructure-providers.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.features"), href: "/features/" },
      { label: t(locale, "features.infrastructure.label"), href: "/features/infrastructure/" },
      { label: t(locale, "features.infrastructure.providers.label") },
    ]}
    label={t(locale, "features.infrastructure.providers.label")}
    title={t(locale, "features.infrastructure.providers.hero.title")}
    description={t(locale, "features.infrastructure.providers.hero.desc")}
  />

  <!-- Real Provider Config UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.infrastructure.providers.mock.window")}</span>
          </div>

          <!-- Provider Config Content -->
          <div class="p-4 space-y-3">
            <!-- Provider Cards -->
            <div class="grid grid-cols-3 gap-2">
              <div class="rounded-md border border-primary/30 bg-primary-soft p-3">
                <div class="flex items-center gap-2 mb-2">
                  <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-primary">
                    <i class="bx bx-server text-primary-foreground icon-sm"></i>
                  </div>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.anthropic")}</span>
                </div>
                <div class="space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.model")}</span>
                    <span class="text-2xs text-foreground-muted font-mono">{t(locale, "features.infrastructure.providers.mock.simpleModel")}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.status")}</span>
                    <span class="inline-flex items-center gap-1 text-2xs" style="color: var(--success);">
                      <span class="h-1 w-1 rounded-full bg-success"></span>
                      {t(locale, "features.infrastructure.providers.mock.connected")}
                    </span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.costMo")}</span>
                    <span class="text-2xs text-foreground-muted font-mono">1M</span>
                  </div>
                </div>
              </div>

              <div class="rounded-md border border-border bg-background p-3">
                <div class="flex items-center gap-2 mb-2">
                  <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-accent-soft">
                    <i class="bx bx-server text-accent icon-sm"></i>
                  </div>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.openai")}</span>
                </div>
                <div class="space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.model")}</span>
                    <span class="text-2xs text-foreground-muted font-mono">{t(locale, "features.infrastructure.providers.mock.gptModel")}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.status")}</span>
                    <span class="inline-flex items-center gap-1 text-2xs" style="color: var(--success);">
                      <span class="h-1 w-1 rounded-full bg-success"></span>
                      {t(locale, "features.infrastructure.providers.mock.connected")}
                    </span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.costMo")}</span>
                    <span class="text-2xs text-foreground-muted font-mono">1M</span>
                  </div>
                </div>
              </div>

              <div class="rounded-md border border-border bg-background p-3">
                <div class="flex items-center gap-2 mb-2">
                  <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-success-soft">
                    <i class="bx bx-server text-success icon-sm"></i>
                  </div>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.infrastructure.mock.google")}</span>
                </div>
                <div class="space-y-1">
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.model")}</span>
                    <span class="text-2xs text-foreground-muted font-mono">{t(locale, "features.infrastructure.providers.mock.codeModel")}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.status")}</span>
                    <span class="inline-flex items-center gap-1 text-2xs" style="color: var(--success);">
                      <span class="h-1 w-1 rounded-full bg-success"></span>
                      {t(locale, "features.infrastructure.providers.mock.connected")}
                    </span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.costMo")}</span>
                    <span class="text-2xs text-foreground-muted font-mono">200K</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Model Routing -->
            <div class="rounded-md border border-border bg-background p-3">
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.infrastructure.providers.mock.routing")}</span>
                <button type="button" class="inline-flex items-center rounded-sm border border-border bg-panel px-2 py-1 text-2xs font-medium text-foreground-muted">
                  <i class="bx bx-slider icon-xs"></i>
                  {t(locale, "features.infrastructure.providers.mock.configure")}
                </button>
              </div>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between rounded-sm bg-panel px-2 py-1.5">
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.chatSimple")}</span>
                  <span class="text-2xs text-foreground-muted font-mono">{t(locale, "features.infrastructure.providers.mock.simpleModel")}</span>
                </div>
                <div class="flex items-center justify-between rounded-sm bg-panel px-2 py-1.5">
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.chatComplex")}</span>
                  <span class="text-2xs text-foreground-muted font-mono">{t(locale, "features.infrastructure.providers.mock.complexModel")}</span>
                </div>
                <div class="flex items-center justify-between rounded-sm bg-panel px-2 py-1.5">
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.infrastructure.providers.mock.codeGen")}</span>
                  <span class="text-2xs text-foreground-muted font-mono">{t(locale, "features.infrastructure.providers.mock.codeModel")}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.infrastructure.providers.problem.label")}
        title={t(locale, "features.infrastructure.providers.problem.title")}
        description={t(locale, "features.infrastructure.providers.problem.desc")}
      />

      <div class="mx-auto max-w-2xl rounded-lg border border-border bg-panel p-8" data-aos="fade-up">
        <div class="flex items-start gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-destructive-soft">
            <i class="bx bx-error text-destructive icon-xl"></i>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.infrastructure.providers.problem.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.infrastructure.providers.problem.desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.infrastructure.providers.what.title")}
        description={t(locale, "features.infrastructure.providers.what.desc")}
      />

      <div class="mx-auto max-w-2xl rounded-lg border border-border bg-panel p-8" data-aos="fade-up">
        <div class="flex items-start gap-4">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-success-soft">
            <i class="bx bx-check-square text-success icon-xl"></i>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.infrastructure.providers.what.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.infrastructure.providers.what.desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.infrastructure.providers.how.title")}
      />

      <div class="grid gap-6 sm:grid-cols-3" data-aos="fade-up">
        {steps.map((step) => (
          <div class="rounded-md border border-border bg-panel p-5">
            <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft mb-3">
              <i class={`bx bx-${step.icon} text-primary icon-xl`}></i>
            </div>
            <span class="text-2xs font-semibold uppercase tracking-widest text-muted-foreground">{step.num}</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-1 mb-1">{t(locale, step.titleKey)}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, step.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.related.title")}
    description={t(locale, "features.infrastructure.hero.desc")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</FeaturesLayout>
