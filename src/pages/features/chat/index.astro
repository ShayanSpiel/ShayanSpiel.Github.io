---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";
import { SITE, WAITLIST_URL } from "../../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const modes = [
  {
    icon: "message-rounded",
    iconColor: "primary",
    titleKey: "features.chat.directorMode.title",
    descKey: "features.chat.directorMode.desc",
    linkKey: "features.chat.directorMode.link",
    href: "/features/chat/director-mode/",
  },
  {
    icon: "play-circle",
    iconColor: "accent",
    titleKey: "features.chat.directMode.title",
    descKey: "features.chat.directMode.desc",
    linkKey: "features.chat.directMode.link",
    href: "/features/chat/direct-mode/",
  },
];

const sharedItems = t(locale, "features.chat.shared.items").split(" · ");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t(locale, "features.chat.pageTitle"),
  description: t(locale, "features.chat.pageDesc"),
  url: SITE.url + "/features/chat/",
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
};
---

<FeaturesLayout
  title={t(locale, "features.chat.pageTitle")}
  description={t(locale, "features.chat.pageDesc")}
  image="/assets/og/features.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[{ label: t(locale, "nav.features"), href: "/features/" }, { label: t(locale, "features.chat.label") }]}
    title={t(locale, "features.chat.hero.title")}
    description={t(locale, "features.chat.hero.desc")}
    cta={{
      label: t(locale, "features.hero.cta"),
      href: localizePath(WAITLIST_URL, locale),
    }}
  />

  <!-- Real Chat UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.chat.mock.window")}</span>
          </div>

          <!-- Mode Selector + Chat Content -->
          <div class="flex min-h-[380px]">
            <!-- Sidebar: Mode Picker -->
            <div class="w-1/3 border-e border-border bg-panel-raised p-3">
              <span class="text-2xs font-medium text-foreground-strong mb-3 block">{t(locale, "features.chat.mock.selectMode")}</span>
              <div class="space-y-2">
                <!-- Director Mode Card -->
                <div class="rounded-md border border-primary/30 bg-primary-soft p-3 cursor-pointer">
                  <div class="flex items-center gap-2 mb-1.5">
                    <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-primary/20">
                      <i class="bx bx-message-rounded text-primary icon-sm"></i>
                    </div>
                    <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.chat.directorMode.title")}</span>
                  </div>
                  <p class="text-2xs text-muted-foreground leading-relaxed">{t(locale, "features.chat.mock.directorActive")}</p>
                  <div class="mt-2 flex items-center gap-1">
                    <span class="h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
                    <span class="text-2xs text-success font-medium">{t(locale, "features.chat.mock.active")}</span>
                  </div>
                </div>
                <!-- Direct Mode Card -->
                <div class="rounded-md border border-border bg-panel p-3 cursor-pointer hover:border-border-strong transition-all">
                  <div class="flex items-center gap-2 mb-1.5">
                    <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-accent-soft">
                      <i class="bx bx-play-circle text-accent icon-sm"></i>
                    </div>
                    <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.chat.directMode.title")}</span>
                  </div>
                  <p class="text-2xs text-muted-foreground leading-relaxed">{t(locale, "features.chat.mock.directActive")}</p>
                </div>
              </div>
            </div>

            <!-- Chat Area -->
            <div class="flex-1 p-4 flex flex-col">
              <!-- Messages -->
              <div class="flex-1 space-y-3">
                <div class="flex justify-end">
                  <div class="max-w-[80%] rounded-md bg-primary-soft px-3 py-2">
                    <p class="text-xs text-foreground">{t(locale, "features.chat.mock.userMsg")}</p>
                  </div>
                </div>
                <div class="flex justify-start">
                  <div class="max-w-[80%] rounded-md bg-panel-raised px-3 py-2">
                    <div class="flex items-center gap-2 mb-1.5">
                      <div class="flex h-5 w-5 items-center justify-center rounded-sm bg-primary-soft">
                        <i class="bx bx-message-rounded text-primary icon-sm"></i>
                      </div>
                      <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.chat.mock.directorAgent")}</span>
                      <span class="ms-auto inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-3xs font-medium bg-success-soft text-success">
                        <span class="h-1 w-1 rounded-full bg-success animate-pulse"></span>
                        {t(locale, "features.harness.mock.running")}
                      </span>
                    </div>
                    <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.chat.mock.agentReply")}</p>
                  </div>
                </div>
                <div class="flex justify-start">
                  <div class="max-w-[80%] rounded-md border border-border bg-background px-3 py-2">
                    <div class="flex items-center gap-2 mb-1">
                      <i class="bx bx-network-chart text-purple icon-sm"></i>
                      <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.chat.mock.spawnTitle")}</span>
                    </div>
                    <div class="rounded-sm bg-panel px-2 py-1 font-mono text-2xs text-muted-foreground">
                      task: "{t(locale, "features.chat.mock.spawnTask")}"
                    </div>
                  </div>
                </div>
              </div>

              <!-- Input Bar -->
              <div class="mt-3 flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2">
                <span class="text-xs text-muted-foreground flex-1">{t(locale, "features.chat.mock.inputPlaceholder")}</span>
                <div class="flex h-6 w-6 items-center justify-center rounded-sm bg-primary text-primary-foreground">
                  <i class="bx bx-chevron-right rtl-flip icon-sm"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two Modes -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.chat.modes.label")}
        title={t(locale, "features.chat.modes.title")}
        description={t(locale, "features.chat.modes.desc")}
      />

      <div class="grid gap-4 sm:grid-cols-2" data-aos="fade-up">
        {modes.map((mode) => (
          <a href={localizePath(mode.href, locale)} class="group block">
            <div class="relative rounded-md border border-border bg-panel p-6 transition-all group-hover:border-border-strong group-hover:bg-panel-raised">
              <div class={`flex h-10 w-10 items-center justify-center rounded-md bg-${mode.iconColor}-soft mb-4`}>
                <i class={`bx bx-${mode.icon} text-${mode.iconColor} icon-xl`}></i>
              </div>
              <h3 class="text-sm font-semibold text-foreground-strong mb-1.5">{t(locale, mode.titleKey)}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed mb-3">{t(locale, mode.descKey)}</p>
              <span class="text-xs text-primary font-medium">{t(locale, mode.linkKey)}</span>
              <span class="absolute top-6 start-6 text-2xs text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100">
                <i class="bx bx-chevron-right rtl-flip icon-md"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Shared Capabilities -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.chat.shared.title")}
        description={t(locale, "features.chat.shared.desc")}
      />

      <div class="mx-auto max-w-2xl" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-6 sm:p-8">
          <ul class="space-y-3">
            {sharedItems.map((item) => (
              <li class="flex items-start gap-3 text-sm text-muted-foreground">
                <i class="bx bx-check-square text-success mt-0.5 shrink-0 icon-base"></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.chat.cta.title")}
    description={t(locale, "features.chat.cta.desc")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</FeaturesLayout>
