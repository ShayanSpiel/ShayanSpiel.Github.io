---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../../i18n/translations";
import { SITE } from "../../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const steps = [
  {
    num: "01",
    titleKey: "features.harness.workflows.how.step1.title",
    descKey: "features.harness.workflows.how.step1.desc",
  },
  {
    num: "02",
    titleKey: "features.harness.workflows.how.step2.title",
    descKey: "features.harness.workflows.how.step2.desc",
  },
  {
    num: "03",
    titleKey: "features.harness.workflows.how.step3.title",
    descKey: "features.harness.workflows.how.step3.desc",
  },
  {
    num: "04",
    titleKey: "features.harness.workflows.how.step4.title",
    descKey: "features.harness.workflows.how.step4.desc",
  },
];

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: t(locale, "features.harness.workflows.how.title"),
  description: t(locale, "features.harness.workflows.hero.desc"),
  url: SITE.url + "/features/harness/workflows/",
  step: steps.map((step) => ({
    "@type": "HowToStep",
    position: parseInt(step.num, 10),
    name: t(locale, step.titleKey),
    text: t(locale, step.descKey),
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: t(locale, "features.harness.workflows.problem.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.harness.workflows.problem.desc"),
      },
    },
    {
      "@type": "Question",
      name: t(locale, "features.harness.workflows.what.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.harness.workflows.what.desc"),
      },
    },
  ],
};
---

<FeaturesLayout
  robots="noindex, follow"
  title={t(locale, "features.harness.workflows.pageTitle")}
  description={t(locale, "features.harness.workflows.pageDesc")}
  image="/assets/og/features.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.features"), href: "/features/" },
      { label: t(locale, "features.harness.label"), href: "/features/harness/" },
      { label: t(locale, "features.harness.workflows.label") },
    ]}
    label={t(locale, "features.harness.workflows.label")}
    title={t(locale, "features.harness.workflows.hero.title")}
    description={t(locale, "features.harness.workflows.hero.desc")}
  />

  <!-- Real Workflow Builder UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-2xs font-medium" style="background: var(--success-soft); color: var(--success);">
                <span class="h-1 w-1 rounded-full bg-success"></span>
                {t(locale, "features.harness.workflows.mock.live")}
              </span>
              <span class="text-2xs text-muted-foreground font-mono">marketing-campaign-brief</span>
            </div>
          </div>

          <!-- Workflow Builder Content -->
          <div class="p-4">
            <!-- Pipeline Name -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.workflows.mock.name")}</span>
                <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.nameSub", { stages: 2 })}</span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" class="inline-flex items-center rounded-sm border border-border bg-panel px-2 py-1 text-2xs font-medium text-foreground-muted">
                  <i class="bx bx-slider icon-xs"></i>
                  {t(locale, "features.harness.workflows.mock.edit")}
                </button>
                <button type="button" class="inline-flex items-center rounded-sm bg-primary px-2 py-1 text-2xs font-medium text-primary-foreground">
                  <i class="bx bx-play icon-xs"></i>
                  {t(locale, "features.harness.workflows.mock.run")}
                </button>
              </div>
            </div>

            <!-- Visual Pipeline Nodes -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2">
              <!-- Node 1: Trigger -->
              <div class="flex-shrink-0 rounded-md border border-border bg-background p-3 w-36">
                <div class="flex items-center gap-1.5 mb-1.5">
                  <div class="flex h-5 w-5 items-center justify-center rounded-sm bg-success-soft">
                    <i class="bx bx-play text-success icon-xs"></i>
                  </div>
                  <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.harness.workflows.mock.trigger")}</span>
                </div>
                <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.triggerSub")}</p>
              </div>

              <!-- Arrow -->
              <div class="flex-shrink-0 flex items-center text-muted-foreground">
                <i class="bx bx-chevron-right rtl-flip icon-lg"></i>
              </div>

              <!-- Node 2: Agent -->
              <div class="flex-shrink-0 rounded-md border border-border bg-background p-3 w-36">
                <div class="flex items-center gap-1.5 mb-1.5">
                  <div class="flex h-5 w-5 items-center justify-center rounded-sm bg-primary-soft">
                    <i class="bx bx-search-alt text-primary icon-xs"></i>
                  </div>
                  <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.harness.workflows.mock.research")}</span>
                </div>
                <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.researchSub")}</p>
              </div>

              <!-- Arrow -->
              <div class="flex-shrink-0 flex items-center text-muted-foreground">
                <i class="bx bx-chevron-right rtl-flip icon-lg"></i>
              </div>

              <!-- Node 3: Agent -->
              <div class="flex-shrink-0 rounded-md border border-border bg-background p-3 w-36">
                <div class="flex items-center gap-1.5 mb-1.5">
                  <div class="flex h-5 w-5 items-center justify-center rounded-sm bg-accent-soft">
                    <i class="bx bx-file text-accent icon-xs"></i>
                  </div>
                  <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.harness.workflows.mock.write")}</span>
                </div>
                <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.writeSub")}</p>
              </div>

              <!-- Arrow -->
              <div class="flex-shrink-0 flex items-center text-muted-foreground">
                <i class="bx bx-chevron-right rtl-flip icon-lg"></i>
              </div>

              <!-- Node 4: Output -->
              <div class="flex-shrink-0 rounded-md border border-border bg-background p-3 w-36">
                <div class="flex items-center gap-1.5 mb-1.5">
                  <div class="flex h-5 w-5 items-center justify-center rounded-sm bg-purple-soft">
                    <i class="bx bx-export text-purple icon-xs"></i>
                  </div>
                  <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.harness.workflows.mock.publish")}</span>
                </div>
                <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.publishSub")}</p>
              </div>
            </div>

            <!-- Recent Runs -->
            <div class="mt-4 pt-4 border-t border-border">
              <span class="text-2xs font-medium text-foreground-strong mb-2 block">{t(locale, "features.harness.workflows.mock.recentRuns")}</span>
              <div class="space-y-1.5">
                <div class="flex items-center justify-between rounded-sm bg-background border border-border px-3 py-2">
                  <div class="flex items-center gap-2">
                    <i class="bx bx-check-square text-success icon-xs"></i>
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.run248")}</span>
                  </div>
                  <span class="text-2xs text-foreground-muted font-mono">4m 12s</span>
                </div>
                <div class="flex items-center justify-between rounded-sm bg-background border border-border px-3 py-2">
                  <div class="flex items-center gap-2">
                    <i class="bx bx-check-square text-success icon-xs"></i>
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.mock.run247")}</span>
                  </div>
                  <span class="text-2xs text-foreground-muted font-mono">3m 58s</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.harness.workflows.problem.label")}
        title={t(locale, "features.harness.workflows.problem.title")}
        description={t(locale, "features.harness.workflows.problem.desc")}
      />

      <div class="mx-auto max-w-2xl" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-destructive-soft">
              <i class="bx bx-error text-destructive icon-2xl"></i>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.harness.workflows.problem.title")}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.harness.workflows.problem.desc")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.harness.workflows.what.title")}
        description={t(locale, "features.harness.workflows.what.desc")}
      />

      <div class="mx-auto max-w-3xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel p-6">
          <div class="flex flex-col items-center gap-3">
            <div class="flex items-center gap-3 w-full max-w-xs rounded-md bg-panel-raised border border-border p-3">
              <i class="bx bx-user text-primary icon-lg"></i>
              <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.agents.title")}</span>
            </div>
            <i class="bx bx-down-arrow-alt text-border-strong icon-2xl"></i>
            <div class="flex items-center gap-3 w-full max-w-xs rounded-md bg-panel-raised border border-border p-3">
              <i class="bx bx-network-chart text-purple icon-lg"></i>
              <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.workflows.title")}</span>
            </div>
            <i class="bx bx-down-arrow-alt text-border-strong icon-2xl"></i>
            <div class="flex items-center gap-3 w-full max-w-xs rounded-md bg-panel-raised border border-border p-3">
              <i class="bx bx-check-square text-success icon-lg"></i>
              <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.evals.title")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.harness.workflows.how.title")}
      />

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {steps.map((step) => (
          <div class="rounded-md border border-border bg-panel p-5">
            <span class="text-2xs font-semibold text-primary">{step.num}</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, step.titleKey)}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, step.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.harness.workflows.hero.title")}
    description={t(locale, "features.harness.workflows.hero.desc")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</FeaturesLayout>
