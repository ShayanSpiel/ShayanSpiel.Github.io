---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";
import { SITE, WAITLIST_URL } from "../../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const steps = [
  { num: "01", titleKey: "features.harness.agents.how.step1.title", descKey: "features.harness.agents.how.step1.desc" },
  { num: "02", titleKey: "features.harness.agents.how.step2.title", descKey: "features.harness.agents.how.step2.desc" },
  { num: "03", titleKey: "features.harness.agents.how.step3.title", descKey: "features.harness.agents.how.step3.desc" },
  { num: "04", titleKey: "features.harness.agents.how.step4.title", descKey: "features.harness.agents.how.step4.desc" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t(locale, "features.harness.agents.pageTitle"),
  description: t(locale, "features.harness.agents.pageDesc"),
  url: SITE.url + "/features/harness/agents/",
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    "@type": "SoftwareApplication",
    name: SITE.name,
    url: SITE.url,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
  },
};
---

<FeaturesLayout
  title={t(locale, "features.harness.agents.pageTitle")}
  description={t(locale, "features.harness.agents.pageDesc")}
  image="/assets/og/features.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.features"), href: "/features/" },
      { label: t(locale, "features.harness.label"), href: "/features/harness/" },
      { label: t(locale, "features.harness.agents.label") },
    ]}
    label={t(locale, "features.harness.agents.label")}
    title={t(locale, "features.harness.agents.hero.title")}
    description={t(locale, "features.harness.agents.hero.desc")}
  />

  <!-- Real Agent Config UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.harness.agents.mock.window")}</span>
          </div>

          <!-- Agent Config Content -->
          <div class="p-6">
            <div class="grid sm:grid-cols-2 gap-6">
              <!-- Left: Agent Identity -->
              <div class="space-y-4">
                <div>
                  <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.harness.agents.mock.name")}</label>
                  <div class="rounded-md border border-border bg-background px-3 py-2">
                    <span class="text-xs text-foreground">{t(locale, "features.harness.agents.mock.nameValue")}</span>
                  </div>
                </div>

                <div>
                  <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.harness.agents.mock.role")}</label>
                  <div class="rounded-md border border-border bg-background px-3 py-2">
                    <span class="text-xs text-muted-foreground">{t(locale, "features.harness.agents.mock.roleValue")}</span>
                  </div>
                </div>

                <div>
                  <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.harness.agents.mock.model")}</label>
                  <div class="flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2">
                    <i class="bx bx-server text-success icon-md"></i>
                    <span class="text-xs text-foreground">{t(locale, "features.harness.agents.mock.modelValue")}</span>
                    <i class="bx bx-chevron-down text-muted-foreground ms-auto icon-md"></i>
                  </div>
                </div>
              </div>

              <!-- Right: Agent Capabilities -->
              <div class="space-y-4">
                <div>
                  <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.harness.agents.mock.skills")}</label>
                  <div class="flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center gap-1 rounded-sm bg-primary-soft px-2 py-1 text-2xs text-primary font-medium">
                      <i class="bx bx-search-alt icon-xs"></i>
                      knowledge.search
                    </span>
                    <span class="inline-flex items-center gap-1 rounded-sm bg-accent-soft px-2 py-1 text-2xs text-accent font-medium">
                      <i class="bx bx-file icon-xs"></i>
                      file.read
                    </span>
                    <span class="inline-flex items-center gap-1 rounded-sm bg-purple-soft px-2 py-1 text-2xs text-purple font-medium">
                      <i class="bx bx-file icon-xs"></i>
                      generate.business-document
                    </span>
                  </div>
                </div>

                <div>
                  <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.harness.agents.mock.files")}</label>
                  <div class="flex flex-wrap gap-1.5">
                    <span class="inline-flex items-center gap-1 rounded-sm bg-background border border-border px-2 py-1 text-2xs text-foreground-muted">
                      <i class="bx bx-file icon-xs"></i>
                      department-marketing.md
                    </span>
                    <span class="inline-flex items-center gap-1 rounded-sm bg-background border border-border px-2 py-1 text-2xs text-foreground-muted">
                      <i class="bx bx-file icon-xs"></i>
                      company-profile.md
                    </span>
                    <span class="inline-flex items-center gap-1 rounded-sm bg-background border border-border px-2 py-1 text-2xs text-foreground-muted">
                      <i class="bx bx-file icon-xs"></i>
                      template-campaign-brief.md
                    </span>
                  </div>
                </div>

                <div>
                  <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.harness.agents.mock.memory")}</label>
                  <div class="rounded-md border border-border bg-background px-3 py-2">
                    <span class="text-xs text-muted-foreground">{t(locale, "features.harness.agents.mock.memoryValue")}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Agent Status -->
            <div class="mt-4 pt-4 border-t border-border">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-2xs font-medium" style="background: var(--success-soft); color: var(--success);">
                    <span class="h-1 w-1 rounded-full bg-success"></span>
                    {t(locale, "features.harness.agents.mock.active")}
                  </span>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.agents.mock.created")}</span>
                </div>
                <div class="flex items-center gap-2">
                  <button type="button" class="inline-flex items-center rounded-sm border border-border bg-panel px-2 py-1 text-2xs font-medium text-foreground-muted">
                    {t(locale, "features.harness.agents.mock.test")}
                  </button>
                  <button type="button" class="inline-flex items-center rounded-sm bg-primary px-2 py-1 text-2xs font-medium text-primary-foreground">
                    {t(locale, "features.harness.agents.mock.save")}
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-destructive">{t(locale, "features.harness.agents.problem.label")}</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "features.harness.agents.problem.title")}</h2>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">{t(locale, "features.harness.agents.problem.desc")}</p>
      </div>

      <div class="mx-auto max-w-2xl" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-destructive-soft">
              <i class="bx bx-error text-destructive icon-2xl"></i>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.harness.agents.problem.title")}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.harness.agents.problem.desc")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What It Is -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "features.harness.agents.what.title")}</h2>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">{t(locale, "features.harness.agents.what.desc")}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft mb-3">
            <i class="bx bx-user text-primary icon-2xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.harness.agents.how.step1.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.harness.agents.how.step1.desc")}</p>
        </div>

        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft mb-3">
            <i class="bx bx-slider text-accent icon-2xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.harness.agents.how.step2.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.harness.agents.how.step2.desc")}</p>
        </div>

        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-purple-soft mb-3">
            <i class="bx bx-file text-purple icon-2xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.harness.agents.how.step3.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.harness.agents.how.step3.desc")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <h2 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "features.harness.agents.how.title")}</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {steps.map((step) => (
          <div class="rounded-md border border-border bg-panel p-5">
            <span class="text-2xs font-semibold text-primary">{step.num}</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, step.titleKey)}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, step.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.harness.agents.cta.title")}
    description={t(locale, "features.harness.agents.cta.desc")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</FeaturesLayout>
