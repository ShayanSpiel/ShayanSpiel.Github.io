---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";
import { SITE, WAITLIST_URL } from "../../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const blocks = [
  {
    icon: "user",
    iconColor: "primary",
    titleKey: "features.harness.agents.title",
    descKey: "features.harness.agents.desc",
    href: "/features/harness/agents/",
  },
  {
    icon: "link",
    iconColor: "accent",
    titleKey: "features.harness.skills.title",
    descKey: "features.harness.skills.desc",
    href: "/features/harness/skills/",
  },
  {
    icon: "network-chart",
    iconColor: "purple",
    titleKey: "features.harness.workflows.title",
    descKey: "features.harness.workflows.desc",
    href: "/features/harness/workflows/",
  },
  {
    icon: "task",
    iconColor: "success",
    titleKey: "features.harness.evals.title",
    descKey: "features.harness.evals.desc",
    href: "/features/harness/evals/",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t(locale, "features.harness.pageTitle"),
  description: t(locale, "features.harness.pageDesc"),
  url: SITE.url + "/features/harness/",
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    "@type": "SoftwareApplication",
    name: SITE.name,
    url: SITE.url,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
  },
};
---

<FeaturesLayout
  title={t(locale, "features.harness.pageTitle")}
  description={t(locale, "features.harness.pageDesc")}
  image="/assets/og/features.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.features"), href: "/features/" },
      { label: t(locale, "features.harness.label") },
    ]}
    title={t(locale, "features.harness.hero.title")}
    description={t(locale, "features.harness.hero.desc")}
  />

  <!-- Real Harness UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.harness.mock.window")}</span>
          </div>

          <!-- Dashboard Content -->
          <div class="p-4">
            <!-- Top Stats Row -->
            <div class="grid grid-cols-4 gap-3 mb-4">
              <div class="rounded-md border border-border bg-panel-raised p-3 text-center">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                  <i class="bx bx-user text-primary icon-sm"></i>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.agents.title")}</span>
                </div>
                <span class="text-lg font-bold text-foreground-strong">7</span>
              </div>
              <div class="rounded-md border border-border bg-panel-raised p-3 text-center">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                  <i class="bx bx-link text-accent icon-sm"></i>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.skills.title")}</span>
                </div>
                <span class="text-lg font-bold text-foreground-strong">9</span>
              </div>
              <div class="rounded-md border border-border bg-panel-raised p-3 text-center">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                  <i class="bx bx-network-chart text-purple icon-sm"></i>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.workflows.title")}</span>
                </div>
                <span class="text-lg font-bold text-foreground-strong">6</span>
              </div>
              <div class="rounded-md border border-border bg-panel-raised p-3 text-center">
                <div class="flex items-center justify-center gap-1.5 mb-1">
                  <i class="bx bx-task text-success icon-sm"></i>
                  <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.evals.title")}</span>
                </div>
                <span class="text-lg font-bold text-foreground-strong">3</span>
              </div>
            </div>

            <!-- Agent List -->
            <div class="rounded-md border border-border bg-background">
              <div class="flex items-center justify-between px-3 py-2 border-b border-border bg-panel-raised">
                <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.mock.activeAgents")}</span>
                <button type="button" class="inline-flex items-center rounded-sm bg-primary px-1.5 py-0.5 text-2xs font-medium text-primary-foreground">
                  <i class="bx bx-plus icon-xs"></i> {t(locale, "features.harness.mock.new")}
                </button>
              </div>
              <div class="divide-y divide-border">
                <!-- Agent Row 1 -->
                <div class="flex items-center gap-3 px-3 py-2.5">
                  <div class="flex h-7 w-7 items-center justify-center rounded-sm bg-primary-soft">
                    <i class="bx bx-user text-primary icon-sm"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.mock.agent1")}</span>
                      <span class="inline-flex items-center gap-1 rounded-sm px-1 py-0.5 text-2xs" style="background: var(--success-soft); color: var(--success);">{t(locale, "features.harness.mock.running")}</span>
                    </div>
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.mock.skillsAttached", { count: 4 })}</span>
                  </div>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.mock.lastActive", { time: "2m" })}</span>
                </div>
                <!-- Agent Row 2 -->
                <div class="flex items-center gap-3 px-3 py-2.5">
                  <div class="flex h-7 w-7 items-center justify-center rounded-sm bg-accent-soft">
                    <i class="bx bx-user text-accent icon-sm"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.mock.agent2")}</span>
                      <span class="inline-flex items-center gap-1 rounded-sm px-1 py-0.5 text-2xs" style="background: var(--warning-soft); color: var(--warning);">{t(locale, "features.harness.mock.idle")}</span>
                    </div>
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.mock.skillsAttached", { count: 3 })}</span>
                  </div>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.mock.lastActive", { time: "1h" })}</span>
                </div>
                <!-- Agent Row 3 -->
                <div class="flex items-center gap-3 px-3 py-2.5">
                  <div class="flex h-7 w-7 items-center justify-center rounded-sm bg-purple-soft">
                    <i class="bx bx-user text-purple icon-sm"></i>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2">
                      <span class="text-2xs font-semibold text-foreground-strong">{t(locale, "features.harness.mock.agent3")}</span>
                      <span class="inline-flex items-center gap-1 rounded-sm px-1 py-0.5 text-2xs" style="background: var(--success-soft); color: var(--success);">{t(locale, "features.harness.mock.running")}</span>
                    </div>
                    <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.mock.skillsAttached", { count: 2 })}</span>
                  </div>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.harness.mock.lastActive", { time: "30s" })}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.harness.layers.label")}
        title={t(locale, "features.harness.layers.title")}
        description={t(locale, "features.harness.layers.desc")}
      />

      <div class="grid gap-4 sm:grid-cols-2" data-aos="fade-up">
        {blocks.map((block) => (
          <a href={localizePath(block.href, locale)} class="group block">
            <div class="relative rounded-md border border-border bg-panel p-5 transition-all group-hover:border-border-strong group-hover:bg-panel-raised">
              <div class={`flex h-9 w-9 items-center justify-center rounded-md bg-${block.iconColor}-soft mb-3`}>
                <i class={`bx bx-${block.icon} text-${block.iconColor} icon-xl`}></i>
              </div>
              <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, block.titleKey)}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, block.descKey)}</p>
              <span class="absolute top-5 start-5 text-2xs text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100">
                <i class="bx bx-chevron-right rtl-flip icon-md"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.harness.example.title")}
        description={t(locale, "features.harness.example.desc")}
      />

      <div class="mx-auto max-w-3xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel p-8">
          <div class="flex flex-col items-center gap-4">
            <div class="w-full rounded-md border border-border bg-panel-raised p-4 text-center">
              <div class="flex items-center justify-center gap-2 mb-1">
                <i class="bx bx-user text-primary icon-lg"></i>
                <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.agents.title")}</span>
              </div>
              <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.agents.flowDesc")}</p>
            </div>

            <div class="flex items-center text-border-strong">
              <i class="bx bx-down-arrow-alt icon-4xl"></i>
            </div>

            <div class="w-full rounded-md border border-border bg-panel-raised p-4 text-center">
              <div class="flex items-center justify-center gap-2 mb-1">
                <i class="bx bx-link text-accent icon-lg"></i>
                <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.skills.title")}</span>
              </div>
              <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.skills.flowDesc")}</p>
            </div>

            <div class="flex items-center text-border-strong">
              <i class="bx bx-down-arrow-alt icon-4xl"></i>
            </div>

            <div class="w-full rounded-md border border-border bg-panel-raised p-4 text-center">
              <div class="flex items-center justify-center gap-2 mb-1">
                <i class="bx bx-network-chart text-purple icon-lg"></i>
                <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.workflows.title")}</span>
              </div>
              <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.workflows.flowDesc")}</p>
            </div>

            <div class="flex items-center text-border-strong">
              <i class="bx bx-down-arrow-alt icon-4xl"></i>
            </div>

            <div class="w-full rounded-md border border-border bg-panel-raised p-4 text-center">
              <div class="flex items-center justify-center gap-2 mb-1">
                <i class="bx bx-task text-success icon-lg"></i>
                <span class="text-xs font-semibold text-foreground-strong">{t(locale, "features.harness.evals.title")}</span>
              </div>
              <p class="text-2xs text-muted-foreground">{t(locale, "features.harness.evals.flowDesc")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.harness.hero.title")}
    description={t(locale, "features.harness.hero.desc")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</FeaturesLayout>
