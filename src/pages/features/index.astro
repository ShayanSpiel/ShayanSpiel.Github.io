---
import FeaturesLayout from "../../layouts/FeaturesLayout.astro";
import FeatureHero from "../../components/features/FeatureHero.astro";
import FeatureCTA from "../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";
import { SITE, AGENT_BRIEFING_PATH } from "../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const layers = [
  {
    icon: "bx-message-rounded",
    iconColor: "primary",
    titleKey: "features.layers.chat.title",
    descKey: "features.layers.chat.desc",
    href: "/features/chat/",
    subFeatures: [
      { titleKey: "features.chat.directorMode.title", descKey: "features.chat.directorMode.desc", href: "/features/chat/director-mode/" },
      { titleKey: "features.chat.directMode.title", descKey: "features.chat.directMode.desc", href: "/features/chat/direct-mode/" },
    ],
  },
  {
    icon: "bx-file",
    iconColor: "accent",
    titleKey: "features.layers.context.title",
    descKey: "features.layers.context.desc",
    href: "/features/context/",
    subFeatures: [
      { titleKey: "features.context.files.title", descKey: "features.context.files.desc", href: "/features/context/files/" },
      { titleKey: "features.context.strategy.title", descKey: "features.context.strategy.desc", href: "/features/context/strategy/" },
      { titleKey: "features.context.memory.title", descKey: "features.context.memory.desc", href: "/features/context/memory/" },
    ],
  },
  {
    icon: "bx-slider",
    iconColor: "purple",
    titleKey: "features.layers.harness.title",
    descKey: "features.layers.harness.desc",
    href: "/features/harness/",
    subFeatures: [
      { titleKey: "features.harness.agents.title", descKey: "features.harness.agents.desc", href: "/features/harness/agents/" },
      { titleKey: "features.harness.skills.title", descKey: "features.harness.skills.desc", href: "/features/harness/skills/" },
      { titleKey: "features.harness.workflows.title", descKey: "features.harness.workflows.desc", href: "/features/harness/workflows/" },
      { titleKey: "features.harness.evals.title", descKey: "features.harness.evals.desc", href: "/features/harness/evals/" },
    ],
  },
  {
    icon: "bx-server",
    iconColor: "success",
    titleKey: "features.layers.infrastructure.title",
    descKey: "features.layers.infrastructure.desc",
    href: "/features/infrastructure/",
    subFeatures: [
      { titleKey: "features.infrastructure.providers.title", descKey: "features.infrastructure.providers.desc", href: "/features/infrastructure/providers/" },
      { titleKey: "features.infrastructure.connections.title", descKey: "features.infrastructure.connections.desc", href: "/features/infrastructure/connections/" },
    ],
  },
];

const howItWorksSteps = [
  { num: "01", titleKey: "features.howItWorks.step1.title", descKey: "features.howItWorks.step1.desc" },
  { num: "02", titleKey: "features.howItWorks.step2.title", descKey: "features.howItWorks.step2.desc" },
  { num: "03", titleKey: "features.howItWorks.step3.title", descKey: "features.howItWorks.step3.desc" },
  { num: "04", titleKey: "features.howItWorks.step4.title", descKey: "features.howItWorks.step4.desc" },
];

---

<FeaturesLayout
  title={t(locale, "features.pageTitle")}
  description={t(locale, "features.pageDesc")}
  image="/assets/og/features.png"
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[{ label: t(locale, "nav.features") }]}
    title={t(locale, "features.hero.title")}
    description={t(locale, "features.hero.desc")}
    cta={{
      label: t(locale, "services.cta.button"),
      href: localizePath(AGENT_BRIEFING_PATH, locale),
    }}
  />

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(var(--foreground) 1px, transparent 1px), linear-gradient(90deg, var(--foreground) 1px, transparent 1px); background-size: 64px 64px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "features.layers.label")}</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "features.layers.title")}</h2>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">{t(locale, "features.layers.desc")}</p>
      </div>

      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden">
          <div class="p-4 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
              <span class="ms-2 text-2xs text-muted-foreground font-mono">spielos://architecture</span>
            </div>
          </div>

          <div class="p-6 space-y-3">
            {layers.map((layer) => (
              <a href={localizePath(layer.href, locale)} class="group block">
                <div class="rounded-md border border-border bg-panel-raised p-4 transition-all group-hover:border-border-strong group-hover:bg-panel-strong">
                  <div class="flex items-start gap-4">
                    <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-${layer.iconColor}-soft`}>
                      <i class={`bx ${layer.icon} text-${layer.iconColor} icon-2xl`}></i>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between mb-1">
                        <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, layer.titleKey)}</h3>
                        <i class="bx bx-chevron-right rtl-flip text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100 icon-md"></i>
                      </div>
                      <p class="text-xs text-muted-foreground leading-relaxed mb-2">{t(locale, layer.descKey)}</p>
                      <div class="flex flex-wrap gap-1.5">
                        {layer.subFeatures.map((sf) => (
                          <span class="inline-flex items-center rounded-sm bg-background px-1.5 py-0.5 text-2xs text-foreground-muted border border-border">
                            {t(locale, sf.titleKey)}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-purple">{t(locale, "features.howItWorks.label")}</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "features.howItWorks.title")}</h2>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">{t(locale, "features.howItWorks.desc")}</p>
      </div>

      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="grid sm:grid-cols-2 gap-4">
          {howItWorksSteps.map((step) => (
            <div class="rounded-md border border-border bg-panel p-5">
              <span class="text-2xs font-semibold text-primary">{step.num}</span>
              <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, step.titleKey)}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, step.descKey)}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="text-center mb-16" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "features.deepDive.label")}</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "features.deepDive.title")}</h2>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">{t(locale, "features.deepDive.desc")}</p>
      </div>

      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="space-y-6">
          {layers.map((layer) => (
            <div class="rounded-md border border-border bg-panel p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-${layer.iconColor}-soft`}>
                  <i class={`bx ${layer.icon} text-${layer.iconColor} icon-2xl`}></i>
                </div>
                <div>
                  <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, layer.titleKey)}</h3>
                  <p class="text-xs text-muted-foreground">{t(locale, layer.descKey)}</p>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-3">
                {layer.subFeatures.map((sf) => (
                  <a href={localizePath(sf.href, locale)} class="group flex items-center justify-between rounded-md border border-border bg-panel-raised p-3 transition-all hover:border-border-strong hover:bg-panel-strong">
                    <div>
                      <h4 class="text-xs font-semibold text-foreground-strong mb-0.5">{t(locale, sf.titleKey)}</h4>
                      <p class="text-2xs text-muted-foreground leading-relaxed">{t(locale, sf.descKey)}</p>
                    </div>
                    <i class="bx bx-chevron-right rtl-flip text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100 icon-md"></i>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "features.related.title")}
    description={t(locale, "features.hero.desc")}
  />
</FeaturesLayout>
