---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import { SITE } from "../../../config";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t(locale, "features.context.files.pageTitle"),
  description: t(locale, "features.context.files.pageDesc"),
  url: SITE.url + "/features/context/files/",
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    "@type": "SoftwareApplication",
    name: SITE.name,
    url: SITE.url,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
  },
};

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: t(locale, "features.context.files.how.title"),
  description: t(locale, "features.context.files.hero.desc"),
  url: SITE.url + "/features/context/files/",
  step: [
    { position: 1, name: t(locale, "features.context.files.how.step1.title"), text: t(locale, "features.context.files.how.step1.desc") },
    { position: 2, name: t(locale, "features.context.files.how.step2.title"), text: t(locale, "features.context.files.how.step2.desc") },
    { position: 3, name: t(locale, "features.context.files.how.step3.title"), text: t(locale, "features.context.files.how.step3.desc") },
  ].map((s) => ({ "@type": "HowToStep", ...s })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: t(locale, "features.context.files.problem.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.context.files.problem.desc"),
      },
    },
    {
      "@type": "Question",
      name: t(locale, "features.context.files.what.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.context.files.what.desc"),
      },
    },
  ],
};
---

<FeaturesLayout
  title={t(locale, "features.context.files.pageTitle")}
  description={t(locale, "features.context.files.pageDesc")}
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.features"), href: "/features/" },
      { label: t(locale, "features.context.label"), href: "/features/context/" },
      { label: t(locale, "features.context.files.label") },
    ]}
    label={t(locale, "features.context.files.label")}
    title={t(locale, "features.context.files.hero.title")}
    description={t(locale, "features.context.files.hero.desc")}
  />

  <!-- Real Files UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.context.files.mock.window")}</span>
          </div>

          <!-- File Browser Content -->
          <div class="flex min-h-[320px]">
            <!-- File List Sidebar -->
            <div class="w-1/3 border-e border-border bg-panel-raised p-3">
              <div class="flex items-center justify-between mb-3">
                <span class="text-2xs font-medium text-foreground-strong">{t(locale, "features.context.files.mock.documents")}</span>
                <button type="button" class="inline-flex items-center rounded-sm bg-primary px-1.5 py-0.5 text-2xs font-medium text-primary-foreground">
                  <i class="bx bx-plus icon-xs"></i>
                </button>
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2 rounded-sm bg-primary-soft px-2 py-1.5">
                  <i class="bx bx-file text-primary icon-sm"></i>
                  <span class="text-2xs text-primary font-medium">company-profile.md</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-file text-foreground-muted icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">operating-principles.md</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-file text-foreground-muted icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">output-standard.md</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-file text-foreground-muted icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">department-marketing.md</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-file text-foreground-muted icon-sm"></i>
                  <span class="text-2xs text-muted-foreground">template-campaign-brief.md</span>
                </div>
              </div>
            </div>

            <!-- File Preview -->
            <div class="flex-1 p-4">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <i class="bx bx-file text-primary icon-md"></i>
                  <span class="text-xs font-medium text-foreground-strong">company-profile.md</span>
                  <span class="text-2xs text-muted-foreground">1.8 KB</span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="inline-flex items-center gap-1 rounded-sm px-1.5 py-0.5 text-2xs font-medium" style="background: var(--success-soft); color: var(--success);">
                    <span class="h-1 w-1 rounded-full bg-success"></span>
                    {t(locale, "features.context.files.mock.indexed")}
                  </span>
                </div>
              </div>
              <div class="rounded-md border border-border bg-background p-3 font-mono text-2xs text-muted-foreground leading-relaxed">
                <p class="text-foreground-muted">{t(locale, "features.context.files.mock.docTitle")}</p>
                <p class="mt-1">{t(locale, "features.context.files.mock.docVoice")}</p>
                <p>{t(locale, "features.context.files.mock.docVoiceLine")}</p>
                <p class="mt-1">{t(locale, "features.context.files.mock.docColors")}</p>
                <p>{t(locale, "features.context.files.mock.docIndigo")}</p>
                <p>{t(locale, "features.context.files.mock.docEmerald")}</p>
                <p class="mt-1">{t(locale, "features.context.files.mock.docTypography")}</p>
                <p>{t(locale, "features.context.files.mock.docFonts")}</p>
              </div>
              <div class="mt-3 flex items-center gap-2">
                <span class="text-2xs text-foreground-muted">{t(locale, "features.context.files.mock.lastIndexed")}</span>
                <span class="text-2xs text-muted-foreground">|</span>
                <span class="text-2xs text-foreground-muted">{t(locale, "features.context.files.mock.usedBy", { count: 3 })}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.context.files.problem.label")}
        title={t(locale, "features.context.files.problem.title")}
        description={t(locale, "features.context.files.problem.desc")}
      />

      <div class="rounded-md border border-border bg-panel p-5 max-w-2xl mx-auto" data-aos="fade-up">
        <div class="flex h-9 w-9 items-center justify-center rounded-md bg-destructive-soft mb-3">
          <i class="bx bx-error text-destructive icon-xl"></i>
        </div>
        <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.files.problem.title")}</h3>
        <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.files.problem.desc")}</p>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.context.files.what.title")}
        description={t(locale, "features.context.files.what.desc")}
      />

      <div class="grid sm:grid-cols-3 gap-6" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft mb-3">
            <i class="bx bx-file text-primary icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.files.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.files.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft mb-3">
            <i class="bx bx-slider text-accent icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.strategy.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.strategy.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-purple-soft mb-3">
            <i class="bx bx-data text-purple icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.memory.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.memory.desc")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.context.files.how.title")}
      />

      <div class="grid sm:grid-cols-3 gap-8" data-aos="fade-up">
        <div class="text-center">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary font-bold text-sm mb-4">1</div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.files.how.step1.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.files.how.step1.desc")}</p>
        </div>
        <div class="text-center">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary font-bold text-sm mb-4">2</div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.files.how.step2.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.files.how.step2.desc")}</p>
        </div>
        <div class="text-center">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary font-bold text-sm mb-4">3</div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.files.how.step3.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.files.how.step3.desc")}</p>
        </div>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "waitlist.cta.title")}
    description={t(locale, "waitlist.cta.p")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</FeaturesLayout>
