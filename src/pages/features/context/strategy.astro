---
import FeaturesLayout from "../../../layouts/FeaturesLayout.astro";
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import { SITE } from "../../../config";
import { type Locale, t } from "../../../i18n/translations";
import { localizePath } from "../../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: t(locale, "features.context.strategy.how.title"),
  description: t(locale, "features.context.strategy.hero.desc"),
  url: SITE.url + "/features/context/strategy/",
  step: [
    { position: 1, name: t(locale, "features.context.strategy.how.step1.title"), text: t(locale, "features.context.strategy.how.step1.desc") },
    { position: 2, name: t(locale, "features.context.strategy.how.step2.title"), text: t(locale, "features.context.strategy.how.step2.desc") },
    { position: 3, name: t(locale, "features.context.strategy.how.step3.title"), text: t(locale, "features.context.strategy.how.step3.desc") },
  ].map((s) => ({ "@type": "HowToStep", ...s })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: t(locale, "features.context.strategy.problem.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.context.strategy.problem.desc"),
      },
    },
    {
      "@type": "Question",
      name: t(locale, "features.context.strategy.what.title"),
      acceptedAnswer: {
        "@type": "Answer",
        text: t(locale, "features.context.strategy.what.desc"),
      },
    },
  ],
};
---

<FeaturesLayout
  title={t(locale, "features.context.strategy.pageTitle")}
  description={t(locale, "features.context.strategy.pageDesc")}
  locale={locale}
>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.features"), href: "/features/" },
      { label: t(locale, "features.context.label"), href: "/features/context/" },
      { label: t(locale, "features.context.strategy.label") },
    ]}
    label={t(locale, "features.context.strategy.label")}
    title={t(locale, "features.context.strategy.hero.title")}
    description={t(locale, "features.context.strategy.hero.desc")}
  />

  <!-- Real Strategy Editor UI Mockup -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 24px 24px;"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel overflow-hidden shadow-panel">
          <!-- Window Header -->
          <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-panel-raised">
            <div class="flex items-center gap-2">
              <div class="h-3 w-3 rounded-full bg-destructive/60"></div>
              <div class="h-3 w-3 rounded-full bg-warning/60"></div>
              <div class="h-3 w-3 rounded-full bg-success/60"></div>
            </div>
            <span class="text-2xs text-muted-foreground font-mono">{t(locale, "features.context.strategy.mock.window")}</span>
          </div>

          <!-- Strategy Editor Content -->
          <div class="p-4 space-y-4">
            <!-- Strategy Name -->
            <div class="rounded-md border border-border bg-background p-3">
              <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.context.strategy.mock.name")}</label>
              <div class="rounded-sm border border-border bg-panel px-3 py-2">
                <span class="text-xs text-foreground">{t(locale, "features.context.strategy.mock.nameValue")}</span>
              </div>
            </div>

            <!-- System Prompt -->
            <div class="rounded-md border border-border bg-background p-3">
              <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.context.strategy.mock.prompt")}</label>
              <div class="rounded-sm border border-border bg-panel px-3 py-2 font-mono text-2xs text-muted-foreground leading-relaxed">
                <p>{t(locale, "features.context.strategy.mock.prompt1")}</p>
                <p class="mt-1">{t(locale, "features.context.strategy.mock.prompt2")}</p>
                <p class="mt-1">{t(locale, "features.context.strategy.mock.prompt3")}</p>
                <p class="mt-1">{t(locale, "features.context.strategy.mock.prompt4")}</p>
              </div>
            </div>

            <!-- Rules -->
            <div class="rounded-md border border-border bg-background p-3">
              <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.context.strategy.mock.rules")}</label>
              <div class="space-y-1.5">
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-check-square text-success icon-xs"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.context.strategy.mock.rule1")}</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-check-square text-success icon-xs"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.context.strategy.mock.rule2")}</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-check-square text-success icon-xs"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.context.strategy.mock.rule3")}</span>
                </div>
                <div class="flex items-center gap-2 rounded-sm bg-panel px-2 py-1.5">
                  <i class="bx bx-error text-destructive icon-xs"></i>
                  <span class="text-2xs text-muted-foreground">{t(locale, "features.context.strategy.mock.rule4")}</span>
                </div>
              </div>
            </div>

            <!-- Target Channels -->
            <div class="rounded-md border border-border bg-background p-3">
              <label class="text-2xs font-medium text-foreground-muted mb-1.5 block">{t(locale, "features.context.strategy.mock.channels")}</label>
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center gap-1 rounded-sm bg-primary-soft px-2 py-1 text-2xs text-primary font-medium">
                  <i class="bx bx-globe icon-xs"></i>
                  {t(locale, "features.context.strategy.mock.channelBlog")}
                </span>
                <span class="inline-flex items-center gap-1 rounded-sm bg-accent-soft px-2 py-1 text-2xs text-accent font-medium">
                  <i class="bx bx-message-rounded icon-xs"></i>
                  {t(locale, "features.context.strategy.mock.channelX")}
                </span>
                <span class="inline-flex items-center gap-1 rounded-sm bg-purple-soft px-2 py-1 text-2xs text-purple font-medium">
                  <i class="bx bx-link icon-xs"></i>
                  {t(locale, "features.context.strategy.mock.channelLinkedIn")}
                </span>
                <span class="inline-flex items-center gap-1 rounded-sm bg-success-soft px-2 py-1 text-2xs text-success font-medium">
                  <i class="bx bx-envelope icon-xs"></i>
                  {t(locale, "features.context.strategy.mock.channelNewsletter")}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "features.context.strategy.problem.label")}
        title={t(locale, "features.context.strategy.problem.title")}
        description={t(locale, "features.context.strategy.problem.desc")}
      />

      <div class="rounded-md border border-border bg-panel p-5 max-w-2xl mx-auto" data-aos="fade-up">
        <div class="flex h-9 w-9 items-center justify-center rounded-md bg-destructive-soft mb-3">
          <i class="bx bx-error text-destructive icon-xl"></i>
        </div>
        <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.strategy.problem.title")}</h3>
        <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.strategy.problem.desc")}</p>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.context.strategy.what.title")}
        description={t(locale, "features.context.strategy.what.desc")}
      />

      <div class="grid sm:grid-cols-3 gap-6" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft mb-3">
            <i class="bx bx-file text-primary icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.files.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.files.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft mb-3">
            <i class="bx bx-slider text-accent icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.strategy.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.strategy.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-purple-soft mb-3">
            <i class="bx bx-data text-purple icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.memory.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.memory.desc")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "features.context.strategy.how.title")}
      />

      <div class="grid sm:grid-cols-3 gap-8" data-aos="fade-up">
        <div class="text-center">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary font-bold text-sm mb-4">1</div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.strategy.how.step1.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.strategy.how.step1.desc")}</p>
        </div>
        <div class="text-center">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary font-bold text-sm mb-4">2</div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.strategy.how.step2.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.strategy.how.step2.desc")}</p>
        </div>
        <div class="text-center">
          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-soft text-primary font-bold text-sm mb-4">3</div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "features.context.strategy.how.step3.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "features.context.strategy.how.step3.desc")}</p>
        </div>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "waitlist.cta.title")}
    description={t(locale, "waitlist.cta.p")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</FeaturesLayout>
