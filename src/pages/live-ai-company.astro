function dive(di) {
  if (nudgeStep === 0 || nudgeStep === 1) { document.getElementById('nudge').classList.remove('show'); setTimeout(() => nudge(2), 2300); }
  if (state !== 'sky') return;
  state = 'aligning';
  document.body.classList.add('transitioning');
  hideCard();
  let t = 180 - di * W_STEP;
  while (t - wheelT > 180) t -= 360;
  while (t - wheelT < -180) t += 360;
  wheelT = t;
  const wait = Math.min(800, 180 + Math.abs(t - wheelA) * 5);
  setTimeout(() => {
  state = 'diving';
  /* Camera will be set by fitCurrent after fan is built */
  document.querySelectorAll('.tree').forEach(t2 => { if (+t2.dataset.i !== di) t2.classList.add('dim'); });
  setTimeout(() => {
    skyEl.style.display = 'none';
    document.body.classList.add('fanmode');
    document.getElementById('state-name').textContent = 'NAVIGATION';
    buildFan(di, 0, true);
    state = 'fan';
    scale = 0.5; tx = 0; ty = 120;
    fitCurrent();
    setTimeout(() => document.body.classList.remove('transitioning'), 1250);
  // Safety: ensure transitioning is removed even if timeout chain fails
  setTimeout(() => document.body.classList.remove('transitioning'), 3000);
  }, 520);
  }, wait);
}
function selectDept(di) {
