  } else {
    if (isMobile()) {
      const ringSpan = (470 + 130) * 2;
      const fit = Math.min((innerWidth - 24) / ringSpan, (innerHeight - 150) / ringSpan);
      scaleT = Math.max(0.34, Math.min(0.62, fit));
