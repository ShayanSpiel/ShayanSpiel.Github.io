---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "SpielOS Live · AI Company Map";
const description = "Interactive spatial map of the SpielOS company — 7 departments, real workflows, measurable outcomes.";
---

<BaseLayout title={title} description={description} noAlternate>
<style is:global>
  :root {
  --bg: var(--background, #0E1118);
  --ivory: var(--foreground, #E9E4D6);
  --ivory-2: var(--foreground-muted, #B9B4A6);
  --ink-2: var(--muted-foreground, #8A8DA0);
  --ink-3: var(--muted-foreground, #565A6E);
  --copper: var(--primary, #C58B5F);
  --line: var(--border, color-mix(in srgb, var(--foreground) 10%, transparent));
  --lnrgb: 233,228,214;
  --badge-glyph: var(--background, #181a24);
  --glass: color-mix(in oklab, var(--background, #0e1118) 85%, transparent);
}
  body.light {
    --bg: #E9EBEE;
    --ivory: #1B1E26;
    --ivory-2: #3E424D;
    --ink-2: #5C606B;
    --ink-3: #888D98;
    --copper: #9A6535;
    --line: color-mix(in srgb, var(--foreground) 28%, transparent);
    --lnrgb: 27,30,38;
    --badge-glyph: #FFFFFF;
    --glass: color-mix(in srgb, var(--foreground) 94%, transparent);
  }
  /* smooth cross-document crossfade between MAP and DASHBOARDS (same-origin) */
  @view-transition { navigation: auto; }
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root) { animation: stFadeOut .2s ease both; }
    ::view-transition-new(root) { animation: stFadeIn .3s ease both; }
  }
  @keyframes stFadeOut { to { opacity: 0; } }
  @keyframes stFadeIn { from { opacity: 0; } }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; overflow: hidden; }
  body {
    font-family: var(--font-sans);
    background: var(--background, var(--bg));
    background-image: radial-gradient(circle, color-mix(in srgb, var(--foreground) 5%, transparent) 1px, transparent 1px);
    background-size: 14px 14px;
    color: var(--ivory);
    -webkit-font-smoothing: antialiased;
    cursor: grab;
  }
  body.panning { cursor: grabbing; }
  /* during a transition the cursor doesn't exist · no hovers, no clicks, until the scene settles */
  body.transitioning #world, body.transitioning .edge-dept, body.transitioning #back, body.transitioning .wchev { pointer-events: none !important; }
  body.transitioning { cursor: default; }

  /* light mode · the instrument on paper (v1 dot-grid canvas energy) */
  body.light {
    background: var(--bg);
    background-image: radial-gradient(circle, color-mix(in srgb, var(--foreground) 20%, transparent) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  body.light #stars { display: none; }
  body.light .node.deployed { box-shadow: 0 0 0 1px color-mix(in srgb, var(--foreground) 18%, transparent), 0 4px 14px color-mix(in srgb, var(--foreground) 16%, transparent); }
  body.light .node.dev { background: var(--badge-glyph); border-color: color-mix(in srgb, var(--foreground) 85%, transparent); box-shadow: 0 2px 9px color-mix(in srgb, var(--foreground) 14%, transparent); }
  body.light .node.plan { background: var(--badge-glyph); border-color: color-mix(in srgb, var(--foreground) 60%, transparent); box-shadow: 0 2px 8px color-mix(in srgb, var(--foreground) 10%, transparent); }
  body.light .node.plan svg { stroke: color-mix(in srgb, var(--foreground) 66%, transparent); }
  body.light .node.selected::after { border-color: color-mix(in srgb, var(--foreground) 80%, transparent); }
  body.light .node.selected::before { border-color: color-mix(in srgb, var(--foreground) 18%, transparent); }
  body.light .mini .jdot { box-shadow: 0 0 6px color-mix(in srgb, var(--foreground) 15%, transparent); }
  body.light .mini .jdot.dev { background: var(--badge-glyph); border-color: color-mix(in srgb, var(--foreground) 62%, transparent); }
  body.light .mini .jdot.plan { background: var(--badge-glyph); border-color: color-mix(in srgb, var(--foreground) 42%, transparent); }
  body.light #hub .ring { background: color-mix(in srgb, var(--foreground) 2%, transparent); border-color: color-mix(in srgb, var(--foreground) 50%, transparent);
    box-shadow: 0 0 0 10px color-mix(in srgb, var(--foreground) 2.5%, transparent); }
  body.light #hub .ring::before { border-color: color-mix(in srgb, var(--foreground) 14%, transparent); }
  body.light .ghost { color: color-mix(in srgb, var(--foreground) 5%, transparent); }
  body.light .root-badge, body.light .mini .rootb { background: var(--badge-glyph); }
  body.light #card .skill { border-color: color-mix(in srgb, var(--foreground) 25%, transparent); }
  body.light #progress .bar { background: color-mix(in srgb, var(--foreground) 14%, transparent); }
  body.light .horizon { background: radial-gradient(ellipse 50% 100% at 50% 100%, color-mix(in srgb, var(--foreground) 5%, transparent), transparent 70%); }

  #stars { position: fixed; inset: -100px; pointer-events: none; opacity: 0; transition: opacity 1.2s ease; }
  body.ready #stars { opacity: 1; }
  .bgstar { position: absolute; border-radius: 50%; background: var(--foreground-muted);
    animation: twinkle 6s ease-in-out infinite; }
  @keyframes twinkle { 0%,100% { opacity: .45; } 50% { opacity: .1; } }
  @media (prefers-reduced-motion: reduce) {
    .bgstar { animation: none !important; }
  }

  #viewport { position: fixed; inset: 0; overflow: hidden; clip-path: inset(0); }
  /* will-change is toggled from JS: on while the camera moves, off once settled —
     leaving it on permanently makes the browser scale a cached raster (blurry zoom) */
  #world { position: absolute; left: 50%; top: 56%; transform-origin: 0 0; overflow: visible; }

  /* ================== SKY ================== */
  #sky { position: absolute; left: 0; top: 0; perspective: 2000px; transform-style: flat; }
  .tree { position: absolute; opacity: 0; }
  body.ready .tree { animation: treein .9s cubic-bezier(.2,.75,.25,1) forwards; animation-delay: var(--d); }
  @keyframes treein { from { opacity: 0; transform: translateY(34px); } to { opacity: 1; transform: translateY(0); } }
  .tree.dim { transition: opacity .45s ease, filter .45s ease; opacity: .12 !important; filter: blur(6px); }
  .tree .warp { transform: rotateY(var(--ry)); transform-style: flat; }
  .tree svg.lines { position: absolute; overflow: visible; pointer-events: none; }

  .sigil { position: absolute; pointer-events: none; opacity: 0; transition: opacity .8s ease; }
  body.ready .sigil { opacity: 1; transition-delay: calc(var(--d) + .5s); }
  .sigil g { fill: none; stroke: var(--c); stroke-linecap: round; stroke-linejoin: round; }
  .sigil .soft { stroke-width: 5; opacity: .1; }
  .sigil .sharp { stroke-width: 1.3; opacity: .26; }
  .sigil .sd { fill: var(--c); stroke: none; }

  .star { position: absolute; pointer-events: none; }
  .star .core {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    border-radius: 50%;
    background: radial-gradient(circle, white 0%, var(--c) 55%, transparent 75%);
  }
  .s-leaf .core { width: 9px; height: 9px; box-shadow: 0 0 9px var(--c), 0 0 20px color-mix(in srgb, var(--c) 45%, transparent); }
  .s-leaf .lbl {
    position: absolute; top: 50%;
    font-size: 40px; font-weight: 500; color: color-mix(in srgb, var(--foreground) 70%, transparent);
    width: 300px; line-height: 1.2;
  }
  body.light .s-leaf .lbl { color: color-mix(in srgb, var(--foreground) 97%, transparent); font-weight: 600; }
  .s-leaf.lr .lbl { left: 13px; text-align: left; transform-origin: 0 50%; transform: translateY(-50%) scale(.3333); }
  .s-leaf.ll .lbl { right: 13px; text-align: right; transform-origin: 100% 50%; transform: translateY(-50%) scale(.3333); }

  .s-fn { width: 34px; height: 34px; margin: -17px 0 0 -17px; }
  .s-fn .ic {
    position: absolute; inset: 0; border-radius: 50%;
    display: grid; place-items: center; color: white;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--c) 75%, white), var(--c));
    box-shadow: 0 0 14px var(--c), 0 0 36px color-mix(in srgb, var(--c) 50%, transparent);
  }
  .s-fn .ic svg { position: absolute; left: 50%; top: 50%; width: 51px; height: 51px; transform: translate(-50%,-50%) scale(.3333); }
  .s-fn .lbl {
    position: absolute; top: 40px; left: 50%;
    transform-origin: 50% 0; transform: translateX(-50%) scale(.3333);
    font-size: 40px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 90%, transparent); white-space: nowrap; text-align: center;
  }
  body.light .s-fn .lbl { color: var(--background); }
  .s-fn.stag .lbl { top: 62px; }

  .s-dom { width: 58px; height: 58px; margin: -29px 0 0 -29px; }
  .s-dom .ic {
    position: absolute; inset: 0; border-radius: 50%;
    display: grid; place-items: center; color: white;
    background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--c) 70%, white), var(--c));
    box-shadow: 0 0 22px var(--c), 0 0 60px color-mix(in srgb, var(--c) 55%, transparent), 0 0 130px color-mix(in srgb, var(--c) 30%, transparent);
  }
  .s-dom .ic svg { position: absolute; left: 50%; top: 50%; width: 81px; height: 81px; transform: translate(-50%,-50%) scale(.3333); }
  .s-dom .lbl {
    position: absolute; top: 70px; left: 50%;
    transform-origin: 50% 0; transform: translateX(-50%) scale(.3333);
    font-family: var(--font-sans);
    font-size: 144px; letter-spacing: .24em; text-transform: uppercase;
    color: var(--ivory); white-space: nowrap; text-align: center;
  }
  .s-dom .sub { font-family: var(--font-sans); font-size: 60px; letter-spacing: .04em; text-transform: none; color: var(--ink-2); margin-top: 14px; }

  /* the ground · both states grow from the same horizon */
  .horizon { position: absolute; pointer-events: none;
    background: radial-gradient(ellipse 50% 100% at 50% 100%, color-mix(in srgb, var(--foreground) 6%, transparent), transparent 70%); }

  /* ====== SKY = seven miniature fans, same language as navigation ====== */
  .mini { cursor: pointer; transition: opacity .35s ease, filter .35s ease; }
  .mini .scaler { transition: transform .35s ease; transform-origin: 0 0; }
  .tree.settled { animation: none !important; opacity: 1; }
  .mini.dim2 { opacity: .42; }
  .mini.focused { opacity: 1; }
  .mini.focused .scaler { transform: scale(1.05); }
  /* hovering ANY part of a department lights the whole thing and darkens the rest of the wheel */
  .mini .hit { position: absolute; left: -250px; top: -420px; width: 500px; height: 470px; border-radius: 50%; }
  @media (hover: hover) and (pointer: fine) {
    #sky:has(.mini:hover) .mini:not(:hover) { opacity: .18 !important; }
    #sky:has(.mini:hover) #hub, #sky:has(.mini:hover) #spokes { opacity: .3; }
  }
  #hub { transition: opacity .35s ease, transform .45s cubic-bezier(.2,.8,.25,1); }
  #spokes { transition: opacity .35s ease; }
  /* hub focused (card open) · same treatment as a focused department */
  #sky.hubfocus #hub { transform: scale(1.65); }
  #sky.hubfocus #hub .hname { color: var(--copper); }
  #sky.hubfocus .mini { opacity: .18 !important; }
  #sky.hubfocus #spokes { opacity: .3; }
  @media (hover: hover) and (pointer: fine) {
    .mini:hover { opacity: 1 !important; }
    .mini:hover .scaler { transform: scale(1.08); }
    .mini:hover .wname .nm { color: var(--c); }
    .mini:hover .jdot { box-shadow: 0 0 10px color-mix(in srgb, var(--c) 55%, transparent); }
  }
  .mini .jdot { position: absolute; width: 15px; height: 15px; margin: -7.5px 0 0 -7.5px; border-radius: 50%;
    background: var(--ivory); box-shadow: 0 0 7px color-mix(in srgb, var(--foreground) 35%, transparent); }
  .mini .jdot.dev { background: color-mix(in srgb, var(--foreground) 10%, transparent); border: 1.5px solid color-mix(in srgb, var(--foreground) 65%, transparent); box-shadow: none; }
  .mini .jdot.plan { background: color-mix(in srgb, var(--foreground) 4%, transparent); border: 1px solid color-mix(in srgb, var(--foreground) 16%, transparent); box-shadow: none; }
  .mini .rootb {
    position: absolute; width: 64px; height: 64px; margin: -32px 0 0 -32px;
    border-radius: 50%; display: grid; place-items: center;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--c) 65%, transparent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--c) 7%, transparent);
  }
  .mini .rootb svg { width: 27px; height: 27px; stroke: var(--c); }
  .mini .wname { position: absolute; transform: translate(-50%,-50%); text-align: center; cursor: pointer; }
  .mini .wname .nm {
    transform-origin: 50% 50%; transform: scale(.3333);
    font-family: var(--font-sans); font-size: 126px; letter-spacing: .24em;
    color: var(--ivory); text-transform: uppercase; white-space: nowrap;
  }
  .mini .wname .sb {
    transform-origin: 50% 0; transform: scale(.3333);
    font-size: 42px; letter-spacing: .06em; color: var(--ink-2); white-space: nowrap; margin-top: -28px;
  }

  /* the company brain · a living neural core at the centre of the wheel */
  #hub { position: absolute; left: 0; top: 0; pointer-events: none; }
  #hub .core { position: absolute; left: -155px; top: -155px; }
  /* light mode · a whisper of dark circular haze so the brain pops off the paper */
  body.light #hub::before { content: ''; position: absolute; left: 0; top: 0; width: 460px; height: 460px; margin: -230px 0 0 -230px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--foreground) 16%, transparent) 0%, color-mix(in srgb, var(--foreground) 8%, transparent) 44%, transparent 72%); pointer-events: none; }
  #hub .spinslow { animation: hspin 170s linear infinite; transform-origin: 0 0; }
  @keyframes hspin { to { transform: rotate(360deg); } }
  #hub .drift { animation: hdrift 12s ease-in-out infinite alternate; }
  @keyframes hdrift { from { transform: translate(2.2px, -2.6px); } to { transform: translate(-2.2px, 2.6px); } }
  #hub .bn { animation: bpulse 3.2s ease-in-out infinite; }
  @keyframes bpulse { 0%, 100% { opacity: .85; } 50% { opacity: .2; } }
  #hub .nucleus { animation: npulse 2.6s ease-in-out infinite; }
  @keyframes npulse { 0%, 100% { opacity: 1; r: 5; } 50% { opacity: .65; r: 6.5; } }
  #hub .hname {
    position: absolute; left: 0; top: 136px; transform: translateX(-50%);
    text-align: center; white-space: nowrap;
    font-size: 11px; font-weight: 700; letter-spacing: .3em; color: var(--ivory-2);
    transition: color .25s ease;
  }
  #hub .hname div { font-size: 9.5px; font-weight: 500; letter-spacing: .14em; color: var(--ink-3); margin-top: 3px; }
  #hub .hname .hz { font-size: 8.5px; font-weight: 700; letter-spacing: .3em; color: var(--copper); margin: 0 0 4px; }
  /* the hub is node zero · clickable */
  #hub .hubhit {
    position: absolute; left: -156px; top: -156px; width: 312px; height: 312px;
    border-radius: 50%; pointer-events: auto; cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    #hub:has(.hubhit:hover) { transform: scale(1.18); }
    #hub:has(.hubhit:hover) .hname { color: var(--copper); }
    #hub:has(.hubhit:hover) .nucleus { animation-duration: 1.1s; }
    #sky:has(.hubhit:hover) .mini { opacity: .35; }
  }
  #spokes { position: absolute; left: 0; top: 0; overflow: visible; pointer-events: none; }

  /* ================== FAN ================== */
  #fanwrap { position: absolute; left: 0; top: 0; overflow: visible; }
  .fan { position: absolute; left: 0; top: 0; transition: opacity .45s ease, transform .45s ease; }
  .fan.enter-r { opacity: 0; transform: translateX(460px); }
  .fan.enter-l { opacity: 0; transform: translateX(-460px); }
  .fan.exit-l { opacity: 0; transform: translateX(-460px); pointer-events: none; }
  .fan.exit-r { opacity: 0; transform: translateX(460px); pointer-events: none; }
  .fan.collapse { opacity: 0; transform: scale(.86); pointer-events: none; }
  .fan svg.under { position: absolute; overflow: visible; pointer-events: none; }

  .fan path.draw { stroke-dasharray: 1; stroke-dashoffset: 1; animation: drawline .55s ease forwards; animation-delay: var(--d, 0s); }
  @keyframes drawline { to { stroke-dashoffset: 0; } }
  .fan circle.popdot { opacity: 0; animation: fadein .3s ease forwards; animation-delay: var(--d, 0s); }
  @keyframes fadein { to { opacity: 1; } }

  .ghost {
    position: absolute; transform: translate(-50%,-50%);
    font-family: var(--font-sans); font-size: 290px; letter-spacing: .12em;
    color: color-mix(in srgb, var(--foreground) 3%, transparent); white-space: nowrap; pointer-events: none;
    text-transform: uppercase;
  }

  .node {
    position: absolute; width: 74px; height: 74px; margin: -37px 0 0 -37px;
    border-radius: 50%; cursor: pointer;
    display: grid; place-items: center;
    transition: transform .18s ease, box-shadow .18s ease, opacity .3s ease;
    opacity: 0; animation: nodepop .45s cubic-bezier(.2,.9,.3,1.4) forwards; animation-delay: var(--d, 0s);
  }
  @keyframes nodepop { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
  .node > svg { width: 36px; height: 36px; pointer-events: none; }   /* the job icon only — not the leaves svg */
  .node .leaves svg { width: 200px; height: 200px; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) { .node:hover { transform: scale(1.12); } }
  .node:focus { outline: none; }
  .node:focus-visible, .team-label:focus-visible, .root-badge:focus-visible {
    outline: 2px solid var(--ivory); outline-offset: 4px; border-radius: 50%; }
  .team-label:focus-visible { border-radius: var(--radius-md); }
  .node.deployed { background: var(--ivory); box-shadow: 0 0 0 1px color-mix(in srgb, var(--foreground) 25%, transparent), 0 4px 18px color-mix(in srgb, var(--background) 50%, transparent); }
  .node.deployed svg { stroke: var(--badge-glyph); }
  .node.dev { background: color-mix(in srgb, var(--foreground) 7%, transparent); border: 1.5px solid color-mix(in srgb, var(--foreground) 70%, transparent); }
  .node.dev svg { stroke: var(--ivory); }
  .node.plan { background: color-mix(in srgb, var(--foreground) 3%, transparent); border: 1.5px solid color-mix(in srgb, var(--foreground) 18%, transparent); }
  .node.plan svg { stroke: color-mix(in srgb, var(--foreground) 30%, transparent); }
  .node.faded { opacity: .25; }
  .node.selected { transform: scale(1.12); }
  .node.selected::after { content: ''; position: absolute; inset: -12px;
    border: 2px solid color-mix(in srgb, var(--foreground) 85%, transparent); border-radius: 50%; }
  .node.selected::before { content: ''; position: absolute; inset: -22px;
    border: 1px solid color-mix(in srgb, var(--foreground) 18%, transparent); border-radius: 50%; }
  .node .nlabel {
    position: absolute; top: 74px; left: 50%;
    transform-origin: 50% 0; transform: translateX(-50%) scale(.3333);
    font-size: 36px; font-weight: 600; color: var(--ivory-2);
    white-space: nowrap; opacity: 0; transition: opacity .2s ease; pointer-events: none;
  }
  .node:hover .nlabel, .node.selected .nlabel { opacity: 1; }
  /* once you're zoomed in, every job is named · no hover hunting */
  body.zoomedin .node:not(.faded) .nlabel { opacity: 1; }

  /* selected node · clear the stage: tag gone, title down + bigger, leaves pushed out with names */
  .node .nlabel, .node .ftag { transition: opacity .2s ease, transform .3s cubic-bezier(.2,.8,.25,1), top .3s cubic-bezier(.2,.8,.25,1); }
  .node.selected .ftag { opacity: 0; }
  .node.selected .nlabel { top: 86px; transform: translateX(-50%) scale(.46); color: var(--ivory); }
  .node .leaves { transition: transform .35s cubic-bezier(.2,.8,.25,1); }
  .node.selected .leaves { transform: scale(1.45); }
  .node.selected .leaf::after { opacity: 1; }

  /* alveoli · each job's sub-skills as terminal leaf clusters · click one to see what it is */
  .node .leaves { position: absolute; left: 50%; top: 50%; width: 0; height: 0; pointer-events: none; }
  .node .leaves svg { position: absolute; left: -100px; top: -100px; overflow: visible; }
  .leaf {
    position: absolute; width: 20px; height: 20px; margin: -10px 0 0 -10px; border-radius: 50%;
    pointer-events: auto; cursor: pointer;
  }
  .leaf::before {
    content: ''; position: absolute; inset: 3.5px; border-radius: 50%;
    background: var(--lc); opacity: .6; transition: transform .18s ease, opacity .18s ease;
  }
  .leaf:hover::before { transform: scale(1.3); opacity: .95; }
  /* the title · only on hover, crisp under zoom */
  .leaf::after {
    content: attr(data-sk); position: absolute; left: 50%; top: 21px;
    transform-origin: 50% 0; transform: translateX(-50%) scale(.3333);
    font-size: 30px; font-weight: 600; letter-spacing: .02em;
    color: var(--ivory-2); white-space: nowrap;
    opacity: 0; transition: opacity .15s ease; pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) { .leaf:hover::after { opacity: 1; } }


  .root-badge {
    position: absolute; width: 150px; height: 150px; margin: -75px 0 0 -75px;
    border-radius: 50%; display: grid; place-items: center;
    background: radial-gradient(circle, color-mix(in srgb, var(--c) 12%, transparent), transparent 70%);
    border: 2px solid color-mix(in srgb, var(--c) 70%, transparent);
    box-shadow: 0 0 0 12px color-mix(in srgb, var(--c) 8%, transparent), 0 0 40px color-mix(in srgb, var(--c) 15%, transparent);
    opacity: 0; animation: nodepop .5s cubic-bezier(.2,.9,.3,1.3) forwards;
  }
  .root-badge svg { width: 56px; height: 56px; stroke: var(--c); fill: none; }

  .fan-dname {
    position: absolute; left: 0; top: 76px; text-align: center;
    transform-origin: 50% 0; transform: translateX(-50%) scale(.3333);
    font-family: var(--font-sans); font-size: 126px; letter-spacing: .22em;
    text-transform: uppercase; color: var(--ivory); white-space: nowrap;
    opacity: 0; animation: fadein .5s ease forwards .4s;
  }
  .fan-dname .fan-dsub { font-family: var(--font-sans); font-size: 42px;
    letter-spacing: .06em; color: var(--ink-2); margin-top: 12px; text-transform: none; }

  .team-label {
    position: absolute; transform: translate(-50%,-50%); text-align: center;
    cursor: pointer; user-select: none;
    opacity: 0; animation: fadein .5s ease forwards; animation-delay: var(--d, 0s);
  }
  .team-label .t {
    font-family: var(--font-sans); font-size: 68px; letter-spacing: .28em;
    transform-origin: 50% 100%; transform: scale(.3333);
    color: var(--ivory-2); text-transform: uppercase; white-space: nowrap;
    transition: color .2s ease;
  }
  .team-label:hover .t { color: var(--ivory); }
  .team-label .tc { font-size: 14px; letter-spacing: .18em; color: var(--ink-3); margin-top: 2px; text-transform: uppercase; }

  /* neighbouring departments at the screen edges, with constellation chevrons */
  .edge-dept {
    position: fixed; top: 50%; transform: translateY(-50%); z-index: 9;
    cursor: pointer; user-select: none;
    display: flex; align-items: center; gap: 11px;
    color: var(--ivory-2);
    transition: color .2s ease, opacity .4s ease; opacity: 0; pointer-events: none;
  }
  body.fanmode .edge-dept { opacity: 1; pointer-events: auto; }
  .edge-dept:hover { color: var(--ivory); }
  .edge-dept .et {
    font-family: var(--font-sans); font-size: 17px; letter-spacing: .3em;
    text-transform: uppercase; writing-mode: vertical-rl;
  }
  .edge-dept .echev { width: 13px; height: 22px; opacity: .9; }
  .edge-dept:hover .echev { animation: chevnudge 1.1s ease-in-out infinite; }
  #edge-l { left: 20px; }
  #edge-l .et { transform: rotate(180deg); }
  #edge-r { right: 20px; }
  @keyframes chevnudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(var(--nx, -3px)); } }
  #edge-r .echev { --nx: 3px; }

  /* wheel chevrons · flank the seated department, step the wheel */
  .wchev {
    position: fixed; bottom: 8.5%; z-index: 9;
    width: 48px; height: 48px; display: grid; place-items: center;
    background: none; border: none; cursor: pointer; color: var(--ivory-2);
    opacity: 0; pointer-events: none; transition: opacity .5s ease, color .2s ease;
  }
  body.ready:not(.fanmode) .wchev { opacity: 1; pointer-events: auto; }
  .wchev svg { width: 15px; height: 25px; }
  @media (hover: hover) and (pointer: fine) {
    .wchev:hover { color: var(--ivory); }
    .wchev:hover svg { animation: chevnudge 1.1s ease-in-out infinite; }
  }
  #wchev-l { left: calc(50% - 215px); }
  #wchev-r { right: calc(50% - 215px); --nx: 3px; }
  @media (max-width: 700px) {
    .wchev { bottom: 14%; }
    #wchev-l { left: calc(50% - 150px); }
    #wchev-r { right: calc(50% - 150px); }
  }

  /* ================== CHROME ================== */
  .chrome { position: fixed; z-index: 10; }
  #topbar {
    top: 0; left: 0; right: 0; height: 52px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 18px; pointer-events: none;
  }
  .brand { font-family: var(--font-sans); font-size: 19px; letter-spacing: .14em; color: var(--ivory); }
  #topright { display: flex; align-items: center; gap: 14px; margin-right: 0; }
  #state-name { font-size: 10px; font-weight: 700; letter-spacing: .22em; color: var(--copper); }
  #counts { display: none; }
  #bookcall {
    pointer-events: auto; display: inline-flex; align-items: center; gap: 7px;
    height: 34px; padding: 0 15px; box-sizing: border-box;
    font-size: 12.5px; font-weight: 600; color: var(--background);
    text-decoration: none; white-space: nowrap; border-radius: var(--radius-md);
    border: 1px solid color-mix(in srgb, var(--background) 10%, transparent); background: var(--foreground);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--background) 6%, transparent);
    transition: color .18s, border-color .18s, background .18s;
  }
  #bookcall:hover { border-color: color-mix(in srgb, var(--background) 22%, transparent); background: color-mix(in srgb, var(--foreground) 96%, var(--background)); }

  /* light / dark switch · top right, the one control that never moves */
  #themetog {
    position: fixed; top: 13px; right: 18px; z-index: 12;
    width: 46px; height: 25px; border-radius: var(--radius-md);
    background: var(--glass); border: 1px solid var(--line);
    cursor: pointer; padding: 0;
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    transition: border-color .2s;
  }
  #themetog:hover { border-color: color-mix(in srgb, var(--ivory) 28%, transparent); }
  #themetog .tt-thumb {
    position: absolute; top: 50%; left: 3px; margin-top: -9.5px;
    width: 19px; height: 19px; border-radius: 50%;
    background: var(--ivory); color: var(--bg);
    display: flex; align-items: center; justify-content: center;
    transition: transform .28s cubic-bezier(.4,0,.2,1);
  }
  body.light #themetog .tt-thumb { transform: translateX(19px); }
  #themetog svg { width: 11px; height: 11px; position: absolute; transition: opacity .2s, transform .28s cubic-bezier(.4,0,.2,1); }
  #themetog .tt-sun { opacity: 0; transform: rotate(-45deg); }
  body.light #themetog .tt-moon { opacity: 0; transform: rotate(45deg); }
  body.light #themetog .tt-sun { opacity: 1; transform: rotate(0deg); }

  #back {
    top: 64px; left: 24px; display: none;
    font-size: 11px; font-weight: 700; letter-spacing: .2em; color: var(--ink-2);
    background: none; border: none; cursor: pointer; font-family: inherit;
    padding: 6px 0;
  }
  #back:hover { color: var(--ivory); }
  body.fanmode #back { display: block; }

  #card {
    top: 104px; left: 28px; width: 364px; display: none;
    background: var(--glass); backdrop-filter: blur(16px);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: 20px 18px 20px 20px;
    max-height: calc(100vh - 200px); overflow-y: auto; overscroll-behavior: contain;
  }
  #card::-webkit-scrollbar { width: 4px; }
  #card::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--foreground) 18%, transparent); border-radius: 2px; }
  body.light #card::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--foreground) 20%, transparent); }
  #card.open { display: block; }
  /* drag the right edge to widen the skill card */
  #cresize { position: fixed; width: 11px; margin-left: -5px; z-index: 11; display: none; cursor: ew-resize; touch-action: none; }
  #cresize::after { content: ''; position: absolute; left: 4px; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; background: transparent; transition: background .15s; }
  #cresize:hover::after, #cresize.dragged::after { background: var(--copper); }
  @media (max-width: 640px) { #cresize { display: none !important; } }
  #card .c-x {
    position: sticky; top: 0; float: right; margin: -6px -6px 0 10px;
    width: 30px; height: 30px; display: grid; place-items: center;
    font-family: inherit; font-size: 13px; color: var(--ivory-2);
    background: var(--glass); border: 1px solid var(--line); border-radius: 50%;
    cursor: pointer; z-index: 2;
  }
  #card .c-x:hover { color: var(--ivory); border-color: var(--copper); }
  /* scrollable surfaces must keep native touch scrolling */
  #card, #reader .rbody, #about .panel, #search .sres { touch-action: pan-y; }
  #card .c-state { font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--copper); margin-bottom: 2px; }
  #card .c-name { font-family: var(--font-sans); font-size: 26px; letter-spacing: .04em; margin-bottom: 6px; }
  #card .c-crumb { font-size: 11px; color: var(--ink-2); letter-spacing: .06em; margin-bottom: 12px; }
  #card .c-desc { font-size: 13px; line-height: 1.65; color: color-mix(in srgb, var(--foreground) 80%, transparent); margin-bottom: 14px; }
  body.light #card .c-desc { color: color-mix(in srgb, var(--foreground) 82%, transparent); }
  #card .c-sec { font-size: 10px; font-weight: 700; letter-spacing: .2em; color: var(--ink-3); margin-bottom: 7px; }
  #card .skills { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  #card .skill { font-size: 11px; color: var(--ivory-2); border: 1px solid color-mix(in srgb, var(--foreground) 25%, transparent); border-radius: var(--radius-sm); padding: 3px 8px; }
  #card .tools { font-size: 12px; color: var(--ink-2); margin-bottom: 14px; }
  #card .cta {
    display: inline-flex; align-items: center; gap: 7px; font-family: inherit; font-size: 11px; font-weight: 700; letter-spacing: .14em;
    color: var(--copper); text-decoration: none; background: none; cursor: pointer; border: 1px solid color-mix(in srgb, var(--copper) 50%, transparent);
    border-radius: var(--radius-sm); padding: 7px 12px; text-transform: uppercase;
    transition: background .2s ease, color .2s ease;
  }
  #card .cta .cta-q { display: inline-grid; place-items: center; width: 15px; height: 15px; border-radius: 50%; border: 1px solid currentColor; font-size: 9px; letter-spacing: 0; }
  #card .cta:hover { background: var(--copper); color: var(--background); }

  /* ===== playbook layer (deep entries) ===== */
  #card .c-found {
    display: inline-block; font-size: 9px; font-weight: 700; letter-spacing: .18em;
    color: var(--copper); border: 1px solid color-mix(in srgb, var(--copper) 45%, transparent);
    border-radius: var(--radius-sm); padding: 2px 6px; margin-left: 9px; vertical-align: 4px; white-space: nowrap;
  }
  #card .c-replaces {
    font-size: 12.5px; line-height: 1.6; color: var(--ivory-2); margin-bottom: 14px;
    padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
  }
  body.light #card .c-replaces { background: color-mix(in srgb, var(--foreground) 3%, transparent); }
  #card .reqs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  #card .req {
    font-size: 11px; color: var(--ivory-2); border: 1px dashed color-mix(in srgb, var(--foreground) 35%, transparent);
    border-radius: var(--radius-sm); padding: 3px 8px; cursor: pointer;
    transition: color .15s ease, border-color .15s ease;
  }
  body.light #card .req { border-color: color-mix(in srgb, var(--foreground) 35%, transparent); }
  #card .req:hover { color: var(--ivory); border-color: var(--ivory); }
  /* the node card is greyscale too · the constellation keeps its colours */
  #card { --copper: var(--muted-foreground); --copper-line: color-mix(in srgb, var(--foreground) 22%, transparent); }
  body.light #card { --copper: var(--muted-foreground); --copper-line: color-mix(in srgb, var(--foreground) 22%, transparent); }
  #card .req.hubchip { color: var(--copper);
    border: 1px solid color-mix(in srgb, var(--copper) 45%, transparent); }
  #card .req.hubchip:hover { color: var(--copper); border-color: var(--copper); }
  #card .ladder { margin-bottom: 14px; }
  #card .lrow { display: flex; gap: 10px; padding: 7px 0; border-top: 1px solid var(--line);
    font-size: 12px; line-height: 1.55; }
  #card .lrow .lk { flex: 0 0 88px; font-size: 9.5px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-3); padding-top: 2px; }
  #card .lrow.cur .lk { color: var(--copper); }
  #card .lrow .lv { color: var(--ivory-2); }
  #card .lrow.cur .lv { color: var(--ivory); }
  #card .c-notes { font-size: 12.5px; line-height: 1.65; color: var(--ivory-2); margin-bottom: 14px; }
  #card .files { margin-bottom: 14px; }
  /* high-up cue: there's a runnable, downloadable skill here */
  #card .c-skillcue { margin: 0 0 14px; }
  #card .c-skillcue:empty { display: none; }
  #card .skillcue {
    display: flex; align-items: center; gap: 10px; cursor: pointer;
    border: 1px solid var(--copper-line, color-mix(in srgb, var(--muted-foreground) 50%, transparent)); border-radius: var(--radius-md);
    padding: 11px 13px; background: color-mix(in srgb, var(--muted-foreground) 7%, transparent);
    transition: background .2s ease, border-color .2s ease;
  }
  #card .skillcue:hover { background: color-mix(in srgb, var(--muted-foreground) 13%, transparent); border-color: var(--copper); }
  #card .skillcue .sc-ic {
    flex: 0 0 auto; width: 26px; height: 26px; border-radius: var(--radius-md); display: flex;
    align-items: center; justify-content: center; font-size: 15px;
    color: var(--copper); background: color-mix(in srgb, var(--muted-foreground) 14%, transparent); border: 1px solid color-mix(in srgb, var(--muted-foreground) 35%, transparent);
  }
  #card .skillcue .sc-tx { flex: 1; font-size: 12px; color: var(--ivory-2); line-height: 1.4; }
  #card .skillcue .sc-tx b { color: var(--ivory); font-weight: 700; }
  #card .skillcue .sc-lock {
    flex: 0 0 auto; font-size: 11px; font-weight: 700; color: var(--copper);
    border: 1px solid var(--copper); border-radius: var(--radius-md); padding: 4px 11px; white-space: nowrap;
  }
  #card .skillcue .sc-go { flex: 0 0 auto; font-size: 11px; font-weight: 700; color: var(--copper); }
  /* "Take it" → glow the actual download so it is obvious where to grab the skill */
  @keyframes dlGlow { 0%,100% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--muted-foreground) 30%, transparent); } 50% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--muted-foreground) 50%, transparent), 0 0 22px color-mix(in srgb, var(--muted-foreground) 55%, transparent); } }
  #card .files.glow .dl { animation: dlGlow 1.15s ease-in-out 3; box-shadow: 0 0 0 1.5px var(--copper); border-color: var(--copper); }
  #card .files.glow .dl .dlt { color: var(--copper); }
  /* "Need help building this?" dialog · solid + readable, above everything */
  #helpdlg, #buydlg { position: fixed; inset: 0; z-index: 9999; display: none; place-items: center; padding: 20px; cursor: default; background: color-mix(in srgb, var(--background) 64%, transparent); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  body.light #helpdlg, body.light #buydlg { background: color-mix(in srgb, var(--background) 44%, transparent); }
  #helpdlg.open, #buydlg.open { display: grid; }
  .hd-panel { width: min(450px,100%); position: relative; cursor: default; background: var(--panel); border: 1px solid color-mix(in srgb, var(--foreground) 13%, transparent); border-radius: var(--radius-md); padding: 30px 28px 28px; box-shadow: 0 40px 100px -28px color-mix(in srgb, var(--background) 72%, transparent); }
  body.light .hd-panel { background: var(--badge-glyph); border-color: color-mix(in srgb, var(--foreground) 12%, transparent); box-shadow: 0 40px 100px -34px color-mix(in srgb, var(--foreground) 28%, transparent); }
  .hd-x { position: absolute; top: 16px; right: 16px; width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid var(--line); background: none; color: var(--ink-2); border-radius: var(--radius-md); cursor: pointer; font-size: 13px; transition: color .15s, border-color .15s; }
  .hd-x:hover { color: var(--ivory); border-color: var(--copper); }
  .hd-eye { font-size: 10px; font-weight: 700; letter-spacing: .22em; color: var(--copper); margin-bottom: 12px; }
  .hd-h { font-family: var(--font-sans); font-size: 25px; letter-spacing: .01em; color: var(--ivory); font-weight: 400; line-height: 1.15; margin-bottom: 14px; }
  .hd-p { font-size: 14px; line-height: 1.72; color: var(--ivory-2); margin-bottom: 13px; }
  body.light .hd-p { color: var(--ivory-2); }
  .hd-cta { display: inline-flex; align-items: center; gap: 7px; margin-top: 8px; font-size: 13px; font-weight: 700; letter-spacing: .02em; text-decoration: none; border: none; font-family: inherit; color: var(--background); background: var(--foreground); padding: 12px 20px; border-radius: var(--radius-md); cursor: pointer; transition: opacity .15s ease, transform .15s ease; }
  body.light .hd-cta { color: var(--foreground); background: var(--background); }
  .hd-cta:hover { opacity: .9; transform: translateY(-1px); }
  #buydlg .hd-sub { margin-top: 12px; font-size: 11.5px; color: var(--ink-2); }

  /* founding strip · standalone visits only (never in embeds) */
  #fstrip { position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%); z-index: 900; display: flex; align-items: center; gap: 12px; background: color-mix(in srgb, var(--background) 78%, transparent); -webkit-backdrop-filter: blur(14px) saturate(1.2); backdrop-filter: blur(14px) saturate(1.2); border: 1px solid color-mix(in srgb, var(--foreground) 16%, transparent); border-radius: var(--radius-md); padding: 7px 7px 7px 17px; white-space: nowrap; }
  #fstrip[hidden] { display: none; }
  body.light #fstrip { background: color-mix(in srgb, var(--foreground) 86%, transparent); border-color: color-mix(in srgb, var(--foreground) 16%, transparent); }
  #fstrip .fs-t { font-size: 12px; letter-spacing: .02em; color: var(--ink-2); }
  #fstrip .fs-t b { color: var(--ivory); font-weight: 700; }
  #fstrip .fs-join { border: none; font-family: inherit; background: var(--foreground); color: var(--background); font-weight: 700; font-size: 12px; border-radius: var(--radius-md); padding: 9px 16px; cursor: pointer; }
  body.light #fstrip .fs-join { background: var(--background); color: var(--foreground); }
  @media (max-width: 640px) { #fstrip .fs-x { display: none; } }
  html.embed #fstrip, html.embed #mapgate { display: none !important; }

  /* email gate · one field between a direct visit and the live map (waitlist design system) */
  #mapgate { position: fixed; inset: 0; z-index: 9998; display: grid; place-items: center; padding: 24px; background: color-mix(in srgb, var(--background) 35%, transparent); -webkit-backdrop-filter: blur(3px) saturate(1.3); backdrop-filter: blur(3px) saturate(1.3); }
  #mapgate[hidden] { display: none; }
  #mapgate .mg-scrim { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 60% 50% at 50% 42%, color-mix(in srgb, var(--background) 88%, transparent), color-mix(in srgb, var(--background) 60%, transparent) 55%, color-mix(in srgb, var(--background) 30%, transparent) 100%); }
  #mapgate .mg-card { position: relative; width: 100%; max-width: 460px; text-align: center; animation: mgIn .4s cubic-bezier(.2,.7,.2,1); font-family: var(--font-sans); }
  @keyframes mgIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  #mapgate .mg-brand { margin-bottom: 26px; }
  #mapgate .mg-brand b { font-family: var(--font-sans); font-weight: 400; font-size: 26px; letter-spacing: .18em; text-transform: uppercase; color: var(--foreground); }
  #mapgate .mg-h { font-size: clamp(26px,4vw,34px); font-weight: 700; letter-spacing: -.02em; line-height: 1.12; color: var(--foreground); margin: 0 0 14px; }
  #mapgate .mg-sub { color: var(--ivory-2); font-size: 15.5px; line-height: 1.55; max-width: 400px; margin: 0 auto 28px; }
  #mapgate .mg-form { display: flex; gap: 10px; max-width: 420px; margin: 0 auto; flex-wrap: wrap; }
  #mapgate .mg-form input { flex: 1; min-width: 200px; width: auto; background: color-mix(in srgb, var(--foreground) 5%, transparent); border: 1px solid color-mix(in srgb, var(--foreground) 17%, transparent); border-radius: var(--radius-md); padding: 14px 16px; color: var(--foreground); font-size: 16px; font-family: inherit; outline: none; transition: border-color .18s; }
  #mapgate .mg-form input:focus { border-color: color-mix(in srgb, var(--primary) 50%, transparent); }
  #mapgate .mg-form input::placeholder { color: var(--ink-3); }
  #mapgate .mg-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-size: 15px; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; border: 1px solid transparent; font-family: inherit; padding: 14px 22px; white-space: nowrap; transition: box-shadow .25s, filter .2s; background: linear-gradient(180deg, var(--primary), color-mix(in srgb, var(--primary) 90%, var(--background))); color: var(--primary-foreground); box-shadow: 0 10px 26px -12px color-mix(in srgb, var(--primary) 70%, transparent), inset 0 1px 0 color-mix(in srgb, var(--foreground) 30%, transparent); }
  #mapgate .mg-btn:hover { filter: brightness(1.09); }
  #mapgate .mg-foot { margin-top: 18px; font-size: 12.5px; color: var(--ink-3); }
  /* locked skill rows + unlock button */
  #card .dl.locked { cursor: pointer; border-style: dashed; opacity: .92; }
  #card .dl.locked .dla { filter: none; font-size: 12px; }
  #card .dl.locked .dlt { color: var(--copper); }
  #card .skbuy {
    display: block; text-align: center; text-decoration: none; cursor: pointer;
    margin-top: 10px; padding: 12px; border-radius: var(--radius-md);
    background: var(--foreground); color: var(--background); font-size: 13px; font-weight: 700;
    transition: opacity .15s ease;
  }
  body.light #card .skbuy { background: var(--background); color: var(--foreground); }
  #card .skbuy:hover { opacity: .88; }
  #card .skcta { display: flex; gap: 8px; margin-top: 10px; }
  #card .skcta .skbuy { flex: 1.3; margin-top: 0; }
  #card .skbook { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; text-decoration: none; cursor: pointer; padding: 12px; border-radius: var(--radius-md); background: transparent; color: var(--ivory); border: 1px solid color-mix(in srgb, var(--foreground) 22%, transparent); font-size: 13px; font-weight: 700; transition: background .15s ease; }
  body.light #card .skbook { color: var(--background); border-color: color-mix(in srgb, var(--foreground) 22%, transparent); }
  #card .skbook:hover { background: color-mix(in srgb, var(--foreground) 7%, transparent); }
  body.light #card .skbook:hover { background: color-mix(in srgb, var(--foreground) 5%, transparent); }
  #card .dl {
    display: flex; align-items: center; flex-wrap: wrap; gap: 4px 9px;
    font-size: 12px; font-weight: 600; color: var(--ivory); text-decoration: none;
    border: 1px solid var(--line); border-radius: var(--radius-md); padding: 9px 11px; margin-bottom: 6px;
    transition: border-color .2s ease;
  }
  #card .dl .dld { flex-basis: 100%; font-size: 11px; font-weight: 400; line-height: 1.55;
    color: var(--ink-2); }
  #card .dl:hover { border-color: var(--copper); }
  #card .dl .dla { color: var(--copper); font-size: 13px; }
  #card .dl .dlt { margin-left: auto; font-size: 8.5px; font-weight: 700; letter-spacing: .14em;
    color: var(--ink-3); }
  #card .my { display: flex; gap: 4px; margin: 2px 0 16px; }
  #card .my button {
    font-family: inherit; flex: 1; font-size: 9px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-2); background: none;
    border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 8px 2px; cursor: pointer;
    transition: color .15s ease, background .15s ease, border-color .15s ease;
  }
  #card .my button:hover { color: var(--ivory); }
  #card .my button.on { background: var(--c, var(--copper)); color: var(--background); border-color: transparent; }

  /* your-tree markers on nodes */
  /* a job you've marked LIVE lights up · the map comes alive as you build your workforce */
  .node.mine { outline: 2px solid var(--c); outline-offset: 4px;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 20%, transparent), 0 0 24px color-mix(in srgb, var(--c) 62%, transparent);
    animation: livepulse 2.8s ease-in-out infinite; }
  @keyframes livepulse {
    0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 16%, transparent), 0 0 16px color-mix(in srgb, var(--c) 44%, transparent); }
    50%      { box-shadow: 0 0 0 5px color-mix(in srgb, var(--c) 26%, transparent), 0 0 30px color-mix(in srgb, var(--c) 72%, transparent); }
  }
  @media (max-width: 700px) { .node.mine { animation: none; } }
  @media (prefers-reduced-motion: reduce) { .node.mine { animation: none; } }
  .node.minedev { outline: 2px dashed color-mix(in srgb, var(--c) 65%, transparent); outline-offset: 4px; }
  /* per-job notes · the member's operating manual, saved to their tree */
  .c-note-in { width: 100%; margin-top: 2px; resize: vertical; min-height: 62px; font: inherit; font-size: 13px; line-height: 1.5;
    color: var(--ivory); background: color-mix(in srgb, var(--foreground) 3%, transparent); border: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent); border-radius: var(--radius-md); padding: 10px 12px; outline: none; }
  .c-note-in:focus { border-color: var(--copper); }
  .c-note-in::placeholder { color: var(--ink-3); }
  body.light .c-note-in { background: color-mix(in srgb, var(--foreground) 2%, transparent); border-color: color-mix(in srgb, var(--foreground) 16%, transparent); }
  .node .mybadge {
    position: absolute; top: -5px; right: -5px; width: 19px; height: 19px; border-radius: 50%;
    background: var(--c); display: none; place-items: center;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--background) 40%, transparent);
  }
  .node.mine .mybadge { display: grid; }
  .node .mybadge svg { width: 10px; height: 10px; stroke: var(--background); }
  .node .ftag {
    position: absolute; top: -34px; left: 50%;
    transform-origin: 50% 100%; transform: translateX(-50%) scale(.3333);
    font-size: 26px; font-weight: 800; letter-spacing: .26em;
    color: var(--copper); white-space: nowrap; pointer-events: none;
  }

  /* ===== version chip + about ===== */
  .brand { display: flex; align-items: baseline; gap: 16px; pointer-events: auto; }
  /* centered segmented nav with fill */
  #tabs {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: flex; gap: 2px; padding: 3px; border-radius: var(--radius-md); height: 34px; box-sizing: border-box;
    background: var(--glass); border: 1px solid var(--line); pointer-events: auto;
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  #tabs a {
    display: flex; align-items: center;
    font-family: var(--font-sans);
    font-size: 10px; font-weight: 700; letter-spacing: .18em; color: var(--ink-2);
    text-decoration: none; padding: 0 16px; border-radius: var(--radius-md); cursor: pointer; transition: color .15s;
  }
  #tabs a.on { background: var(--ivory); color: var(--bg); }
  #tabs a:not(.on):hover { color: var(--ivory); }
  .brand .ver {
    font-family: var(--font-sans);
    font-size: 9px; font-weight: 700; letter-spacing: .18em; color: var(--copper);
    border: 1px solid color-mix(in srgb, var(--copper) 45%, transparent);
    border-radius: var(--radius-sm); padding: 3px 7px; cursor: pointer;
    transition: background .2s ease, color .2s ease;
  }
  .brand .ver:hover { background: var(--copper); color: var(--background); }
  #about {
    position: fixed; inset: 0; z-index: 40; display: none;
    background: color-mix(in srgb, var(--bg) 70%, transparent); backdrop-filter: blur(10px);
  }
  #about.open { display: grid; place-items: center; }
  #about .panel {
    width: min(580px, calc(100vw - 48px)); max-height: calc(100vh - 90px); overflow-y: auto;
    background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius-md);
    padding: 36px 40px; position: relative;
  }
  #about .panel::-webkit-scrollbar { width: 4px; }
  #about .panel::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--foreground) 18%, transparent); border-radius: 2px; }
  #about .ab-x {
    position: absolute; top: 14px; right: 16px; font-family: inherit; font-size: 16px;
    color: var(--ink-2); background: none; border: none; cursor: pointer; padding: 6px;
  }
  #about .ab-x:hover { color: var(--ivory); }
  #about h1 { font-family: var(--font-sans); font-size: 27px; letter-spacing: .12em; font-weight: 400; }
  #about .ab-tag { font-size: 12.5px; color: var(--ink-2); margin: 8px 0 22px; line-height: 1.6; }
  #about .ab-sec { font-size: 10px; font-weight: 700; letter-spacing: .2em; color: var(--copper);
    margin: 22px 0 8px; }
  #about p { font-size: 13px; line-height: 1.7; color: var(--ivory-2); }
  #about p b { color: var(--ivory); font-weight: 600; }
  #about .ab-steps { margin: 4px 0 0; padding: 0; list-style: none; counter-reset: st; }
  #about .ab-steps li { font-size: 13px; line-height: 1.7; color: var(--ivory-2);
    counter-increment: st; display: flex; gap: 12px; padding: 5px 0; }
  #about .ab-steps li::before { content: counter(st, decimal-leading-zero);
    font-family: var(--font-sans); color: var(--copper); font-size: 14px; padding-top: 1px; }
  #about .ab-steps li b { color: var(--ivory); font-weight: 600; }
  #about .ab-btns { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
  #about .ab-btns button {
    font-family: inherit; font-size: 9.5px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ivory-2);
    background: none; border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 8px 13px; cursor: pointer; transition: color .15s ease, border-color .15s ease;
  }
  #about .ab-btns button:hover { color: var(--ivory); border-color: var(--copper); }
  #about .ab-foot { margin-top: 26px; padding-top: 16px; border-top: 1px solid var(--line);
    font-size: 11.5px; color: var(--ink-3); line-height: 1.7; }
  #about .ab-foot a { color: var(--copper); text-decoration: none; }
  #about .ab-lists { margin: 16px 0 2px; display: flex; flex-direction: column; gap: 16px; }
  #about .ab-lgroup .ab-lh { font-size: 10px; font-weight: 700; letter-spacing: .2em; color: var(--copper); margin-bottom: 7px; }
  #about .ab-lgroup .ab-lh.dev { color: var(--ivory-2); }
  #about .ab-items { display: flex; flex-direction: column; gap: 1px; }
  #about .ab-item { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left; font: inherit; color: var(--ivory-2); background: none; border: none; padding: 6px 8px; border-radius: var(--radius-md); cursor: pointer; }
  #about .ab-item:hover { background: color-mix(in srgb, var(--foreground) 6%, transparent); color: var(--ivory); }
  body.light #about .ab-item:hover { background: color-mix(in srgb, var(--foreground) 5%, transparent); }
  #about .ab-item .dot { width: 7px; height: 7px; border-radius: 50%; flex: 0 0 auto; }
  #about .ab-item .dot.devdot { background: transparent; border: 1.5px solid currentColor; }
  #about .ab-item .it-name { font-size: 13px; }
  #about .ab-item .it-dept { margin-left: auto; font-size: 10px; letter-spacing: .04em; color: var(--ink-2); }

  /* ===== skill file reader · read before you take ===== */
  #reader {
    position: fixed; inset: 0; z-index: 50; display: none;
    background: color-mix(in srgb, var(--bg) 72%, transparent); backdrop-filter: blur(10px);
  }
  #reader.open { display: grid; place-items: center; }
  #reader .rpanel {
    width: min(760px, calc(100vw - 48px)); height: calc(100vh - 90px);
    display: flex; flex-direction: column;
    background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius-md);
    overflow: hidden;
  }
  #reader .rhead {
    display: flex; align-items: center; gap: 14px;
    padding: 18px 24px; border-bottom: 1px solid var(--line); flex: 0 0 auto;
  }
  #reader .rname { font-family: var(--font-sans); font-size: 18px; letter-spacing: .06em; }
  #reader .rtag { font-size: 8.5px; font-weight: 700; letter-spacing: .16em; color: var(--copper);
    border: 1px solid color-mix(in srgb, var(--copper) 45%, transparent); border-radius: var(--radius-sm); padding: 3px 7px; }
  #reader .rbtns { margin-left: auto; display: flex; gap: 6px; }
  #reader .rbtns button, #reader .rbtns a {
    font-family: inherit; font-size: 9.5px; font-weight: 700; letter-spacing: .14em;
    text-transform: uppercase; color: var(--ivory-2); text-decoration: none;
    background: none; border: 1px solid var(--line); border-radius: var(--radius-sm);
    padding: 7px 11px; cursor: pointer; transition: color .15s ease, border-color .15s ease;
  }
  #reader .rbtns button:hover, #reader .rbtns a:hover { color: var(--ivory); border-color: var(--copper); }
  #reader .rbody { flex: 1; overflow-y: auto; padding: 24px 28px 34px; }
  #reader .rglance {
    border: 1px solid color-mix(in srgb, var(--copper) 35%, transparent);
    border-radius: var(--radius-md); padding: 14px 16px; margin-bottom: 22px;
  }
  #reader .rglance .rg-sec { font-size: 9px; font-weight: 700; letter-spacing: .2em;
    color: var(--copper); margin: 0 0 5px; }
  #reader .rglance .rg-sec:not(:first-child) { margin-top: 12px; }
  #reader .rglance p { margin: 0; font-size: 12.5px; line-height: 1.65; color: var(--ivory-2); }
  #reader .rglance .rg-covers { display: flex; flex-wrap: wrap; gap: 5px; }
  #reader .rglance .rg-job { font-size: 10.5px; color: var(--ivory-2);
    border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 2px 7px; }
  #reader .rbody::-webkit-scrollbar { width: 4px; }
  #reader .rbody::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--foreground) 18%, transparent); border-radius: 2px; }
  #reader .rbody h2 { font-family: var(--font-sans); font-size: 21px; font-weight: 400;
    letter-spacing: .04em; margin: 26px 0 10px; }
  #reader .rbody h3 { font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase;
    color: var(--copper); margin: 22px 0 8px; }
  #reader .rbody h4 { font-size: 12.5px; font-weight: 700; color: var(--ivory); margin: 16px 0 6px; }
  #reader .rbody p, #reader .rbody li { font-size: 13px; line-height: 1.75; color: var(--ivory-2); margin: 0 0 10px; }
  #reader .rbody .mdic { width: 1.02em; height: 1.02em; display: inline-block; vertical-align: -.16em; margin: 0 2px 0 0; color: var(--ink-2); stroke-width: 1.9; }
  #reader .rbody ul, #reader .rbody ol { padding-left: 20px; margin: 0 0 12px; }
  #reader .rbody li { margin: 0 0 4px; }
  #reader .rbody b { color: var(--ivory); font-weight: 600; }
  #reader .rbody code {
    font-family: ui-monospace, Menlo, monospace; font-size: 11.5px;
    background: color-mix(in srgb, var(--foreground) 6%, transparent); border: 1px solid var(--line);
    border-radius: var(--radius-sm); padding: 1px 5px; color: var(--ivory);
  }
  body.light #reader .rbody code { background: color-mix(in srgb, var(--foreground) 5%, transparent); }
  #reader .rbody pre {
    font-family: ui-monospace, Menlo, monospace; font-size: 11px; line-height: 1.55;
    background: color-mix(in srgb, var(--foreground) 4%, transparent); border: 1px solid var(--line);
    border-radius: var(--radius-md); padding: 14px 16px; overflow-x: auto; margin: 0 0 14px;
    color: var(--ivory-2); white-space: pre;
  }
  body.light #reader .rbody pre { background: color-mix(in srgb, var(--foreground) 4%, transparent); }
  #reader .rbody pre code { background: none; border: none; padding: 0; font-size: inherit; }
  #reader .rbody hr { border: none; border-top: 1px solid var(--line); margin: 22px 0; }
  #reader .rbody blockquote { border-left: 2px solid var(--copper); padding: 2px 0 2px 14px; margin: 0 0 12px; }
  #reader .rbody blockquote p { color: var(--ivory-2); font-style: italic; }
  #reader .rbody table { border-collapse: collapse; margin: 0 0 14px; font-size: 12px; }
  #reader .rbody th, #reader .rbody td { border: 1px solid var(--line); padding: 6px 10px;
    text-align: left; color: var(--ivory-2); line-height: 1.5; }
  #reader .rbody th { color: var(--ivory); font-weight: 600; }

  /* deployment progress · quiet, top right, department view only */
  #progress { top: 66px; right: 18px; text-align: right; pointer-events: none;
    opacity: 0; transition: opacity .4s ease; }
  body.fanmode #progress { opacity: 1; }
  #progress .p-num { display: inline; font-family: var(--font-sans); font-size: 16px; color: var(--copper); }
  #progress .p-lbl { display: inline; font-size: 9.5px; letter-spacing: .16em; color: var(--ivory-2); margin-left: 6px; }
  #progress .p-lbl b { color: var(--ivory); font-weight: 700; }
  #progress .bar { width: 132px; height: 2px; margin: 7px 0 0 auto; background: color-mix(in srgb, var(--foreground) 15%, transparent); border-radius: 2px; position: relative; }
  body.light #progress .bar { background: color-mix(in srgb, var(--foreground) 14%, transparent); }
  #progress .bar i { position: absolute; left: 0; top: 0; bottom: 0; background: var(--copper); border-radius: 2px; transition: width .8s cubic-bezier(.2,.8,.2,1) .5s; }
  #progress .bar i.dev { background: color-mix(in srgb, var(--foreground) 34%, transparent); transition: width .8s cubic-bezier(.2,.8,.2,1) .5s, left .8s cubic-bezier(.2,.8,.2,1) .5s; }
  body.light #progress .bar i.dev { background: color-mix(in srgb, var(--foreground) 32%, transparent); }

  #skycta {
    bottom: 64px; left: 50%; transform: translateX(-50%); text-align: center;
    font-size: 11px; letter-spacing: .26em; color: var(--ink-3); text-transform: uppercase;
    opacity: 0; transition: opacity .8s ease 1.6s; pointer-events: none;
  }
  body.ready:not(.fanmode) #skycta { opacity: 1; }

  #domnav {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 11;
    display: flex; gap: 2px; padding: 3px;
    background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius-md);
    backdrop-filter: blur(12px);
    opacity: 0; transition: opacity .8s ease 1.2s;
  }
  body.ready #domnav { opacity: 1; }
  #domnav button {
    font-family: inherit; font-size: 11px; font-weight: 600; color: var(--ink-2);
    background: none; border: none; border-radius: var(--radius-md); padding: 6px 12px; cursor: pointer;
    letter-spacing: .04em; display: flex; align-items: center; gap: 6px;
  }
  #domnav button .dotc { width: 6px; height: 6px; border-radius: 50%; background: var(--c); }
  #domnav button:hover { color: var(--ivory); }
  #domnav button.active { background: color-mix(in srgb, var(--foreground) 10%, transparent); color: var(--ivory); }

  #controls {
    bottom: 16px; right: 16px; display: flex; align-items: center; gap: 2px;
    background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius-md);
    backdrop-filter: blur(12px); padding: 3px;
  }
  #controls button { font-family: inherit; font-size: 14px; color: var(--ivory);
    background: none; border: none; border-radius: var(--radius-md); width: 30px; height: 28px; cursor: pointer; }
  #controls button:hover { background: color-mix(in srgb, var(--foreground) 10%, transparent); }
  #zoom-pct { font-size: 11px; color: var(--ink-2); width: 44px; text-align: center; }
  #controls .fit { font-size: 11px; width: auto; padding: 0 10px; font-weight: 600; }


  /* ===== search ===== */
  #search {
    position: fixed; inset: 0; z-index: 45; display: none;
    background: color-mix(in srgb, var(--bg) 62%, transparent); backdrop-filter: blur(8px);
  }
  #search.open { display: block; }
  #search .spanel {
    width: min(540px, calc(100vw - 24px)); margin: 11vh auto 0;
    background: var(--glass); border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden;
  }
  #search input {
    width: 100%; font-family: inherit; font-size: 15px; color: var(--ivory);
    background: none; border: none; outline: none; padding: 15px 18px;
    border-bottom: 1px solid var(--line);
  }
  #search input::placeholder { color: var(--ink-3); }
  #search .sres { max-height: 46vh; overflow-y: auto; }
  #search .sres::-webkit-scrollbar { width: 4px; }
  #search .sres::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--foreground) 18%, transparent); border-radius: 2px; }
  #search .sit { display: flex; align-items: center; gap: 11px; padding: 11px 17px; cursor: pointer; }
  #search .sit.sel, #search .sit:hover { background: color-mix(in srgb, var(--foreground) 7%, transparent); }
  body.light #search .sit.sel, body.light #search .sit:hover { background: color-mix(in srgb, var(--foreground) 5%, transparent); }
  #search .sdot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex: none; }
  #search .sname { font-size: 13px; font-weight: 600; color: var(--ivory); }
  #search .scrumb { font-size: 10.5px; color: var(--ink-3); margin-left: auto; white-space: nowrap; padding-left: 12px; }
  #search .snone { padding: 16px 18px; font-size: 12px; color: var(--ink-3); }
  #controls .srch { font-size: 13px; }

  /* ===== first-visit nudge ===== */
  #nudge {
    position: fixed; bottom: 88px; left: 50%; transform: translateX(-50%); z-index: 12;
    font-size: 12px; letter-spacing: .04em; color: var(--ivory); white-space: nowrap;
    background: var(--glass); border: 1px solid color-mix(in srgb, var(--copper) 45%, transparent);
    border-radius: var(--radius-md); padding: 9px 17px;
    opacity: 0; transition: opacity .5s ease; pointer-events: none;
  }
  #nudge.show { opacity: 1; }

  /* sub-skill chips are decomposition, not buttons */
  #card .skill { cursor: default; }

  /* ================== MOBILE ================== */
  html, body { touch-action: none; -webkit-tap-highlight-color: transparent; overscroll-behavior: none; }
  @media (max-width: 700px) {
    #counts { display: none; }
    .brand { font-size: 16px; }
    #topbar { height: 46px; padding: 0 14px; }
    #back { top: 52px; left: 14px; font-size: 10px; letter-spacing: .16em; }
    #progress { top: 52px; right: 14px; }
    #progress .p-num { font-size: 14px; }
    #progress .p-lbl { font-size: 8.5px; letter-spacing: .12em; }
    #progress .bar { width: 100px; }
    /* a real top nav on glass */
    /* ===== consistent mobile nav (IDENTICAL layout on map / dash / chart so nothing shifts
       when you switch tabs): search hidden, tabs in the flow tightened, and a LABELED
       'Book a call' CTA instead of a bare mystery icon. ===== */
    #topbar {
      height: 54px; padding: 0 10px;
      background: var(--glass); backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }
    #topright { display: flex; align-items: center; margin-right: 0; gap: 6px; }
    #state-name { display: none; }
    /* !important · map's base .topsearch{display:flex} lives in a later <style> block and
       would otherwise win on source order (this is why the search stayed visible on map but
       not dash/chart, shifting the tabs) */
    .topsearch { display: none !important; }
    #bookcall { padding: 0 11px; height: 30px; gap: 6px; font-size: 11px; }
    #bookcall .bc-t { display: none; }
    #bookcall::after { content: "Book a call"; font-weight: 600; }
    /* tiny phones (<360px): drop the CTA label to an icon so the bar never overflows */
    @media (max-width: 360px) { #bookcall::after { content: none; } #bookcall { padding: 7px; } }
    #tabs { background: none; border: none; -webkit-backdrop-filter: none; backdrop-filter: none; gap: 1px; }
    #tabs a { padding: 5px 7px; font-size: 9px; letter-spacing: .05em; }
    #themetog { top: 15px; right: 12px; background: none; -webkit-backdrop-filter: none; backdrop-filter: none; }
    #back { top: 66px; }
    #progress { top: 66px; }
    #controls { bottom: 12px; right: 10px; padding: 2px; }
    #controls button { width: 27px; height: 26px; font-size: 13px; }
    #zoom-pct { width: 36px; font-size: 10px; }
    .edge-dept .et { font-size: 13px; letter-spacing: .22em; }
    .edge-dept .echev { width: 10px; height: 17px; }
    #edge-l { left: 8px; }
    #edge-r { right: 8px; }
    /* the card becomes a bottom sheet · fixed region, node sits centered above it */
    #card {
      top: 44%; left: 10px; right: 10px; bottom: 10px;
      width: auto; max-height: none;
      border-radius: var(--radius-md); border-left-width: 1px;
      border-top: 2px solid var(--ivory);
      padding: 16px 16px 18px;
    }
    #card .c-name { font-size: 21px; }
    #card .c-x { width: 36px; height: 36px; font-size: 15px; color: var(--ivory); }
    #about .panel { width: calc(100vw - 20px); max-height: calc(100vh - 40px); padding: 26px 22px; }
    #about h1 { font-size: 22px; }
    #reader .rpanel { width: calc(100vw - 12px); height: calc(100vh - 24px); }
    #reader .rhead { padding: 13px 14px; gap: 9px; }
    #reader .rname { font-size: 15px; }
    #reader .rbtns button, #reader .rbtns a { padding: 6px 8px; font-size: 8.5px; }
    #reader .rbody { padding: 16px 16px 28px; }
    /* the bottom sheet owns the bottom of the screen */
    #card.open ~ #controls { display: none; }
    #reader .rbody table { display: block; overflow-x: auto; max-width: 100%; }
    /* bigger labels · readable at mobile home zoom */
    .node .nlabel { font-size: 40px; transform: translateX(-50%) scale(.45); }
    /* edge switchers stay visible on mobile at all zooms, with fatter tap targets */
    .edge-dept { padding: 18px 10px; }
    /* PERF: stop every continuous compositor animation on phones. Hundreds of these
       (starfield twinkle + neural-core pulse/drift/rotation) were re-rasterizing every
       frame during a spin and crashing mobile Safari. Static reads fine. */
    .bgstar,
    #hub .spinslow, #hub .drift, #hub .bn, #hub .nucleus { animation: none !important; }
    /* PERF (the big one): a backdrop-filter pinned over the spinning wheel forces Safari to
       re-sample + re-blur the moving content behind it EVERY frame. Three of them (top bar,
       zoom controls, search) stacked over a 60fps spin is a classic iOS tab-crash. Drop the
       blur on mobile — the glass background is already 85-94% opaque, so it barely changes. */
    #topbar, #controls, #domnav, .topsearch {
      -webkit-backdrop-filter: none !important; backdrop-filter: none !important;
    }
    #topbar { background: var(--bg) !important; }
    /* PERF (THE spin crash): each of the 7 department trees carries a 1400x800px SVG of
       branch lines plus ~20 job-dot divs. Rotating the wheel forced WebKit to RE-RASTERIZE
       all 7 of those big SVGs every single frame — the iPhone GPU ran out of texture memory
       and reloaded the tab. Fix: while the wheel is rotating, promote each rotating tree (and
       the spokes) to its OWN compositor layer. The rotation then composites a bitmap that was
       rasterized ONCE, instead of re-rasterizing the SVG per frame. The full constellation
       stays visible the whole time; the layers are released the instant it settles so a static
       frame re-rasterizes sharp. */
    body.wheelspin .tree .rot,
    body.wheelspin #spokes { will-change: transform; }
  }
  @media (min-width: 701px) {
    /* desktop only: switchers get out of the way when zoomed in */
    body.fanmode.zoomedin .edge-dept { opacity: 0; pointer-events: none; }
  }

