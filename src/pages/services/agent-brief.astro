---
import Page from "../../layouts/Page.astro";
import { SITE, BOOKING_LINK, BOOKING_CONFIG } from "../../config";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const PIPELINE_NODES = [
  { icon: "bx-bullseye",        colorClass: "node-goal" },
  { icon: "bx-file",            colorClass: "" },
  { icon: "bx-export",          colorClass: "" },
  { icon: "bx-layout",          colorClass: "" },
  { icon: "bx-data",            colorClass: "" },
  { icon: "bx-shield-quarter",  colorClass: "" },
  { icon: "bx-rocket",          colorClass: "node-success" },
];

const BRIEF_TABLE = [
  { icon: "bx-bullseye",        nameKey: "services.brief.step1.name", descKey: "services.brief.step1.desc" },
  { icon: "bx-file",            nameKey: "services.brief.step2.name", descKey: "services.brief.step2.desc" },
  { icon: "bx-export",          nameKey: "services.brief.step3.name", descKey: "services.brief.step3.desc" },
  { icon: "bx-layout",          nameKey: "services.brief.step4.name", descKey: "services.brief.step4.desc" },
  { icon: "bx-data",            nameKey: "services.brief.step5.name", descKey: "services.brief.step5.desc" },
  { icon: "bx-shield-quarter",  nameKey: "services.brief.step6.name", descKey: "services.brief.step6.desc" },
  { icon: "bx-rocket",          nameKey: "services.brief.step7.name", descKey: "services.brief.step7.desc" },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "nav.services"), item: `${SITE.url}${localizePath("/services/", locale)}` },
    { "@type": "ListItem", position: 3, name: t(locale, "agentBrief.label"), item: `${SITE.url}${localizePath("/services/agent-brief/", locale)}` },
  ],
};
---

<Page
  title={t(locale, "agentBrief.pageTitle")}
  description={t(locale, "agentBrief.pageDesc")}
  image="/assets/og/home.png"
  locale={locale}
>
  <section class="relative overflow-hidden pt-24 sm:pt-32 pb-12 sm:pb-16">
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-1/3 h-[28rem] w-[42rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6">
      <div class="mb-10">
        <a href={localizePath("/services/", locale)} class="inline-flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors mb-6">
          <i class="bx bx-chevron-left icon-base rtl:rotate-180"></i>
          {t(locale, "services.pageTitle")}
        </a>

        <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "agentBrief.label")}</p>
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mt-3 mb-4">
          <div class="max-w-2xl">
            <h1 class="text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-5xl">{t(locale, "agentBrief.hero.titleLead")}<br /><span class="text-primary">{t(locale, "agentBrief.hero.titleAccent")}</span></h1>
            <p class="mt-5 text-sm leading-relaxed text-muted-foreground">{t(locale, "agentBrief.hero.body")}</p>
            <p class="mt-3 text-xs font-medium text-foreground">{t(locale, "agentBrief.hero.trust")}</p>
          </div>
          <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)}
            data-cal-cta
            data-cta-location="agent_brief_hero"
            class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-5 h-10 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20 cursor-pointer shrink-0"
          >
            {t(locale, "cta.bookDiscoveryCall")}
          </button>
        </div>
      </div>

      <div class="h-px bg-border mb-10"></div>

      <!-- 1. The Brief Framework -->
      <div id="framework" class="mb-14 scroll-mt-24">
        <h2 class="text-xs font-semibold text-primary uppercase tracking-wider mb-6">{t(locale, "services.brief.section1")}</h2>
        <div class="brief-rail relative grid grid-cols-7 gap-1 sm:gap-2" data-aos="fade-up">
          {PIPELINE_NODES.map((n, i) => (
            <Fragment>
              <div class="relative z-10 flex min-w-0 flex-col items-center gap-1.5">
                <div class:list={["pipeline-icon border bg-panel", n.colorClass, i < 4 ? "border-primary shadow-[0_0_18px_var(--primary-soft)]" : "border-border"]}>
                  <i class={`bx ${n.icon}`}></i>
                </div>
                <span class="pipeline-label text-center leading-tight text-3xs sm:text-2xs">{i + 1}. {t(locale, `services.brief.step${i + 1}.name`)}</span>
              </div>
            </Fragment>
          ))}
        </div>
      </div>

      <!-- 2. Core Agent Statement with animated slots -->
      <div class="mb-14">
        <h2 class="text-xs font-semibold text-primary uppercase tracking-wider mb-4">{t(locale, "services.brief.section2")}</h2>
        <div class="rounded-md border border-border bg-panel p-6 sm:p-8">
          <p class="text-sm sm:text-base text-foreground leading-relaxed" set:html={t(locale, "services.brief.statement")} />
        </div>
      </div>

      <!-- 3. What We Define Together -->
      <div class="mb-14">
        <h2 class="text-xs font-semibold text-primary uppercase tracking-wider mb-4">{t(locale, "services.brief.section3")}</h2>
        <div class="rounded-md border border-border bg-panel overflow-hidden">
          {BRIEF_TABLE.map((row, i) => (
            <div class="brief-table-row">
              <span class="text-3xs font-bold text-primary w-4 text-right">{i + 1}</span>
              <div class="flex h-7 w-7 items-center justify-center rounded bg-panel-raised shrink-0">
                <i class={`bx ${row.icon} text-foreground-muted icon-base`}></i>
              </div>
              <span class="text-xs font-semibold text-foreground-strong w-20 shrink-0">{t(locale, row.nameKey)}</span>
              <span class="text-xs text-muted-foreground">{t(locale, row.descKey)}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="h-px bg-border mb-10 sm:mb-12"></div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>

<style>
  .brief-rail::before {
    content: "";
    position: absolute;
    inset-inline: 7%;
    top: 1.25rem;
    height: 2px;
    background: linear-gradient(to right, var(--primary), var(--accent), var(--border));
  }
</style>
