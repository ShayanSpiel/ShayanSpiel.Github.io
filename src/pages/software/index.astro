---
import Page from "../../layouts/Page.astro";
import FeatureHero from "../../components/features/FeatureHero.astro";
import FeatureCTA from "../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";
import { SITE } from "../../config";
import { SOFTWARE_SOLUTIONS } from "../../data/software-solutions";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isFa = locale === "fa";

const logos = import.meta.glob("../../assets/brand-logos/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const logo = (key: string) => logos[`../../assets/brand-logos/${key}.svg`] ?? "";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "nav.solutions"), item: `${SITE.url}${localizePath("/features/", locale)}` },
    { "@type": "ListItem", position: 3, name: t(locale, "nav.bysoftware"), item: `${SITE.url}${localizePath("/software/", locale)}` },
  ],
};
---

<Page title={t(locale, "softwareHub.pageTitle")} description={t(locale, "softwareHub.pageDesc")} image="/assets/og/home.png" locale={locale}>
  <FeatureHero
    locale={locale}
    breadcrumbs={[{ label: t(locale, "nav.solutions"), href: "/features/" }, { label: t(locale, "nav.bysoftware") }]}
    title={t(locale, "softwareHub.hero.title")}
    description={t(locale, "softwareHub.hero.desc")}
  />

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        {SOFTWARE_SOLUTIONS.map((s) => (
          <a
            href={localizePath(`/${s.slug}/`, locale)}
            class="group relative flex items-start gap-4 overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong"
          >
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-60" aria-hidden="true"></div>
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border border-border bg-panel-raised shadow-panel transition-all group-hover:-translate-y-0.5">
              <span class="block [&>svg]:h-8 [&>svg]:w-8" set:html={logo(s.key)} />
            </div>
            <span class="min-w-0">
              <span class="flex items-center gap-2">
                <h2 class="text-sm font-semibold text-foreground-strong">{s.name}</h2>
                <i class={`bx ${s.iconClass} text-primary/80 icon-base shrink-0`} aria-hidden="true"></i>
              </span>
              <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{isFa ? s.taglineFa : s.taglineEn}</span>
              <span class="mt-3 inline-flex items-center gap-1 text-2xs font-semibold uppercase tracking-widest text-primary opacity-80 transition-opacity group-hover:opacity-100">
                {s.keyword}<i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i>
              </span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "softwarePage.cta.title", { name: "SpielOS" })}
    description={t(locale, "softwarePage.cta.desc")}
  />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
