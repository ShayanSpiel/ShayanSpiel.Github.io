---
import Page from "../../layouts/Page.astro";
import { type Locale, t } from "../../i18n/translations";
import { SOFTWARE_SOLUTIONS } from "../../data/software-solutions";
import { WORKFLOW_SOLUTIONS } from "../../data/workflow-solutions";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const departments = [
  { slug: "design", icon: "bx-palette" },
  { slug: "content", icon: "bx-pen" },
  { slug: "marketing", icon: "bx-speaker" },
  { slug: "seo", icon: "bx-search-alt" },
  { slug: "analytics", icon: "bx-bar-chart-alt-2" },
];

const filters = [
  { id: "all", labelKey: "solutions.filter.all" },
  { id: "workflows", labelKey: "solutions.filter.workflows" },
  { id: "departments", labelKey: "solutions.filter.departments" },
  { id: "software", labelKey: "solutions.filter.software" },
];
---

<Page
  title={locale === "fa" ? "راهکارهای اتوماسیون AI | ورک‌فلوها، دپارتمان‌ها و نرم‌افزار | SpielOS" : "AI Automation Solutions | Workflows, Departments & Software | SpielOS"}
  description={t(locale, "solutions.hub.desc")}
  image="/assets/og/home.png"
  locale={locale}
>
  <section class="relative pt-24 pb-12 sm:pt-28 sm:pb-16 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-10"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up">{t(locale, "solutions.hub.title")}</h1>
      <p class="mt-6 text-base text-muted-foreground max-w-2xl leading-relaxed" data-aos="fade-up">{t(locale, "solutions.hub.desc")}</p>
      <div class="mt-8 inline-flex flex-wrap items-center justify-center gap-1.5 rounded-full border border-border bg-panel p-1 shadow-panel" data-aos="fade-up" role="group" aria-label="Filter solutions">
        {filters.map((f, i) => (
          <button
            type="button"
            data-solution-filter={f.id}
            aria-pressed={i === 0 ? "true" : "false"}
            class={`rounded-full px-4 py-1.5 text-xs font-medium transition-all ${i === 0 ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground hover:bg-panel-raised"}`}
          >{t(locale, f.labelKey)}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- WORKFLOWS -->
  <section class="solution-group relative py-16 sm:py-20" data-category="workflows">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 flex items-end justify-between gap-4 flex-wrap" data-aos="fade-up">
        <div>
          <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "solutions.workflows.group")}</span>
          <h2 class="font-bold text-foreground-strong tracking-tight mt-2 text-2xl sm:text-3xl">What work do you want off your plate?</h2>
        </div>
        <a href="/solutions/workflows/" class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "solutions.viewall.workflows")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {WORKFLOW_SOLUTIONS.map((w) => (
          <a href={`/solutions/workflows/${w.slug}/`} class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80 from-primary via-accent to-transparent"></div>
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft text-primary"><i class="bx bx-repeat icon-xl" aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong group-hover:text-primary transition-colors">{t(locale, `wf.${w.slug}.name`)}</h3>
            <p class="mt-1.5 grow text-xs leading-relaxed text-muted-foreground">{t(locale, `wf.${w.slug}.desc`)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AI DEPARTMENTS -->
  <section class="solution-group relative overflow-hidden py-16 sm:py-20" data-category="departments">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mb-8 max-w-xl" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "solutions.departments.group")}</span>
        <h2 class="font-bold text-foreground-strong tracking-tight mt-2 text-2xl sm:text-3xl">Departments that run real company work.</h2>
      </div>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        {departments.map((d) => (
          <a href={`/solutions/ai-departments/${d.slug}/`} class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80 from-accent via-purple to-transparent"></div>
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-accent-soft text-accent"><i class={`${d.icon} icon-xl`} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong group-hover:text-primary transition-colors">{t(locale, `useCases.card.${d.slug}.title`)}</h3>
            <p class="mt-1.5 grow text-xs leading-relaxed text-muted-foreground line-clamp-3">{t(locale, d.descKey)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SOFTWARE -->
  <section class="solution-group relative py-16 sm:py-20" data-category="software">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 max-w-xl" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "solutions.software.group")}</span>
        <h2 class="font-bold text-foreground-strong tracking-tight mt-2 text-2xl sm:text-3xl">One concrete workflow on the software you already use.</h2>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-aos="fade-up">
        {SOFTWARE_SOLUTIONS.map((s) => (
          <a href={`/solutions/software/${s.slug}/`} class="group relative overflow-hidden rounded-md border border-border bg-panel p-4 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <p class="text-xs font-semibold text-foreground-strong group-hover:text-primary transition-colors">{locale === "fa" ? `${s.name} اتوماسیون` : `${s.name} automation`}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">{locale === "fa" ? s.taglineFa : s.taglineEn}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">Not sure which one fits? Show us the work.</h2>
      <a href="/apply/" data-cta-location="solutions_hub_final" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">Apply — Free Review</a>
    </div>
  </section>

  <script>
    (function () {
      var buttons = document.querySelectorAll("[data-solution-filter]");
      var groups = document.querySelectorAll(".solution-group");
      function apply(filter) {
        buttons.forEach(function (b) {
          var active = b.getAttribute("data-solution-filter") === filter;
          b.setAttribute("aria-pressed", active ? "true" : "false");
          b.className = active
            ? "rounded-full px-4 py-1.5 text-xs font-medium transition-all bg-primary text-primary-foreground"
            : "rounded-full px-4 py-1.5 text-xs font-medium transition-all text-muted-foreground hover:text-foreground hover:bg-panel-raised";
        });
        groups.forEach(function (g) {
          g.style.display = filter === "all" || g.getAttribute("data-category") === filter ? "" : "none";
        });
      }
      buttons.forEach(function (b) {
        b.addEventListener("click", function () { apply(b.getAttribute("data-solution-filter")); });
      });
    })();
  </script>
</Page>
