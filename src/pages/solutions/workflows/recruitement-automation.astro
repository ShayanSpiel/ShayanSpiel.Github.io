---
import Page from "../../../layouts/Page.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import FAQList from "../../../components/sections/FAQList.astro";
import { brandLogo } from "../../../data/brand-logos";
import { APPLY_PATH, SITE } from "../../../config";
import { localizePath } from "../../../i18n";
import { t } from "../../../i18n/translations";

/** The recruiting loop, mirrored to the demo and the ICP's general stack. */
const steps = [
  {
    title: "Brief captured",
    desc: "Vacancy text lands and is structured — role, stack, salary, location, work preference.",
    icon: "bx-clipboard",
  },
  {
    title: "Candidates sourced",
    desc: "Your candidate DB, LinkedIn and Indeed matched to the extracted criteria — no tab-hopping.",
    icon: "bx-search-alt",
  },
  {
    title: "Screened & scored",
    desc: "CVs read against must-haves, scored with fit reasons and gaps — no spreadsheet copy-paste.",
    icon: "bx-task",
  },
  {
    title: "Top 5 ranked",
    desc: "The five best fits ranked with evidence and a client-ready summary paragraph.",
    icon: "bx-trophy",
  },
  {
    title: "Interviews scheduled",
    desc: "Calendars coordinated, invites sent, reschedules handled without the back-and-forth.",
    icon: "bx-calendar-check",
  },
  {
    title: "Shortlist delivered",
    desc: "Ranked shortlist saved to Drive and handed over where your team and client already look.",
    icon: "bx-folder",
  },
];

/** Familiar ICP tools — real marks, colored recent logos */
const tools = [
  { key: "notion", name: "Notion" },
  { key: "sheets", name: "Google Sheets" },
  { key: "linkedin", name: "LinkedIn" },
  { key: "indeed", name: "Indeed" },
  { key: "workable", name: "Workable" },
  { key: "gmail", name: "Gmail" },
  { key: "slack", name: "Slack" },
  { key: "attio", name: "Attio" },
  { key: "hubspot", name: "HubSpot" },
  { key: "calendar", name: "Google Calendar" },
  { key: "zoom", name: "Zoom" },
  { key: "calendly", name: "Calendly" },
  { key: "drive", name: "Google Drive" },
];

/** Per-step tool groups — each step connects down to its 1–3 tools */
const stepTools: string[][] = [
  ["notion", "sheets"],                 // Brief captured
  ["linkedin", "indeed", "workable"],   // Candidates sourced
  ["gmail", "slack"],                   // Screened & scored
  ["attio", "hubspot"],                 // Top 5 ranked
  ["calendar", "zoom", "calendly"],     // Interviews scheduled
  ["drive"],                            // Shortlist delivered
];

const audiences = [
  {
    name: "Recruitment agencies",
    note: "High-volume roles and parallel clients, with a coordination cost that scales with every placement.",
  },
  {
    name: "In-house talent teams",
    note: "Small teams expected to run sourcing, screening, and scheduling like a full recruiting desk.",
  },
  {
    name: "HR teams",
    note: "Hiring repeatedly, but with no dedicated recruiter to own the loop end to end.",
  },
];

const faqs = [
  {
    q: "What is recruitment & HR workflow automation?",
    a: "It is a workflow that runs the coordination side of hiring — capturing the brief, sourcing and screening candidates, ranking a shortlist, scheduling interviews, and collecting references — automatically on the tools you already use, instead of a person copying data between tabs.",
  },
  {
    q: "Do we need to replace our ATS or job boards?",
    a: "No. SpielOS works on top of LinkedIn, Indeed, your email, calendar, and drive. It adds the coordination layer; your existing stack stays exactly where it is.",
  },
  {
    q: "Will candidates or clients know it's automated?",
    a: "They experience faster, consistent responses. The AI drafts from your voice and your rules; your recruiter still owns every conversation that matters — screen calls, interviews, and offers.",
  },
  {
    q: "What stays human?",
    a: "Judgment calls. Fit, sensitivity, the actual interview, and the offer stay with your team. The automation handles the tracking, the chasing, and the filing.",
  },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t("en", "nav.home"), item: `${SITE.url}${localizePath("/", "en")}` },
    { "@type": "ListItem", position: 2, name: t("en", "nav.solutions"), item: `${SITE.url}${localizePath("/solutions/", "en")}` },
    { "@type": "ListItem", position: 3, name: t("en", "nav.workflows"), item: `${SITE.url}${localizePath("/solutions/workflows/", "en")}` },
    { "@type": "ListItem", position: 4, name: "Recruitment Workflow Automation", item: `${SITE.url}/solutions/workflows/recruitement-automation/` },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Page
  title="Recruitment Workflow Automation | SpielOS"
  description="Recruitment workflow automation for hiring teams. Source, screen, rank, schedule, and update your ATS without copying data between tools."
  image="/assets/og/SpielOS.png"
  locale="en"
  noAlternate
>
  <!-- 1 - HERO -->
  <section class="relative flex min-h-[64vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[34rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-md glow-blob-accent opacity-10"></div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <nav aria-label={t("en", "common.breadcrumbAria")} class="mb-8">
        <ol class="flex items-center justify-center gap-1.5 text-2xs text-muted-foreground flex-wrap">
          <li><a href={localizePath("/", "en")} class="hover:text-foreground transition-colors">{t("en", "nav.home")}</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><a href={localizePath("/solutions/", "en")} class="hover:text-foreground transition-colors">{t("en", "nav.solutions")}</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><a href={localizePath("/solutions/workflows/", "en")} class="hover:text-foreground transition-colors">{t("en", "nav.workflows")}</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><span class="text-foreground font-medium" aria-current="page">Recruitment &amp; HR</span></li>
        </ol>
      </nav>
      <div class="inline-flex items-center gap-2 rounded-md border border-border bg-panel-raised px-3 py-1 mb-6" data-aos="fade-up">
        <i class="bx bx-briefcase text-primary/80 icon-sm shrink-0" aria-hidden="true"></i>
        <span class="text-2xs text-muted-foreground font-medium">RECRUITMENT WORKFLOW AUTOMATION</span>
      </div>
      <h1 class="mt-4 text-4xl font-extrabold leading-[0.95] tracking-tight text-foreground-strong sm:text-5xl lg:text-6xl" data-aos="fade-up">Recruitment workflow automation for hiring teams.</h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground" data-aos="fade-up">Source, screen, rank, schedule, and update your ATS without copying data between tools.</p>
      <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed text-muted-foreground" data-aos="fade-up">SpielOS automates repetitive recruiting work on your existing stack. Your team keeps every hiring decision.</p>
      <div class="mt-8 flex flex-col items-center gap-3" data-aos="fade-up">
        <a href="#see-it-run" data-cta-location="workflow_recruitement_hero" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">SEE IT RUN</a>
        <p class="text-sm text-muted-foreground max-w-lg text-center" data-aos="fade-up">From job brief to ranked shortlist.<br>Watch SpielOS's recruitment workflow, take a role brief, find candidates, screen them against your criteria, and return a ranked shortlist with reasons behind each match.</p>
      </div>
    </div>
  </section>

  <!-- 2 - VIDEO SHOWCASE -->
  <section id="see-it-run" class="relative overflow-hidden py-16 sm:py-20 scroll-mt-24">
    <div class="mx-auto max-w-5xl px-6">
      <div class="mb-10 text-center" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">RECRUITING AUTOMATION</span>
        <h2 class="font-bold text-foreground-strong tracking-tight mt-3 text-3xl sm:text-4xl">Automate the recruiting loop.</h2>
        <p class="mx-auto mt-4 max-w-2xl text-sm text-muted-foreground leading-relaxed">A live SpielOS run turning a recruiter's brief into a sourced, screened, and ranked candidate shortlist.</p>
      </div>
      <div class="relative overflow-hidden rounded-md border border-border bg-panel shadow-panel" data-aos="fade-up">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80 from-primary via-accent to-transparent"></div>
        <div class="aspect-video w-full bg-black">
          <iframe
            class="h-full w-full"
            src="https://www.youtube.com/embed/XHI1vMsPyzQ?rel=0&modestbranding=1&enablejsapi=1"
            title="AI Optimized HR Automation Workflow for Recruitment Teams — SpielOS"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
      <p class="mt-4 text-center text-2xs text-muted-foreground">SpielOS ranking candidates from a brief — sourced, screened, and shortlisted on your stack.</p>
    </div>
  </section>

  <!-- 3 - HOW IT RUNS — exact workflow card, plus small tools row -->
  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <SectionHeader label="WORKS ON YOUR STACK" title="Your recruitment tools, just automated." />
      <div class="flow-canvas relative overflow-hidden rounded-md border border-border bg-panel px-5 py-10 shadow-panel sm:px-8 sm:py-14" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
        <ol class="flow-rail relative z-10 grid gap-6 sm:grid-cols-6 sm:gap-0">
          {steps.map((s, i) => {
            const last = i === steps.length - 1;
            return (
              <li class="flow-station relative flex items-center gap-4 sm:flex-col sm:gap-3 sm:text-center">
                <div class:list={["flow-node relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-md border bg-panel-raised", last ? "border-success text-success shadow-[0_0_24px_var(--success-soft)]" : i === 0 ? "border-primary text-primary shadow-[0_0_24px_var(--primary-soft)]" : "border-border text-muted-foreground"]}>
                  <i class={`bx ${s.icon} icon-xl`} aria-hidden="true"></i>
                </div>
                <p class:list={["text-xs font-semibold leading-snug", last ? "text-success" : i === 0 ? "text-foreground-strong" : "text-foreground-muted"]}>{s.title}</p>
              </li>
            );
          })}
        </ol>
        <!-- Per-step tool groups — vertical stem 2-3px below step name, with calm back-and-forth shine -->
        <div class="relative z-10 mt-[2px] sm:mt-[3px]">
          <div class="grid gap-6 sm:grid-cols-6 sm:gap-0">
            {stepTools.map((keys, idx) => (
              <div class="flex flex-col items-center">
                {/* vertical stem — straight line down from workflow node to its tools */}
                <div class="relative h-7 w-px overflow-hidden bg-primary/15 sm:h-9">
                  <div class="absolute left-1/2 top-0 h-2 w-px -translate-x-1/2 bg-primary opacity-95 shadow-[0_0_8px_var(--primary)] animate-stem-shine" style={`animation-delay: ${idx * 0.34}s`}></div>
                </div>
                <div class="mt-2 flex flex-wrap justify-center gap-1.5 sm:mt-2">
                  {keys.map((k) => {
                    const tl = tools.find((t) => t.key === k)!;
                    return (
                      <span class="flex h-7 w-7 items-center justify-center rounded-md border border-border bg-panel-raised shadow-panel [&>svg]:h-4 [&>svg]:w-4" title={tl.name} set:html={brandLogo(tl.key)}></span>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
          <p class="mt-6 text-center text-2xs font-medium tracking-wide text-muted-foreground">Familiar tools, familiar work, delegated to AI.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 - BEFORE / AFTER — with HR illustrations + BUILT FOR RECRUITMENT TEAMS -->
  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-5xl px-6">
      <div class="mb-12 text-center" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">LESS ADMIN. MORE RECRUITING.</span>
        <h2 class="font-bold text-foreground-strong tracking-tight mt-3 text-3xl sm:text-4xl">Stop doing recruiting work by hand.</h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2" data-aos="fade-up">
        <div class="group relative flex flex-col overflow-hidden rounded-md border border-destructive/30 bg-panel shadow-panel transition-all hover:border-destructive/50">
          <div class="absolute inset-x-0 top-0 z-10 h-px bg-gradient-to-r opacity-70 from-destructive via-destructive-soft to-transparent"></div>
          <div class="relative h-52 overflow-hidden bg-[#F5F1E8] sm:h-60">
            <img src="/images/recruitment/before-hr.png" alt="Before — HR manager overwhelmed by copy-paste hiring" width="720" height="540" loading="lazy" decoding="async" class="h-full w-full object-cover object-center transition-all duration-300 group-hover:scale-[1.02]" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-panel/40 via-transparent to-transparent"></div>
          </div>
          <div class="p-6">
            <div class="mb-3 flex items-center gap-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-destructive-soft"><i class="bx bx-user text-destructive icon-base" aria-hidden="true"></i></span>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-destructive">Before — manual</h3>
            </div>
            <ul class="space-y-2">
              <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-x-circle text-destructive/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Copy candidate profiles.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-x-circle text-destructive/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Screen CVs manually.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-x-circle text-destructive/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Update spreadsheets and ATS records.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-x-circle text-destructive/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Chase candidate availability.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-x-circle text-destructive/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Coordinate calendars.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-x-circle text-destructive/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Prepare shortlists.</li>
            </ul>
          </div>
        </div>
        <div class="group relative flex flex-col overflow-hidden rounded-md border border-primary/30 bg-panel shadow-panel transition-all hover:border-primary/50">
          <div class="absolute inset-x-0 top-0 z-10 h-px bg-gradient-to-r opacity-80 from-primary via-accent to-transparent"></div>
          <div class="relative h-52 overflow-hidden bg-[#F5F1E8] sm:h-60">
            <img src="/images/recruitment/after-hr.png" alt="With SpielOS — HR calm, shortlist ready, hiring on autopilot" width="720" height="540" loading="lazy" decoding="async" class="h-full w-full object-cover object-center transition-all duration-300 group-hover:scale-[1.02]" />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-panel/30 via-transparent to-transparent"></div>
          </div>
          <div class="p-6">
            <div class="mb-3 flex items-center gap-2">
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary-soft"><i class="bx bx-network-chart text-primary icon-base" aria-hidden="true"></i></span>
              <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">With SpielOS</h3>
            </div>
            <ul class="space-y-2">
              <li class="flex items-start gap-2 text-sm leading-relaxed text-foreground"><i class="bx bx-check-square text-primary/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Candidates get sourced.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-foreground"><i class="bx bx-check-square text-primary/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Criteria get checked.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-foreground"><i class="bx bx-check-square text-primary/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Shortlists arrive ranked.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-foreground"><i class="bx bx-check-square text-primary/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Interviews get scheduled.</li>
              <li class="flex items-start gap-2 text-sm leading-relaxed text-foreground"><i class="bx bx-check-square text-primary/70 icon-sm shrink-0 mt-0.5" aria-hidden="true"></i>Records stay updated.</li>
            </ul>
          </div>
        </div>
      </div>
      <p class="mt-8 text-center text-sm text-foreground-strong font-medium" data-aos="fade-up">Your recruiters review the candidates and make the decisions.</p>
      <!-- Built for recruitment teams — below the before/after cards, same section -->
      <div class="mt-10 text-center" data-aos="fade-up">
        <p class="text-2xs font-semibold uppercase tracking-[0.14em] text-primary">BUILT FOR RECRUITMENT TEAMS</p>
        <h3 class="mt-2 text-xl font-bold tracking-tight text-foreground-strong sm:text-2xl">Automate the work between brief and interview.</h3>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel-raised px-3 py-1.5 text-xs font-medium text-foreground-strong shadow-panel"><i class="bx bx-briefcase text-primary icon-sm" aria-hidden="true"></i>Recruitment agencies</span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel-raised px-3 py-1.5 text-xs font-medium text-foreground-strong shadow-panel"><i class="bx bx-group text-primary icon-sm" aria-hidden="true"></i>In-house talent teams</span>
          <span class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel-raised px-3 py-1.5 text-xs font-medium text-foreground-strong shadow-panel"><i class="bx bx-user text-primary icon-sm" aria-hidden="true"></i>HR teams</span>
        </div>
      </div>
    </div>
  </section>


<!-- 5 - FINAL CTA -->
  <section class="relative overflow-hidden py-28 sm:py-36">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute left-1/2 top-[52%] h-[28rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">FREE WORKFLOW REVIEW</p>
      <h2 class="mt-5 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-5xl">Show us one<br /><span class="text-primary">recruiting workflow.</span></h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">We'll show you what can be automated, how it would run on your current tools, and what stays with your team.</p>
      <a href={localizePath(APPLY_PATH, "en")} data-cta-location="workflow_recruitement_final" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">Get a Free Review</a>
      <p class="mx-auto mt-4 max-w-xl text-2xs leading-relaxed text-muted-foreground">No new ATS &bull; No platform migration &bull; No hiring decisions handed to AI</p>
    </div>
  </section>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Page>

<style>
  /*
   * Connector geometry: every li draws ONE segment from the center of its
   * own icon to the center of the NEXT icon, so lines can never overshoot
   * the first or last icon. Icons are opaque and sit above the line (z-10).
   */

  /* Flow rail — mobile: vertical segments between icon centers (h-11 -> 1.375rem). */
  .flow-station:not(:last-child)::before {
    content: "";
    position: absolute;
    inset-inline-start: 1.375rem;
    top: 50%;
    height: 100%;
    width: 2px;
    translate: -50% 0;
    border-radius: var(--radius-md);
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--primary) 40%, transparent),
      color-mix(in oklab, var(--accent) 40%, transparent)
    );
  }

  /* Flow rail — sm+: horizontal segments, node center sits at 1.375rem
     from the station top (h-11 icon, flex-col). */
  @media (min-width: 640px) {
    .flow-station:not(:last-child)::before { display: none; }
    .flow-station:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 1.375rem;
      height: 2px;
      inset-inline-start: 50%;
      width: 100%;
      border-radius: var(--radius-md);
      background: linear-gradient(
        to right,
        color-mix(in oklab, var(--primary) 45%, transparent),
        color-mix(in oklab, var(--accent) 45%, transparent)
      );
    }
    [dir="rtl"] .flow-station:not(:last-child)::after {
      background: linear-gradient(to left, color-mix(in oklab, var(--primary) 45%, transparent), color-mix(in oklab, var(--accent) 45%, transparent));
    }
  }

  @keyframes stem-shine {
    0% { transform: translateY(-120%); opacity: 0; }
    8% { opacity: 1; }
    50% { transform: translateY(420%); opacity: 1; }
    58% { opacity: 1; }
    100% { transform: translateY(-120%); opacity: 0; }
  }
  .animate-stem-shine {
    animation: stem-shine 2.8s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-stem-shine { animation: none; opacity: 0.6; }
  }
</style>
