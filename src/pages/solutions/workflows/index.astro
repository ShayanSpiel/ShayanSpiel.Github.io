---
import Page from "../../../layouts/Page.astro";
import { WORKFLOW_SOLUTIONS, WORKFLOW_HUB_GROUPS } from "../../../data/workflow-solutions";

const byslug = Object.fromEntries(WORKFLOW_SOLUTIONS.map((w) => [w.slug, w]));

/** Distinct boxicon per workflow — mirrors the nav icon set. */
const WF_ICONS: Record<string, string> = {
  "follow-up-automation": "bx-bell",
  "data-entry-automation": "bx-data",
  "client-onboarding-automation": "bx-user-check",
  "client-intake-automation": "bx-envelope-open",
  "document-collection-automation": "bx-folder-open",
  "lead-qualification-automation": "bx-target-lock",
  "invoice-processing-automation": "bx-receipt",
  "candidate-screening-automation": "bx-id-card",
};
---

<Page
  title="Workflow Automation Solutions | SpielOS"
  description="Automation for the work that repeats: follow-ups, data entry, client intake, onboarding, document collection, invoicing, qualification, screening."
  image="/assets/og/home.png"
  noAlternate
>
  <section class="relative pt-24 pb-12 sm:pt-28 sm:pb-16 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-10"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center justify-center gap-1.5 text-2xs text-muted-foreground flex-wrap">
          <li><a href="/" class="hover:text-foreground transition-colors">Home</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><a href="/solutions/" class="hover:text-foreground transition-colors">Solutions</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><span class="text-foreground font-medium" aria-current="page">Workflows</span></li>
        </ol>
      </nav>
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-raised px-3 py-1 mb-6" data-aos="fade-up">
        <i class="bx bx-repeat text-primary/80 icon-sm shrink-0" aria-hidden="true"></i>
        <span class="text-2xs text-muted-foreground font-medium">WORKFLOW AUTOMATION</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up">What work do you want off your plate?</h1>
      <p class="mt-6 text-base text-muted-foreground max-w-2xl leading-relaxed" data-aos="fade-up">Start with the recurring work your team keeps doing manually: copying, chasing, checking, reporting, admin. Pick the workflow that sounds like your week.</p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3" data-aos="fade-up">
        <a href="/solutions/" class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium hover:border-border-strong hover:bg-panel-raised transition-all"><i class="bx bx-arrow-back rtl-flip icon-sm me-2" aria-hidden="true"></i>All solutions</a>
      </div>
    </div>
  </section>

  {WORKFLOW_HUB_GROUPS.map((group) => (
    <section class="relative py-12 sm:py-16">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mb-8 max-w-xl" data-aos="fade-up">
          <h2 class="text-lg font-bold text-foreground-strong">{group.label}</h2>
          <p class="mt-1 text-xs leading-relaxed text-muted-foreground">{group.blurb}</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
          {group.slugs.map((slug) => {
            const w = byslug[slug];
            return (
              <a href={`/solutions/workflows/${w.slug}/`} class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80 from-primary via-accent to-transparent"></div>
                <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft text-primary shadow-[0_0_18px_var(--primary-soft)]"><i class={`bx ${WF_ICONS[w.slug] ?? "bx-repeat"} icon-xl`} aria-hidden="true"></i></div>
                <h3 class="text-sm font-semibold text-foreground-strong transition-colors group-hover:text-primary">{w.name}</h3>
                <p class="mt-1.5 grow text-xs leading-relaxed text-muted-foreground">{w.h1.replace(/^Automate /, "").replace(/\.$/, "")}</p>
                <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-primary">See the workflow<i class="bx bx-chevron-right rtl-flip icon-sm transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i></span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-primary">NOT LISTED?</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">If it repeats, it can probably be automated.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">Show us how the work runs today. We will tell you honestly what can be automated, what should stay human, and what it would take.</p>
      <a href="/apply/" data-cta-location="workflows_hub_final" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">Apply — Free Review</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://spielos.xyz/" },
      { "@type": "ListItem", position: 2, name: "Solutions", item: "https://spielos.xyz/solutions/" },
      { "@type": "ListItem", position: 3, name: "Workflows", item: "https://spielos.xyz/solutions/workflows/" },
    ],
  })} />
</Page>
