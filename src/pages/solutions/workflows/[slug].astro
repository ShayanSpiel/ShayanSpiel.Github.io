---
import Page from "../../../layouts/Page.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import { WORKFLOW_SOLUTIONS, type WorkflowSolution } from "../../../data/workflow-solutions";
import { SOFTWARE_SOLUTIONS } from "../../../data/software-solutions";

export function getStaticPaths() {
  return WORKFLOW_SOLUTIONS.map((workflow) => ({
    params: { slug: workflow.slug },
    props: { workflow },
  }));
}

const { workflow: w } = Astro.props;
const tools = w.toolKeys
  .map((k) => SOFTWARE_SOLUTIONS.find((s) => s.key === k))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
const relatedWorkflows = w.relatedWorkflows
  .map((slug) => WORKFLOW_SOLUTIONS.find((x) => x.slug === slug))
  .filter((x): x is WorkflowSolution => Boolean(x));

const SITE_URL = "https://spielos.xyz";

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Solutions", item: `${SITE_URL}/solutions/` },
    { "@type": "ListItem", position: 3, name: "Workflows", item: `${SITE_URL}/solutions/workflows/` },
    { "@type": "ListItem", position: 4, name: w.name, item: `${SITE_URL}/solutions/workflows/${w.slug}/` },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: w.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Page title={w.seoTitle} description={w.seoDesc} image="/assets/og/home.png" noAlternate>
  <!-- 1 - HERO -->
  <section class="relative pt-24 pb-12 sm:pt-28 sm:pb-16 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-10"></div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center justify-center gap-1.5 text-2xs text-muted-foreground flex-wrap">
          <li><a href="/" class="hover:text-foreground transition-colors">Home</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><a href="/solutions/" class="hover:text-foreground transition-colors">Solutions</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><a href="/solutions/workflows/" class="hover:text-foreground transition-colors">Workflows</a></li>
          <li class="flex items-center gap-1.5"><span aria-hidden="true" class="text-border-strong">/</span><span class="text-foreground font-medium" aria-current="page">{w.name}</span></li>
        </ol>
      </nav>
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-raised px-3 py-1 mb-6" data-aos="fade-up">
        <i class="bx bx-repeat text-primary/80 icon-sm shrink-0" aria-hidden="true"></i>
        <span class="text-2xs text-muted-foreground font-medium">{w.eyebrow}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up">{w.h1}</h1>
      <p class="mt-6 text-base text-muted-foreground max-w-2xl leading-relaxed" data-aos="fade-up">{w.heroCopy}</p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3" data-aos="fade-up">
        <a href="/apply/" data-cta-location={`workflow_${w.slug}`} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">Apply — Free Review</a>
        <a href="#what-changes" class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium hover:border-border-strong hover:bg-panel-raised transition-all">See how it works</a>
      </div>
    </div>
  </section>

  <!-- 2 - THE MANUAL PROBLEM -->
  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12 text-center" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">TODAY, BY HAND</span>
        <h2 class="font-bold text-foreground-strong tracking-tight mt-3 text-3xl sm:text-4xl">The work nobody was hired to do.</h2>
      </div>
      <div class="grid gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-start">
        <ol class="wf-rail relative mx-auto max-w-sm w-full" data-aos="fade-up">
          {w.manualSteps.map((step, i) => (
            <li class="relative flex gap-4 py-2.5">
              <div class={`relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-md border bg-panel-raised ${i === 0 ? "border-destructive text-destructive bg-destructive-soft" : "border-border text-muted-foreground"}`}>
                <span class="text-2xs font-bold">{i + 1}</span>
              </div>
              <p class="pt-1 text-xs leading-relaxed text-muted-foreground">{step}</p>
            </li>
          ))}
        </ol>
        <div class="rounded-lg border border-destructive/30 bg-panel p-6 shadow-panel self-center" data-aos="fade-up">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-destructive-soft"><i class="bx bx-error text-destructive icon-xl"></i></div>
          <p class="text-base font-semibold leading-relaxed text-foreground-strong">{w.painPoint}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 - WHAT CHANGES -->
  <section id="what-changes" class="relative overflow-hidden py-20 sm:py-24 scroll-mt-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mb-12 text-center" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">WHAT CHANGES</span>
        <h2 class="font-bold text-foreground-strong tracking-tight mt-3 text-3xl sm:text-4xl">Same process. No checklist manager.</h2>
      </div>
      <div class="grid gap-3 md:grid-cols-2 max-w-4xl mx-auto" data-aos="fade-up">
        <div class="rounded-lg border border-border bg-panel p-6 shadow-panel">
          <div class="mb-4 flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-muted-foreground/10"><i class="bx bx-user text-muted-foreground icon-base" aria-hidden="true"></i></span>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Before</h3>
          </div>
          <p class="text-sm leading-relaxed text-muted-foreground">{w.beforeText}</p>
        </div>
        <div class="rounded-lg border border-primary/30 bg-panel p-6 shadow-panel transition-all hover:border-primary">
          <div class="mb-4 flex items-center gap-2">
            <span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary-soft"><i class="bx bx-network-chart text-primary icon-base" aria-hidden="true"></i></span>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">With SpielOS</h3>
          </div>
          <p class="text-sm leading-relaxed text-foreground">{w.withText}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 - HOW IT RUNS -->
  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <SectionHeader label="HOW THE WORKFLOW RUNS" title="Actual states. Actual actions." />
      <div class="relative overflow-hidden rounded-xl border border-border bg-panel px-4 py-8 shadow-panel sm:px-8" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <ol class="relative z-[1] flex flex-wrap items-center justify-center gap-y-3">
          {w.flowStates.map((state, i) => (
            <li class="flex items-center">
              <span class={`inline-flex items-center rounded-md border px-3 py-1.5 text-xs font-medium ${i === 0 ? "border-primary bg-primary-soft text-primary" : i === w.flowStates.length - 1 ? "border-success bg-success-soft text-success" : "border-border bg-panel-raised text-foreground"}`}>{state}</span>
              {i < w.flowStates.length - 1 && <i class="bx bx-chevron-right rtl-flip icon-md text-border-strong mx-1" aria-hidden="true"></i>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 5 - WHAT IT CAN AUTOMATE -->
  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label="WHAT IT AUTOMATES" title={w.automateIntro.replace(":", ".")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {w.automate.map((item) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80 from-primary via-accent to-transparent"></div>
            <div class="mb-3 flex items-center gap-2">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-primary-soft text-primary"><i class="bx bx-check-square icon-sm" aria-hidden="true"></i></span>
              <h3 class="text-xs font-semibold text-foreground-strong">{item.title}</h3>
            </div>
            <p class="text-xs leading-relaxed text-muted-foreground">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 - TOOLS -->
  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <SectionHeader label="NO MIGRATION" title="Works with the tools you already use." description="The workflow runs on top of your current stack — we connect to it, we don't replace it." />
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3" data-aos="fade-up">
        {tools.map((tool) => (
          <a href={`/solutions/software/${tool.slug}/`} class="group relative overflow-hidden rounded-md border border-border bg-panel p-4 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <p class="text-xs font-semibold text-foreground-strong group-hover:text-primary transition-colors">{tool.name} automation</p>
            <p class="mt-0.5 text-3xs text-muted-foreground">See how it connects →</p>
          </a>
        ))}
      </div>
      <p class="mt-4 text-center text-2xs text-muted-foreground">Plus your ATS, CRM, or internal systems where an integration is genuinely supported.</p>
    </div>
  </section>

  <!-- 7 - WHO IT'S FOR -->
  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-5xl px-6">
      <SectionHeader label="WHO THIS IS FOR" title="Built for teams where this work repeats weekly." />
      <div class="grid gap-3 md:grid-cols-3" data-aos="fade-up">
        {w.audiences.map((a) => (
          <article class="rounded-lg border border-border bg-panel p-5 shadow-panel">
            <h3 class="text-sm font-semibold text-foreground-strong mb-1">{a.name}</h3>
            <p class="text-xs leading-relaxed text-muted-foreground">{a.note}</p>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2" data-aos="fade-up">
        <span class="text-2xs uppercase tracking-widest text-muted-foreground me-2">Run by an AI department:</span>
        {w.relatedDepartments.map((d) => (
          <a href={`/solutions/ai-departments/${d}/`} class="inline-flex items-center gap-1 rounded-full border border-border bg-panel px-3 py-1 text-xs capitalize text-muted-foreground hover:text-foreground hover:border-border-strong transition-all">
            AI {d} department<i class="bx bx-chevron-right rtl-flip icon-xs" aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8 - HUMAN BOUNDARIES -->
  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <SectionHeader label="HUMAN BOUNDARIES" title="Automate the repetition. Keep the judgment." />
      <div class="grid gap-3 md:grid-cols-2" data-aos="fade-up">
        <div class="rounded-lg border border-success/30 bg-panel p-6 shadow-panel">
          <div class="mb-4 flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-success-soft"><i class="bx bx-check-square text-success icon-lg" aria-hidden="true"></i></span>
            <h3 class="text-sm font-semibold text-foreground-strong">Runs on its own</h3>
          </div>
          <ul class="space-y-2">
            {w.runsAlone.map((item) => (
              <li class="flex gap-2 text-xs leading-relaxed text-muted-foreground"><i class="bx bx-check icon-sm text-success shrink-0 mt-0.5" aria-hidden="true"></i>{item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-warning/30 bg-panel p-6 shadow-panel">
          <div class="mb-4 flex items-center gap-2">
            <span class="flex h-8 w-8 items-center justify-center rounded-md bg-warning-soft"><i class="bx bx-group text-warning icon-lg" aria-hidden="true"></i></span>
            <h3 class="text-sm font-semibold text-foreground-strong">Stops for a human</h3>
          </div>
          <ul class="space-y-2">
            {w.stopsForHuman.map((item) => (
              <li class="flex gap-2 text-xs leading-relaxed text-muted-foreground"><i class="bx bx-user icon-sm text-warning shrink-0 mt-0.5" aria-hidden="true"></i>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      <p class="mt-6 text-center text-xs leading-relaxed text-muted-foreground max-w-2xl mx-auto">{w.boundaryIntro}</p>
    </div>
  </section>

  <!-- 9 - FAQ -->
  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-3xl px-6">
      <SectionHeader label="QUESTIONS" title={`${w.name}, answered.`} />
      <div class="space-y-2" data-aos="fade-up">
        {w.faqs.map((f) => (
          <details class="group rounded-md border border-border bg-panel shadow-panel open:border-border-strong">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 text-sm font-medium text-foreground-strong [&::-webkit-details-marker]:hidden">
              {f.q}
              <i class="bx bx-chevron-down rtl-flip icon-md text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true"></i>
            </summary>
            <p class="px-4 pb-4 text-xs leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RELATED WORKFLOWS -->
  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-6">
      <SectionHeader label="KEEP EXPLORING" title="Related workflows." />
      <div class="grid gap-3 md:grid-cols-3" data-aos="fade-up">
        {relatedWorkflows.map((r) => (
          <a href={`/solutions/workflows/${r.slug}/`} class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80 from-accent via-purple to-transparent"></div>
            <p class="text-2xs font-semibold uppercase tracking-widest text-primary mb-1">Workflow</p>
            <h3 class="text-sm font-semibold text-foreground-strong group-hover:text-primary transition-colors">{r.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 10 - FINAL CTA -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute left-1/2 top-[52%] h-[28rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-primary">START WITH ONE WORKFLOW</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">Show us the workflow you want off your plate.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-muted-foreground">Walk us through how it works today. We will map what can be automated, what should stay human, and what the implementation would require.</p>
      <a href="/apply/" data-cta-location={`workflow_${w.slug}_final`} class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">Apply — Free Review</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Page>

<style is:global>
  .wf-rail::before {
    content: "";
    position: absolute;
    inset-inline-start: 0.85rem;
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(to bottom, var(--destructive), var(--primary));
    opacity: 0.35;
  }
</style>
