---
import { readFileSync } from "node:fs";
import path from "node:path";
import FeatureHero from "../../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../../components/features/FeatureCTA.astro";
import SectionHeader from "../../../../components/sections/SectionHeader.astro";
import Page from "../../../../layouts/Page.astro";
import { SITE } from "../../../../config";
import { localizePath } from "../../../../i18n";
import { type Locale, t } from "../../../../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

/* The gallery is BUILD-DRIVEN: the archetype list is read from the Design
   department registry at build time, never hardcoded here. The path anchors
   to the repo root via process.cwd() because `astro build` runs from the
   project root; a relative new URL(..., import.meta.url) would resolve
   against the bundled dist/chunks module and miss the file. Rebuilding the
   site after a registry change updates the public gallery automatically. */
const registryPath = path.join(process.cwd(), ".agents/company/departments/design/templates/registry.json");
const registry = JSON.parse(readFileSync(registryPath, "utf8")) as {
  archetypes: {
    id: string;
    kind: "shorts" | "social";
    file: string;
    legacy?: boolean;
    confirmed?: boolean;
    content_relevance?: string;
    description?: string;
    research_map?: string;
  }[];
};

type Entry = (typeof registry.archetypes)[number];

/* Committed live renders under public/design-gallery/. Entries without a
   render fall back to an icon + description card automatically. */
const VIDEOS: Record<string, { src: string; poster: string }> = {
  "heartbeat": { src: "/design-gallery/video/heartbeat.mp4", poster: "/design-gallery/video/posters/heartbeat.jpg" },
  "loop-rail": { src: "/design-gallery/video/loop-rail.mp4", poster: "/design-gallery/video/posters/loop-rail.jpg" },
  "contrast-text": { src: "/design-gallery/video/contrast-text.mp4", poster: "/design-gallery/video/posters/contrast-text.jpg" },
  "data-card": { src: "/design-gallery/video/data-card.mp4", poster: "/design-gallery/video/posters/data-card.jpg" },
  "question-hook": { src: "/design-gallery/video/question-hook.mp4", poster: "/design-gallery/video/posters/question-hook.jpg" },
  "storyboard": { src: "/design-gallery/video/storyboard.mp4", poster: "/design-gallery/video/posters/storyboard.jpg" },
};
const STILLS: Record<string, string> = {
  "agent-brief": "/design-gallery/social/agent-brief.png",
  "department-map": "/design-gallery/social/department-map.png",
  "list-checklist": "/design-gallery/social/list-checklist.png",
  "single-fact": "/design-gallery/social/single-fact.png",
  "testimonial-pull-quote": "/design-gallery/social/testimonial-pull-quote.png",
};

/* Status badge model: every entry is confirmed unless the registry marks it
   `confirmed: false`. The four v3.4 additions carry content_relevance, which
   distinguishes them from the earlier registered set. */
type BadgeKind = "registered" | "new" | "preview" | "legacy";
function badgeFor(entry: Entry): { kind: BadgeKind; key: string } {
  if (entry.legacy) return { kind: "legacy", key: "useCases.design.gallery.badge.legacy" };
  if (entry.confirmed === false) return { kind: "preview", key: "useCases.design.gallery.badge.preview" };
  if (entry.content_relevance) return { kind: "new", key: "useCases.design.gallery.badge.new" };
  return { kind: "registered", key: "useCases.design.gallery.badge.registered" };
}

const motion = registry.archetypes.filter((entry) => entry.kind === "shorts" && !entry.legacy);
const stills = registry.archetypes.filter((entry) => entry.kind === "social" && !entry.legacy);
const legacy = registry.archetypes.filter((entry) => entry.legacy);

const fmt = (n: number) => (locale === "fa" ? new Intl.NumberFormat("fa-IR").format(n) : String(n));
const summary = t(locale, "useCases.design.gallery.summary", {
  total: fmt(registry.archetypes.length),
  motion: fmt(motion.length),
  stills: fmt(stills.length),
});

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "nav.usecases"), item: `${SITE.url}${localizePath("/solutions/", locale)}` },
    { "@type": "ListItem", position: 3, name: t(locale, "nav.design"), item: `${SITE.url}${localizePath("/solutions/ai-departments/design/", locale)}` },
    { "@type": "ListItem", position: 4, name: t(locale, "nav.gallery"), item: `${SITE.url}${localizePath("/use-cases/design/gallery/", locale)}` },
  ],
};

const badgeClasses: Record<BadgeKind, string> = {
  registered: "bg-success-soft text-success",
  new: "bg-primary-soft text-primary",
  preview: "bg-warning-soft text-warning",
  legacy: "bg-muted-foreground/10 text-muted-foreground",
};
---

<Page title={t(locale, "useCases.design.gallery.pageTitle")} description={t(locale, "useCases.design.gallery.pageDesc")} image="/assets/og/design-gallery.png" locale={locale}>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.usecases"), href: "/solutions/" },
      { label: t(locale, "nav.design"), href: "/solutions/ai-departments/design/" },
      { label: t(locale, "nav.gallery") },
    ]}
    label={t(locale, "useCases.design.gallery.hero.label")}
    title={t(locale, "useCases.design.gallery.hero.title")}
    description={t(locale, "useCases.design.gallery.hero.desc")}
  />
  <div class="relative py-6 sm:py-8">
    <div class="mx-auto max-w-6xl px-6">
      <p class="text-center text-2xs font-semibold uppercase tracking-widest text-foreground-muted" data-aos="fade-up">{summary}</p>
      <p class="mt-2 text-center text-2xs text-muted-foreground" data-aos="fade-up"><i class="bx bx-revision rtl-flip icon-xs align-middle me-1"></i>{t(locale, "useCases.design.gallery.liveNote")}</p>
    </div>
  </div>

  <section class="relative py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.design.gallery.motion.title")} description={t(locale, "useCases.design.gallery.motion.desc")} />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        {motion.map((entry) => {
          const video = VIDEOS[entry.id];
          const badge = badgeFor(entry);
          return (
            <article class="gallery-card flex flex-col overflow-hidden rounded-lg border border-border bg-panel shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
              <div class="relative border-b border-border bg-background-deep">
                {video ? (
                  <video
                    class="mx-auto aspect-[9/16] w-full max-w-[16rem]"
                    src={video.src}
                    poster={video.poster}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-label={entry.id}
                  ></video>
                ) : (
                  <div class="mx-auto flex aspect-[9/16] w-full max-w-[16rem] items-center justify-center">
                    <i class="bx bx-film text-foreground-muted icon-4xl" aria-hidden="true"></i>
                  </div>
                )}
                <span class="absolute start-3 top-3 inline-flex items-center rounded-full border border-border bg-panel px-2.5 py-0.5 text-2xs font-medium text-muted-foreground">{t(locale, "useCases.design.gallery.meta.motion")}</span>
              </div>
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-sm font-semibold text-foreground-strong">{entry.id}</h3>
                  <span class:list={["rounded-full px-2.5 py-0.5 text-2xs font-medium", badgeClasses[badge.kind]]}>{t(locale, badge.key)}</span>
                </div>
                {entry.description && <p class="text-xs leading-relaxed text-muted-foreground">{entry.description}</p>}
                {entry.research_map && (
                  <p class="mt-auto border-t border-border pt-3 text-2xs leading-relaxed text-foreground-muted">
                    <span class="font-medium text-muted-foreground">{t(locale, "useCases.design.gallery.source")}: </span>
                    {entry.research_map}
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-16 sm:py-20">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.design.gallery.social.title")} description={t(locale, "useCases.design.gallery.social.desc")} />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        {stills.map((entry) => {
          const still = STILLS[entry.id];
          const badge = badgeFor(entry);
          return (
            <article class="gallery-card flex flex-col overflow-hidden rounded-lg border border-border bg-panel shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
              <div class="relative border-b border-border bg-background-deep">
                {still ? (
                  <img class="mx-auto aspect-[4/5] w-full max-w-[18rem] object-cover" src={still} alt={entry.id} width="1080" height="1350" loading="lazy" />
                ) : (
                  <div class="mx-auto flex aspect-[4/5] w-full max-w-[18rem] items-center justify-center">
                    <i class="bx bx-image-alt text-foreground-muted icon-4xl" aria-hidden="true"></i>
                  </div>
                )}
                <span class="absolute start-3 top-3 inline-flex items-center rounded-full border border-border bg-panel px-2.5 py-0.5 text-2xs font-medium text-muted-foreground">{t(locale, "useCases.design.gallery.meta.still")}</span>
              </div>
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-sm font-semibold text-foreground-strong">{entry.id}</h3>
                  <span class:list={["rounded-full px-2.5 py-0.5 text-2xs font-medium", badgeClasses[badge.kind]]}>{t(locale, badge.key)}</span>
                </div>
                {entry.description && <p class="text-xs leading-relaxed text-muted-foreground">{entry.description}</p>}
                {entry.research_map && (
                  <p class="mt-auto border-t border-border pt-3 text-2xs leading-relaxed text-foreground-muted">
                    <span class="font-medium text-muted-foreground">{t(locale, "useCases.design.gallery.source")}: </span>
                    {entry.research_map}
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="relative py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.design.gallery.legacy.title")} description={t(locale, "useCases.design.gallery.legacy.desc")} />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        {legacy.map((entry) => {
          const badge = badgeFor(entry);
          const isMotion = entry.kind === "shorts";
          return (
            <article class="gallery-card flex flex-col overflow-hidden rounded-lg border border-border bg-panel shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
              <div class="flex items-center justify-center gap-3 border-b border-border bg-panel-deep/40 px-5 py-10">
                <div class:list={["flex h-12 w-12 items-center justify-center rounded-md", isMotion ? "bg-accent-soft text-accent" : "bg-purple-soft text-purple"]}>
                  <i class:list={[isMotion ? "bx bx-film" : "bx bx-image-alt", "icon-3xl"]} aria-hidden="true"></i>
                </div>
                <div class="flex flex-col gap-1">
                  <span class="text-2xs font-medium text-foreground">{entry.id}</span>
                  <span class="text-2xs text-muted-foreground">{t(locale, isMotion ? "useCases.design.gallery.meta.motion" : "useCases.design.gallery.meta.still")}</span>
                </div>
              </div>
              <div class="flex flex-1 flex-col gap-3 p-5">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-sm font-semibold text-foreground-strong">{entry.id}</h3>
                  <span class:list={["rounded-full px-2.5 py-0.5 text-2xs font-medium", badgeClasses[badge.kind]]}>{t(locale, badge.key)}</span>
                </div>
                {entry.description && <p class="text-xs leading-relaxed text-muted-foreground">{entry.description}</p>}
                <p class="mt-auto border-t border-border pt-3 text-2xs leading-relaxed text-foreground-muted">{t(locale, "useCases.design.gallery.noRender")}</p>
                {entry.research_map && (
                  <p class="text-2xs leading-relaxed text-foreground-muted">
                    <span class="font-medium text-muted-foreground">{t(locale, "useCases.design.gallery.source")}: </span>
                    {entry.research_map}
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <div class="relative pb-4 text-center">
    <div class="mx-auto max-w-6xl px-6">
      <a href={localizePath("/solutions/ai-departments/design/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80"><i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i>{t(locale, "useCases.design.gallery.back")}</a>
    </div>
  </div>

  <FeatureCTA locale={locale} title={t(locale, "useCases.design.gallery.cta.title")} description={t(locale, "useCases.design.gallery.cta.desc")} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>