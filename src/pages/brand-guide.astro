              <header class="guide-layer__heading"><p>{tr("brandGuide.execution.eyebrow")}</p><h2>{tr("brandGuide.execution.title1")} <em>{tr("brandGuide.execution.titleAccent")}</em></h2></header>
              <GuideDiagramCanvas class="guide-layer__diagram" designWidth={1680} designHeight={940} ariaLabel="AI executes a brand system" edges={executionEdges}>
                <div class="guide-execution-side guide-execution-side--before"><label>{tr("brandGuide.execution.before")}</label><h3>{tr("brandGuide.execution.beforePrompt").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</h3><p>{tr("brandGuide.execution.guesses")}</p><div class="guide-chat-card" data-guide-node="execution-before-chat"><strong><img class="guide-provider-mark guide-provider-mark--chatgpt" src="/assets/brand/chatgpt.svg" alt="" width="20" height="20" /> ChatGPT</strong><span>{tr("brandGuide.execution.beforePrompt").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</span><small>⌘　↑</small></div><div class="guide-execution-posts">{beforePostAssets.map((asset) => <span><img src={asset} alt="Branded output variation" width="1080" height="1350" loading="lazy" /></span>)}</div><small>{tr("brandGuide.execution.beforeOutputNote").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</small></div>
                <GuideGlassCore class="guide-execution-core" node="execution-core" icon="">
                  <p class="guide-execution-core__eyebrow">{tr("brandGuide.execution.withSystem")}</p>
                  <h3>{tr("brandGuide.execution.hasSystem")}</h3>
                  <div class="guide-execution-core__rows">{[["bx-grid-alt","brandGuide.execution.components","brandGuide.execution.componentsNote"],["bx-data","brandGuide.execution.tokens","brandGuide.execution.tokensNote"],["bx-file","brandGuide.execution.templates","brandGuide.execution.templatesNote"],["bx-file","brandGuide.execution.rules","brandGuide.execution.rulesNote"],["bx-image","brandGuide.execution.examples","brandGuide.execution.examplesNote"],["bx-folder","brandGuide.execution.assets","brandGuide.execution.assetsNote"],["bx-play-circle","brandGuide.execution.motion","brandGuide.execution.motionNote"]].map(([icon, title, sub]) => <span><i class={`bx ${icon} icon-xl`}></i><b>{tr(title)}</b><small>{tr(sub)}</small></span>)}</div>
                </GuideGlassCore>
                <div class="guide-execution-side guide-execution-side--after"><label>{tr("brandGuide.execution.after")}</label><h3>{tr("brandGuide.execution.afterPrompt").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</h3><p>{tr("brandGuide.execution.executes")}</p><div class="guide-chat-card" data-guide-node="execution-after-chat"><strong><img class="guide-provider-mark guide-provider-mark--claude" src="/assets/brand/claude.svg" alt="" width="20" height="20" /> Claude</strong><span>{tr("brandGuide.execution.afterPrompt").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</span><small>↗</small></div><div class="guide-execution-stack" data-guide-node="execution-after-output"><span><img src="/design-gallery/social/explore-new-horizons.png" alt="On-brand generated story" width="896" height="1120" loading="lazy" /></span><span><img src="/design-gallery/social/explore-new-horizons.png" alt="On-brand generated story variation" width="896" height="1120" loading="lazy" /></span><span><img src="/design-gallery/social/explore-new-horizons.png" alt="On-brand generated story variation" width="896" height="1120" loading="lazy" /></span></div><small>{tr("brandGuide.execution.onBrand")}<br />{tr("brandGuide.execution.anyFormat")}</small></div>
                <div class="guide-execution-tools"><span><img class="guide-provider-mark guide-provider-mark--chatgpt" src="/assets/brand/chatgpt.svg" alt="" width="22" height="22" />ChatGPT</span><span><img class="guide-provider-mark guide-provider-mark--claude" src="/assets/brand/claude.svg" alt="" width="22" height="22" />Claude</span><span><img class="guide-provider-mark guide-provider-mark--gemini" src="/assets/brand/gemini.svg" alt="" width="22" height="22" />Gemini</span><span><img class="guide-provider-mark guide-provider-mark--copilot" src="/assets/brand/copilot.svg" alt="" width="22" height="22" />Copilot</span><small>{tr("brandGuide.execution.anyTool").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</small></div>
                <div class="guide-layer__bottom-claim"><strong>{tr("brandGuide.execution.claim1")}</strong><strong>{tr("brandGuide.execution.claim2")} <em>{tr("brandGuide.execution.claimAccent")}</em></strong></div>
              </GuideDiagramCanvas>
            </div>
          ) : slide.kind === "production" ? (
            <GuideProductionScene locale={locale} />
          ) : slide.kind === "cost-model" ? (
            <GuideCostModelScene locale={locale} />
          ) : slide.kind === "system-map" ? (
            <GuideSystemMapScene locale={locale} />
          ) : slide.kind === "review" ? (
            <GuideReviewScene locale={locale} />
          ) : (
            <div class="guide-slide__content">
              <h2>{slide.title}</h2>
              <p>{slide.body}</p>
            </div>
          )}
          <div class="guide-slide__controls" aria-label="Slide controls">
            <button type="button" data-guide-previous aria-label={tr("brandGuide.previous")}><i class="bx bx-left-arrow-alt icon-2xl" aria-hidden="true"></i></button>
            <button type="button" data-guide-next aria-label={index === slides.length - 1 ? tr("brandGuide.apply") : tr("brandGuide.next")}><i class="bx bx-right-arrow-alt icon-2xl" aria-hidden="true"></i></button>
          </div>
        </section>
      ))}
    </div>

    <button class="guide-fullscreen" type="button" data-guide-fullscreen data-enter-label={tr("brandGuide.fullscreen")} data-exit-label={tr("brandGuide.exitFullscreen")} aria-label={tr("brandGuide.fullscreen")} title={tr("brandGuide.fullscreen")}>
      <i class="bx bx-fullscreen icon-xl" aria-hidden="true"></i>
    </button>

    <div class="guide-status">
      <nav class="guide-progress" aria-label={tr("brandGuide.slideCount")}>
        {Array.from({ length: slides.length }, (_, index) => <button type="button" data-guide-dot={index + 1} aria-label={tr("brandGuide.goTo", { number: index + 1 })} aria-current={index === 0 ? "step" : undefined}></button>)}
      </nav>
      <div class="guide-counter" aria-hidden="true"><b data-guide-current>Access</b><span>/</span><span>{slides.length}</span></div>
    </div>
    <aside class="guide-orientation" aria-live="polite">
      <i class="bx bx-right-arrow-alt icon-3xl" aria-hidden="true"></i>
      <p>{tr("brandGuide.rotate")}</p>
    </aside>
  </main>
  <script>import "../scripts/brand-guide";</script>
</BaseLayout>
