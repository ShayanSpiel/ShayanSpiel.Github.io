---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpielOSLogo from "../components/SpielOSLogo.astro";
import BrandProblemDiagram from "../components/BrandProblemDiagram.astro";
import GuideDiagramCanvas, { type DiagramEdge } from "../components/brand-guide/GuideDiagramCanvas.astro";
import GuideGlassCore from "../components/brand-guide/GuideGlassCore.astro";
import GuideProductionScene from "../components/brand-guide/GuideProductionScene.astro";
import GuideCostModelScene from "../components/brand-guide/GuideCostModelScene.astro";
import GuideSystemMapScene from "../components/brand-guide/GuideSystemMapScene.astro";
import GuideReviewScene from "../components/brand-guide/GuideReviewScene.astro";
import { t, type Locale } from "../i18n/translations";
import { FORMS } from "../config";
import { brandLogo } from "../data/brand-logos";
import "../styles/brand-guide.css";
import "../styles/brand-guide-layers.css";
import "../styles/brand-guide-reference-corrections.css";
import "../styles/brand-guide-continuation.css";
import "../styles/brand-guide-polish.css";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const tr = (key: string, params?: Record<string, string | number>) => t(locale, key, params);
type GuideSlide = {
  number: number;
  kind: "problem" | "cost" | "ai" | "infra" | "scatter" | "system" | "outputs" | "media" | "execution" | "production" | "cost-model" | "system-map" | "review" | "generic";
  eyebrow: string;
  title: string;
  body: string;
};
const slides: GuideSlide[] = [
  { number: 1, kind: "problem", eyebrow: tr("brandGuide.slide1.eyebrow"), title: tr("brandGuide.slide1.title"), body: tr("brandGuide.slide1.body") },
  { number: 2, kind: "cost", eyebrow: tr("brandGuide.slide2.eyebrow"), title: "", body: "" },
  { number: 3, kind: "ai", eyebrow: tr("brandGuide.slide3.eyebrow"), title: "", body: "" },
  { number: 4, kind: "infra", eyebrow: tr("brandGuide.slide4.eyebrow"), title: "", body: "" },
  { number: 5, kind: "scatter", eyebrow: tr("brandGuide.slide5.eyebrow"), title: "", body: "" },
  { number: 6, kind: "system", eyebrow: tr("brandGuide.slide6.eyebrow"), title: "", body: "" },
  { number: 7, kind: "outputs", eyebrow: tr("brandGuide.slide7.eyebrow"), title: "", body: "" },
  { number: 8, kind: "media", eyebrow: tr("brandGuide.slide8.eyebrow"), title: "", body: "" },
  { number: 9, kind: "execution", eyebrow: tr("brandGuide.slide9.eyebrow"), title: "", body: "" },
  { number: 10, kind: "production", eyebrow: tr("brandGuide.slide10.eyebrow"), title: "", body: "" },
  { number: 11, kind: "cost-model", eyebrow: tr("brandGuide.slide11.eyebrow"), title: "", body: "" },
  { number: 12, kind: "system-map", eyebrow: tr("brandGuide.slide12.eyebrow"), title: "", body: "" },
  { number: 13, kind: "review", eyebrow: tr("brandGuide.slide13.eyebrow"), title: "", body: "" },
];

const outputCards = [
  ["output-social", "Social Post", "bx-image", "/design-gallery/social/ideas-in-motion.png"],
  ["output-quote", "Quote", "bxs-quote-alt-left", ""],
  ["output-stat", "Stat", "bx-bar-chart-alt-2", ""],
  ["output-case", "Case Study", "bx-image", "/design-gallery/social/explore-new-horizons.png"],
  ["output-announcement", "Announcement", "bx-message-square-detail", ""],
  ["output-story", "Instagram Story", "bxl-instagram", "/design-gallery/social/explore-new-horizons.png"],
  ["output-carousel", "Carousel", "bx-images", "/design-gallery/social/ideas-in-motion.png"],
  ["output-video", "Video Scene", "bx-play-circle", "/design-gallery/video/posters/from-ideas-to-impact.jpg"],
  ["output-demo", "Product Demo", "bx-window", ""],
  ["output-landing", "Landing Page Section", "bx-layout", "/design-gallery/social/ideas-in-motion.png"],
] as const;
const beforePostAssets = [
  "/design-gallery/social/explore-new-horizons.png",
  "/design-gallery/social/ideas-in-motion.png",
  "/design-gallery/social/youtube-bold.png",
  "/design-gallery/social/list-checklist.png",
] as const;

const flowEdges = (prefix: string, sources: string[], target: string, side: "top" | "bottom" = "top"): DiagramEdge[] => sources.map((source, index) => ({
  id: `${prefix}-${source}-${target}`,
  from: source,
  to: target,
  fromAnchor: { side: side === "top" ? "bottom" : "top", ratio: .5 },
  toAnchor: { side: side === "top" ? "top" : "bottom", ratio: sources.length === 1 ? .5 : index / (sources.length - 1) },
}));
const scatterEdges: DiagramEdge[] = [
  ...["scatter-logo", "scatter-guidelines", "scatter-figma", "scatter-canva", "scatter-css", "scatter-drive", "scatter-video", "scatter-templates", "scatter-head"].map((source, index) => ({
    id: `scatter-${source}-core`, from: source, to: "scatter-core",
    fromAnchor: { side: "right" as const, ratio: .5 },
    toAnchor: { side: "left" as const, ratio: .12 + index * .095 },
    // Stagger the handles so the fan remains legible instead of collapsing
    // into one dark bundle when the file cluster is scaled.
    bend: [-.24, -.17, -.1, -.03, .04, .11, .18, .25, .13][index],
  })),
  { id: "scatter-core-folder", from: "scatter-core", to: "scatter-folder", fromAnchor: { side: "right", ratio: .5 }, toAnchor: { side: "left", ratio: .5 }, arrow: true },
];
const systemEdges: DiagramEdge[] = [
  ...flowEdges("system-top", ["system-colors", "system-fonts", "system-spacing", "system-logo"], "system-core"),
  ...flowEdges("system-bottom", ["system-layout", "system-image", "system-motion"], "system-core", "bottom"),
  { id: "system-core-code", from: "system-core", to: "system-code", fromAnchor: { side: "right", ratio: .5 }, toAnchor: { side: "left", ratio: .5 }, arrow: true },
];
const outputEdges: DiagramEdge[] = [
  { id: "output-core-social", from: "output-core", to: "output-social", fromAnchor: { side: "right", ratio: .3 }, toAnchor: { side: "left", ratio: .5 }, arrow: true },
  { id: "output-core-story", from: "output-core", to: "output-story", fromAnchor: { side: "right", ratio: .7 }, toAnchor: { side: "left", ratio: .5 }, arrow: true },
  ...[["output-social","output-quote"],["output-quote","output-stat"],["output-stat","output-case"],["output-case","output-announcement"],["output-story","output-carousel"],["output-carousel","output-video"],["output-video","output-demo"],["output-demo","output-landing"]].map(([from, to]) => ({ id: `${from}-${to}`, from, to, fromAnchor: { side: "right" as const, ratio: .5 }, toAnchor: { side: "left" as const, ratio: .5 }, arrow: true })),
  { id: "output-core-primitive-1", from: "output-core", to: "output-primitive-1", fromAnchor: { side: "bottom", ratio: .5 }, toAnchor: { side: "top", ratio: .5 } },
  ...[1,2,3,4,5].map(index => ({ id: `output-primitive-${index}-${index + 1}`, from: `output-primitive-${index}`, to: `output-primitive-${index + 1}`, fromAnchor: { side: "right" as const, ratio: .5 }, toAnchor: { side: "left" as const, ratio: .5 } })),
];
const mediaEdges: DiagramEdge[] = [
  { id: "media-content-template", from: "media-content", to: "media-template", fromAnchor: { side: "bottom", ratio: .5 }, toAnchor: { side: "top", ratio: .5 }, arrow: true },
  { id: "media-template-image", from: "media-template", to: "media-image", fromAnchor: { side: "bottom", ratio: .5 }, toAnchor: { side: "top", ratio: .5 }, arrow: true },
  { id: "media-image-core", from: "media-image", to: "media-core", fromAnchor: { side: "right", ratio: .35 }, toAnchor: { side: "left", ratio: .7 } },
  { id: "media-script-scenes", from: "media-script", to: "media-scenes", fromAnchor: { side: "bottom", ratio: .5 }, toAnchor: { side: "top", ratio: .5 }, arrow: true },
  { id: "media-scenes-motion", from: "media-scenes", to: "media-motion", fromAnchor: { side: "bottom", ratio: .5 }, toAnchor: { side: "top", ratio: .5 }, arrow: true },
  { id: "media-motion-video", from: "media-motion", to: "media-video", fromAnchor: { side: "bottom", ratio: .5 }, toAnchor: { side: "top", ratio: .5 }, arrow: true },
  { id: "media-core-video", from: "media-core", to: "media-video", fromAnchor: { side: "right", ratio: .7 }, toAnchor: { side: "left", ratio: .35 } },
];
const executionEdges: DiagramEdge[] = [
  { id: "execution-before-core", from: "execution-before-chat", to: "execution-core", fromAnchor: { side: "right", ratio: .5 }, toAnchor: { side: "left", ratio: .35 }, arrow: true },
  { id: "execution-core-after", from: "execution-core", to: "execution-after-chat", fromAnchor: { side: "right", ratio: .35 }, toAnchor: { side: "left", ratio: .5 }, arrow: true },
  { id: "execution-core-output", from: "execution-core", to: "execution-after-output", fromAnchor: { side: "right", ratio: .72 }, toAnchor: { side: "left", ratio: .5 }, dashed: true, arrow: true },
];

const aiEdges: DiagramEdge[] = [
  { id: "input-tool-01", from: "ai-input", to: "tool-01", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.5 }, controlPoints: [{ x: 0.46, y: 0.25 }, { x: 0.12, y: 0.2 }] },
  { id: "input-tool-02", from: "ai-input", to: "tool-02", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.5 }, controlPoints: [{ x: 0.48, y: 0.25 }, { x: 0.28, y: 0.2 }] },
  { id: "input-tool-03", from: "ai-input", to: "tool-03", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.5 }, controlPoints: [{ x: 0.5, y: 0.25 }, { x: 0.5, y: 0.2 }] },
  { id: "input-tool-04", from: "ai-input", to: "tool-04", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.5 }, controlPoints: [{ x: 0.52, y: 0.25 }, { x: 0.72, y: 0.2 }] },
  { id: "input-tool-05", from: "ai-input", to: "tool-05", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.5 }, controlPoints: [{ x: 0.54, y: 0.25 }, { x: 0.9, y: 0.2 }] },
  { id: "tool-01-manual", from: "tool-01", to: "manual-fixes", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.1 }, bend: 0.08 },
  { id: "tool-02-manual", from: "tool-02", to: "manual-fixes", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.3 }, bend: 0.05 },
  { id: "tool-03-manual", from: "tool-03", to: "manual-fixes", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.5 } },
  { id: "tool-04-manual", from: "tool-04", to: "manual-fixes", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.7 }, bend: -0.05 },
  { id: "tool-05-manual", from: "tool-05", to: "manual-fixes", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio: 0.9 }, bend: -0.08 },
];

const costEdges: DiagramEdge[] = [
  { id: "cost-card-rail-1", from: "cost-card-1", to: "cost-rail-1", fromAnchor: { side: "left", ratio: 0.5 }, toAnchor: { side: "center" } },
  { id: "cost-card-rail-2", from: "cost-card-2", to: "cost-rail-2", fromAnchor: { side: "left", ratio: 0.5 }, toAnchor: { side: "center" } },
  { id: "cost-card-rail-3", from: "cost-card-3", to: "cost-rail-3", fromAnchor: { side: "left", ratio: 0.5 }, toAnchor: { side: "center" } },
  { id: "cost-card-rail-4", from: "cost-card-4", to: "cost-rail-4", fromAnchor: { side: "left", ratio: 0.5 }, toAnchor: { side: "center" } },
  { id: "cost-card-rail-5", from: "cost-card-5", to: "cost-rail-5", fromAnchor: { side: "left", ratio: 0.5 }, toAnchor: { side: "center" } },
  { id: "cost-rail-1-2", from: "cost-rail-1", to: "cost-rail-2", fromAnchor: { side: "center" }, toAnchor: { side: "center" } },
  { id: "cost-rail-2-3", from: "cost-rail-2", to: "cost-rail-3", fromAnchor: { side: "center" }, toAnchor: { side: "center" } },
  { id: "cost-rail-3-4", from: "cost-rail-3", to: "cost-rail-4", fromAnchor: { side: "center" }, toAnchor: { side: "center" } },
  { id: "cost-rail-4-5", from: "cost-rail-4", to: "cost-rail-5", fromAnchor: { side: "center" }, toAnchor: { side: "center" } },
  { id: "cost-5-merge", from: "cost-card-5", to: "cost-output-merge", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "center" } },
  { id: "cost-merge-time", from: "cost-output-merge", to: "cost-metric-time", fromAnchor: { side: "center" }, toAnchor: { side: "top", ratio: 0.5 } },
  { id: "cost-merge-cost", from: "cost-output-merge", to: "cost-metric-cost", fromAnchor: { side: "center" }, toAnchor: { side: "top", ratio: 0.5 } },
  { id: "cost-merge-people", from: "cost-output-merge", to: "cost-metric-people", fromAnchor: { side: "center" }, toAnchor: { side: "top", ratio: 0.5 } },
  { id: "cost-merge-inconsistency", from: "cost-output-merge", to: "cost-metric-inconsistency", fromAnchor: { side: "center" }, toAnchor: { side: "top", ratio: 0.5 } },
];

// Ratios are local to the core card, not absolute canvas coordinates.  The
// measured canvas resolves the actual card bounds at every viewport, so the
// six branches stay attached when the row is widened or scaled on mobile.
const infraCoreAnchors = [0.05, 0.23, 0.4, 0.6, 0.77, 0.95];
const infraEdges: DiagramEdge[] = infraCoreAnchors.flatMap((ratio, index) => [
  { id: `infra-input-${index + 1}`, from: `infra-input-${index + 1}`, to: "infra-core", fromAnchor: { side: "bottom", ratio: 0.5 }, toAnchor: { side: "top", ratio } },
  { id: `infra-output-${index + 1}`, from: "infra-core", to: `infra-output-${index + 1}`, fromAnchor: { side: "bottom", ratio }, toAnchor: { side: "top", ratio: 0.5 } },
]);
---

<BaseLayout
  title={tr("brandGuide.pageTitle")}
  description={tr("brandGuide.pageDesc")}
  canonical={locale === "fa" ? "https://brand.spielos.xyz/fa/brand-guide/" : "https://brand.spielos.xyz/brand-guide/"}
  image="/assets/og/founder.png"
  locale={locale}
  alternateBaseUrl="https://brand.spielos.xyz"
  showChat={false}
>
  <main class="brand-guide" data-brand-guide>
    <div class="brand-guide__deck" aria-live="polite">
      <section class="guide-slide guide-slide--gate is-active" data-guide-slide="0" aria-label={tr("brandGuide.access")}>
        <div class="guide-grid" aria-hidden="true"></div>
        <div class="guide-orbit guide-orbit--one" aria-hidden="true"><i class="bx bxs-file-pdf icon-2xl"></i><strong>{tr("brandGuide.orbit.guidelines").split("\n").map((line, index) => <Fragment>{index > 0 && <br />}{line}</Fragment>)}</strong><small>{tr("brandGuide.orbit.guidelinesNote")}</small><b>×</b></div>
        <div class="guide-orbit guide-orbit--two" aria-hidden="true"><i class="bx bx-image icon-2xl"></i><strong>Logo_Final_v4.png</strong><b>×</b></div>
        <div class="guide-orbit guide-orbit--three" aria-hidden="true"><span class="guide-swatches"><i></i><i></i><i></i><i></i></span><strong>{tr("brandGuide.orbit.colors")}</strong><small>{tr("brandGuide.orbit.colorsNote")}</small></div>
        <div class="guide-orbit guide-orbit--four" aria-hidden="true"><strong class="guide-type-sample">Aa</strong><span>Typography.fig</span><small>{tr("brandGuide.orbit.typographyNote")}</small></div>
        <div class="guide-orbit guide-orbit--five" aria-hidden="true"><i class="bx bxs-file-archive icon-2xl"></i><strong>Campaign_assets.zip</strong><small>{tr("brandGuide.orbit.assetsNote")}</small><b>×</b></div>
        <div class="guide-orbit guide-orbit--six" aria-hidden="true"><i class="bx bxs-file icon-2xl"></i><strong>Old template.pptx</strong><small>{tr("brandGuide.orbit.templateNote")}</small><b>×</b></div>
        <div class="guide-orbit guide-orbit--seven" aria-hidden="true"><i class="bx bx-trash icon-2xl"></i></div>

        <div class="guide-gate">
          <p class="guide-kicker">{tr("brandGuide.kicker")}</p>
          <h1 dir={locale === "fa" ? "rtl" : "ltr"}>
            {locale === "fa" ? (
              <>
                {tr("brandGuide.titleBefore")} <span class="guide-doc-word" dir="ltr"><span class="guide-doc-logo" set:html={brandLogo("docs")} aria-label="Google Docs" />{tr("brandGuide.titleDoc")}</span><br />
                {tr("brandGuide.titleInto")} <span class="guide-marker"><em>{tr("brandGuide.titleMarker")}</em></span><span class="guide-insert" dir="ltr" aria-label="AI"><span class="guide-insertion-mark" aria-hidden="true"></span><b>AI</b></span><br />
                <span class="guide-serif-title">{tr("brandGuide.titleAfter")}</span>
              </>
            ) : (
              <>
                {tr("brandGuide.titleBefore")} <span class="guide-doc-word"><span class="guide-doc-logo" set:html={brandLogo("docs")} aria-label="Google Docs" />{tr("brandGuide.titleDoc")}</span> {tr("brandGuide.titleInto")}<br />
                <span class="guide-marker"><em>{tr("brandGuide.titleMarker")}</em></span><span class="guide-insert" dir="ltr" aria-label="AI added to Executable"><span class="guide-insertion-mark" aria-hidden="true"></span><b>AI</b></span><br />
                <span class="guide-serif-title">{tr("brandGuide.titleAfter")}</span>
              </>
            )}
          </h1>
          <p class="guide-subtitle">{tr("brandGuide.subtitle")}</p>
          <div class="guide-founder-quote">
            <div class="guide-avatar"><img src="/assets/avatars/avatar.jpg" alt="Shayan Spiel" width="96" height="96" /></div>
            {locale === "fa" ? <p>{tr("brandGuide.quote")}</p> : <p>For 10 years, I’ve led startup growth and campaigns that produced <strong>3M+ users in 3 days</strong> and contributed to <strong>80%+ YoY growth.</strong> A proper AI Brand Infrastructure can help you <span class="guide-output-claim"><strong>2× output</strong><span class="guide-at-least"><span class="guide-insertion-mark" aria-hidden="true"></span>at least</span></span>, lower production cost, and keep one brand across every channel.</p>}
          </div>
          <form class="guide-email-form" action={FORMS.contact} method="POST" novalidate data-invalid-error={tr("brandGuide.unlockError")} data-submit-error={tr("brandGuide.submitError")}>
            <input type="hidden" name="_subject" value="SpielOS Brand Guide Access" />
            <input type="hidden" name="source" value="brand-guide" />
            <label class="sr-only" for="brand-guide-email">{tr("brandGuide.emailLabel")}</label>
            <div class="guide-email-field"><i class="bx bx-envelope icon-xl" aria-hidden="true"></i><input id="brand-guide-email" name="email" type="email" autocomplete="email" placeholder={tr("brandGuide.emailPlaceholder")} required /></div>
            <button type="submit">{tr("brandGuide.access")}<i class="bx bx-right-arrow-alt icon-xl" aria-hidden="true"></i></button>
          </form>
          <p class="guide-unlock-error" role="alert" data-guide-error hidden><i class="bx bx-error icon-base" aria-hidden="true"></i><span data-guide-error-message>{tr("brandGuide.unlockError")}</span></p>
          <div class="guide-countdown" aria-label={tr("brandGuide.free")}>
            <p>{tr("brandGuide.free")}</p>
            <div>
              {["days", "hours", "minutes", "seconds"].map(unit => <span><b data-countdown={unit}>14</b><small>{tr(`brandGuide.${unit}`)}</small></span>)}
            </div>
          </div>
        </div>
        <button class="guide-next guide-next--locked" type="button" data-guide-next aria-label={tr("brandGuide.start")}><i class="bx bx-right-arrow-alt icon-4xl" aria-hidden="true"></i><span><i class="bx bx-lock-alt icon-base" aria-hidden="true"></i></span></button>
        <p class="guide-lock-note" aria-hidden="true"><i class="bx bx-up-arrow-alt icon-xl"></i>{tr("brandGuide.lockNote")}</p>
        <div class="guide-route" aria-hidden="true"><span class="guide-route__node"></span><span class="guide-route__line guide-route__line--one"></span><span class="guide-route__line guide-route__line--two"></span><span class="guide-route__arrow"><i class="bx bx-down-arrow-alt icon-xl"></i></span></div>
        <p class="guide-path-note" aria-hidden="true">{tr("brandGuide.pathFrom")} <i class="bx bx-right-arrow-alt icon-base"></i> <strong>{tr("brandGuide.pathSame")}</strong> <i class="bx bx-right-arrow-alt icon-base"></i> {tr("brandGuide.pathTo")}</p>
      </section>

      {slides.map((slide, index) => (
        <section class:list={["guide-slide", `guide-slide--${slide.number}`, slide.kind === "problem" && "guide-slide--problem"]} data-guide-slide={index + 1} data-guide-label={slide.eyebrow} data-guide-display-number={slide.number} aria-label={`Guide slide ${slide.number}`} aria-hidden="true">
          <div class="guide-grid" aria-hidden="true"></div>
          {slide.kind === "problem" ? (
            <BrandProblemDiagram locale={locale} />
          ) : slide.kind === "cost" ? (
            <div class="guide-reference guide-reference--cost">
              <div class="guide-reference__copy">
                <p class="guide-reference__eyebrow">{tr("brandGuide.cost.eyebrow")}</p>
                <h2>{tr("brandGuide.cost.title1")}<br />{tr("brandGuide.cost.title2")}<br />{tr("brandGuide.cost.title3")} <em>{tr("brandGuide.cost.titleAccent1")}<br />{tr("brandGuide.cost.titleAccent2")}</em> {tr("brandGuide.cost.title4")}</h2>
                <p class="guide-reference__body">{tr("brandGuide.cost.body")}</p>
                <p class="guide-reference__body guide-reference__body--short">{tr("brandGuide.cost.short")}</p>
                <div class="guide-reference__rule"></div>
                <p class="guide-reference__claim"><strong>{tr("brandGuide.cost.claim1")}</strong><em>{tr("brandGuide.cost.claim2")}</em></p>
              </div>
              <div class="guide-cost-scene">
                <GuideDiagramCanvas class="guide-cost-diagram" designWidth={1680} designHeight={940} ariaLabel="Repeated brand work creates time, cost, people, and inconsistency" edges={costEdges}>
                  <div class="guide-cost-stack">
                    <article data-guide-node="cost-card-1"><i class="guide-cost-rail-node" data-guide-node="cost-rail-1" aria-hidden="true"></i><span class="guide-cost-stack__icon"><i class="bx bx-image icon-2xl"></i></span><div><strong>{tr("brandGuide.cost.card1")}</strong><small>{tr("brandGuide.cost.card1Note")}</small></div><b>!</b></article>
                    <article data-guide-node="cost-card-2"><i class="guide-cost-rail-node" data-guide-node="cost-rail-2" aria-hidden="true"></i><span class="guide-cost-stack__icon guide-cost-stack__icon--type">Aa</span><div><strong>{tr("brandGuide.cost.card2")}</strong><small>{tr("brandGuide.cost.card2Note")}</small></div><b>!</b></article>
                    <article data-guide-node="cost-card-3"><i class="guide-cost-rail-node" data-guide-node="cost-rail-3" aria-hidden="true"></i><span class="guide-cost-stack__icon"><i class="bx bx-play icon-2xl"></i></span><div><strong>{tr("brandGuide.cost.card3")}</strong><small>{tr("brandGuide.cost.card3Note")}</small></div><b>!</b></article>
                    <article data-guide-node="cost-card-4"><i class="guide-cost-rail-node" data-guide-node="cost-rail-4" aria-hidden="true"></i><span class="guide-cost-stack__icon"><i class="bx bx-file icon-2xl"></i></span><div><strong>{tr("brandGuide.cost.card4")}</strong><small>{tr("brandGuide.cost.card4Note")}</small></div><b>!</b></article>
                    <article data-guide-node="cost-card-5"><i class="guide-cost-rail-node" data-guide-node="cost-rail-5" aria-hidden="true"></i><span class="guide-cost-stack__icon"><i class="bx bx-refresh icon-2xl"></i></span><div><strong>{tr("brandGuide.cost.card5")}</strong><small>{tr("brandGuide.cost.card5Note")}</small></div><b>!</b></article>
                  </div>
