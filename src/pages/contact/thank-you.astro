---
import Page from "../../layouts/Page.astro";
import { SITE } from "../../config";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
---

<Page
  title={t(locale, "contact.thanks.title")}
  description={t(locale, "contact.thanks.desc")}
  locale={locale}
>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6 text-center" data-aos="fade-up">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-success-soft mx-auto mb-6">
        <i class="bx bx-check-square text-success text-2xl"></i>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "contact.thanks.title")}</h1>
      <p class="mt-4 text-sm text-muted-foreground max-w-md mx-auto">{t(locale, "contact.thanks.desc")}</p>
      <a href={localizePath("/contact/", locale)} class="mt-8 inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium hover:bg-panel-raised hover:border-border-strong transition-all">
        <i class="bx bx-chevron-left icon-md mr-1"></i>
        {t(locale, "contact.thanks.back")}
      </a>
    </div>
  </section>
</Page>
