---
import Page from "../layouts/Page.astro";
import { getCollection } from "astro:content";
import { SITE, AUTHOR, FOUNDER, WAITLIST_URL } from "../config";
import SectionHeader from "../components/sections/SectionHeader.astro";
import ProofMetrics from "../components/sections/ProofMetrics.astro";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const allNotes = await getCollection(locale === "fa" ? "notesFa" : "notes");
const sortedNotes = allNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestNotes = sortedNotes.slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: AUTHOR.name,
  url: SITE.url,
  image: `${SITE.url}/assets/avatars/avatar.jpg`,
  jobTitle: AUTHOR.jobTitle,
  description: AUTHOR.description,
  sameAs: AUTHOR.sameAs,
  worksFor: { "@id": `${SITE.url}/#organization` },
  knowsAbout: [
    "AI agents",
    "Agent orchestration",
    "Context engineering",
    "Prompt caching",
    "Founder distribution",
    "Startup systems",
    "Product strategy",
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "en",
  publisher: { "@id": `${SITE.url}/#organization` },
};

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/PreOrder",
  },
  author: { "@id": `${SITE.url}/#person` },
  publisher: { "@id": `${SITE.url}/#organization` },
};

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Latest Notes from SpielOS",
  itemListElement: latestNotes.map((note, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE.url}${localizePath(`/notes${note.data.permalink}`, locale)}`,
    name: note.data.title,
    datePublished: note.data.date.toISOString(),
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
  ],
};
---

<Page
  title={AUTHOR.name + " — " + t(locale, "home.pageTitle")}
  description={t(locale, "home.pageDesc")}
  image="/assets/og/home.png"
  locale={locale}
>
  <!-- Section 1: Founder-led Hero -->
  <section class:list={["relative min-h-[90vh] flex items-center justify-center overflow-hidden", locale === "fa" ? "font-iransansx" : ""]}>
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-15"></div>

    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-raised px-3 py-1 mb-8" data-aos="fade-up">
        <span class="text-2xs text-muted-foreground font-medium">{t(locale, "home.hero.badge")}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up">
        {t(locale, "home.hero.title1")}<br />
        <span class="text-primary">{t(locale, "home.hero.title2")}</span>
      </h1>

      <div class="mt-8 space-y-4 text-base text-muted-foreground max-w-2xl mx-auto leading-relaxed" data-aos="fade-up">
        <p>
          {t(locale, "home.hero.p1")}
        </p>
        <p>
          {t(locale, "home.hero.p2")}
        </p>
        <p class="text-foreground font-medium">
          {t(locale, "home.hero.p3")}
        </p>
      </div>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3" data-aos="fade-up">
        <a href={localizePath(WAITLIST_URL, locale)} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
          {t(locale, "home.hero.cta1")}
        </a>
        <a href="#avatar" class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium hover:bg-panel-raised hover:border-border-strong transition-all">
          {t(locale, "home.hero.cta2")}
        </a>
      </div>
    </div>
  </section>

  <!-- Section 2: Avatar Recognition -->
  <section id="avatar" class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="max-w-3xl mx-auto text-center mb-16" data-aos="fade-up">
        <h2 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight leading-tightest">
          {t(locale, "home.section2.title")}
        </h2>
        <p class="mt-6 text-base text-muted-foreground leading-relaxed">
          {t(locale, "home.section2.p1")}
          {t(locale, "home.section2.p2")}
        </p>
        <p class="mt-4 text-base text-foreground font-medium">
          {t(locale, "home.section2.p3")}
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-6">
          <div class="flex items-center gap-2 mb-4">
            <i class="bx bx-error text-destructive icon-lg"></i>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "home.section2.card1.title")}</h3>
          </div>
          <ul class="space-y-3 text-xs text-muted-foreground">
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section2.card1.item1")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section2.card1.item2")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section2.card1.item3")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section2.card1.item4")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section2.card1.item5")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section2.card1.item6")}</li>
          </ul>
        </div>
        <div class="rounded-md border border-border bg-panel p-6">
          <div class="flex items-center gap-2 mb-4">
            <i class="bx bx-check-square text-success icon-lg"></i>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "home.section2.card2.title")}</h3>
          </div>
          <ul class="space-y-3 text-xs text-muted-foreground">
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section2.card2.item1")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section2.card2.item2")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section2.card2.item3")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section2.card2.item4")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section2.card2.item5")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section2.card2.item6")}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: Entry Outcome -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "home.section3.label")}
        title={t(locale, "home.section3.title")}
        description={t(locale, "home.section3.desc")}
      />

      <div class="max-w-2xl mx-auto" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-6 sm:p-8">
          <div class="flex items-center gap-2 mb-4">
            <i class="bx bx-network-chart text-primary icon-lg"></i>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "home.section3.card.title")}</h3>
          </div>
          <ul class="space-y-3 text-xs text-muted-foreground">
            <li class="flex items-start gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary text-2xs font-bold mt-0.5">1</span>
              <span>{t(locale, "home.section3.step1")}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary text-2xs font-bold mt-0.5">2</span>
              <span>{t(locale, "home.section3.step2")}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary text-2xs font-bold mt-0.5">3</span>
              <span>{t(locale, "home.section3.step3")}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary text-2xs font-bold mt-0.5">4</span>
              <span>{t(locale, "home.section3.step4")}</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-soft text-primary text-2xs font-bold mt-0.5">5</span>
              <span>{t(locale, "home.section3.step5")}</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-10 text-center" data-aos="fade-up">
        <a href={localizePath(WAITLIST_URL, locale)} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
          {t(locale, "home.section3.cta")}
        </a>
      </div>
    </div>
  </section>

  <!-- Section 4: Why SpielOS Exists -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "home.section4.title")}
        description={t(locale, "home.section4.desc")}
      />

      <div class="grid sm:grid-cols-2 gap-4" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex items-center gap-2 mb-3">
            <i class="bx bx-check-square text-success icon-lg"></i>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "home.section4.card1.title")}</h3>
          </div>
          <ul class="space-y-2 text-xs text-muted-foreground">
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section4.card1.item1")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section4.card1.item2")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-success mt-0.5">→</span> {t(locale, "home.section4.card1.item3")}</li>
          </ul>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex items-center gap-2 mb-3">
            <i class="bx bx-error text-destructive icon-lg"></i>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "home.section4.card2.title")}</h3>
          </div>
          <ul class="space-y-2 text-xs text-muted-foreground">
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section4.card2.item1")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section4.card2.item2")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "home.section4.card2.item3")}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Founder Proof -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "home.section5.title")}
        description={t(locale, "home.section5.desc")}
      />

      <ProofMetrics proof={FOUNDER.proof} locale={locale} />

      <div class="mt-10 rounded-md border border-border bg-panel p-6 sm:p-8" data-aos="fade-up">
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-2">{t(locale, "home.section5.card1.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "home.section5.card1.desc")}</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-2">{t(locale, "home.section5.card2.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "home.section5.card2.desc")}</p>
          </div>
        </div>
      </div>

      <div class="mt-8 text-center" data-aos="fade-up">
        <a href={localizePath("/founder/", locale)} class="inline-flex items-center gap-1.5 text-xs text-primary font-semibold hover:opacity-80 transition-opacity">
          {t(locale, "home.section5.link")}
        </a>
      </div>
    </div>
  </section>

  <!-- Section 6: Product Bridge -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] glow-blob opacity-10"></div>

    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "home.section6.label")}
        title={t(locale, "home.section6.title")}
        description={t(locale, "home.section6.desc")}
      />

      <div class="grid sm:grid-cols-3 gap-4" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft mb-3">
            <i class="bx bx-group text-primary icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "home.section6.card1.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "home.section6.card1.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft mb-3">
            <i class="bx bx-link text-accent icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "home.section6.card2.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "home.section6.card2.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-purple-soft mb-3">
            <i class="bx bx-network-chart text-purple icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "home.section6.card3.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "home.section6.card3.desc")}</p>
        </div>
      </div>

      <div class="mt-10 text-center" data-aos="fade-up">
        <a href={localizePath(WAITLIST_URL, locale)} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
          {t(locale, "home.section6.cta")}
        </a>
      </div>
    </div>
  </section>

  <!-- Section 7: Notes -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "home.section7.label")}
        title={t(locale, "home.section7.title")}
        description={t(locale, "home.section7.desc")}
      />

      <div class="grid sm:grid-cols-3 gap-4" data-aos="fade-up">
        {latestNotes.map((note) => (
          <a href={localizePath(`/notes${note.data.permalink}`, locale)} class="group block p-5 rounded-md border border-border bg-panel transition-all duration-150 hover:border-border-strong hover:bg-panel-raised">
            <div class="text-2xs text-muted-foreground mb-2">
              {note.data.date.toLocaleDateString(locale === "fa" ? "fa-IR" : "en-US", { month: "short", day: "numeric", year: "numeric" })}
            </div>
            <h3 class="text-sm font-semibold text-foreground-strong leading-snug mb-1.5 group-hover:text-primary transition-colors">{note.data.title}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">{note.data.description}</p>
            {note.data.tags.length > 0 && (
              <span class="mt-3 inline-flex items-center rounded-md bg-panel-raised px-2 py-0.5 text-2xs font-medium text-muted-foreground">{note.data.tags[0]}</span>
            )}
          </a>
        ))}
      </div>

      <div class="mt-8 text-center" data-aos="fade-up">
        <a href={localizePath("/notes/", locale)} class="inline-flex items-center gap-1.5 text-xs text-primary font-semibold hover:opacity-80 transition-opacity">
          {t(locale, "home.section7.link")}
        </a>
      </div>
    </div>
  </section>

  <!-- Section 8: Final Conversion -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] glow-blob opacity-10"></div>

    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">
        {t(locale, "home.section8.title")}
      </h2>
      <p class="mt-4 text-sm text-muted-foreground max-w-lg mx-auto">
        {t(locale, "home.section8.desc")}
      </p>
      <a href={localizePath(WAITLIST_URL, locale)} class="mt-8 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
        {t(locale, "home.section8.cta")}
      </a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
