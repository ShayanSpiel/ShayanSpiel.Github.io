---
import { getCollection } from "astro:content";
import ContactModal from "../components/ContactModal.astro";
import JourneyLine from "../components/JourneyLine.astro";
import OperatingLoop from "../components/architecture/OperatingLoop.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import Page from "../layouts/Page.astro";
import { AUTHOR, FOUNDER, SITE } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";
import snapshot from "../data/live-goals.json";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;

const notes = await getCollection(locale === "fa" ? "notesFa" : "notes");
const preferred = ["gates-not-models", "pipeline-not-strategy", "migration-audits"];
const featuredNotes = preferred.map((slug) => notes.find((note) => note.id.replace(/\.mdx?$/, "") === slug)).filter(Boolean).slice(0, 3);
const liveGoals = (snapshot as { goals: Array<{ name: string; display_title?: string; owner_id: string; goal_status: string; updated_at: string }> }).goals;
const liveGoal = liveGoals.find((goal) => ["director", "email", "outbound"].includes(goal.owner_id) && goal.goal_status === "active") ?? liveGoals[0];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Person", "@id": `${SITE.url}/#person`, name: AUTHOR.name, url: SITE.url, image: `${SITE.url}/assets/avatars/avatar.jpg`, jobTitle: AUTHOR.jobTitle, sameAs: AUTHOR.sameAs, worksFor: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name, url: SITE.url, description: t(locale, "conversion.home.pageDesc"), inLanguage: locale, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": `${SITE.url}/#software`, name: SITE.name, url: SITE.url, description: t(locale, "conversion.home.pageDesc"), applicationCategory: "BusinessApplication", operatingSystem: "Web", author: { "@id": `${SITE.url}/#person` }, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }] },
];

const workCards = ["requests", "reports", "intake", "checks"];
---

<Page title={t(locale, "conversion.home.pageTitle")} description={t(locale, "conversion.home.pageDesc")} image="/assets/og/home.png" locale={locale}>
  <JourneyLine />
  <section id="hero" class="relative flex min-h-[82vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[34rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.home.hero.label")}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">
        {t(locale, "conversion.home.hero.titleLead")}<br />
        <span class="text-primary">{t(locale, "conversion.home.hero.titleAccent")}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.hero.body")}</p>
      <p class="mt-4 text-sm font-medium text-foreground">{t(locale, "conversion.home.hero.support")}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizePath("/services/agent-brief/#request", locale)} data-open-contact-modal data-cta-location="home_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground transition-all hover:brightness-110">{t(locale, "cta.requestAgentBrief")}</a>
        <a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium transition-all hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.home.hero.secondary")}</a>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.work.label")} title={t(locale, "conversion.home.work.title")} description={t(locale, "conversion.home.work.body")} />
      <div class="grid gap-4 sm:grid-cols-2" data-aos="fade-up">
        {workCards.map((card) => <div class="flex gap-3 rounded-md border border-border bg-panel p-5"><i class="bx bx-time-five mt-0.5 text-warning icon-xl" aria-hidden="true"></i><p class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.home.work.${card}`)}</p></div>)}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.mechanism.label")} title={t(locale, "conversion.home.mechanism.title")} description={t(locale, "conversion.home.mechanism.body")} />
      <OperatingLoop locale={locale} />
      <div class="mt-8 text-center"><a href={localizePath("/architecture/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.mechanism.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6">
      <SectionHeader label={t(locale, "conversion.home.live.label")} title={t(locale, "conversion.home.live.title")} description={t(locale, "conversion.home.live.body")} />
      {liveGoal && <div class="rounded-lg border border-border bg-panel p-6" data-aos="fade-up"><p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.home.live.current")}</p><h3 class="mt-3 text-lg font-semibold text-foreground-strong">{liveGoal.display_title ?? liveGoal.name}</h3><p class="mt-2 text-xs text-muted-foreground">{t(locale, `live.status.${liveGoal.goal_status}`)}</p></div>}
      <div class="mt-8 text-center"><a href={localizePath("/live/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.live.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "conversion.home.path.label")} title={t(locale, "conversion.home.path.title")} description={t(locale, "conversion.home.path.body")} /><div class="flex justify-center gap-3" data-aos="fade-up"><a href={localizePath("/services/agent-brief/#request", locale)} data-open-contact-modal class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.requestAgentBrief")}</a><a href={localizePath("/services/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.home.path.secondary")}</a></div></div>
  </section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "conversion.home.brief.label")} title={t(locale, "conversion.home.brief.title")} description={t(locale, "conversion.home.brief.body")} /><div class="flex justify-center gap-3" data-aos="fade-up"><a href={localizePath("/services/agent-brief/#request", locale)} data-open-contact-modal class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "conversion.home.brief.primary")}</a><a href={localizePath("/services/agent-brief/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.home.brief.secondary")}</a></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-4xl px-6" data-aos="fade-up"><h2 class="text-3xl font-bold tracking-tight text-foreground-strong">{t(locale, "conversion.home.founder.title")}</h2><p class="mt-5 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.founder.body", { years: FOUNDER.experienceYears, products: FOUNDER.productAttempts })}</p><a href={localizePath("/founder/", locale)} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.founder.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div></section>

  {featuredNotes.length > 0 && <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "conversion.home.notes.label")} title={t(locale, "conversion.home.notes.title")} /><div class="grid gap-4 md:grid-cols-3" data-aos="fade-up">{featuredNotes.map((note) => note && <a href={localizePath(`/notes/${note.data.permalink.replace(/^\/+|\/+$/g, "")}/`, locale)} class="rounded-md border border-border bg-panel p-5 transition-all hover:border-border-strong hover:bg-panel-raised"><h3 class="text-sm font-semibold text-foreground-strong">{note.data.title}</h3><p class="mt-2 text-xs leading-relaxed text-muted-foreground">{note.data.description}</p></a>)}</div></div></section>}

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up"><h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.home.final.title")}</h2><p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.final.body")}</p><a href={localizePath("/services/agent-brief/#request", locale)} data-open-contact-modal class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.requestAgentBrief")}</a></div></section>

  <ContactModal locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>
