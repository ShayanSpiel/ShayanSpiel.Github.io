---
import { getCollection } from "astro:content";
import JourneyLine from "../components/JourneyLine.astro";
import JourneySignature from "../components/JourneySignature.astro";
import JourneyUniversal from "../components/JourneyUniversal.astro";
import OperatingLoop from "../components/architecture/OperatingLoop.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import Page from "../layouts/Page.astro";
import { AUTHOR, FOUNDER, SITE, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";
import snapshot from "../data/live-goals.json";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;

const notes = await getCollection(locale === "fa" ? "notesFa" : "notes");
const preferred = ["gates-not-models", "pipeline-not-strategy", "migration-audits"];
const featuredNotes = preferred.map((slug) => notes.find((note) => note.id.replace(/\.mdx?$/, "") === slug)).filter(Boolean).slice(0, 3);
const liveGoals = (snapshot as { goals: Array<{ name: string; display_title?: string; owner_id: string; goal_status: string; updated_at: string }> }).goals;
const liveGoal = liveGoals.find((goal) => ["director", "email", "outbound"].includes(goal.owner_id) && goal.goal_status === "active") ?? liveGoals[0];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Person", "@id": `${SITE.url}/#person`, name: AUTHOR.name, url: SITE.url, image: `${SITE.url}/assets/avatars/avatar.jpg`, jobTitle: AUTHOR.jobTitle, sameAs: AUTHOR.sameAs, worksFor: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name, url: SITE.url, description: t(locale, "conversion.home.pageDesc"), inLanguage: locale, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": `${SITE.url}/#software`, name: SITE.name, url: SITE.url, description: t(locale, "conversion.home.pageDesc"), applicationCategory: "BusinessApplication", operatingSystem: "Web", author: { "@id": `${SITE.url}/#person` }, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }] },
];

const workCards = [
  { key: "requests", icon: "bx-envelope", tile: "bg-primary-soft text-primary", gradient: "from-primary via-accent to-transparent" },
  { key: "reports", icon: "bx-data", tile: "bg-accent-soft text-accent", gradient: "from-accent via-purple to-transparent" },
  { key: "intake", icon: "bx-task", tile: "bg-purple-soft text-purple", gradient: "from-purple via-warning to-transparent" },
  { key: "checks", icon: "bx-check-shield", tile: "bg-warning-soft text-warning", gradient: "from-warning via-primary to-transparent" },
];
---

<Page title={t(locale, "conversion.home.pageTitle")} description={t(locale, "conversion.home.pageDesc")} image="/assets/og/home.png" locale={locale}>
  <JourneyLine />
  <section id="hero" class="relative flex min-h-[82vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[34rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div>
    <!-- universal journey - isolated hero 5-anchors, no gallery/video template mix (5 points, 5s draw, grey->color)
         Hero spatial anchors in viewBox 0 0 1200 700 xMinYMin meet (edge-merged: 0,0 locks to container top-left matching fixed left rail top-left):
          [12,28] start edge-merged with left rail start [100,24] as ONE shared origin (12-10 ring=2px from left edge, 28-10=18≈24 rail y; with xMinYMin meet both at true viewport top-left, read as 1 continuous line),
          [210,220] node2 left side of title "Build a business" far near edge (x 210 west of content 152, y 220 mid-title),
          [460,160] node3 top of eyebrow a little left through center (eyebrow label above title at y ~160, x 460 ≈ 600-140, slightly left),
          [600,390] node4 below title at center (x 600 center, y 390 below title block ~260-340),
          [600,545] goal bullseye top side of CTA button (x 600 center, y 545 with 545+24+8=577<700 margin above CTA row).
         Note y ordering 28 -> 220 -> 160 -> 390 -> 545 is intentional: node3 y 160 < node2 y 220 because eyebrow
         is ABOVE title, so Catmull-Rom segment node2->node3 is an upward S-wander (like left rail / gallery S-wave).
         Path via Catmull-Rom→cubic pure C chain, continuous tangents, smooth; isolated to src/components+src/pages. xMinYMin meet pins 0,0 to container top-left so hero start [12,28] aligns to rail [100,24]. -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <JourneyUniversal
        points={[[12, 28], [210, 220], [460, 160], [600, 390], [600, 545]]}
        viewBox="0 0 1200 700"
        preserveAspectRatio="xMinYMin meet"
        animation="auto"
        faded
      />
    </div>
    <div class="relative z-[1] mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-primary">{t(locale, "conversion.home.hero.label")}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[0.95] tracking-tight text-foreground-strong sm:text-6xl">
        {t(locale, "conversion.home.hero.titleLead")}<br />
        <span class="text-primary">{t(locale, "conversion.home.hero.titleAccent")}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.hero.body")}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="home_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110 hover:-translate-y-px">{t(locale, "cta.bookDiscoveryCall")}</button>
        <a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium transition-all hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.home.hero.secondary")}</a>
      </div>
      <p class="mt-3 text-2xs tracking-wide text-muted-foreground">Free 30-min assessment · You keep the brief</p>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.work.label")} title={t(locale, "conversion.home.work.title")} description={t(locale, "conversion.home.work.body")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {workCards.map((card) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80", card.gradient]} aria-hidden="true"></div>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md", card.tile]}><i class:list={["bx", card.icon, "icon-xl"]} aria-hidden="true"></i></div>
            <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.home.work.${card.key}`)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-x-0 bottom-0 z-0 aspect-[12/1] opacity-35">
      <JourneySignature variant="band" gradientId="home-band-grad" />
    </div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.mechanism.label")} title={t(locale, "conversion.home.mechanism.title")} description={t(locale, "conversion.home.mechanism.body")} />
      <OperatingLoop locale={locale} />
      <div class="mt-8 text-center"><a href={localizePath("/architecture/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.mechanism.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6">
      <SectionHeader label={t(locale, "conversion.home.live.label")} title={t(locale, "conversion.home.live.title")} description={t(locale, "conversion.home.live.body")} />
      {liveGoal && (
        <div class="group relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel transition-all hover:border-border-strong hover:shadow-panel" data-aos="fade-up">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
          <div class="relative flex items-start justify-between gap-4">
            <div>
              <p class="inline-flex items-center gap-2 text-2xs font-semibold uppercase tracking-widest text-primary"><span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>{t(locale, "conversion.home.live.current")}</p>
              <h3 class="mt-3 text-lg font-semibold leading-tight text-foreground-strong">{liveGoal.display_title ?? liveGoal.name}</h3>
              <p class="mt-2 inline-flex items-center rounded-md bg-panel-raised px-2 py-1 text-2xs font-medium text-muted-foreground border border-border">{t(locale, `live.status.${liveGoal.goal_status}`)}</p>
            </div>
            <span class="hidden sm:flex h-10 w-10 items-center justify-center rounded-md bg-success-soft text-success"><i class="bx bx-pulse icon-xl" aria-hidden="true"></i></span>
          </div>
        </div>
      )}
      <div class="mt-8 text-center"><a href={localizePath("/live/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.live.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute bottom-0 start-0 z-0 hidden w-56 h-72 opacity-40 lg:block">
      <JourneySignature variant="corner" gradientId="home-path-grad" />
    </div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.path.label")} title={t(locale, "conversion.home.path.title")} description={t(locale, "conversion.home.path.body")} />
      <div class="relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel sm:p-8" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
        <div class="relative grid gap-6 lg:grid-cols-5 lg:items-center">
          <div class="lg:col-span-3">
            <ol class="flex items-center gap-2 sm:gap-3">
              <li class="flex items-center gap-2 text-xs font-medium text-foreground-strong"><span class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground text-2xs font-bold">1</span> {t(locale, "conversion.home.path.step1") ?? "Identify"}</li>
              <span class="h-px flex-1 bg-gradient-to-r from-primary via-accent to-border opacity-60"></span>
              <li class="flex items-center gap-2 text-xs font-medium text-foreground-strong"><span class="flex h-7 w-7 items-center justify-center rounded-md bg-accent text-white text-2xs font-bold">2</span> Brief</li>
              <span class="h-px flex-1 bg-gradient-to-r from-accent via-purple to-border opacity-60"></span>
              <li class="flex items-center gap-2 text-xs font-medium text-foreground-strong"><span class="flex h-7 w-7 items-center justify-center rounded-md border border-border bg-panel-raised text-muted-foreground text-2xs font-bold">3</span> Build</li>
            </ol>
            <p class="mt-4 text-xs leading-relaxed text-muted-foreground">{t(locale, "conversion.home.path.detail") ?? "One workflow, one evidence-backed system. We test it against your current way of working before it ships."}</p>
          </div>
          <div class="lg:col-span-2 flex flex-col gap-3 lg:items-end">
            <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="inline-flex h-11 w-full items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110 lg:w-auto">{t(locale, "cta.bookDiscoveryCall")}</button>
            <a href={localizePath("/services/", locale)} class="inline-flex h-10 w-full items-center justify-center gap-1 rounded-md border border-border bg-panel-raised px-5 text-xs font-semibold text-foreground transition-all hover:border-border-strong hover:bg-panel lg:w-auto">{t(locale, "conversion.home.path.secondary")}<i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.brief.label")} title={t(locale, "conversion.home.brief.title")} description={t(locale, "conversion.home.brief.body")} />
      <div class="relative overflow-hidden rounded-xl border border-border bg-panel shadow-panel" data-aos="fade-up">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-primary to-transparent opacity-80" aria-hidden="true"></div>
        <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
        <div class="absolute end-0 top-0 z-0 hidden w-56 h-72 opacity-20 lg:block">
          <JourneySignature variant="corner" gradientId="home-brief-grad" glow={false} />
        </div>
        <div class="relative grid lg:grid-cols-5">
          <div class="p-6 sm:p-8 lg:col-span-3">
            <p class="text-2xs font-semibold uppercase tracking-widest text-primary mb-3">{t(locale, "conversion.home.brief.previewLabel") ?? "Included in your Agent Brief"}</p>
            <ul class="grid gap-3 sm:grid-cols-2">
              <li class="flex gap-3 rounded-md border border-border bg-panel-raised p-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary-soft text-primary"><i class="bx bx-bullseye icon-md" aria-hidden="true"></i></span><div><p class="text-xs font-semibold text-foreground-strong">Outcome & scope</p><p class="text-2xs leading-relaxed text-muted-foreground">What success looks like</p></div></li>
              <li class="flex gap-3 rounded-md border border-border bg-panel-raised p-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-transfer icon-md" aria-hidden="true"></i></span><div><p class="text-xs font-semibold text-foreground-strong">Inputs → Outputs</p><p class="text-2xs leading-relaxed text-muted-foreground">Data in, artifact out</p></div></li>
              <li class="flex gap-3 rounded-md border border-border bg-panel-raised p-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-purple-soft text-purple"><i class="bx bx-layer icon-md" aria-hidden="true"></i></span><div><p class="text-xs font-semibold text-foreground-strong">Knowledge & tools</p><p class="text-2xs leading-relaxed text-muted-foreground">Systems & connections</p></div></li>
              <li class="flex gap-3 rounded-md border border-border bg-panel-raised p-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-warning-soft text-warning"><i class="bx bx-check-shield icon-md" aria-hidden="true"></i></span><div><p class="text-xs font-semibold text-foreground-strong">Rules & approvals</p><p class="text-2xs leading-relaxed text-muted-foreground">Human gates</p></div></li>
            </ul>
            <p class="mt-4 text-2xs leading-relaxed text-muted-foreground">{t(locale, "conversion.home.brief.footer") ?? "You keep the brief whether we build together or not, it is your workflow spec."}</p>
          </div>
          <div class="relative flex flex-col justify-center gap-3 border-t border-border bg-panel-deep/30 p-6 sm:p-8 lg:col-span-2 lg:border-t-0 lg:border-s">
            <p class="text-xs font-medium leading-relaxed text-muted-foreground">Map one workflow into a clear, reviewable spec before any building starts.</p>
            <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.bookDiscoveryCall")}</button>
            <a href={localizePath("/services/agent-brief/", locale)} class="inline-flex h-10 items-center justify-center gap-1 rounded-md border border-border bg-panel px-5 text-xs font-semibold text-foreground transition-all hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.home.brief.secondary")}<i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-x-0 top-0 z-0 aspect-[12/1] opacity-35">
      <JourneySignature variant="band" gradientId="home-founder-grad" />
    </div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <div class="relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel sm:p-8">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
        <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
        <div class="relative">
          <h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.home.founder.title")}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.founder.body", { years: FOUNDER.experienceYears, products: FOUNDER.productAttempts })}</p>
          <a href={localizePath("/founder/", locale)} class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.founder.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </section>

  {featuredNotes.length > 0 && (
    <section class="relative py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-6">
        <SectionHeader label={t(locale, "conversion.home.notes.label")} title={t(locale, "conversion.home.notes.title")} />
        <div class="grid gap-3 md:grid-cols-3" data-aos="fade-up">
          {featuredNotes.map((note) => note && (
            <a href={localizePath(`/notes/${note.data.permalink.replace(/^\/+|\/+$/g, "")}/`, locale)} class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-primary to-transparent opacity-70" aria-hidden="true"></div>
              <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-file icon-lg" aria-hidden="true"></i></div>
              <h3 class="text-sm font-semibold leading-snug text-foreground-strong group-hover:text-primary transition-colors">{note.data.title}</h3>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground line-clamp-3">{note.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-2xs font-semibold uppercase tracking-widest text-primary opacity-0 transition-opacity group-hover:opacity-100">{t(locale, "common.readMore")}<i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[52%] h-[28rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.home.final.title")}</h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.final.body")}</p>
      <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground transition-all hover:brightness-110 shadow-lg shadow-primary/20">{t(locale, "cta.bookDiscoveryCall")}</button>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>
