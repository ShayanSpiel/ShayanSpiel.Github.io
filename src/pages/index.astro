---
import HomepageHeroJourney from "../components/HomepageHeroJourney.astro";
import ToolGrid from "../components/home/ToolGrid.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import Page from "../layouts/Page.astro";
import { APPLY_PATH, AUTHOR, SITE } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";
import snapshot from "../data/live-goals.json";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;

const liveGoals = (snapshot as { goals: Array<{ name: string; display_title?: string; owner_id: string; goal_status: string; updated_at: string }> }).goals;
const liveGoal = liveGoals.find((goal) => ["director", "email", "outbound"].includes(goal.owner_id) && goal.goal_status === "active") ?? liveGoals[0];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Person", "@id": `${SITE.url}/#person`, name: AUTHOR.name, url: SITE.url, image: `${SITE.url}/assets/avatars/avatar.jpg`, jobTitle: AUTHOR.jobTitle, sameAs: AUTHOR.sameAs, worksFor: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name, url: SITE.url, description: t(locale, "schema.website.desc"), inLanguage: locale, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": `${SITE.url}/#software`, name: SITE.name, url: SITE.url, description: t(locale, "schema.software.desc"), applicationCategory: "BusinessApplication", operatingSystem: "Web", author: { "@id": `${SITE.url}/#person` }, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }] },
];

const workCards = [
  { key: "followups", icon: "bx-envelope", tile: "bg-primary-soft text-primary", gradient: "from-primary via-accent to-transparent" },
  { key: "dataentry", icon: "bx-data", tile: "bg-accent-soft text-accent", gradient: "from-accent via-purple to-transparent" },
  { key: "recurring", icon: "bx-refresh", tile: "bg-purple-soft text-purple", gradient: "from-purple via-warning to-transparent" },
  { key: "checks", icon: "bx-check-shield", tile: "bg-warning-soft text-warning", gradient: "from-warning via-primary to-transparent" },
];


const briefCards = [
  { key: "job", icon: "bx-bullseye", tile: "bg-primary-soft text-primary" },
  { key: "inputs", icon: "bx-transfer", tile: "bg-accent-soft text-accent" },
  { key: "tools", icon: "bx-layer", tile: "bg-purple-soft text-purple" },
  { key: "rules", icon: "bx-check-shield", tile: "bg-warning-soft text-warning" },
];

const icpCards = [
  { key: "recruitment", icon: "bx-group", tile: "bg-primary-soft text-primary" },
  { key: "accounting", icon: "bx-calculator", tile: "bg-accent-soft text-accent" },
  { key: "agencies", icon: "bx-briefcase-alt-2", tile: "bg-purple-soft text-purple" },
];
---

<Page title={t(locale, "conversion.home.pageTitle")} description={t(locale, "conversion.home.pageDesc")} image="/assets/og/home.png" locale={locale}>
  <section id="hero" class="relative flex min-h-[82vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[34rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-full glow-blob-accent opacity-10"></div>
    <!-- Homepage hero journey: an isolated five-anchor attention path leading to the CTA. It is independent from the Services rail and the gallery templates. -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <HomepageHeroJourney
        points={[[20, 28], [210, 220], [540, 135], [600, 390], [600, 545]]}
        viewBox="0 0 1200 700"
        preserveAspectRatio="none"
        faded
      />
    </div>
    <div class="relative z-[1] mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-primary">{t(locale, "conversion.home.hero.label")}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[0.95] tracking-tight text-foreground-strong sm:text-6xl">
        {t(locale, "conversion.home.hero.titleLead")}<br />
        <span class="text-primary">{t(locale, "conversion.home.hero.titleAccent")}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.hero.body")}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizePath(APPLY_PATH, locale)} data-cta-location="home_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110 hover:-translate-y-px">{t(locale, "cta.apply")}</a>
        <a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium transition-all hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.home.hero.secondary")}</a>
      </div>
      <p class="mt-3 text-2xs tracking-wide text-muted-foreground">{t(locale, "conversion.home.hero.proof")}</p>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.work.label")} title={t(locale, "conversion.home.work.title")} description={t(locale, "conversion.home.work.body")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {workCards.map((card) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80", card.gradient]} aria-hidden="true"></div>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md", card.tile]}><i class:list={["bx", card.icon, "icon-xl"]} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, `conversion.home.work.${card.key}.title`)}</h3>
            <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, `conversion.home.work.${card.key}.desc`)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.mechanism.label")} title={t(locale, "conversion.home.mechanism.title")} description={t(locale, "conversion.home.mechanism.body")} />
      <ToolGrid locale={locale} />
      <div class="mt-8 text-center"><a href={localizePath("/features/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.mechanism.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.path.label")} title={t(locale, "conversion.home.path.title")} description={t(locale, "conversion.home.path.body")} />
      <div class="grid gap-3 sm:grid-cols-3" data-aos="fade-up">
        {[1, 2, 3].map((n, i) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80", i === 0 ? "from-primary via-accent to-transparent" : i === 1 ? "from-accent via-purple to-transparent" : "from-purple via-warning to-transparent"]} aria-hidden="true"></div>
            <div class="mb-3 flex items-center gap-2">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-primary text-primary-foreground text-2xs font-bold">{n}</span>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-foreground-strong">{t(locale, `conversion.home.path.step${n}.title`)}</h3>
            </div>
            <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, `conversion.home.path.step${n}.desc`)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.services.label")} title={t(locale, "conversion.home.services.title")} description={t(locale, "conversion.home.services.body")} />
      <div class="grid gap-3 md:grid-cols-2" data-aos="fade-up">
        <!-- Owner directive: AI Workers leads, DeSlopping second (matches Services page). -->
        <div class="rounded-lg border border-border bg-panel p-6 shadow-panel">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-success-soft"><i class="bx bx-trending-up text-success icon-xl"></i></div>
          <h3 class="text-base font-semibold text-foreground-strong">{t(locale, "conversion.pricing.help.workers.t")}</h3>
          <p class="mt-2 text-sm font-medium text-foreground">{t(locale, "conversion.pricing.help.workers.d1")}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{t(locale, "conversion.pricing.help.workers.d2")}</p>
        </div>
        <div class="rounded-lg border border-border bg-panel p-6 shadow-panel">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-destructive-soft"><i class="bx bx-error text-destructive icon-xl"></i></div>
          <h3 class="text-base font-semibold text-foreground-strong">{t(locale, "conversion.pricing.help.deslop.t")}</h3>
          <p class="mt-2 text-sm font-medium text-foreground">{t(locale, "conversion.pricing.help.deslop.d1")}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{t(locale, "conversion.pricing.help.deslop.d2")}</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row" data-aos="fade-up">
        <a href={localizePath(APPLY_PATH, locale)} data-cta-location="home_services" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a>
        <a href={localizePath("/services/", locale)} class="inline-flex h-11 items-center justify-center gap-1 rounded-md border border-border bg-panel px-6 text-sm font-medium transition-all hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.pricing.services.link")}<i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i></a>
      </div>
      <p class="mt-4 text-center text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6">
      <SectionHeader label={t(locale, "conversion.home.live.label")} title={t(locale, "conversion.home.live.title")} description={t(locale, "conversion.home.live.body")} />
      {liveGoal && (
        <div class="group relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel transition-all hover:border-border-strong hover:shadow-panel" data-aos="fade-up">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
          <div class="relative flex items-start justify-between gap-4">
            <div>
              <p class="inline-flex items-center gap-2 text-2xs font-semibold uppercase tracking-widest text-primary"><span class="h-1.5 w-1.5 rounded-full bg-success" aria-hidden="true"></span>{t(locale, "conversion.home.live.current")}</p>
              <h3 class="mt-3 text-lg font-semibold leading-tight text-foreground-strong">{liveGoal.display_title ?? liveGoal.name}</h3>
              <p class="mt-2 inline-flex items-center rounded-md bg-panel-raised px-2 py-1 text-2xs font-medium text-muted-foreground border border-border">{t(locale, `live.status.${liveGoal.goal_status}`)}</p>
            </div>
            <span class="hidden sm:flex h-10 w-10 items-center justify-center rounded-md bg-success-soft text-success"><i class="bx bx-pulse icon-xl" aria-hidden="true"></i></span>
          </div>
        </div>
      )}
      <div class="mt-8 text-center"><a href={localizePath("/live/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.live.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <div class="relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel sm:p-8">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
        <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
        <div class="relative">
          <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-primary">{t(locale, "conversion.home.founder.label")}</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.home.founder.title")}</h2>
          <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.founder.body")}</p>
          <a href={localizePath("/founder/", locale)} class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "conversion.home.founder.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "conversion.home.icp.label")} title={t(locale, "conversion.home.icp.title")} description={t(locale, "conversion.home.icp.body")} />
      <div class="grid gap-3 md:grid-cols-3" data-aos="fade-up">
        {icpCards.map((card) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md", card.tile]}><i class:list={["bx", card.icon, "icon-xl"]} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, `conversion.home.icp.${card.key}.title`)}</h3>
            <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, `conversion.home.icp.${card.key}.desc`)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[52%] h-[28rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-[0.18em] text-primary">{t(locale, "conversion.home.final.label")}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.home.final.title")}</h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.final.body")}</p>
      <a href={localizePath(APPLY_PATH, locale)} data-cta-location="home_final" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>
