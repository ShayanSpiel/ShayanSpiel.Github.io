---
import BusinessBrain from "../components/home/BusinessBrain.astro";
import WorkflowHandoff from "../components/home/WorkflowHandoff.astro";
import CompactRoi from "../components/home/CompactRoi.astro";
import TrustProof from "../components/home/TrustProof.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import Page from "../layouts/Page.astro";
import { APPLY_PATH, SITE } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "SoftwareApplication", "@id": `${SITE.url}/#software`, name: SITE.name, url: SITE.url, description: t(locale, "schema.software.desc"), applicationCategory: "BusinessApplication", operatingSystem: "Web", author: { "@id": `${SITE.url}/#person` }, publisher: { "@id": `${SITE.url}/#organization` } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }] },
];
const btnPrimary = "inline-flex h-11 items-center justify-center gap-2 rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-px hover:brightness-110 active:brightness-95";
const btnSecondary = "inline-flex h-11 items-center justify-center gap-2 rounded-md border border-border bg-panel px-6 text-sm font-medium transition-all hover:border-border-strong hover:bg-panel-raised";
---

<Page title={t(locale, "conversion.home.pageTitle")} description={t(locale, "conversion.home.pageDesc")} image="/assets/og/home.png" locale={locale}>
  <section id="hero" class="relative flex min-h-[82vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[34rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="relative z-[1] mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="inline-flex w-fit items-center gap-1.5 rounded-md bg-primary-soft px-3 py-1 font-mono text-2xs font-bold uppercase tracking-widest text-primary">
        <i class="bx bx-target-lock icon-sm" aria-hidden="true"></i>
        {t(locale, "conversion.home.hero.label")}
      </p>
      <h1 class="mt-5 text-4xl font-extrabold leading-[0.95] tracking-tight text-foreground-strong sm:text-6xl">
        {t(locale, "conversion.home.hero.titleLead")}<br />
        <span class="text-primary" set:html={t(locale, "conversion.home.hero.titleAccent")} />
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.hero.body")}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizePath(APPLY_PATH, locale)} data-cta-location="home_hero" class={btnPrimary}>
          <i class="bx bx-pointer icon-base" aria-hidden="true"></i>{t(locale, "cta.apply")}
        </a>
        <a href={localizePath("/live/", locale)} class={btnSecondary}>
          <i class="bx bx-pulse icon-base text-primary" aria-hidden="true"></i>{t(locale, "conversion.home.hero.secondary")}
        </a>
      </div>
      <p class="mt-3 text-2xs tracking-wide text-muted-foreground">{t(locale, "conversion.home.hero.proof")}</p>
    </div>
  </section>

  <section id="business-brain" class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "conversion.home.work.label")}
        title={t(locale, "conversion.home.work.title")}
        description={t(locale, "conversion.home.work.body")}
      />
      <BusinessBrain locale={locale} />
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row" data-aos="fade-up">
        <a href={localizePath(APPLY_PATH, locale)} data-cta-location="home_business_brain" class={btnPrimary}>
          <i class="bx bx-pointer icon-base" aria-hidden="true"></i>{t(locale, "conversion.home.mechanism.apply")}
        </a>
        {/* /learn/ ships as its own publish; button restored when it goes live */}
      </div>
    </div>
  </section>

  <section id="offer" class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "conversion.home.path.label")}
        title={t(locale, "conversion.home.path.title")}
        description={t(locale, "conversion.home.path.body")}
        animate={false}
      />
      <WorkflowHandoff locale={locale} />

      <div class="relative mx-auto mt-16 max-w-4xl text-center">
        <p class="text-2xs font-bold uppercase tracking-[0.14em] text-success"><i class="bx bx-check-shield me-1 icon-sm" aria-hidden="true"></i>{t(locale, "conversion.home.roi.eyebrow")}</p>
        <h3 class="mx-auto mt-3 max-w-4xl text-3xl font-extrabold leading-tight tracking-tight text-foreground-strong sm:text-5xl">
          {t(locale, "conversion.home.roi.titleLead")}<br /><span class="text-primary" set:html={t(locale, "conversion.home.roi.titleAccent")} />
        </h3>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.roi.body")}</p>
        <h4 class="mt-12 text-3xl font-extrabold tracking-tight text-foreground-strong sm:text-4xl" set:html={t(locale, "conversion.home.roi.question")} />
      </div>
      <div id="roi-calculator" class="mx-auto mt-7 max-w-5xl">
        <CompactRoi locale={locale} />
      </div>
      <TrustProof locale={locale} />
    </div>
  </section>

  <section id="final-cta" class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid" aria-hidden="true"></div>
    <div class="absolute left-1/2 top-1/2 h-[26rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="inline-flex w-fit items-center gap-1.5 rounded-md bg-primary-soft px-3 py-1 font-mono text-2xs font-bold uppercase tracking-widest text-primary">
        {t(locale, "conversion.home.final.label")}
      </p>
      <h2 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-foreground-strong sm:text-5xl" set:html={t(locale, "conversion.home.final.title")} />
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.home.final.body")}</p>
      <a href={localizePath(APPLY_PATH, locale)} data-cta-location="home_final" class={`${btnPrimary} mt-8 h-12 px-8`}>
        <i class="bx bx-pointer icon-base" aria-hidden="true"></i>{t(locale, "conversion.home.final.cta")}
      </a>
    </div>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>
