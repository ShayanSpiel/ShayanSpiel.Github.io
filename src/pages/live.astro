---
import ContactModal from "../components/ContactModal.astro";
import LiveTimeline, { type LiveGoal } from "../components/live/LiveTimeline.astro";
import LiveStatus, { type Heartbeat } from "../components/live/LiveStatus.astro";
import LiveStats, { type LiveTotals } from "../components/live/LiveStats.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import OperatingLoop from "../components/architecture/OperatingLoop.astro";
import Page from "../layouts/Page.astro";
import { SITE } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";
import snapshot from "../data/live-goals.json";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const data = snapshot as unknown as { goals: LiveGoal[]; totals: LiveTotals; runtime_state?: { state?: "running" | "resting"; heartbeat?: Heartbeat | null; last_activity_at?: string | null; last_sync_at?: string } };
const state = data.runtime_state?.state ?? "resting";
const heartbeat = data.runtime_state?.heartbeat ?? null;
const metricLabel = (metric: string) => metric === "reply_rate" ? t(locale, "live.metric.replyRate") : metric;
const heartbeatText = (hb: Heartbeat) => {
  const operator = hb.operator === "ge" ? "≥" : hb.operator === "le" ? "≤" : hb.operator === "eq" ? "=" : hb.operator;
  const target = hb.metric === "reply_rate" && typeof hb.target === "number" ? `${Math.round(hb.target * 100)}%` : String(hb.target);
  return t(locale, "live.entry.metric", { metric: metricLabel(hb.metric), operator, target });
};
const lastActivityText = data.runtime_state?.last_activity_at
  ? t(locale, "live.state.lastActivity", { time: new Intl.DateTimeFormat(locale === "fa" ? "fa-IR-u-ca-gregory" : "en-US", { dateStyle: "medium", timeStyle: "short" }).format(new Date(data.runtime_state.last_activity_at)) })
  : "";
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "nav.live"), item: `${SITE.url}${localizePath("/live/", locale)}` },
  ],
};
const vocab = [
  { icon: "bx-bullseye", color: "primary", titleKey: "live.vocab.goal.title", descKey: "live.vocab.goal.desc" },
  { icon: "bx-group", color: "accent", titleKey: "live.vocab.department.title", descKey: "live.vocab.department.desc" },
  { icon: "bx-run", color: "purple", titleKey: "live.vocab.run.title", descKey: "live.vocab.run.desc" },
  { icon: "bx-slider", color: "warning", titleKey: "live.vocab.improvement.title", descKey: "live.vocab.improvement.desc" },
];
const howTo = [
  { icon: "bx-bullseye", color: "primary", titleKey: "live.howto.goal.title", descKey: "live.howto.goal.desc" },
  { icon: "bx-revision", color: "accent", titleKey: "live.howto.run.title", descKey: "live.howto.run.desc" },
  { icon: "bx-slider", color: "purple", titleKey: "live.howto.improvement.title", descKey: "live.howto.improvement.desc" },
  { icon: "bx-file", color: "success", titleKey: "live.howto.evidence.title", descKey: "live.howto.evidence.desc" },
];
---

<Page title={t(locale, "conversion.live.pageTitle")} description={t(locale, "conversion.live.pageDesc")} locale={locale}>
  <section id="live-hero" class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[36%] h-[30rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[60%] top-[32%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.live.hero.label")}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.live.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.live.hero.titleAccent")}</span></h1>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.live.hero.body")}</p>
      <div class="mx-auto mt-8 max-w-3xl text-start">
        <LiveStatus locale={locale} state={state} heartbeat={heartbeat} heartbeatText={heartbeatText} lastActivityText={lastActivityText} />
      </div>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={localizePath("/services/agent-brief/#request", locale)} data-open-contact-modal data-cta-location="live_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.requestAgentBrief")}</a>
        <a href={localizePath("/architecture/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.live.hero.secondary")}</a>
      </div>
    </div>
  </section>

  <section id="live-model" class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "live.hero.loop.title")} title={t(locale, "live.howto.title")} description={t(locale, "live.howto.desc")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {vocab.map((item) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-" + item.color + " to-transparent"]}></div>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-" + item.color + "-soft"]}><i class:list={["bx", item.icon, "text-" + item.color, "icon-xl"]} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, item.titleKey)}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, item.descKey)}</p>
          </article>
        ))}
      </div>
      <div class="mt-8"><OperatingLoop locale={locale} /></div>
      <p class="mx-auto mt-5 max-w-2xl text-center text-xs leading-relaxed text-muted-foreground">{t(locale, "live.hero.evidence")}</p>
    </div>
  </section>

  <section id="live-stats" class="relative py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "live.stats.label")} title={t(locale, "live.stats.title")} /><LiveStats locale={locale} totals={data.totals} /></div>
  </section>

  <section id="live-howto" class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "live.howto.label")} title={t(locale, "live.howto.title")} description={t(locale, "live.howto.desc")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {howTo.map((item, index) => (
          <article class="relative rounded-lg border border-border bg-panel p-5 shadow-panel">
            <span class="absolute end-4 top-4 font-mono text-2xs text-foreground-muted">0{index + 1}</span>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-" + item.color + "-soft"]}><i class:list={["bx", item.icon, "text-" + item.color, "icon-xl"]} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, item.titleKey)}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, item.descKey)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="live-timeline" class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="absolute inset-0 opacity-[0.025] hero-grid"></div>
    <div class="relative mx-auto max-w-4xl px-6">
      <LiveTimeline locale={locale} goals={data.goals} />
    </div>
  </section>

  <section id="live-cta" class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.live.final.title")}</h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.live.final.body")}</p>
      <a href={localizePath("/services/agent-brief/#request", locale)} data-open-contact-modal data-cta-location="live_final" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.requestAgentBrief")}</a>
    </div>
  </section>

  <ContactModal locale={locale} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script is:inline define:vars={{
    runningLabel: t(locale, "live.state.running"),
    restingLabel: t(locale, "live.state.resting"),
    restingText: t(locale, "live.heartbeat.resting"),
    replyRateLabel: t(locale, "live.metric.replyRate"),
    metricTemplate: t(locale, "live.entry.metric"),
    activityTemplate: t(locale, "live.state.lastActivity"),
    localeCode: locale === "fa" ? "fa-IR-u-ca-gregory" : "en-US",
  }}>
    (function () {
      var root = document.getElementById('live-status-root');
      if (!root) return;
      var label = document.getElementById('live-status-state-label-text');
      var icon = document.getElementById('live-status-state-icon');
      var tile = root.querySelector('.live-hb-tile');
      var goal = root.querySelector('[data-heartbeat-goal]');
      var metric = root.querySelector('[data-heartbeat-metric]');
      var stageWrap = document.getElementById('live-status-stage');
      var stage = root.querySelector('[data-heartbeat-stage]');
      var resting = document.getElementById('live-status-resting');
      var activity = document.getElementById('live-status-activity');
      function metricText(heartbeat) {
        if (!heartbeat) return '';
        var operator = heartbeat.operator === 'ge' ? '≥' : heartbeat.operator === 'le' ? '≤' : heartbeat.operator === 'eq' ? '=' : heartbeat.operator;
        var metricName = heartbeat.metric === 'reply_rate' ? replyRateLabel : heartbeat.metric;
        var target = heartbeat.metric === 'reply_rate' && typeof heartbeat.target === 'number' ? Math.round(heartbeat.target * 100) + '%' : String(heartbeat.target);
        return metricTemplate.replace('{metric}', metricName).replace('{operator}', operator).replace('{target}', target);
      }
      function apply(data) {
        var running = data && data.state === 'running' && data.heartbeat;
        var heartbeat = running ? data.heartbeat : null;
        root.setAttribute('data-live-state', running ? 'running' : 'resting');
        root.setAttribute('data-heartbeat-state', running ? 'running' : 'resting');
        root.classList.toggle('live-state-running', !!running);
        root.classList.toggle('live-state-resting', !running);
        if (label) label.textContent = running ? runningLabel : restingLabel;
        if (icon) icon.className = 'bx ' + (running ? 'bx-run text-primary' : 'bx-time-five text-muted-foreground') + ' icon-sm';
        if (tile) {
          tile.classList.toggle('bg-success-soft', !!running);
          tile.classList.toggle('text-success', !!running);
          tile.classList.toggle('bg-destructive-soft', !running);
          tile.classList.toggle('text-destructive', !running);
        }
        if (goal) goal.textContent = heartbeat ? heartbeat.goal_name : '';
        if (metric) metric.textContent = metricText(heartbeat);
        if (stage) stage.textContent = heartbeat && heartbeat.stage ? heartbeat.stage : '';
        if (stageWrap) stageWrap.classList.toggle('hidden', !(heartbeat && heartbeat.stage));
        if (resting) {
          resting.textContent = restingText;
          resting.classList.toggle('hidden', !!running);
        }
        if (activity) {
          var activityText = '';
          if (data && data.last_activity_at) {
            var formatted = new Intl.DateTimeFormat(localeCode, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(data.last_activity_at));
            activityText = activityTemplate.replace('{time}', formatted);
          }
          activity.textContent = activityText;
          activity.classList.toggle('hidden', !activityText);
        }
      }
      function poll() { fetch('/live-state.json?t=' + Date.now(), { cache: 'no-store' }).then(function (response) { if (!response.ok) throw new Error('status'); return response.json(); }).then(apply).catch(function () {}); }
      poll();
      window.setInterval(poll, 30000);
    })();
  </script>
</Page>
