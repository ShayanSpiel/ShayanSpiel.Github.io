---
import LiveTimeline, { type LiveGoal } from "../components/live/LiveTimeline.astro";
import LiveStatus, { type Heartbeat, type Northstar } from "../components/live/LiveStatus.astro";
import LiveStats, { type LiveTotals } from "../components/live/LiveStats.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import OperatingLoop from "../components/architecture/OperatingLoop.astro";
import Page from "../layouts/Page.astro";
import { SITE, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";
import snapshot from "../data/live-goals.json";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const data = snapshot as unknown as {
  goals: LiveGoal[];
  totals: LiveTotals;
  northstar?: Northstar | null;
  runtime_state?: { state?: "running" | "resting"; heartbeat?: Heartbeat | null; last_activity_at?: string | null; last_sync_at?: string };
};
const state = data.runtime_state?.state ?? "resting";
const heartbeat = data.runtime_state?.heartbeat ?? null;
const northstar = data.northstar ?? null;
const metricLabel = (metric: string) =>
  metric === "reply_rate" ? t(locale, "live.metric.replyRate") :
  metric === "booked_calls" ? t(locale, "live.metric.bookedCalls") :
  metric === "published_items" ? t(locale, "live.metric.publishedItems") : metric;
const formatTarget = (metric: string, target: number | boolean | string) =>
  metric === "reply_rate" && typeof target === "number" ? `${Math.round(target * 100)}%` :
  typeof target === "boolean" ? t(locale, target ? "live.target.yes" : "live.target.no") :
  String(target);
const metricText = (entry: { metric: string; operator: string; target: number | boolean | string }) => {
  const operator = entry.operator === "ge" ? "≥" : entry.operator === "le" ? "≤" : entry.operator === "eq" ? "=" : entry.operator;
  const target = formatTarget(entry.metric, entry.target);
  return typeof entry.target === "boolean"
    ? `${metricLabel(entry.metric)} ${target}`
    : t(locale, "live.entry.metric", { metric: metricLabel(entry.metric), operator, target });
};
const heartbeatText = (hb: Heartbeat) => metricText(hb);
const northstarText = (n: Northstar) => metricText(n);
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "nav.live"), item: `${SITE.url}${localizePath("/live/", locale)}` },
  ],
};
const vocab = [
  { icon: "bx-bullseye", tile: "bg-primary-soft text-primary", gradient: "from-primary via-accent to-transparent", titleKey: "live.vocab.goal.title", descKey: "live.vocab.goal.desc" },
  { icon: "bx-group", tile: "bg-accent-soft text-accent", gradient: "from-accent via-purple to-transparent", titleKey: "live.vocab.department.title", descKey: "live.vocab.department.desc" },
  { icon: "bx-run", tile: "bg-purple-soft text-purple", gradient: "from-purple via-warning to-transparent", titleKey: "live.vocab.run.title", descKey: "live.vocab.run.desc" },
  { icon: "bx-slider", tile: "bg-warning-soft text-warning", gradient: "from-warning via-primary to-transparent", titleKey: "live.vocab.improvement.title", descKey: "live.vocab.improvement.desc" },
];
const howTo = [
  { icon: "bx-bullseye", tile: "bg-primary-soft text-primary", gradient: "from-primary via-accent to-transparent", titleKey: "live.howto.goal.title", descKey: "live.howto.goal.desc" },
  { icon: "bx-revision", tile: "bg-accent-soft text-accent", gradient: "from-accent via-purple to-transparent", titleKey: "live.howto.run.title", descKey: "live.howto.run.desc" },
  { icon: "bx-slider", tile: "bg-purple-soft text-purple", gradient: "from-purple via-success to-transparent", titleKey: "live.howto.improvement.title", descKey: "live.howto.improvement.desc" },
  { icon: "bx-file", tile: "bg-success-soft text-success", gradient: "from-success via-accent to-transparent", titleKey: "live.howto.evidence.title", descKey: "live.howto.evidence.desc" },
];
---

<Page title={t(locale, "conversion.live.pageTitle")} description={t(locale, "conversion.live.pageDesc")} locale={locale}>
  <section id="live-hero" class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[36%] h-[30rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[60%] top-[32%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.live.hero.label")}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.live.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.live.hero.titleAccent")}</span></h1>
      <p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.live.hero.body")}</p>
      <div class="mx-auto mt-8 max-w-3xl text-start">
        <LiveStatus locale={locale} state={state} heartbeat={heartbeat} northstar={northstar} heartbeatText={heartbeatText} northstarText={northstarText} />
      </div>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="live_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.bookDiscoveryCall")}</button>
        <a href={localizePath("/features/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.live.hero.secondary")}</a>
      </div>
    </div>
  </section>

  <section id="live-model" class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "live.hero.loop.title")} title={t(locale, "live.howto.title")} description={t(locale, "live.howto.desc")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {vocab.map((item) => (
          <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80", item.gradient]} aria-hidden="true"></div>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md", item.tile]}><i class:list={["bx", item.icon, "icon-xl"]} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, item.titleKey)}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, item.descKey)}</p>
          </article>
        ))}
      </div>
      <div class="mt-8"><OperatingLoop locale={locale} /></div>
      <p class="mx-auto mt-5 max-w-2xl text-center text-xs leading-relaxed text-muted-foreground">{t(locale, "live.hero.evidence")}</p>
    </div>
  </section>

  <section id="live-stats" class="relative py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "live.stats.label")} title={t(locale, "live.stats.title")} /><LiveStats locale={locale} totals={data.totals} /></div>
  </section>

  <section id="live-howto" class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "live.howto.label")} title={t(locale, "live.howto.title")} description={t(locale, "live.howto.desc")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {howTo.map((item, index) => (
          <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel">
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80", item.gradient]} aria-hidden="true"></div>
            <span class="absolute end-4 top-4 text-2xs text-foreground-muted">0{index + 1}</span>
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md", item.tile]}><i class:list={["bx", item.icon, "icon-xl"]} aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, item.titleKey)}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, item.descKey)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="live-timeline" class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="absolute inset-0 opacity-[0.025] hero-grid"></div>
    <div class="relative mx-auto max-w-4xl px-6">
      <LiveTimeline locale={locale} goals={data.goals} />
    </div>
  </section>

  <section id="live-cta" class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.live.final.title")}</h2>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.live.final.body")}</p>
      <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="live_final" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.bookDiscoveryCall")}</button>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script is:inline define:vars={{
    restingText: t(locale, "live.heartbeat.resting"),
    replyRateLabel: t(locale, "live.metric.replyRate"),
    bookedCallsLabel: t(locale, "live.metric.bookedCalls"),
    publishedItemsLabel: t(locale, "live.metric.publishedItems"),
    systemImprovementLabel: t(locale, "live.heartbeat.systemImprovement"),
    businessWorkLabel: t(locale, "live.heartbeat.businessWork"),
    metricTemplate: t(locale, "live.entry.metric"),
    localeCode: locale === "fa" ? "fa-IR-u-ca-gregory" : "en-US",
  }}>
    (function () {
      var root = document.getElementById('live-status-root');
      if (!root) return;
      var tile = root.querySelector('.live-hb-tile');
      var goal = root.querySelector('[data-heartbeat-goal]');
      var metric = root.querySelector('[data-heartbeat-metric]');
      var resting = document.getElementById('live-status-resting');
      var userFacing = { reply_rate: replyRateLabel, booked_calls: bookedCallsLabel, published_items: publishedItemsLabel };
      function metricText(heartbeat) {
        if (!heartbeat) return '';
        var operator = heartbeat.operator === 'ge' ? '≥' : heartbeat.operator === 'le' ? '≤' : heartbeat.operator === 'eq' ? '=' : heartbeat.operator;
        var metricName = userFacing[heartbeat.metric] || heartbeat.metric;
        var target = heartbeat.metric === 'reply_rate' && typeof heartbeat.target === 'number' ? Math.round(heartbeat.target * 100) + '%' : String(heartbeat.target);
        return metricTemplate.replace('{metric}', metricName).replace('{operator}', operator).replace('{target}', target);
      }
      function titleFor(heartbeat) {
        if (!heartbeat) return '';
        var copy = localeCode === 'fa-IR-u-ca-gregory' ? (heartbeat.display_title_fa || heartbeat.display_title) : heartbeat.display_title;
        if (copy) return copy;
        return heartbeat.owner_id === 'system-improvement' ? systemImprovementLabel : businessWorkLabel;
      }
      function bodyFor(heartbeat) {
        if (!heartbeat) return '';
        if (userFacing[heartbeat.metric]) return metricText(heartbeat);
        var copy = localeCode === 'fa-IR-u-ca-gregory' ? (heartbeat.business_value_fa || heartbeat.business_value) : heartbeat.business_value;
        return copy || '';
      }
      function apply(data) {
        var running = data && data.state === 'running' && data.heartbeat;
        var heartbeat = running ? data.heartbeat : null;
        root.setAttribute('data-live-state', running ? 'running' : 'resting');
        root.setAttribute('data-heartbeat-state', running ? 'running' : 'resting');
        root.classList.toggle('live-state-running', !!running);
        root.classList.toggle('live-state-resting', !running);
        if (tile) {
          tile.classList.toggle('bg-success-soft', !!running);
          tile.classList.toggle('text-success', !!running);
          tile.classList.toggle('bg-destructive-soft', !running);
          tile.classList.toggle('text-destructive', !running);
        }
        if (goal) goal.textContent = heartbeat ? titleFor(heartbeat) : '';
        if (metric) {
          var body = heartbeat ? bodyFor(heartbeat) : '';
          metric.textContent = body;
          metric.classList.toggle('hidden', !body);
        }
        if (resting) {
          resting.textContent = restingText;
          resting.classList.toggle('hidden', !!running);
        }
      }
      function poll() { fetch('/live-state.json?t=' + Date.now(), { cache: 'no-store' }).then(function (response) { if (!response.ok) throw new Error('status'); return response.json(); }).then(apply).catch(function () {}); }
      poll();
      window.setInterval(poll, 30000);
    })();
  </script>
</Page>
