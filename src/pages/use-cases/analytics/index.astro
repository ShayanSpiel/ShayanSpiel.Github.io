---
import FeatureHero from "../../../components/features/FeatureHero.astro";
import FeatureCTA from "../../../components/features/FeatureCTA.astro";
import SectionHeader from "../../../components/sections/SectionHeader.astro";
import Page from "../../../layouts/Page.astro";
import { SITE } from "../../../config";
import { localizePath } from "../../../i18n";
import { type Locale, t } from "../../../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const steps = t(locale, "useCases.analytics.how.steps").split(" · ");
const livePoints = t(locale, "useCases.analytics.live.points").split(" · ");
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "nav.usecases"), item: `${SITE.url}${localizePath("/use-cases/", locale)}` },
    { "@type": "ListItem", position: 3, name: t(locale, "nav.analytics"), item: `${SITE.url}${localizePath("/use-cases/analytics/", locale)}` },
  ],
};
---

<Page title={t(locale, "useCases.analytics.pageTitle")} description={t(locale, "useCases.analytics.pageDesc")} image="/assets/og/use-cases.png" locale={locale}>
  <FeatureHero
    locale={locale}
    breadcrumbs={[
      { label: t(locale, "nav.usecases"), href: "/use-cases/" },
      { label: t(locale, "nav.analytics") },
    ]}
    label={t(locale, "useCases.analytics.hero.label")}
    title={t(locale, "useCases.analytics.hero.title")}
    description={t(locale, "useCases.analytics.hero.desc")}
    cta={{ label: t(locale, "cta.bookDiscoveryCall") }}
  />

  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "useCases.analytics.how.label")} title={t(locale, "useCases.analytics.how.title")} description={t(locale, "useCases.analytics.how.desc")} />
      <div class="design-canvas relative overflow-hidden rounded-xl border border-border bg-panel p-5 shadow-panel sm:p-8" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
        <ol class="design-rail relative mx-auto max-w-2xl">
          {steps.map((step, index) => (
            <li class="relative flex gap-4 py-3">
              <div class:list={["relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-md border bg-panel-raised", index === 0 ? "border-accent text-accent shadow-[0_0_20px_var(--accent-soft)]" : "border-border text-muted-foreground"]}>
                <span class="text-xs font-bold">{index + 1}</span>
              </div>
              <div class="pt-1">
                <p class="text-xs leading-relaxed text-muted-foreground">{step}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.analytics.workflows.title")} description={t(locale, "useCases.analytics.workflows.desc")} />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-purple to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-data icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.workflows.tracking.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.workflows.tracking.desc")}</p>
        </article>
        <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-purple via-info to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-purple-soft text-purple"><i class="bx bx-purchase-tag icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.workflows.conversions.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.workflows.conversions.desc")}</p>
        </article>
        <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-info via-primary to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-info-soft text-info"><i class="bx bx-calendar icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.workflows.reporting.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.workflows.reporting.desc")}</p>
        </article>
        <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-success-soft text-success"><i class="bx bx-line-chart icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.workflows.funnel.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.workflows.funnel.desc")}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.analytics.agents.title")} description={t(locale, "useCases.analytics.agents.desc")} />
      <div class="grid gap-3 md:grid-cols-2" data-aos="fade-up">
        <article class="flex gap-4 rounded-lg border border-accent/30 bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-slider icon-xl" aria-hidden="true"></i></div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.agents.operator.title")}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.agents.operator.desc")}</p>
          </div>
        </article>
        <article class="flex gap-4 rounded-lg border border-accent/30 bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-bar-chart-alt-2 icon-xl" aria-hidden="true"></i></div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.agents.analyst.title")}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.agents.analyst.desc")}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.analytics.skills.title")} description={t(locale, "useCases.analytics.skills.desc")} />
      <div class="grid gap-3 md:grid-cols-2" data-aos="fade-up">
        <article class="flex gap-4 rounded-lg border border-accent/30 bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-data icon-xl" aria-hidden="true"></i></div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.skills.analytics.title")}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.skills.analytics.desc")}</p>
          </div>
        </article>
        <article class="flex gap-4 rounded-lg border border-accent/30 bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-globe icon-xl" aria-hidden="true"></i></div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.skills.seo.title")}</h3>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.skills.seo.desc")}</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="relative py-20 sm:py-24">
    <div class="mx-auto max-w-4xl px-6">
      <SectionHeader title={t(locale, "useCases.analytics.connections.title")} description={t(locale, "useCases.analytics.connections.desc")} />
      <div class="design-canvas relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel sm:p-10" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
        <div class="relative mx-auto flex max-w-4xl gap-4">
          <span class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-muted-foreground/10 text-muted-foreground"><i class="bx bx-link icon-xl" aria-hidden="true"></i></span>
          <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.connections.body")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader title={t(locale, "useCases.analytics.artifacts.title")} description={t(locale, "useCases.analytics.artifacts.desc")} />
      <div class="grid gap-3 sm:grid-cols-3" data-aos="fade-up">
        <article class="rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-list-check icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.artifacts.registry.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.artifacts.registry.desc")}</p>
        </article>
        <article class="rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-success-soft text-success"><i class="bx bx-file icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.artifacts.report.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.artifacts.report.desc")}</p>
        </article>
        <article class="rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-purple-soft text-purple"><i class="bx bx-trending-up icon-xl" aria-hidden="true"></i></div>
          <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "useCases.analytics.artifacts.attribution.title")}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, "useCases.analytics.artifacts.attribution.desc")}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-0 bg-panel-deep/35"></div>
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "useCases.analytics.live.label")} title={t(locale, "useCases.analytics.live.title")} description={t(locale, "useCases.analytics.live.desc")} />
      <div class="design-canvas relative overflow-hidden rounded-xl border border-border bg-panel p-5 shadow-panel sm:p-8" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
        <ul class="relative mx-auto grid max-w-4xl gap-3 sm:grid-cols-2">
          {livePoints.map((point) => (
            <li class="flex items-start gap-3 rounded-md border border-accent/30 bg-panel-raised p-4 transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-panel">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent">
                <i class="bx bx-check-square icon-md" aria-hidden="true"></i>
              </span>
              <span class="pt-1 text-xs leading-relaxed text-muted-foreground">{point}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="mt-8 text-center">
        <a href={localizePath("/live/", locale)} class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:opacity-80">{t(locale, "useCases.analytics.live.cta")}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <FeatureCTA locale={locale} title={t(locale, "useCases.analytics.cta.title")} description={t(locale, "useCases.analytics.cta.desc")} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>

<style is:global>
  .border-accent\/30 { border-color: color-mix(in oklab, var(--accent) 30%, transparent); }
  .bg-muted-foreground\/10 { background-color: color-mix(in oklab, var(--muted-foreground) 10%, transparent); }

  .design-rail::before {
    content: "";
    position: absolute;
    inset-inline-start: 1.1rem;
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    border-radius: var(--radius-pill);
    background: linear-gradient(to bottom, var(--accent), var(--primary));
    opacity: 0.6;
  }
</style>
