---
import Page from "../../layouts/Page.astro";
import FeatureHero from "../../components/features/FeatureHero.astro";
import FeatureCTA from "../../components/features/FeatureCTA.astro";
import JourneySignature from "../../components/JourneySignature.astro";
import { type Locale, t } from "../../i18n/translations";
import { SITE } from "../../config";
import { localizePath } from "../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

---

  <Page
    title={t(locale, "useCases.pageTitle")}
    description={t(locale, "useCases.pageDesc")}
    image="/assets/og/use-cases.png"
    locale={locale}
    robots="noindex, follow"
  >
  <FeatureHero
    locale={locale}
    breadcrumbs={[{ label: t(locale, "nav.usecases") }]}
    title={t(locale, "useCases.hero.title")}
    description={t(locale, "useCases.hero.desc")}
  />

  <section class="relative overflow-hidden py-20 sm:py-24">
    <div class="absolute inset-x-0 top-0 z-0 aspect-[12/1] opacity-30">
      <JourneySignature variant="band" gradientId="use-cases-band-grad" />
    </div>
    <div class="relative mx-auto max-w-6xl px-6">
      <div class="relative overflow-hidden rounded-xl border border-border bg-panel p-6 shadow-panel sm:p-10" data-aos="fade-up">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-purple to-transparent opacity-80" aria-hidden="true"></div>
        <div class="absolute end-0 top-0 z-0 hidden w-44 h-64 opacity-30 lg:block">
          <JourneySignature variant="corner" gradientId="use-cases-card-grad" glow={false} />
        </div>
        <div class="relative flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-md bg-accent-soft text-accent">
              <i class="bx bx-palette icon-2xl" aria-hidden="true"></i>
            </div>
            <h2 class="text-lg font-semibold text-foreground-strong mb-2">{t(locale, "useCases.card.design.title")}</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">{t(locale, "useCases.card.design.desc")}</p>
          </div>
          <div class="relative flex shrink-0 flex-wrap gap-3">
            <a
              href={localizePath("/use-cases/design/", locale)}
              class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-5 h-10 text-sm font-medium hover:bg-panel-raised hover:border-border-strong transition-all"
            >
              {t(locale, "useCases.card.design.case")}
            </a>
            <a
              href={localizePath("/use-cases/design/gallery/", locale)}
              class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-5 h-10 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all"
            >
              {t(locale, "useCases.card.design.gallery")}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "useCases.hero.title")}
    description={t(locale, "useCases.hero.desc")}
  />
</Page>