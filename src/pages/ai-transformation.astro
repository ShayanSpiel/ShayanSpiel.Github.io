---
import TransformationDeck from "../components/infrastructure/presentation/TransformationDeck";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
interface Props {locale?: 'en' | 'fa'}
const {locale='en'} = Astro.props;
const fa=locale==='fa';
const title=fa?'معماری یک شرکت هوش‌مصنوعی‌محور':'How to architect an AI-first company';
const description=fa?'ارائهٔ تعاملی تحول با هوش مصنوعی: از هدف کسب‌وکار و تیم تحول تا هارنس، حافظه، سیستم‌عامل و ارزیابی نتایج.':'An interactive presentation explaining how AI Transformation improves work, builds a shared operating system, and scales proven workflows across departments.';
const jsonLd = { "@context": "https://schema.org", "@type": "WebPage", name: title, description, inLanguage:locale, url: `${SITE.url}/${fa?'fa/':''}ai-transformation/`, isPartOf: { "@id": `${SITE.url}/#website` } };
---
<BaseLayout title={`${title} | SpielOS`} description={description} locale={locale} image="/assets/og/ai-transformation.png" showChat={false}>
  <TransformationDeck locale={locale} client:load />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
