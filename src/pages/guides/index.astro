---
import Page from "../../layouts/Page.astro";
import FeatureHero from "../../components/features/FeatureHero.astro";
import FeatureCTA from "../../components/features/FeatureCTA.astro";
import { type Locale, t } from "../../i18n/translations";
import { SITE } from "../../config";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t(locale, "guides.pageTitle"),
  description: t(locale, "guides.pageDesc"),
  url: SITE.url + "/guides/",
  isPartOf: {
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
  },
  about: {
    "@type": "SoftwareApplication",
    name: SITE.name,
    url: SITE.url,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
  },
};
---

  <Page
    title={t(locale, "guides.pageTitle")}
    description={t(locale, "guides.pageDesc")}
    image="/assets/og/guides.png"
    locale={locale}
    robots="noindex"
  >
  <FeatureHero
    locale={locale}
    breadcrumbs={[{ label: "Guides" }]}
    title={t(locale, "guides.hero.title")}
    description={t(locale, "guides.hero.desc")}
  />

  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-md border border-border bg-panel p-8 text-center" data-aos="fade-up">
        <div class="flex h-12 w-12 items-center justify-center rounded-md bg-accent-soft mx-auto mb-4">
          <i class="bx bx-task text-accent icon-4xl"></i>
        </div>
        <h2 class="text-lg font-semibold text-foreground-strong mb-2">{t(locale, "guides.placeholder.title")}</h2>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-lg mx-auto">{t(locale, "guides.placeholder.desc")}</p>
      </div>
    </div>
  </section>

  <FeatureCTA
    locale={locale}
    title={t(locale, "guides.hero.title")}
    description={t(locale, "guides.hero.desc")}
  />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>
