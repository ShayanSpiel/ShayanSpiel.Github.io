---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShowcaseNav from "../components/showcase/ShowcaseNav.astro";
import ShowcaseHero from "../components/showcase/ShowcaseHero.astro";
import ShowcaseHowItWorks from "../components/showcase/ShowcaseHowItWorks.astro";
import ShowcaseDirectorMode from "../components/showcase/ShowcaseDirectorMode.astro";
import ShowcaseFeatures from "../components/showcase/ShowcaseFeatures.astro";
import ShowcaseWaitlistCTA from "../components/showcase/ShowcaseWaitlistCTA.astro";
import Footer from "../components/Footer.astro";
import { type Locale, t } from "../i18n/translations";
import { SITE } from "../config";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const title = t(locale, "waitlist.title");
const description = t(locale, "waitlist.desc");

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/PreOrder",
  },
  author: { "@id": `${SITE.url}/#person` },
  publisher: { "@id": `${SITE.url}/#organization` },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
    { "@type": "ListItem", position: 2, name: "Waitlist", item: `${SITE.url}/waitlist/` },
  ],
};
---

<BaseLayout title={title} description={description} locale={locale}>
  <ShowcaseNav slot="nav" locale={locale} />
  <ShowcaseHero locale={locale} />
  <ShowcaseHowItWorks locale={locale} />
  <ShowcaseDirectorMode locale={locale} />
  <ShowcaseFeatures locale={locale} />
  <ShowcaseWaitlistCTA locale={locale} />
  <div class="text-center pb-8">
    <p class="text-xs text-muted-foreground">
      {t(locale, "waitlist.services.link")} <a href={localizePath("/services/", locale)} class="text-primary hover:opacity-80 transition-opacity">Learn more →</a>
    </p>
  </div>
  <Footer slot="footer" showThemeToggle locale={locale} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>
