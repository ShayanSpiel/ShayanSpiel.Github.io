---
import Page from "../layouts/Page.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import FAQList from "../components/sections/FAQList.astro";
import { SITE } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const contactHref = localizePath("/contact/", locale);
const pricingHref = localizePath("/pricing/", locale);

const title = t(locale, "partners.pageTitle");
const description = t(locale, "partners.pageDesc");

const faqs = [1, 2, 3, 4].map((n) => {
  const a = t(locale, `partners.faq.a${n}`);
  let aHtml: string | undefined;
  if (n === 4) {
    const label = locale === "fa" ? "\u0635\u0641\u062d\u0647\u200c\u06cc \u062a\u0639\u0631\u0641\u0647" : "pricing page";
    const anchor = `<a class="font-semibold text-primary hover:underline" href="${pricingHref}">${label}</a>`;
    aHtml = locale === "fa" ? a.replace("\u0635\u0641\u062d\u0647\u200c\u06cc \u062a\u0639\u0631\u0641\u0647", anchor) : a.replace("pricing page", anchor);
  }
  return { q: t(locale, `partners.faq.q${n}`), a, aHtml };
});

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "partners.hero.label"), item: `${SITE.url}${localizePath("/partners/", locale)}` },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Page title={title} description={description} locale={locale}>
  <!-- 1 — HERO -->
  <section class="relative overflow-hidden pt-24 pb-24 sm:pt-32 sm:pb-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[30rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "partners.hero.label")}</p>
      <h1 class="mt-5 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">
        {t(locale, "partners.hero.titleLead")} <span class="text-primary">{t(locale, "partners.hero.titleAccent")}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-muted-foreground">{t(locale, "partners.hero.body")}</p>
      <div class="mt-9 flex justify-center">
        <a href={contactHref} data-cta-location={`partners_hero_${locale}`} class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110 active:brightness-95">{t(locale, "partners.cta.hero")}</a>
      </div>
    </div>
  </section>

  <!-- 2 — THE DEAL -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-center font-bold tracking-tight text-foreground-strong text-3xl sm:text-4xl" data-aos="fade-up">{t(locale, "partners.deal.title")}</h2>

      <div class="mt-14 grid gap-6 md:grid-cols-[1.4fr_1fr]" data-aos="fade-up">
        <!-- Bring a Customer -->
        <article class="group relative flex flex-col overflow-hidden rounded-md border border-border-strong bg-panel-raised p-8 shadow-panel ring-1 ring-primary/30 transition-all hover:-translate-y-1 sm:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <div class="flex items-center gap-3.5">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-primary-soft">
              <i class="bx bx-user-check text-primary icon-2xl" aria-hidden="true"></i>
            </div>
            <h3 class="font-sans text-xl font-bold text-foreground-strong">{t(locale, "partners.deal.customerTitle")}</h3>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{t(locale, "partners.customerDesc")}</p>

          <div class="mt-auto pt-10">
            <p class="font-extrabold leading-none tracking-tight text-primary" dir="ltr">
              <span class="text-7xl sm:text-8xl">50%</span>
            </p>
            <p class="mt-3 font-sans text-sm font-semibold text-foreground">{t(locale, "partners.firstPayment")}</p>
            <p class="mt-2 font-sans text-sm text-muted-foreground">
              <span class="align-baseline font-extrabold text-foreground-strong" dir="ltr"><span class="text-xl">20%</span></span>
              {t(locale, "partners.restOfYear")}
            </p>
          </div>
        </article>

        <!-- Bring a Lead -->
        <article class="group relative flex flex-col overflow-hidden rounded-md border border-border bg-panel p-8 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong sm:p-10">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent to-transparent opacity-50" aria-hidden="true"></div>
          <div class="flex items-center gap-3.5">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md bg-accent-soft">
              <i class="bx bx-link text-accent icon-2xl" aria-hidden="true"></i>
            </div>
            <h3 class="font-sans text-xl font-bold text-foreground-strong">{t(locale, "partners.deal.leadTitle")}</h3>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-muted-foreground">{t(locale, "partners.leadDesc")}</p>

          <div class="mt-auto pt-10">
            <p class="font-extrabold leading-none tracking-tight text-foreground-strong" dir="ltr">
              <span class="text-7xl sm:text-8xl">25%</span>
            </p>
            <p class="mt-3 font-sans text-sm font-semibold text-foreground">{t(locale, "partners.firstPayment")}</p>
            <p class="mt-2 font-sans text-sm text-muted-foreground">
              <span class="align-baseline font-extrabold text-foreground-strong" dir="ltr"><span class="text-xl">20%</span></span>
              {t(locale, "partners.restOfYear")}
            </p>
          </div>
        </article>
      </div>

      <p class="mt-12 text-center text-xs leading-relaxed text-muted-foreground" data-aos="fade-up">
        {t(locale, "partners.note")}
        <a href={pricingHref} data-cta-location={`partners_note_pricing_${locale}`} class="font-semibold text-primary hover:underline">{t(locale, "partners.note.link")}</a>
      </p>
    </div>
  </section>

  <!-- 3 — FAQ -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <SectionHeader label={t(locale, "partners.faq.label")} title={t(locale, "partners.faq.title")} />
      <FAQList locale={locale} keyPrefix="partners-faq" entries={faqs} />
    </div>
  </section>

  <!-- 4 — FINAL CTA -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute left-1/2 top-[34%] h-[24rem] w-[40rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-5xl">{t(locale, "partners.final.title")}</h2>
      <p class="mx-auto mt-5 max-w-lg text-sm leading-relaxed text-muted-foreground sm:text-base">{t(locale, "partners.final.body")}</p>
      <div class="mt-8 flex justify-center">
        <a href={contactHref} data-cta-location={`partners_final_${locale}`} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-8 h-12 text-base font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">{t(locale, "partners.cta.final")}</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Page>
