---
import Page from "../layouts/Page.astro";
import { FORMS, SITE, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";
import ToolLogos from "../components/ToolLogos.astro";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const steps = [1, 2, 3] as const;
const choices = [
  {
    key: "workers",
    icon: "bx-network-chart",
    tile: "bg-primary-soft text-primary",
    chipsLabel: t(locale, "conversion.apply.form.automating"),
    chips: [1, 2, 3, 4].map((n) => t(locale, `conversion.apply.form.workersChip${n}`)),
    logos: ["microsoftexcel", "dynamics365", "salesforce", "hubspot", "microsoftoutlook"],
  },
  {
    key: "software",
    icon: "bx-code-alt",
    tile: "bg-accent-soft text-accent",
    chipsLabel: t(locale, "conversion.apply.form.fixing"),
    chips: [1, 2, 3, 4].map((n) => t(locale, `conversion.apply.form.softwareChip${n}`)),
    logos: ["claude", "openai", "github", "lovable", "replit"],
  },
] as const;

// Owner directive 2026-08-26 (revised same day): single-viewport apply
// takeover WITH the site navbar (owner correction). Title + description +
// wizard + one tiny footer line fill exactly one viewport under the fixed
// nav; the Page footer remains reachable by scrolling. Hero sections, fit
// checklist, FAQ section, and final CTA are removed; /fa/apply/ inherits
// this component via the thin-wrapper pattern.
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "conversion.apply.hero.label"), item: `${SITE.url}${localizePath("/apply/", locale)}` },
  ],
};
---

<Page
  title={t(locale, "conversion.apply.pageTitle")}
  description={t(locale, "conversion.apply.pageDesc")}
  image="/assets/og/apply.png"
  locale={locale}
>
  <div class="relative flex h-[calc(100vh-4rem)] flex-col supports-[height:100dvh]:h-[calc(100dvh-4rem)]">
    <!-- Full-viewport grid backdrop (extends edge to edge, top and bottom) -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="canvas-grid"></div>
      <div class="glow-blob absolute -top-24 left-[10%] h-80 w-80 rounded-md opacity-20"></div>
      <div class="glow-blob-accent absolute -bottom-24 right-[8%] h-80 w-80 rounded-md opacity-15"></div>
    </div>
    <!-- HEADER: title + description only -->
    <header class="relative z-10 w-full shrink-0 px-6 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))] text-center sm:pb-4 sm:pt-4">
      <h1 class="mx-auto max-w-4xl text-3xl font-extrabold leading-tight tracking-tight text-foreground-strong sm:text-5xl">
        {t(locale, "conversion.apply.hero.titleLead")} <span class="text-primary">{t(locale, "conversion.apply.hero.titleAccent")}</span>
      </h1>
      <p class="mx-auto mt-2 max-w-3xl whitespace-nowrap text-xs font-semibold text-muted-foreground sm:text-sm">{t(locale, "conversion.apply.form.note")}</p>
    </header>

    <!-- WIZARD: fills the remaining viewport; pane box never resizes -->
    <section class="relative z-10 flex min-h-0 w-full flex-1 flex-col px-4 sm:px-6">
      <div id="free-review" class="relative z-10 mx-auto flex w-full max-w-5xl min-h-0 flex-1 flex-col overflow-hidden rounded-md border border-border bg-panel shadow-panel">
        <div class="absolute inset-x-0 top-0 z-10 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
        <form id="apply-form" novalidate class="flex min-h-0 flex-1 flex-col">
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_subject" value="SpielOS Free Review Application" />
          <input type="hidden" name="source" value="apply" />

          <div id="wizard-progress" class="flex shrink-0 items-center gap-2 border-b border-border bg-panel-raised px-6 py-3 sm:gap-3 sm:px-10 sm:py-4">
            {steps.map((n, i) => (
              <div class:list={["flex items-center", i > 0 && "flex-1"]}>
                {i > 0 && <span class="progress-line h-px flex-1 bg-border"></span>}
                <span class="step-dot flex h-7 w-7 shrink-0 items-center justify-center rounded-md border font-mono text-xs font-bold" data-step={n}>{n}</span>
                <span class="step-name ms-2 hidden text-xs font-semibold text-muted-foreground sm:block" data-step={n}>{t(locale, `conversion.apply.wizard.step${n}`)}</span>
              </div>
            ))}
          </div>

          <!-- Fixed-size pane viewport: every step stacks in the same box,
               so advancing never changes the wizard's width or height. -->
          <div class="relative min-h-0 flex-1">
            <fieldset data-pane="1" class="absolute inset-0 overflow-y-auto px-6 py-6 sm:px-10 sm:py-8">
              <legend class="sr-only">{t(locale, "conversion.apply.wizard.step1")}</legend>
              <p class="text-2xs font-semibold uppercase tracking-widest text-primary">01 — {t(locale, "conversion.apply.wizard.step1")}</p>
              <p class="mt-1 text-lg font-bold text-foreground-strong sm:text-xl sm:font-bold">{t(locale, "conversion.apply.form.helpLabel")}</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {choices.map(({ key, icon, tile, chipsLabel, chips, logos }, i) => (
                  <label class="group relative flex cursor-pointer flex-col overflow-hidden rounded-md border border-border bg-panel p-6 transition-all hover:-translate-y-0.5 hover:border-border-strong has-[:checked]:border-primary has-[:checked]:bg-primary-soft/30 has-[:checked]:shadow-panel">
                    <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-70" aria-hidden="true"></span>
                    <input type="radio" name="help_type" value={key} class="sr-only" checked={i === 0} />
                    <div class:list={["flex h-12 w-12 items-center justify-center rounded-md transition-colors", tile]}>
                      <i class={`${icon} icon-4xl`}></i>
                    </div>
                    <p class="mt-4 text-base font-semibold leading-snug text-foreground sm:text-lg">{t(locale, `conversion.apply.form.choice.${key}`)}</p>
                    <p class="mt-1 text-xs text-muted-foreground sm:text-sm">{t(locale, `conversion.apply.form.choice.${key}.d`)}</p>
                    <div class="mt-3 flex flex-wrap items-center gap-1.5">
                      <span class="text-3xs font-semibold uppercase tracking-wide text-muted-foreground">{chipsLabel}</span>
                      {chips.map((chip) => (
                        <span class="rounded-sm border border-border bg-panel-raised px-1.5 py-0.5 text-3xs text-muted-foreground">{chip}</span>
                      ))}
                    </div>
                    <div class="mt-auto pt-4">
                      <ToolLogos show={[...logos]} />
                    </div>
                  </label>
                ))}
              </div>
              <div class="mt-4">
                <p class="text-sm font-semibold text-foreground-strong">{t(locale, "conversion.apply.wizard.hint1")}</p>
                <p class="mt-1 text-xs leading-relaxed text-muted-foreground sm:text-sm">{t(locale, "conversion.apply.wizard.sub2")}</p>
              </div>
            </fieldset>

            <fieldset data-pane="2" hidden class="absolute inset-0 overflow-y-auto px-6 py-6 sm:px-10 sm:py-8">
              <legend class="sr-only">{t(locale, "conversion.apply.wizard.step2")}</legend>
              <p class="text-2xs font-semibold uppercase tracking-widest text-primary">02 — {t(locale, "conversion.apply.wizard.step2")}</p>
              <p class="mt-1 text-lg font-bold text-foreground-strong sm:text-xl sm:font-bold">{t(locale, "conversion.apply.form.nowLabel")}</p>
              <textarea name="message" rows="4" required placeholder={t(locale, "conversion.apply.form.nowHint")} class="mt-4 w-full rounded-md border border-border bg-input px-4 py-3 text-base leading-relaxed text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring resize-y transition-colors"></textarea>
              <label for="link" class="mt-4 block text-sm font-medium text-foreground-strong">{t(locale, "conversion.apply.form.linkLabel")} <span class="font-normal text-muted-foreground">({t(locale, "conversion.apply.form.optional")})</span></label>
              <input type="url" id="link" name="link" placeholder="https://" class="mt-2 w-full h-12 rounded-md border border-border bg-input px-4 text-base text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
              <p class="mt-4 text-sm text-muted-foreground">{t(locale, "conversion.apply.wizard.hint2")}</p>
            </fieldset>

            <fieldset data-pane="3" hidden class="absolute inset-0 overflow-y-auto px-6 py-6 sm:px-10 sm:py-8">
              <legend class="sr-only">{t(locale, "conversion.apply.wizard.step3")}</legend>
              <p class="text-2xs font-semibold uppercase tracking-widest text-primary">03 — {t(locale, "conversion.apply.wizard.step3")}</p>
              <p class="mt-1 text-lg font-bold text-foreground-strong sm:text-xl sm:font-bold">{t(locale, "conversion.apply.wizard.contactTitle")}</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block text-sm font-medium text-foreground-strong">{t(locale, "conversion.apply.form.name")}</label>
                  <input type="text" id="name" name="name" required autocomplete="name" class="h-12 w-full rounded-md border border-border bg-input px-4 text-base text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
                </div>
                <div>
                  <label for="email" class="mb-2 block text-sm font-medium text-foreground-strong">{t(locale, "conversion.apply.form.email")}</label>
                  <input type="email" id="email" name="email" required autocomplete="email" class="h-12 w-full rounded-md border border-border bg-input px-4 text-base text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
                </div>
              </div>
              <p class="mt-4 text-sm text-muted-foreground">{t(locale, "conversion.apply.wizard.hint3")}</p>
            </fieldset>
          </div>

          <div class="flex shrink-0 items-center justify-between gap-3 border-t border-border px-6 py-4 sm:px-10 sm:py-5">
            <button type="button" id="wiz-back" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium text-muted-foreground hover:bg-panel-raised hover:text-foreground transition-all sm:h-12 sm:px-6 sm:text-base" disabled>
              <i class="bx bx-chevron-left rtl-flip icon-md"></i>
              {t(locale, "conversion.apply.wizard.back")}
            </button>
            <button type="button" id="wiz-next" class="group inline-flex items-center justify-center gap-1.5 rounded-md bg-primary text-primary-foreground px-7 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20 sm:h-12 sm:px-8 sm:text-base">
              {t(locale, "conversion.apply.wizard.next")}
              <i class="bx bx-chevron-right rtl-flip icon-md transition-transform group-hover:translate-x-0.5"></i>
            </button>
            <button id="submit-btn" type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-foreground px-7 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20 sm:h-12 sm:px-8 sm:text-base" style="display:none">
              <span id="submit-text">{t(locale, "conversion.apply.form.submit")}</span>
              <i id="submit-spinner" class="bx bx-loader icon-base bx-spin align-middle" style="display:none"></i>
            </button>
          </div>

          <!-- Floating error banner: overlays the card so showing it never
               shifts the fixed wizard geometry. -->
          <div id="form-error" class="absolute inset-x-4 bottom-20 z-20 hidden rounded-md bg-destructive-soft border border-destructive/20 p-3 text-center text-sm text-destructive shadow-popover"></div>
        </form>
      </div>

      <!-- FOOTER: one tiny line -->
      <footer class="flex w-full shrink-0 items-center justify-center gap-2 py-2.5 text-center">
        <span class="text-2xs text-foreground-muted sm:text-xs">{t(locale, "conversion.apply.microcopy")}</span>
        <span aria-hidden="true" class="text-border">·</span>
        <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="apply_footer_call_icon" aria-label={t(locale, "cta.preferCallShort")} title={t(locale, "cta.preferCallShort")} class="inline-flex items-center gap-1 text-2xs text-muted-foreground transition-colors hover:text-primary sm:text-xs">
          {t(locale, "cta.preferCallShort")}
          <i class="bx bx-phone icon-sm" aria-hidden="true"></i>
        </button>
      </footer>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <script is:inline define:vars={{ formEndpoint: FORMS.contact, thankYouPath: localizePath("/apply/thank-you/", locale) }}>
  (function() {
    var form = document.getElementById('apply-form');
    var panes = form.querySelectorAll('fieldset[data-pane]');
    var dots = form.querySelectorAll('.step-dot');
    var names = form.querySelectorAll('.step-name');
    var back = document.getElementById('wiz-back');
    var next = document.getElementById('wiz-next');
    var submitBtn = document.getElementById('submit-btn');
    var spinner = document.getElementById('submit-spinner');
    var errorEl = document.getElementById('form-error');
    if (!form || !panes.length || !back || !next || !submitBtn) return;

    var current = 1, total = panes.length;
    var locale = document.documentElement.lang || 'en';
    var page = window.location.pathname;
    var started = false;

    function track(name) {
      if (typeof window.spielosTrack === 'function') {
        window.spielosTrack(name, { form_type: 'apply', page: page, locale: locale, step: current });
      }
    }

    function render() {
      panes.forEach(function(p) { p.hidden = Number(p.dataset.pane) !== current; });
      dots.forEach(function(d) {
        var n = Number(d.dataset.step);
        d.classList.toggle('border-primary', n <= current);
        d.classList.toggle('bg-primary', n === current);
        d.classList.toggle('text-primary-foreground', n === current);
        d.classList.toggle('text-primary', n < current);
        d.classList.toggle('border-border', n > current);
        d.classList.toggle('text-muted-foreground', n > current);
      });
      names.forEach(function(nEl) {
        var n = Number(nEl.dataset.step);
        nEl.classList.toggle('text-foreground', n === current);
        nEl.classList.toggle('text-primary', n < current);
      });
      back.disabled = current === 1;
      back.style.display = 'inline-flex';
      next.style.display = current < total ? 'inline-flex' : 'none';
      submitBtn.style.display = current === total ? 'inline-flex' : 'none';
    }

    function valid() {
      var pane = panes[current - 1];
      var bad = false;
      pane.querySelectorAll('[required]').forEach(function(el) {
        if (!el.value.trim()) { bad = true; el.classList.add('border-destructive'); }
        else el.classList.remove('border-destructive');
      });
      return !bad;
    }

    form.addEventListener('input', function () {
      if (!started) { started = true; track('lead_form_start'); }
    });

    next.addEventListener('click', function() {
      if (current < total && valid()) { current++; render(); track('lead_form_step'); }
    });
    back.addEventListener('click', function() {
      if (current > 1) { current--; render(); }
    });

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      track('lead_form_submit');
      errorEl.style.display = 'none';
      submitBtn.disabled = true;
      spinner.style.display = '';
      var data = {};
      new FormData(form).forEach(function(v, k) { data[k] = v; });
      try {
        var res = await fetch(formEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (!res.ok) throw new Error();
        window.location.assign(thankYouPath);
        track('lead_form_success');
        if (typeof window.spielosTrack === 'function') window.spielosTrack('apply_submitted', { page: page, locale: locale });
      } catch (err) {
        errorEl.textContent = 'Something went wrong. Please try again or email us directly.';
        errorEl.style.display = 'block';
        track('lead_form_error');
        submitBtn.disabled = false;
        spinner.style.display = 'none';
      }
    });

    render();
  })();
  </script>
</Page>
