---
import Page from "../layouts/Page.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import FAQList from "../components/sections/FAQList.astro";
import { FORMS, SITE, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const steps = [1, 2, 3] as const;
const choices = [
  { key: "workers", icon: "bx-network-chart", tile: "bg-primary-soft text-primary" },
  { key: "software", icon: "bx-code-alt", tile: "bg-accent-soft text-accent" },
] as const;
const faqs = [1, 2, 3, 4, 5, 6] as const;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "conversion.apply.hero.label"), item: `${SITE.url}${localizePath("/apply/", locale)}` },
  ],
};
---

<Page
  title={t(locale, "conversion.apply.pageTitle")}
  description={t(locale, "conversion.apply.pageDesc")}
  image="/assets/og/apply.png"
  locale={locale}
>
  <!-- HERO -->
  <section class="relative flex min-h-[64vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[34rem] w-[52rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-md glow-blob-accent opacity-10"></div>
    <div class="relative mx-auto max-w-5xl px-6" data-aos="fade-up">
      <div class="mx-auto max-w-4xl text-center">
        <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.apply.hero.label")}</p>
        <h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.apply.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.apply.hero.titleAccent")}</span></h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg font-semibold text-foreground-strong">{t(locale, "conversion.apply.hero.sub")}</p>
        <p class="mt-2 text-sm text-muted-foreground">{t(locale, "conversion.apply.hero.line1")}</p>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.apply.hero.intro1")} {t(locale, "conversion.apply.hero.intro2")} {t(locale, "conversion.apply.hero.intro3")}</p>
        <a href="#free-review" class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-px hover:brightness-110">{t(locale, "conversion.apply.cta.start")}<i class="bx bx-chevron-down icon-md ms-1 animate-bounce-subtle"></i></a>
      </div>
    </div>
  </section>

  <!-- WHAT WE LOOK FOR -->
  <section class="relative pb-24 pt-4 sm:pb-32">
    <div class="mx-auto max-w-5xl px-6">
      <SectionHeader label={t(locale, "conversion.apply.fit.label")} title={t(locale, "conversion.apply.fit.title")} />
      <div class="grid gap-3 lg:grid-cols-[1.25fr_0.75fr]" data-aos="fade-up">
        <div class="group relative overflow-hidden rounded-md border border-border bg-panel p-6 shadow-panel transition-all hover:border-border-strong sm:p-8">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-primary">{t(locale, "conversion.apply.fit.subtitle")}</h3>
          <ul class="mt-6 grid gap-x-8 gap-y-4 sm:grid-cols-2">
            {([1, 2, 3, 4, 5] as const).map((n) => (
              <li class="flex items-start gap-2.5">
                <i class="bx bx-check-square icon-base mt-1 shrink-0 text-success"></i>
                <span class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.apply.fit.i${n}`)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="group relative overflow-hidden rounded-md border border-border bg-panel p-6 shadow-panel transition-all hover:border-border-strong sm:p-8">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-purple to-transparent opacity-80" aria-hidden="true"></div>
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft text-primary"><i class="bx bx-info-square icon-xl"></i></div>
          <h3 class="mt-5 text-base font-semibold text-foreground-strong">{t(locale, "conversion.apply.fit.notSureTitle")}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{t(locale, "conversion.apply.fit.notSureDesc")}</p>
          <div class="mt-6 flex items-center gap-2">
            <a href="#free-review" class="inline-flex h-10 flex-1 items-center justify-center rounded-md border border-border bg-panel px-5 text-sm font-semibold text-foreground-strong transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.apply.cta.start")}</a>
            <!-- Optional secondary action (owner directive 2026-08-23): icon-only
                 Cal booking trigger. Opens Cal's native embed popup in place. -->
            <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="apply_not_sure_call_icon" aria-label={t(locale, "cta.preferCallShort")} title={t(locale, "cta.preferCallShort")} class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-border bg-panel-raised text-muted-foreground transition-all hover:border-border-strong hover:bg-panel-strong hover:text-primary">
              <i class="bx bx-phone icon-base" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WIZARD -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-5xl px-6" data-aos="fade-up">
      <div class="mb-8 max-w-2xl">
        <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.apply.form.label")}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.apply.form.title")}</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{t(locale, "conversion.apply.form.note")}</p>
      </div>
      <div id="free-review" class="relative scroll-mt-28 overflow-hidden rounded-md border border-border bg-panel shadow-panel">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
        <form id="apply-form" novalidate>
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_subject" value="SpielOS Free Review Application" />
          <input type="hidden" name="source" value="apply" />

          <div id="wizard-progress" class="flex items-center gap-2 border-b border-border bg-panel-raised px-6 py-4 sm:gap-3 sm:px-10">
            {steps.map((n, i) => (
              <div class:list={["flex items-center", i > 0 && "flex-1"]}>
                {i > 0 && <span class="progress-line h-px flex-1 bg-border"></span>}
                <span class="step-dot flex h-7 w-7 shrink-0 items-center justify-center rounded-md border font-mono text-xs font-bold" data-step={n}>{n}</span>
                <span class="step-name ms-2 hidden text-xs font-semibold text-muted-foreground sm:block" data-step={n}>{t(locale, `conversion.apply.wizard.step${n}`)}</span>
              </div>
            ))}
          </div>

          <div class="px-8 py-10 sm:px-12">

            <fieldset data-pane="1">
              <p class="text-2xs font-semibold uppercase tracking-widest text-primary">01 — {t(locale, "conversion.apply.wizard.step1")}</p>
              <legend class="text-xl font-bold text-foreground-strong sm:text-2xl">{t(locale, "conversion.apply.form.helpLabel")}</legend>
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {choices.map(({ key, icon, tile }, i) => (
                    <label class="group relative cursor-pointer overflow-hidden rounded-md border border-border bg-panel p-6 transition-all hover:-translate-y-0.5 hover:border-border-strong has-[:checked]:border-primary has-[:checked]:bg-primary-soft/30 has-[:checked]:shadow-panel">
                      <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-70" aria-hidden="true"></span>
                    <input type="radio" name="help_type" value={key} class="sr-only" checked={i === 0} />
                    <div class:list={["flex h-11 w-11 items-center justify-center rounded-md transition-colors", tile]}>
                      <i class={`${icon} icon-4xl`}></i>
                    </div>
                    <p class="mt-4 text-base font-semibold leading-snug text-foreground">{t(locale, `conversion.apply.form.choice.${key}`)}</p>
                    <p class="mt-1 text-sm text-muted-foreground">{t(locale, `conversion.apply.form.choice.${key}.d`)}</p>
                  </label>
                ))}
              </div>
              <p class="mt-5 text-sm text-muted-foreground">{t(locale, "conversion.apply.wizard.hint1")}</p>
            </fieldset>

            <fieldset data-pane="2" hidden>
              <p class="text-2xs font-semibold uppercase tracking-widest text-primary">02 — {t(locale, "conversion.apply.wizard.step2")}</p>
              <legend class="text-xl font-bold text-foreground-strong sm:text-2xl">{t(locale, "conversion.apply.form.nowLabel")}</legend>
              <textarea name="message" rows="5" required placeholder={t(locale, "conversion.apply.form.nowHint")} class="mt-6 w-full rounded-md border border-border bg-input px-4 py-3 text-base leading-relaxed text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring resize-y transition-colors"></textarea>
              <label for="link" class="mt-5 block text-sm font-medium text-foreground-strong">{t(locale, "conversion.apply.form.linkLabel")} <span class="font-normal text-muted-foreground">({t(locale, "conversion.apply.form.optional")})</span></label>
              <input type="url" id="link" name="link" placeholder="https://" class="mt-2 w-full h-12 rounded-md border border-border bg-input px-4 text-base text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
              <p class="mt-4 text-sm text-muted-foreground">{t(locale, "conversion.apply.wizard.hint2")}</p>
            </fieldset>

            <fieldset data-pane="3" hidden>
              <p class="text-2xs font-semibold uppercase tracking-widest text-primary">03 — {t(locale, "conversion.apply.wizard.step3")}</p>
              <legend class="text-xl font-bold text-foreground-strong sm:text-2xl">{t(locale, "conversion.apply.wizard.contactTitle")}</legend>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div>
                  <label for="name" class="mb-2 block text-sm font-medium text-foreground-strong">{t(locale, "conversion.apply.form.name")}</label>
                  <input type="text" id="name" name="name" required autocomplete="name" class="h-12 w-full rounded-md border border-border bg-input px-4 text-base text-foreground focus:border-primary focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
                </div>
                <div>
                  <label for="email" class="mb-2 block text-sm font-medium text-foreground-strong">{t(locale, "conversion.apply.form.email")}</label>
                  <input type="email" id="email" name="email" required autocomplete="email" class="h-12 w-full rounded-md border border-border bg-input px-4 text-base text-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
                </div>
              </div>
              <p class="mt-5 text-sm text-muted-foreground">{t(locale, "conversion.apply.wizard.hint3")}</p>
            </fieldset>

          </div>

          <div class="flex items-center justify-between gap-3 border-t border-border px-8 py-5 sm:px-12">
            <button type="button" id="wiz-back" class="inline-flex items-center justify-center gap-1.5 rounded-md border border-border bg-panel px-6 h-12 text-base font-medium text-muted-foreground hover:bg-panel-raised hover:text-foreground transition-all" disabled>
              <i class="bx bx-chevron-left rtl-flip icon-md"></i>
              {t(locale, "conversion.apply.wizard.back")}
            </button>
            <button type="button" id="wiz-next" class="group inline-flex items-center justify-center gap-1.5 rounded-md bg-primary text-primary-foreground px-8 h-12 text-base font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
              {t(locale, "conversion.apply.wizard.next")}
              <i class="bx bx-chevron-right rtl-flip icon-md transition-transform group-hover:translate-x-0.5"></i>
            </button>
            <button id="submit-btn" type="submit" class="inline-flex items-center gap-2 rounded-md bg-primary text-primary-foreground px-8 h-12 text-base font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20" style="display:none">
              <span id="submit-text">{t(locale, "conversion.apply.form.submit")}</span>
              <i id="submit-spinner" class="bx bx-loader icon-base bx-spin align-middle" style="display:none"></i>
            </button>
          </div>
        </form>

      </div>

      <p class="mt-6 text-center text-sm text-foreground-muted">{t(locale, "conversion.apply.microcopy")}</p>

      <div id="form-error" class="mt-4 hidden rounded-md bg-destructive-soft border border-destructive/20 p-3 text-center text-sm text-destructive"></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-3xl px-6">
      <SectionHeader label={t(locale, "conversion.apply.faq.label")} title={t(locale, "conversion.apply.faq.title")} />
      <FAQList locale={locale} items={faqs} keyPrefix="conversion.apply.faq" />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute left-1/2 top-[52%] h-[28rem] w-[44rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.apply.hero.label")}</p>
      <h2 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-5xl">{t(locale, "conversion.apply.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.apply.hero.titleAccent")}</span></h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.apply.final.title")}</p>
      <a href="#free-review" class="mt-9 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-8 h-12 text-base font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">{t(locale, "conversion.apply.cta.start")}</a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <script is:inline define:vars={{ formEndpoint: FORMS.contact, thankYouPath: localizePath("/apply/thank-you/", locale) }}>
  (function() {
    var form = document.getElementById('apply-form');
    var panes = form.querySelectorAll('fieldset[data-pane]');
    var dots = form.querySelectorAll('.step-dot');
    var names = form.querySelectorAll('.step-name');
    var back = document.getElementById('wiz-back');
    var next = document.getElementById('wiz-next');
    var submitBtn = document.getElementById('submit-btn');
    var spinner = document.getElementById('submit-spinner');
    var errorEl = document.getElementById('form-error');
    if (!form || !panes.length || !back || !next || !submitBtn) return;

    var current = 1, total = panes.length;
    var locale = document.documentElement.lang || 'en';
    var page = window.location.pathname;
    var started = false;

    function track(name) {
      if (typeof window.spielosTrack === 'function') {
        window.spielosTrack(name, { form_type: 'apply', page: page, locale: locale, step: current });
      }
    }

    function render() {
      panes.forEach(function(p) { p.hidden = Number(p.dataset.pane) !== current; });
      dots.forEach(function(d) {
        var n = Number(d.dataset.step);
        d.classList.toggle('border-primary', n <= current);
        d.classList.toggle('bg-primary', n === current);
        d.classList.toggle('text-primary-foreground', n === current);
        d.classList.toggle('text-primary', n < current);
        d.classList.toggle('border-border', n > current);
        d.classList.toggle('text-muted-foreground', n > current);
      });
      names.forEach(function(nEl) {
        var n = Number(nEl.dataset.step);
        nEl.classList.toggle('text-foreground', n === current);
        nEl.classList.toggle('text-primary', n < current);
      });
      back.disabled = current === 1;
      back.style.display = 'inline-flex';
      next.style.display = current < total ? 'inline-flex' : 'none';
      submitBtn.style.display = current === total ? 'inline-flex' : 'none';
    }

    function valid() {
      var pane = panes[current - 1];
      var bad = false;
      pane.querySelectorAll('[required]').forEach(function(el) {
        if (!el.value.trim()) { bad = true; el.classList.add('border-destructive'); }
        else el.classList.remove('border-destructive');
      });
      return !bad;
    }

    form.addEventListener('input', function () {
      if (!started) { started = true; track('lead_form_start'); }
    });

    next.addEventListener('click', function() {
      if (current < total && valid()) { current++; render(); track('lead_form_step'); }
    });
    back.addEventListener('click', function() {
      if (current > 1) { current--; render(); }
    });

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      track('lead_form_submit');
      errorEl.style.display = 'none';
      submitBtn.disabled = true;
      spinner.style.display = '';
      var data = {};
      new FormData(form).forEach(function(v, k) { data[k] = v; });
      try {
        var res = await fetch(formEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (!res.ok) throw new Error();
        window.location.assign(thankYouPath);
        track('lead_form_success');
        if (typeof window.spielosTrack === 'function') window.spielosTrack('apply_submitted', { page: page, locale: locale });
      } catch (err) {
        errorEl.textContent = 'Something went wrong. Please try again or email us directly.';
        errorEl.style.display = 'block';
        track('lead_form_error');
        submitBtn.disabled = false;
        spinner.style.display = 'none';
      }
    });

    render();
  })();
  </script>
</Page>
