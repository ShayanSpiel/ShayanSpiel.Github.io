---
import Page from "../layouts/Page.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { SITE, AUTHOR, FOUNDER, APPLY_PATH } from "../config";
import { localizePath } from "../i18n";
import SectionHeader from "../components/sections/SectionHeader.astro";
import ProofMetrics from "../components/sections/ProofMetrics.astro";
import ProductCard from "../components/sections/ProductCard.astro";
import { type Locale, t } from "../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const productDescKeys: Record<string, string> = {
  "SpielOS": "product.spielos.desc",
  "CacheCatch": "product.cachecatch.desc",
  "Spiel-OS": "product.spielosOld.desc",
  "Vibebaba": "product.vibebaba.desc",
  "ShayanWiki": "product.shayanwiki.desc",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: AUTHOR.name,
  url: SITE.url + "/founder/",
  image: `${SITE.url}/assets/avatars/avatar.jpg`,
  jobTitle: AUTHOR.jobTitle,
  description: AUTHOR.description,
  sameAs: AUTHOR.sameAs,
  worksFor: { "@id": `${SITE.url}/#organization` },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Tehran",
  },
  knowsAbout: [
    "AI agents",
    "Agent orchestration",
    "LangGraph",
    "Context engineering",
    "Prompt caching",
    "Founder distribution",
    "Startup systems",
    "Product strategy",
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Digikala",
      sameAs: "https://en.wikipedia.org/wiki/Digikala",
    },
    {
      "@type": "Organization",
      name: "Takhfifan",
    },
    {
      "@type": "Organization",
      name: "Varzesh3",
    },
  ],
  knowsLanguage: ["en", "fa"],
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: "Founder", item: `${SITE.url}${localizePath("/founder/", locale)}` },
  ],
};
---

<Page
  title={AUTHOR.name + " — " + t(locale, "founder.pageTitle")}
  description={t(locale, "founder.pageDesc")}
  image="/assets/og/founder.png"
  locale={locale}
>
  <!-- Hero -->
  <section class="relative flex min-h-[72vh] items-center justify-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[40%] h-[32rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="absolute left-[58%] top-[36%] h-64 w-64 rounded-md glow-blob-accent opacity-10"></div>

    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <div class="relative mx-auto mb-6 h-24 w-24">
        <div class="absolute inset-0 rounded-md bg-gradient-to-br from-primary via-accent to-transparent opacity-20 blur-xl"></div>
        <img src="/assets/avatars/avatar.jpg" alt={AUTHOR.name} width="96" height="96" class="relative rounded-md border border-border bg-panel shadow-panel object-cover w-24 h-24" loading="lazy" />
      </div>

      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "founder.authorTitle")}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-extrabold text-foreground-strong tracking-tight leading-tightest">
        {FOUNDER.name}
      </h1>

      <div class="mt-4 flex items-center justify-center gap-3">
        <SocialIcons size="md" show={["x", "linkedin", "github"]} />
      </div>

      <div class="mt-8 space-y-3 text-base leading-relaxed text-muted-foreground max-w-2xl mx-auto" data-aos="fade-up">
        <p>{t(locale, "founder.hero.p1")}</p>
        <p set:html={t(locale, "founder.hero.p2")} />
        <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, "founder.coreParagraph")}</p>
      </div>
    </div>
  </section>

  <!-- Systems Before Agents -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "founder.systems.label")}
        title={t(locale, "founder.systems.title")}
        description={t(locale, "founder.systems.desc")}
      />

      <div class="relative overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel sm:p-8" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
        <div class="relative">
          <ProofMetrics proof={FOUNDER.proof} locale={locale} />
        </div>
      </div>

      <div class="mt-10 mx-auto max-w-2xl space-y-4 text-sm leading-relaxed text-muted-foreground text-center" data-aos="fade-up">
        <p>{t(locale, "founder.systems.p1")}</p>
        <p>{t(locale, "founder.systems.p2")}</p>
        <p class="font-medium text-foreground">{t(locale, "founder.systems.p3")}</p>
      </div>
    </div>
  </section>

  <!-- Twenty Products -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "founder.products.title")}
        description={t(locale, "founder.products.desc")}
      />

      <div class="grid gap-3 sm:grid-cols-2" data-aos="fade-up">
        <article class="group relative overflow-hidden rounded-md border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-destructive via-warning to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-destructive-soft text-destructive">
            <i class="bx bx-error icon-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1.5">{t(locale, "founder.products.card1.title")}</h3>
          <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.products.card1.desc")}</p>
        </article>
        <article class="group relative overflow-hidden rounded-md border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-success via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-success-soft text-success">
            <i class="bx bx-check-square icon-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1.5">{t(locale, "founder.products.card2.title")}</h3>
          <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.products.card2.desc")}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Moving Into Agent Systems -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "founder.agents.label")}
        title={t(locale, "founder.agents.title")}
        description={t(locale, "founder.agents.desc")}
      />

      <div class="grid gap-3 sm:grid-cols-3" data-aos="fade-up">
        <article class="group relative overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft text-primary">
            <i class="bx bx-code-alt icon-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">LangChain & LangGraph</h3>
          <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.agents.card1.desc")}</p>
        </article>
        <article class="group relative overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-purple to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-accent-soft text-accent">
            <i class="bx bx-layer icon-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "founder.agents.card2.title")}</h3>
          <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.agents.card2.desc")}</p>
        </article>
        <article class="group relative overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-warning via-primary to-transparent opacity-80" aria-hidden="true"></div>
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-warning-soft text-warning">
            <i class="bx bx-task icon-xl" aria-hidden="true"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "founder.agents.card3.title")}</h3>
          <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.agents.card3.desc")}</p>
        </article>
      </div>

      <div class="mt-10 text-center" data-aos="fade-up">
        <p class="mx-auto max-w-2xl text-sm leading-relaxed text-muted-foreground" set:html={t(locale, "founder.agents.p1")} />
      </div>
    </div>
  </section>

  <!-- Why SpielOS -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "founder.why.label")}
        title={t(locale, "founder.why.title")}
        description={t(locale, "founder.why.desc")}
      />

      <div class="relative overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel sm:p-8" data-aos="fade-up">
        <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
        <div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
        <div class="relative grid gap-6 sm:grid-cols-2">
          <div class="relative overflow-hidden rounded-md border border-border bg-panel-raised p-5">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-60" aria-hidden="true"></div>
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft text-primary"><i class="bx bx-bullseye icon-lg" aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-2">{t(locale, "founder.why.card1.title")}</h3>
            <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.why.card1.desc")}</p>
          </div>
          <div class="relative overflow-hidden rounded-md border border-border bg-panel-raised p-5">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-purple to-transparent opacity-60" aria-hidden="true"></div>
            <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-group icon-lg" aria-hidden="true"></i></div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-2">{t(locale, "founder.why.card2.title")}</h3>
            <p class="text-xs leading-relaxed text-muted-foreground">{t(locale, "founder.coreParagraph")}</p>
          </div>
        </div>
      </div>

      <div class="mt-10 text-center" data-aos="fade-up">
        <a href={localizePath(APPLY_PATH, locale)} data-cta-location="founder_final" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
          {t(locale, "cta.apply")}
        </a>
        <div class="mt-4">
          <a href={localizePath("/services/", locale)} class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:opacity-80 transition-opacity">
            {t(locale, "founder.services.cta")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "founder.selected.title")}
        description={t(locale, "founder.selected.desc")}
      />

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">
        {FOUNDER.products.map((product) => (
          <ProductCard
            name={product.name}
            status={product.status}
            description={t(locale, productDescKeys[product.name] || product.description)}
            url={product.url}
            locale={locale}
          />
        ))}
      </div>

      <div class="mt-8 text-center" data-aos="fade-up">
        <a href={localizePath("/spielos-v1/", locale)} class="inline-flex items-center gap-2 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors">
          <i class="bx bx-history icon-base" aria-hidden="true"></i>
          {t(locale, "founder.spielosV1.link")}
        </a>
      </div>
    </div>
  </section>

  <!-- Personal -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <div class="relative overflow-hidden rounded-md border border-border bg-panel p-6 shadow-panel sm:p-8" data-aos="fade-up">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-60" aria-hidden="true"></div>
        <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
        <div class="relative space-y-4">
          <div class="flex items-center gap-4">
            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft text-primary"><i class="bx bx-map icon-lg" aria-hidden="true"></i></span>
            <span class="text-sm text-muted-foreground"><strong class="font-semibold text-foreground-strong">{t(locale, "founder.personal.basedIn")}</strong> {t(locale, "founder.location")}</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft text-accent"><i class="bx bx-certification icon-lg" aria-hidden="true"></i></span>
            <span class="text-sm text-muted-foreground"><strong class="font-semibold text-foreground-strong">{t(locale, "founder.personal.education")}</strong> {t(locale, "founder.education")}</span>
          </div>
          <div class="flex items-center gap-4">
            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-purple-soft text-purple"><i class="bx bx-user icon-lg" aria-hidden="true"></i></span>
            <span class="text-sm text-muted-foreground"><strong class="font-semibold text-foreground-strong">{t(locale, "founder.personal.role")}</strong> {t(locale, "founder.personal.roleValue")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
