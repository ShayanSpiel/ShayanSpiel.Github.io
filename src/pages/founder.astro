---
import Page from "../layouts/Page.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { SITE, AUTHOR, FOUNDER, WAITLIST_URL } from "../config";
import { localizePath } from "../i18n";
import SectionHeader from "../components/sections/SectionHeader.astro";
import ProofMetrics from "../components/sections/ProofMetrics.astro";
import ProductCard from "../components/sections/ProductCard.astro";
import { type Locale, t } from "../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const productDescKeys: Record<string, string> = {
  "SpielOS": "product.spielos.desc",
  "CacheCatch": "product.cachecatch.desc",
  "Spiel-OS": "product.spielosOld.desc",
  "Vibebaba": "product.vibebaba.desc",
  "ShayanWiki": "product.shayanwiki.desc",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: AUTHOR.name,
  url: SITE.url + "/founder/",
  image: `${SITE.url}/assets/avatars/avatar.jpg`,
  jobTitle: AUTHOR.jobTitle,
  description: AUTHOR.description,
  sameAs: AUTHOR.sameAs,
  worksFor: { "@id": `${SITE.url}/#organization` },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Tehran",
  },
  knowsAbout: [
    "AI agents",
    "Agent orchestration",
    "LangGraph",
    "Context engineering",
    "Prompt caching",
    "Founder distribution",
    "Startup systems",
    "Product strategy",
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Digikala",
      sameAs: "https://en.wikipedia.org/wiki/Digikala",
    },
    {
      "@type": "Organization",
      name: "Takhfifan",
    },
    {
      "@type": "Organization",
      name: "Varzesh3",
    },
  ],
  knowsLanguage: ["en", "fa"],
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: "Founder", item: `${SITE.url}${localizePath("/founder/", locale)}` },
  ],
};
---

<Page
  title={AUTHOR.name + " — " + t(locale, "founder.pageTitle")}
  description={t(locale, "founder.pageDesc")}
  image="/assets/og/about.png"
  locale={locale}
>
  <!-- Hero -->
  <section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-15"></div>

    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <img src="/assets/avatars/avatar.jpg" alt={AUTHOR.name} width="80" height="80" class="rounded-xl mx-auto mb-6 border border-border shadow-lg" loading="lazy" />

      <h1 class="text-4xl sm:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up">
        {FOUNDER.name}
      </h1>

      <p class="mt-3 text-base text-muted-foreground" data-aos="fade-up">{t(locale, "founder.authorTitle")}</p>

      <div class="mt-4 flex items-center justify-center gap-3" data-aos="fade-up">
        <SocialIcons size="md" show={["x", "linkedin", "github"]} />
      </div>

      <div class="mt-8 space-y-3 text-base text-muted-foreground max-w-xl mx-auto leading-relaxed" data-aos="fade-up">
        <p>{t(locale, "founder.hero.p1")}</p>
        <p set:html={t(locale, "founder.hero.p2")} />
        <p class="text-sm text-muted-foreground">{t(locale, "founder.coreParagraph")}</p>
      </div>
    </div>
  </section>

  <!-- Systems Before Agents -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "founder.systems.label")}
        title={t(locale, "founder.systems.title")}
        description={t(locale, "founder.systems.desc")}
      />

      <ProofMetrics proof={FOUNDER.proof} locale={locale} />

      <div class="mt-10 space-y-4 text-sm text-muted-foreground max-w-2xl mx-auto leading-relaxed" data-aos="fade-up">
        <p>{t(locale, "founder.systems.p1")}</p>
        <p>{t(locale, "founder.systems.p2")}</p>
        <p class="text-foreground font-medium">{t(locale, "founder.systems.p3")}</p>
      </div>
    </div>
  </section>

  <!-- Twenty Products -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "founder.products.title")}
        description={t(locale, "founder.products.desc")}
      />

      <div class="grid sm:grid-cols-2 gap-4" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-destructive-soft mb-4">
            <i class="bx bx-error text-destructive icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1.5">{t(locale, "founder.products.card1.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.products.card1.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-success-soft mb-4">
            <i class="bx bx-check-square text-success icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1.5">{t(locale, "founder.products.card2.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.products.card2.desc")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Moving Into Agent Systems -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "founder.agents.label")}
        title={t(locale, "founder.agents.title")}
        description={t(locale, "founder.agents.desc")}
      />

      <div class="grid sm:grid-cols-3 gap-4" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft mb-3">
            <i class="bx bx-code-alt text-primary icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">LangChain & LangGraph</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.agents.card1.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-accent-soft mb-3">
            <i class="bx bx-layer text-accent icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "founder.agents.card2.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.agents.card2.desc")}</p>
        </div>
        <div class="rounded-md border border-border bg-panel p-5">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-warning-soft mb-3">
            <i class="bx bx-task text-warning icon-xl"></i>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "founder.agents.card3.title")}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.agents.card3.desc")}</p>
        </div>
      </div>

      <div class="mt-10 text-center" data-aos="fade-up">
        <p class="text-sm text-muted-foreground max-w-2xl mx-auto leading-relaxed" set:html={t(locale, "founder.agents.p1")} />
      </div>
    </div>
  </section>

  <!-- Why SpielOS -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] glow-blob opacity-10"></div>

    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "founder.why.label")}
        title={t(locale, "founder.why.title")}
        description={t(locale, "founder.why.desc")}
      />

      <div class="rounded-md border border-border bg-panel p-6 sm:p-8 mb-10" data-aos="fade-up">
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-2">{t(locale, "founder.why.card1.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.why.card1.desc")}</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-2">{t(locale, "founder.why.card2.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "founder.coreParagraph")}</p>
          </div>
        </div>
      </div>

      <div class="text-center" data-aos="fade-up">
        <a href={localizePath(WAITLIST_URL, locale)} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
          {t(locale, "founder.why.cta")}
        </a>
        <div class="mt-4">
          <a href={localizePath("/services/", locale)} class="inline-flex items-center gap-1.5 text-xs text-primary font-semibold hover:opacity-80 transition-opacity">
            {t(locale, "founder.services.cta")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        title={t(locale, "founder.selected.title")}
        description={t(locale, "founder.selected.desc")}
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-aos="fade-up">
        {FOUNDER.products.map((product) => (
          <ProductCard
            name={product.name}
            status={product.status}
            description={t(locale, productDescKeys[product.name] || product.description)}
            url={product.url}
            locale={locale}
          />
        ))}
      </div>

      <div class="mt-8 text-center" data-aos="fade-up">
        <a href="/spielos-v1/" class="inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground transition-colors">
          <i class="bx bx-history icon-base"></i>
          {t(locale, "founder.spielosV1.link")}
        </a>
      </div>
    </div>
  </section>

  <!-- Personal -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-md border border-border bg-panel p-6 sm:p-8" data-aos="fade-up">
        <div class="space-y-3 text-sm text-muted-foreground">
          <div class="flex items-center gap-3">
            <i class="bx bx-map text-foreground-strong icon-base"></i>
            <span><strong class="text-foreground-strong">{t(locale, "founder.personal.basedIn")}</strong> {t(locale, "founder.location")}</span>
          </div>
          <div class="flex items-center gap-3">
            <i class="bx bx-certification text-foreground-strong icon-base"></i>
            <span><strong class="text-foreground-strong">{t(locale, "founder.personal.education")}</strong> {t(locale, "founder.education")}</span>
          </div>
          <div class="flex items-center gap-3">
            <i class="bx bx-user text-foreground-strong icon-base"></i>
            <span><strong class="text-foreground-strong">{t(locale, "founder.personal.role")}</strong> {t(locale, "founder.personal.roleValue")}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
