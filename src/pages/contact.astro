---
import Page from "../layouts/Page.astro";
import { FORMS, SITE, SOCIAL, APPLY_PATH, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const formCopy = {
  name: t(locale, "contact.name"),
  namePlaceholder: t(locale, "contact.namePlaceholder"),
  email: t(locale, "contact.email"),
  emailPlaceholder: t(locale, "contact.emailPlaceholder"),
  message: t(locale, "contact.message"),
  messagePlaceholder: t(locale, "contact.messagePlaceholder"),
  submit: t(locale, "contact.submit"),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "contact.title"), item: `${SITE.url}${localizePath("/contact/", locale)}` },
  ],
};
---

<Page
  title={t(locale, "contact.title")}
  description={t(locale, "contact.desc")}
  image="/assets/og/contact.png"
  locale={locale}
>
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="relative mx-auto max-w-3xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "contact.label")}</span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "contact.title")}</h1>
        <p class="mt-4 text-sm text-muted-foreground max-w-lg mx-auto">
          {t(locale, "contact.desc")}
        </p>
      </div>

      <!-- Primary action: Apply — Free Review (Apply-first funnel). -->
      <div data-aos="fade-up" class="rounded-md border border-border bg-panel p-6 sm:p-8 mb-6 text-center">
        <h2 class="text-lg font-semibold text-foreground-strong">{t(locale, "contact.booking.title")}</h2>
        <p class="mt-2 text-sm text-muted-foreground max-w-md mx-auto leading-relaxed">{t(locale, "contact.booking.desc")}</p>
        <div class="mt-6 flex items-center justify-center gap-2">
          <a href={localizePath(APPLY_PATH, locale)} data-cta-location="contact_primary" class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
            {t(locale, "cta.apply")}
          </a>
          <!-- Optional secondary action (owner directive 2026-08-23): icon-only
               Cal booking trigger. Opens Cal's native embed popup in place. -->
          <button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="contact_call_icon" aria-label={t(locale, "cta.preferCallShort")} title={t(locale, "cta.preferCallShort")} class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-border bg-panel-raised text-muted-foreground transition-all hover:border-border-strong hover:bg-panel-strong hover:text-primary">
            <i class="bx bx-phone icon-lg" aria-hidden="true"></i>
          </button>
        </div>
        <p class="mt-3 text-xs text-foreground-muted">{t(locale, "contact.booking.fallback")}</p>
      </div>

      <div data-aos="fade-up" class="rounded-md border border-border bg-panel p-6 sm:p-8">
        <form id="contact-form" class="space-y-5">
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_subject" value="SpielOS Contact Form" />
          <div>
            <label for="name" class="block text-xs font-medium text-foreground-strong mb-1.5">{formCopy.name}</label>
            <input type="text" id="name" name="name" required placeholder={formCopy.namePlaceholder} class="w-full h-11 rounded-md border border-border bg-input px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
          </div>
          <div>
            <label for="email" class="block text-xs font-medium text-foreground-strong mb-1.5">{formCopy.email}</label>
            <input type="email" id="email" name="email" required placeholder={formCopy.emailPlaceholder} class="w-full h-11 rounded-md border border-border bg-input px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
          </div>
          <div>
            <label for="message" class="block text-xs font-medium text-foreground-strong mb-1.5">{formCopy.message}</label>
            <textarea id="message" name="message" rows="5" required placeholder={formCopy.messagePlaceholder} class="w-full rounded-md border border-border bg-input px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-y min-h-[120px] transition-colors"></textarea>
          </div>

          <button id="submit-btn" type="submit" class="w-full rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
            <span id="submit-text">{formCopy.submit}</span>
            <i id="submit-spinner" class="bx bx-loader icon-base bx-spin" style="display:none" aria-hidden="true"></i>
          </button>

          <div id="form-error" class="hidden rounded-md bg-destructive-soft border border-destructive/20 p-3 text-xs text-destructive"></div>
        </form>

        <div id="success-state" class="hidden text-center py-8">
          <div class="flex h-14 w-14 items-center justify-center rounded-md bg-success-soft mx-auto mb-6">
            <i class="bx bx-check-square text-success text-2xl"></i>
          </div>
          <h2 class="text-xl font-bold text-foreground-strong">{t(locale, "contact.thanks.title")}</h2>
          <p class="mt-2 text-sm text-muted-foreground max-w-md mx-auto">{t(locale, "contact.thanks.desc")}</p>
          <button id="send-another" type="button" class="mt-6 inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium hover:bg-panel-raised hover:border-border-strong transition-all">
            {t(locale, "contact.thanks.back")}
          </button>
        </div>
      </div>

      <script is:inline define:vars={{ formEndpoint: FORMS.contact, thankYouUrl: localizePath("/contact/thank-you/", locale) }}>
      (function() {
        var form = document.getElementById('contact-form');
        var btn = document.getElementById('submit-btn');
        var text = document.getElementById('submit-text');
        var spinner = document.getElementById('submit-spinner');
        var errorEl = document.getElementById('form-error');
        var successState = document.getElementById('success-state');
        var sendAnother = document.getElementById('send-another');

        if (!form || !btn || !text || !spinner || !errorEl || !successState) return;

        var originalText = text.textContent;
        var locale = document.documentElement.lang || 'en';
        var page = window.location.pathname;
        var started = false;

        function track(name) {
          if (typeof window.spielosTrack === 'function') {
            window.spielosTrack(name, { form_type: 'contact', page: page, locale: locale, location: 'inline' });
          }
        }

        track('lead_form_view');
        form.addEventListener('input', function () {
          if (started) return;
          started = true;
          track('lead_form_start');
        });

        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          track('lead_form_submit');
          errorEl.classList.add('hidden');
          btn.disabled = true;
          btn.classList.add('opacity-70', 'cursor-not-allowed');
          text.textContent = originalText.replace('...', '') + '...';
          spinner.style.display = '';

          var formData = new FormData(form);
          var data = {};
          formData.forEach(function(value, key) { data[key] = value; });

          try {
            var response = await fetch(formEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            });

            if (response.ok) {
              track('lead_form_success');
              // Success shows the inline thanks panel; the thank-you page
              // stays available as a no-JS fallback target.
              form.classList.add('hidden');
              successState.classList.remove('hidden');
              text.textContent = originalText;
              spinner.style.display = 'none';
              btn.disabled = false;
              btn.classList.remove('opacity-70', 'cursor-not-allowed');
            } else {
              throw new Error('Submission failed');
            }
          } catch (err) {
            errorEl.textContent = 'Something went wrong. Please try again or email us directly.';
            errorEl.classList.remove('hidden');
            track('lead_form_error');
            btn.disabled = false;
            btn.classList.remove('opacity-70', 'cursor-not-allowed');
            text.textContent = originalText;
            spinner.style.display = 'none';
          }
        });

        if (sendAnother) {
          sendAnother.addEventListener('click', function() {
            form.reset();
            form.classList.remove('hidden');
            successState.classList.add('hidden');
            errorEl.classList.add('hidden');
          });
        }
      })();
      </script>

      <div data-aos="fade-up" class="mt-12 text-center space-y-6">
        <div class="rounded-md border border-border bg-panel p-6">
          <h2 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "contact.dmTitle")}</h2>
          <p class="text-xs text-muted-foreground mb-4">{t(locale, "contact.dmDesc")}</p>
          <div class="flex items-center justify-center gap-4">
            <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel-raised px-5 h-10 text-sm font-medium hover:bg-panel-strong hover:border-border-strong transition-all"><i class="bx bxl-twitter icon-base" aria-hidden="true"></i>{t(locale, "contact.dmX")}</a>
            <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel-raised px-5 h-10 text-sm font-medium hover:bg-panel-strong hover:border-border-strong transition-all"><i class="bx bxl-linkedin-square icon-base" aria-hidden="true"></i>{t(locale, "contact.dmLinkedin")}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
