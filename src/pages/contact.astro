---
import Page from "../layouts/Page.astro";
import { FORMS, AUTHOR, SITE, SOCIAL } from "../config";
import { ICONS } from "../lib/icons";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const formCopy = {
  name: t(locale, "contact.name"),
  namePlaceholder: t(locale, "contact.namePlaceholder"),
  email: t(locale, "contact.email"),
  emailPlaceholder: t(locale, "contact.emailPlaceholder"),
  message: t(locale, "contact.message"),
  messagePlaceholder: t(locale, "contact.messagePlaceholder"),
  submit: t(locale, "contact.submit"),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "contact.title"), item: `${SITE.url}${localizePath("/contact/", locale)}` },
  ],
};
---

<Page
  title={t(locale, "contact.title")}
  description={t(locale, "contact.desc")}
  image="/assets/og/contact.png"
  locale={locale}
>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "contact.label")}</span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "contact.title")}</h1>
        <p class="mt-4 text-sm text-muted-foreground max-w-lg mx-auto">
          {t(locale, "contact.desc")}
        </p>
      </div>

      <div data-aos="fade-up" class="rounded-lg border border-border bg-panel p-6 sm:p-8">
        <form id="contact-form" action={FORMS.contact} method="POST" class="space-y-5">
          <input type="hidden" name="_next" id="form-next" value="" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_subject" value="SpielOS Contact Form" />
          <div>
            <label for="name" class="block text-xs font-medium text-foreground-strong mb-1.5">{formCopy.name}</label>
            <input type="text" id="name" name="name" required placeholder={formCopy.namePlaceholder} class="w-full h-11 rounded-md border border-border bg-input px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
          </div>
          <div>
            <label for="email" class="block text-xs font-medium text-foreground-strong mb-1.5">{formCopy.email}</label>
            <input type="email" id="email" name="email" required placeholder={formCopy.emailPlaceholder} class="w-full h-11 rounded-md border border-border bg-input px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
          </div>
          <div>
            <label for="message" class="block text-xs font-medium text-foreground-strong mb-1.5">{formCopy.message}</label>
            <textarea id="message" name="message" rows="5" required placeholder={formCopy.messagePlaceholder} class="w-full rounded-md border border-border bg-input px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-y min-h-[120px] transition-colors"></textarea>
          </div>

          <button id="submit-btn" type="submit" class="w-full rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
            <span id="submit-text">{formCopy.submit}</span>
            <i id="submit-spinner" class="bx bx-loader icon-base bx-spin" style="display:none;"></i>
          </button>
        </form>
      </div>

      <script is:inline define:vars={{ thankYouPath: localizePath("/contact/thank-you/", locale) }}>
      (function() {
        var nextInput = document.getElementById('form-next');
        if (nextInput) nextInput.value = window.location.origin + thankYouPath;

        var form = document.getElementById('contact-form');
        var btn = document.getElementById('submit-btn');
        var text = document.getElementById('submit-text');
        var spinner = document.getElementById('submit-spinner');
        if (form && btn && text && spinner) {
          form.addEventListener('submit', function() {
            btn.disabled = true;
            btn.classList.add('opacity-70', 'cursor-not-allowed');
            text.textContent = text.textContent.replace('...', '') + '...';
            spinner.style.display = '';
          });
        }
      })();
      </script>

      <div data-aos="fade-up" class="mt-12 text-center space-y-6">
        <p class="text-xs text-muted-foreground">{t(locale, "contact.orEmail")} <a href={`mailto:${AUTHOR.email}`} class="text-primary hover:opacity-80 transition-opacity">{AUTHOR.email}</a></p>

        <div class="rounded-lg border border-border bg-panel p-6">
          <h2 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, "contact.dmTitle")}</h2>
          <p class="text-xs text-muted-foreground mb-4">{t(locale, "contact.dmDesc")}</p>
          <div class="flex items-center justify-center gap-4">
            <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel-raised px-5 h-10 text-sm font-medium hover:bg-panel-strong hover:border-border-strong transition-all" set:html={ICONS.x + " " + t(locale, "contact.dmX")} />
            <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel-raised px-5 h-10 text-sm font-medium hover:bg-panel-strong hover:border-border-strong transition-all" set:html={ICONS.linkedin + " " + t(locale, "contact.dmLinkedin")} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
