---
import SectionHeader from "../components/sections/SectionHeader.astro";
import HomepageJourneyRail from "../components/HomepageJourneyRail.astro";
import Page from "../layouts/Page.astro";
import { AUTHOR, SITE, APPLY_PATH } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const applyHref = localizePath(APPLY_PATH, locale);
const workflows = ["intake", "support", "reporting", "scheduling", "quality", "research"] as const;
const goodFit = ["customers", "time", "observable", "accessible", "implementation"] as const;
const notFit = ["prerevenue", "chatbot", "rare", "toolkit"] as const;
const serviceCards = [
  { key: "deslop", icon: "bx-code-alt", tone: "destructive", bullets: [1, 2, 3] },
  { key: "workers", icon: "bx-network-chart", tone: "success", bullets: [1, 2, 3] },
] as const;
const processSteps = [1, 2, 3, 4, 5, 6] as const;
const systemSteps = ["baseline", "define", "connect", "test", "deploy"] as const;
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "Service", "@id": `${SITE.url}${localizePath("/services/", locale)}#service`, name: t(locale, "conversion.services.pageTitle"), description: t(locale, "conversion.services.pageDesc"), url: `${SITE.url}${localizePath("/services/", locale)}`, provider: { "@id": `${SITE.url}/#person`, name: AUTHOR.name }, serviceType: "AI implementation" },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }, { "@type": "ListItem", position: 2, name: t(locale, "nav.services"), item: `${SITE.url}${localizePath("/services/", locale)}` }] },
] };
---

<Page title={t(locale, "conversion.services.pageTitle")} description={t(locale, "conversion.services.pageDesc")} locale={locale}>
  <HomepageJourneyRail />
  <section class="relative flex min-h-[76vh] items-center overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.04] hero-grid"></div><div class="absolute left-1/2 top-[42%] h-[32rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div><div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up"><p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.services.hero.label")}</p><h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.services.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.services.hero.titleAccent")}</span></h1><p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.hero.body")}</p><p class="mx-auto mt-4 max-w-2xl text-xs leading-relaxed text-foreground-muted">{t(locale, "conversion.services.hero.evidence")}</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><a href={applyHref} data-cta-location="services_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-px hover:brightness-110">{t(locale, "cta.apply")}</a><a href={localizePath("/pricing/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.pricing.services.link")}</a></div><p class="mt-4 text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "conversion.services.svc.label")} title={t(locale, "conversion.services.svc.title")} description={t(locale, "conversion.services.svc.body")} /><div class="grid gap-4 md:grid-cols-2" data-aos="fade-up">{serviceCards.map(({ key, icon, tone, bullets }) => <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong sm:p-8"><div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r to-transparent opacity-80", tone === "destructive" ? "from-destructive via-warning" : "from-success via-primary"]}></div><div class:list={["flex h-11 w-11 items-center justify-center rounded-md", tone === "destructive" ? "bg-destructive-soft text-destructive" : "bg-success-soft text-success"]}><i class:list={["bx", icon, "icon-2xl"]} aria-hidden="true"></i></div><h3 class="mt-5 text-xl font-bold text-foreground-strong">{t(locale, `conversion.pricing.help.${key}.t`)}</h3><p class="mt-2 text-sm font-medium leading-relaxed text-foreground">{t(locale, `conversion.pricing.help.${key}.d1`)}</p><ul class="mt-5 space-y-3 border-t border-border pt-5">{bullets.map((n) => <li class="flex items-start gap-2.5"><i class:list={["bx bx-check-square icon-base shrink-0", tone === "destructive" ? "text-destructive" : "text-success"]} aria-hidden="true"></i><span class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.svc.${key}.b${n}`)}</span></li>)}</ul><a href={applyHref} data-cta-location={`services_${key}`} class="mt-7 inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-opacity hover:opacity-80">{t(locale, `conversion.services.svc.${key}.cta`)}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></article>)}</div><div class="mt-5 flex flex-col items-center justify-center gap-3 rounded-lg border border-border bg-panel-deep/50 px-5 py-5 text-center sm:flex-row sm:gap-5" data-aos="fade-up"><span class="text-sm font-semibold text-foreground-strong">{t(locale, "conversion.services.svc.scale1")}</span><i class="bx bx-right-arrow-alt rtl-flip icon-xl text-primary" aria-hidden="true"></i><span class="text-sm font-semibold text-foreground-strong">{t(locale, "conversion.services.svc.scale2")}</span><i class="bx bx-right-arrow-alt rtl-flip icon-xl text-accent" aria-hidden="true"></i><span class="text-sm font-semibold text-foreground-strong">{t(locale, "conversion.services.svc.scale3")}</span></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-5xl px-6"><SectionHeader label={t(locale, "conversion.services.how.label")} title={t(locale, "conversion.services.how.title")} description={t(locale, "conversion.services.how.body")} /><ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">{processSteps.map((n) => <li class="group relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-70"></div><span class="font-mono text-2xs font-bold text-primary">0{n}</span><p class="mt-4 text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.how.s${n}`)}</p></li>)}</ol><div class="mt-8 text-center"><a href={applyHref} data-cta-location="services_process" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a><p class="mt-3 text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 opacity-[0.03] hero-grid"></div><div class="relative mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.system.title")} description={t(locale, "conversion.services.system.body")} /><ol class="service-rail relative mx-auto grid max-w-5xl gap-6 sm:grid-cols-5 sm:gap-0" data-aos="fade-up">{systemSteps.map((step, index) => <li class="relative flex items-start gap-4 sm:flex-col sm:items-center sm:px-3 sm:text-center"><span class:list={["relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-md border bg-panel font-mono text-xs font-bold", index < 3 ? "border-primary text-primary shadow-[0_0_20px_var(--primary-soft)]" : "border-border text-muted-foreground"]}>{index + 1}</span><p class="text-xs leading-relaxed text-muted-foreground">{t(locale, `conversion.services.system.${step}`)}</p></li>)}</ol></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.workflows.title")} description={t(locale, "conversion.services.workflows.body")} /><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">{workflows.map((workflow) => <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-70"></div><i class="bx bx-task icon-2xl text-primary" aria-hidden="true"></i><p class="mt-4 text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.workflows.${workflow}`)}</p></article>)}</div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-5xl px-6"><SectionHeader label={t(locale, "conversion.services.proof.label")} title={t(locale, "conversion.services.proof.title")} description={t(locale, "conversion.services.proof.body")} /><div class="flex flex-col justify-center gap-3 sm:flex-row" data-aos="fade-up"><a href={localizePath("/features/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.proof.architecture")}</a><a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.proof.live")}</a></div></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.fit.title")} /><div class="grid gap-3 md:grid-cols-2" data-aos="fade-up"><article class="relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-success via-accent to-transparent opacity-80"></div><h3 class="flex items-center gap-2 text-sm font-semibold text-success"><i class="bx bx-check-square icon-xl" aria-hidden="true"></i>{t(locale, "conversion.services.fit.good")}</h3><ul class="mt-5 space-y-3">{goodFit.map((item) => <li class="flex gap-2.5 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-check-square mt-0.5 text-success icon-md shrink-0" aria-hidden="true"></i><span>{t(locale, `conversion.services.fit.${item}`)}</span></li>)}</ul></article><article class="relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-destructive via-warning to-transparent opacity-80"></div><h3 class="flex items-center gap-2 text-sm font-semibold text-destructive"><i class="bx bx-error icon-xl" aria-hidden="true"></i>{t(locale, "conversion.services.fit.not")}</h3><ul class="mt-5 space-y-3">{notFit.map((item) => <li class="flex gap-2.5 text-sm leading-relaxed text-muted-foreground"><i class="bx bx-error mt-0.5 text-destructive icon-md shrink-0" aria-hidden="true"></i><span>{t(locale, `conversion.services.fit.${item}`)}</span></li>)}</ul></article></div></div></section>

  <section class="relative overflow-hidden py-28 sm:py-36"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.03] hero-grid"></div><div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up"><p class="text-xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.services.final.label")}</p><h2 class="mt-5 text-3xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-5xl">{t(locale, "conversion.services.final.title")}</h2><p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.final.body")}</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><a href={applyHref} data-cta-location="services_final" class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a><a href={localizePath("/pricing/", locale)} class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-panel px-8 text-base font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.final.pricing")}</a></div><p class="mt-4 text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-5xl px-6"><SectionHeader label={t(locale, "conversion.services.deal.label")} title={t(locale, "conversion.services.deal.title")} description={t(locale, "conversion.services.deal.intro")} /><div class="grid gap-3 md:grid-cols-3" data-aos="fade-up">{["d1", "d2", "d3"].map((key, index) => <div class="group relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong"><div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-accent via-purple to-transparent opacity-70"></div><span class="font-mono text-2xs font-bold text-primary">0{index + 1}</span><p class="mt-4 text-sm font-semibold leading-relaxed text-foreground-strong">{t(locale, `conversion.services.deal.${key}`)}</p></div>)}</div><p class="mt-6 text-center text-sm text-muted-foreground">{t(locale, "conversion.services.deal.close")}</p></div></section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>

<style>
  .service-rail::before { content: ""; position: absolute; inset-inline-start: 1.1rem; top: 1rem; bottom: 1rem; width: 2px; background: linear-gradient(to bottom, var(--primary), var(--accent), var(--border)); }
  @media (min-width: 640px) { .service-rail::before { inset-inline: 10%; top: 1.1rem; bottom: auto; width: auto; height: 2px; background: linear-gradient(to right, var(--primary), var(--accent), var(--border)); } }
</style>
