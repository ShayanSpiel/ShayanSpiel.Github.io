---
import SectionHeader from "../components/sections/SectionHeader.astro";
import HomepageJourneyRail from "../components/HomepageJourneyRail.astro";
import JourneyLine from "../components/JourneyLine.astro";
import Page from "../layouts/Page.astro";
import { AUTHOR, SITE, APPLY_PATH } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const applyHref = localizePath(APPLY_PATH, locale);
const pricingHref = localizePath("/pricing/", locale);
// Owner directive: AI Workers leads, DeSlopping second (on Services and homepage alike).
const serviceCards = [
  { key: "workers", icon: "bx-network-chart", tone: "success", bullets: [1, 2, 3] },
  { key: "deslop", icon: "bx-code-alt", tone: "destructive", bullets: [1, 2, 3] },
] as const;
const processSteps = [1, 2, 3, 4, 5, 6] as const;
const dealSteps = ["d1", "d2", "d3"] as const;
const costCards = [
  { tKey: "c1t", dKey: "c1d", icon: "bx-group", soft: "bg-warning-soft", text: "text-warning", line: "from-warning" },
  { tKey: "c2t", dKey: "c2d", icon: "bx-time-five", soft: "bg-info-soft", text: "text-info", line: "from-info" },
  { tKey: "c3t", dKey: "c3d", icon: "bx-trending-up", soft: "bg-destructive-soft", text: "text-destructive", line: "from-destructive" },
] as const;
// "one subscription" links to pricing inside the two-services description.
const svcBody = `${t(locale, "conversion.services.svc.bodyA")}<a class="font-medium text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary" href="${pricingHref}" data-cta-location="services_subscription_link">${t(locale, "conversion.services.svc.bodyLink")}</a>${t(locale, "conversion.services.svc.bodyB")}`;
const jsonLd = { "@context": "https://schema.org", "@graph": [
  { "@type": "Service", "@id": `${SITE.url}${localizePath("/services/", locale)}#service`, name: t(locale, "conversion.services.pageTitle"), description: t(locale, "conversion.services.pageDesc"), url: `${SITE.url}${localizePath("/services/", locale)}`, provider: { "@id": `${SITE.url}/#person`, name: AUTHOR.name }, serviceType: "AI implementation" },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }, { "@type": "ListItem", position: 2, name: t(locale, "nav.services"), item: `${SITE.url}${localizePath("/services/", locale)}` }] },
] };
---

<Page title={t(locale, "conversion.services.pageTitle")} description={t(locale, "conversion.services.pageDesc")} image="/assets/og/services.png" locale={locale}>
  <HomepageJourneyRail />
  <section class="relative flex min-h-[76vh] items-center overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.04] hero-grid"></div><div class="absolute left-1/2 top-[42%] h-[32rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div><div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up"><p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.services.hero.label")}</p><h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.services.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.services.hero.titleAccent")}</span></h1><p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.hero.body")}</p><p class="mx-auto mt-3 max-w-xl text-xs text-muted-foreground" set:html={t(locale, "partners.fromServices.pre") + `<a class="font-semibold text-primary hover:underline" href="${localizePath("/partners/", locale)}" data-cta-location="services_partners">${t(locale, "partners.fromServices.link")}</a>`} /><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><a href={applyHref} data-cta-location="services_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-px hover:brightness-110">{t(locale, "cta.apply")}</a><a href={pricingHref} data-cta-location="services_hero_pricing" class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.pricing.services.link")}</a></div><p class="mt-4 text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader label={t(locale, "conversion.services.svc.label")} title={t(locale, "conversion.services.svc.title")} description={svcBody} /><div class="grid gap-4 md:grid-cols-2" data-aos="fade-up">{serviceCards.map(({ key, icon, tone, bullets }) => <article class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong sm:p-8"><div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r to-transparent opacity-80", tone === "destructive" ? "from-destructive via-warning" : "from-success via-primary"]}></div><div class:list={["flex h-11 w-11 items-center justify-center rounded-md", tone === "destructive" ? "bg-destructive-soft text-destructive" : "bg-success-soft text-success"]}><i class:list={["bx", icon, "icon-2xl"]} aria-hidden="true"></i></div><h3 class="mt-5 text-xl font-bold text-foreground-strong">{t(locale, `conversion.pricing.help.${key}.t`)}</h3><p class="mt-2 text-sm font-medium leading-relaxed text-foreground">{t(locale, `conversion.pricing.help.${key}.d1`)}</p><ul class="mt-5 flex-1 space-y-3 border-t border-border pt-5">{bullets.map((n) => <li class="flex items-start gap-2.5"><i class:list={["bx bx-check-square icon-base mt-1 shrink-0", tone === "destructive" ? "text-destructive" : "text-success"]} aria-hidden="true"></i><span class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.svc.${key}.b${n}`)}</span></li>)}</ul><a href={applyHref} data-cta-location={`services_${key}`} class="mt-auto inline-flex items-center gap-1.5 self-start pt-6 text-sm font-semibold text-primary transition-opacity hover:opacity-80">{t(locale, `conversion.services.svc.${key}.cta`)}<i class="bx bx-chevron-right rtl-flip icon-md" aria-hidden="true"></i></a></article>)}</div><div class="mt-10" data-aos="fade-up">
          <JourneyLine steps={[t(locale, "conversion.services.journey.problem"), t(locale, "conversion.services.journey.w1"), t(locale, "conversion.services.journey.w2"), t(locale, "conversion.services.journey.goal")]} />
        </div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-5xl px-6"><SectionHeader label={t(locale, "conversion.services.how.label")} title={t(locale, "conversion.services.how.title")} description={t(locale, "conversion.services.how.body")} /><ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">{processSteps.map((n) => <li class="group relative rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong"><div class="flex items-start gap-3"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary-soft text-xs font-bold text-primary">{String(n).padStart(2, "0")}</span><p class="pt-1 text-sm font-medium leading-relaxed text-foreground-strong">{t(locale, `conversion.services.how.s${n}`)}</p></div></li>)}</ol><div class="mt-8 text-center"><a href={applyHref} data-cta-location="services_process" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a><p class="mt-3 text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="relative mx-auto max-w-5xl px-6"><SectionHeader label={t(locale, "conversion.services.deal.label")} title={t(locale, "conversion.services.deal.title")} description={t(locale, "conversion.services.deal.intro")} /><div class="deal-canvas relative overflow-hidden rounded-xl border border-border bg-panel px-5 py-10 shadow-panel sm:px-8 sm:py-14" data-aos="fade-up"><div class="absolute inset-0 opacity-[0.04] hero-grid"></div><div class="absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div><div class="deal-rail relative z-10 grid gap-6 sm:grid-cols-3 sm:gap-0">{dealSteps.map((key, index) => <div class="deal-station relative flex items-center gap-4 sm:flex-col sm:gap-3 sm:text-center"><div class="deal-node relative z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-primary bg-panel-raised text-base font-extrabold text-primary shadow-[0_0_24px_var(--primary-soft)]">{index + 1}</div><p class="max-w-[16rem] text-xs font-semibold leading-relaxed text-foreground-strong sm:max-w-none">{t(locale, `conversion.services.deal.${key}`)}</p></div>)}</div></div><p class="mt-8 flex items-center justify-center gap-2 text-center text-sm text-muted-foreground" data-aos="fade-up"><i class="bx bx-check-square icon-base shrink-0 text-success" aria-hidden="true"></i>{t(locale, "conversion.services.deal.close")}</p><div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row" data-aos="fade-up"><a href={applyHref} data-cta-location="services_deal" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a><a href={pricingHref} data-cta-location="services_deal_pricing" class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.final.pricing")}</a></div></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.cost.title")} description={t(locale, "conversion.services.cost.body")} /><div class="grid gap-4 md:grid-cols-3" data-aos="fade-up">{costCards.map(({ tKey, dKey, icon, soft, text, line }) => <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong"><div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r to-transparent opacity-70", line]}></div><div class:list={["flex h-10 w-10 items-center justify-center rounded-md", soft, text]}><i class:list={["bx", icon, "icon-xl"]} aria-hidden="true"></i></div><h3 class="mt-5 text-base font-bold text-foreground-strong">{t(locale, `conversion.services.cost.${tKey}`)}</h3><p class="mt-2 text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.cost.${dKey}`)}</p></article>)}</div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-5xl px-6"><SectionHeader label={t(locale, "conversion.services.proof.label")} title={t(locale, "conversion.services.proof.title")} description={t(locale, "conversion.services.proof.body")} /><div class="flex flex-col justify-center gap-3 sm:flex-row" data-aos="fade-up"><a href={localizePath("/features/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.proof.architecture")}</a><a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.proof.live")}</a></div></div></section>

  <section class="relative overflow-hidden py-28 sm:py-36"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.03] hero-grid"></div><div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up"><p class="text-xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.services.final.label")}</p><h2 class="mt-5 text-3xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-5xl">{t(locale, "conversion.services.final.title")}</h2><p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.final.body")}</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><a href={applyHref} data-cta-location="services_final" class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:brightness-110">{t(locale, "cta.apply")}</a><a href={pricingHref} data-cta-location="services_final_pricing" class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-panel px-8 text-base font-medium text-foreground transition-colors hover:border-border-strong hover:bg-panel-raised">{t(locale, "conversion.services.final.pricing")}</a></div><p class="mt-4 text-xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p></div></section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>

<style>
  .deal-rail { position: relative; }
  .deal-rail::before,
  .deal-rail::after {
    content: "";
    position: absolute;
    inset-inline-start: 1.375rem;
    top: 1.375rem;
    bottom: 1.375rem;
    width: 2px;
    border-radius: var(--radius-pill);
  }
  .deal-rail::before { background: var(--border-strong); }
  .deal-rail::after { bottom: 50%; background: linear-gradient(to bottom, var(--primary), var(--accent)); }
  @media (min-width: 640px) {
    .deal-rail::before,
    .deal-rail::after {
      inset-inline-start: calc(100% / 6);
      inset-inline-end: calc(100% / 6);
      top: 1.375rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .deal-rail::after { inset-inline-end: 50%; background: linear-gradient(to right, var(--primary), var(--accent)); }
  }
</style>
