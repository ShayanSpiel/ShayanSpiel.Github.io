---
import Page from "../layouts/Page.astro";
import { SITE, AUTHOR } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";
import SectionHeader from "../components/sections/SectionHeader.astro";
import SpielOSLogo from "../components/SpielOSLogo.astro";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: t(locale, "services.pageTitle"),
  description: t(locale, "services.pageDesc"),
  url: `${SITE.url}${localizePath("/services/", locale)}`,
  provider: {
    "@type": "Person",
    "@id": `${SITE.url}/#person`,
    name: AUTHOR.name,
    url: SITE.url,
  },
  areaServed: "Web",
  serviceType: "AI Agent Implementation",
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: "Services", item: `${SITE.url}${localizePath("/services/", locale)}` },
  ],
};

const icpItems = [
  { icon: "bx-cart", color: "primary", titleKey: "services.icp.item1.title", descKey: "services.icp.item1.desc" },
  { icon: "bx-briefcase", color: "accent", titleKey: "services.icp.item2.title", descKey: "services.icp.item2.desc" },
  { icon: "bx-calendar", color: "purple", titleKey: "services.icp.item3.title", descKey: "services.icp.item3.desc" },
  { icon: "bx-user", color: "success", titleKey: "services.icp.item4.title", descKey: "services.icp.item4.desc" },
  { icon: "bx-store", color: "warning", titleKey: "services.icp.item5.title", descKey: "services.icp.item5.desc" },
  { icon: "bx-code-alt", color: "primary", titleKey: "services.icp.item6.title", descKey: "services.icp.item6.desc" },
];

const PIPELINE_NODES = [
  { icon: "bx-bullseye",        colorClass: "node-goal" },
  { icon: "bx-file",            colorClass: "" },
  { icon: "bx-export",          colorClass: "" },
  { icon: "bx-layout",          colorClass: "" },
  { icon: "bx-data",            colorClass: "" },
  { icon: "bx-shield-quarter",  colorClass: "" },
  { icon: "bx-rocket",          colorClass: "node-success" },
];

const BRIEF_TABLE = [
  { icon: "bx-bullseye",        nameKey: "services.brief.step1.name", descKey: "services.brief.step1.desc" },
  { icon: "bx-file",            nameKey: "services.brief.step2.name", descKey: "services.brief.step2.desc" },
  { icon: "bx-export",          nameKey: "services.brief.step3.name", descKey: "services.brief.step3.desc" },
  { icon: "bx-layout",          nameKey: "services.brief.step4.name", descKey: "services.brief.step4.desc" },
  { icon: "bx-data",            nameKey: "services.brief.step5.name", descKey: "services.brief.step5.desc" },
  { icon: "bx-shield-quarter",  nameKey: "services.brief.step6.name", descKey: "services.brief.step6.desc" },
  { icon: "bx-rocket",          nameKey: "services.brief.step7.name", descKey: "services.brief.step7.desc" },
];

const EX_EN = JSON.stringify([
  { 0: "support request message", 1: "customer", 2: "categorize and draft a reply", 3: "response draft", 4: "Slack channel", 5: "customer history", 6: "escalation policies", 7: "response time < 2 min" },
  { 0: "screenshot", 1: "QA team", 2: "extract errors and file a bug", 3: "bug ticket", 4: "Jira board", 5: "codebase context", 6: "severity classification", 7: "reproduction steps captured" },
  { 0: "contract PDF", 1: "legal department", 2: "extract key dates and obligations", 3: "structured summary", 4: "Notion page", 5: "past contract terms", 6: "compliance checklist", 7: "all deadlines identified" },
]);
const EX_FA = JSON.stringify([
  { 0: "پیام درخواست پشتیبانی", 1: "مشتری", 2: "دسته‌بندی و پاسخ اولیه", 3: "پیش‌نویس پاسخ", 4: "کانال Slack", 5: "تاریخچه مشتری", 6: "سیاست‌های ارجاع", 7: "زمان پاسخ کمتر از ۲ دقیقه" },
  { 0: "اسکرین‌شات", 1: "تیم QA", 2: "استخراج خطاها و ثبت باگ", 3: "تیکت باگ", 4: "تخته Jira", 5: "زمینه کدپایگاه", 6: "طبقه‌بندی شدت", 7: "مراحل بازتولید ثبت شده" },
  { 0: "قرارداد PDF", 1: "بخش حقوقی", 2: "استخراج تاریخ‌ها و تعهدات", 3: "خلاصه ساختاریافته", 4: "صفحه Notion", 5: "شرایط قراردادهای قبلی", 6: "چک‌لیست انطباق", 7: "تمام مهلت‌ها شناسایی شده" },
]);
const examplesJson = locale === "fa" ? EX_FA : EX_EN;

---

<Page
  title={t(locale, "services.pageTitle") + " — " + SITE.name}
  description={t(locale, "services.pageDesc")}
  image="/assets/og/home.png"
  locale={locale}
>
  <!-- Hero -->
  <section class:list={["relative min-h-[70vh] flex items-center justify-center overflow-hidden", locale === "fa" ? "font-iransansx" : ""]}>
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-15"></div>

    <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-raised px-3 py-1 mb-8" data-aos="fade-up">
        <span class="text-2xs text-muted-foreground font-medium">{t(locale, "services.pageTitle")}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up" set:html={t(locale, "services.hero.title")} />

      <p class="mt-6 text-base text-muted-foreground max-w-2xl mx-auto leading-relaxed" data-aos="fade-up">
        {t(locale, "services.hero.desc")}
      </p>

      <div class="mt-10" data-aos="fade-up">
        <a href={localizePath("/contact/", locale)} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
          {t(locale, "services.cta.button")}
        </a>
      </div>
    </div>
  </section>

  <!-- Start Now -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "services.startNow.label")}
        title={t(locale, "services.startNow.title")}
        description={t(locale, "services.startNow.desc")}
      />

      <div class="mt-10 text-center" data-aos="fade-up">
        <button id="open-brief" type="button" class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium hover:bg-panel-raised hover:border-border-strong transition-all cursor-pointer">
          <i class="bx bx-file icon-base mr-2"></i>
          {t(locale, "services.startNow.cta")}
        </button>
      </div>
    </div>
  </section>

  <!-- What you will get -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "services.whatYouGet.label")}
        title={t(locale, "services.whatYouGet.title")}
        description={t(locale, "services.whatYouGet.desc")}
      />

      <div class="mx-auto max-w-4xl" data-aos="fade-up">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-md border border-border bg-panel p-5">
            <span class="text-2xs font-semibold text-primary">01</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, "services.process.audit.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "services.process.audit.desc")}</p>
          </div>
          <div class="rounded-md border border-border bg-panel p-5">
            <span class="text-2xs font-semibold text-primary">02</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, "services.process.design.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "services.process.design.desc")}</p>
          </div>
          <div class="rounded-md border border-border bg-panel p-5">
            <span class="text-2xs font-semibold text-primary">03</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, "services.process.testing.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "services.process.testing.desc")}</p>
          </div>
          <div class="rounded-md border border-border bg-panel p-5">
            <span class="text-2xs font-semibold text-primary">04</span>
            <h3 class="text-sm font-semibold text-foreground-strong mt-2 mb-1">{t(locale, "services.process.deployment.title")}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, "services.process.deployment.desc")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "services.icp.label")}
        title={t(locale, "services.icp.title")}
        description={t(locale, "services.icp.desc")}
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-aos="fade-up">
        {icpItems.map((item) => (
          <div class="rounded-md border border-border bg-panel p-5">
            <div class={`flex h-9 w-9 items-center justify-center rounded-md bg-${item.color}-soft mb-3`}>
              <i class={`bx ${item.icon} text-${item.color} icon-xl`}></i>
            </div>
            <h3 class="text-sm font-semibold text-foreground-strong mb-1">{t(locale, item.titleKey)}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">{t(locale, item.descKey)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we solve -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader
        label={t(locale, "services.problems.label")}
        title={t(locale, "services.problems.title")}
        description={t(locale, "services.problems.desc")}
      />

      <div class="max-w-2xl mx-auto" data-aos="fade-up">
        <div class="rounded-md border border-border bg-panel p-6 sm:p-8">
          <div class="flex items-center gap-2 mb-4">
            <i class="bx bx-error text-destructive icon-lg"></i>
            <h3 class="text-sm font-semibold text-foreground-strong">{t(locale, "services.problems.label")}</h3>
          </div>
          <ul class="space-y-3 text-xs text-muted-foreground">
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "services.problems.item1")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "services.problems.item2")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "services.problems.item3")}</li>
            <li class="flex items-start gap-2"><span class="rtl-flip text-destructive mt-0.5">→</span> {t(locale, "services.problems.item4")}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-24 sm:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] glow-blob opacity-10"></div>

    <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
      <h2 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">
        {t(locale, "services.cta.title")}
      </h2>
      <p class="mt-4 text-sm text-muted-foreground max-w-lg mx-auto">
        {t(locale, "services.cta.desc")}
      </p>
      <a href={localizePath("/contact/", locale)} class="mt-8 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
        {t(locale, "services.cta.button")}
      </a>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <!-- Agent Brief Modal -->
  <div id="brief-modal" class="brief-modal-overlay" role="dialog" aria-modal="true" aria-label={t(locale, "services.brief.title")} hidden>
    <div class="brief-modal">
      <div class="brief-modal-header">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft">
            <i class="bx bx-file text-primary icon-lg"></i>
          </div>
          <div>
            <h2 class="text-lg font-bold text-foreground-strong">{t(locale, "services.brief.title")}</h2>
            <p class="text-xs text-muted-foreground">{t(locale, "services.brief.subtitle")}</p>
          </div>
        </div>
        <button id="close-brief" type="button" class="flex h-8 w-8 items-center justify-center rounded-md hover:bg-panel-raised transition-colors text-muted-foreground hover:text-foreground" aria-label={t(locale, "services.brief.close")}>
          <i class="bx bx-x icon-lg"></i>
        </button>
      </div>

      <div class="brief-modal-body">
        <!-- 1. The Brief Framework -->
        <div class="mb-8">
          <h3 class="text-xs font-semibold text-primary uppercase tracking-wider mb-5">{t(locale, "services.brief.section1")}</h3>
          <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4 sm:gap-2">
            {PIPELINE_NODES.map((n, i) => (
              <div class="flex sm:items-center gap-2 sm:gap-3 w-full sm:w-auto justify-center">
                <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3">
                  <div class:list={["pipeline-icon", n.colorClass, "w-12 h-12 sm:w-10 sm:h-10"]}>
                    <i class={`bx ${n.icon} icon-2xl`}></i>
                  </div>
                  <span class="pipeline-label">{i + 1}. {t(locale, `services.brief.step${i + 1}.name`)}</span>
                </div>
                {i < PIPELINE_NODES.length - 1 && (
                  <i class="bx bx-chevron-right text-muted-hidden sm:block icon-xl rtl:rotate-180"></i>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- 2. Core Agent Statement — animated slots -->
        <div class="mb-8">
          <h3 class="text-xs font-semibold text-primary uppercase tracking-wider mb-3">{t(locale, "services.brief.section2")}</h3>
          <div class="rounded-md border border-border bg-panel p-5">
            <p class="text-sm text-foreground leading-relaxed" set:html={t(locale, "services.brief.statement")} />
          </div>
        </div>

        <!-- 3. What We Define Together -->
        <div class="mb-6">
          <h3 class="text-xs font-semibold text-primary uppercase tracking-wider mb-3">{t(locale, "services.brief.section3")}</h3>
          <div class="rounded-md border border-border bg-panel overflow-hidden">
            {BRIEF_TABLE.map((row, i) => (
              <div class="brief-table-row">
                <span class="text-3xs font-bold text-primary w-4 text-right">{i + 1}</span>
                <div class="flex h-7 w-7 items-center justify-center rounded bg-panel-raised shrink-0">
                  <i class={`bx ${row.icon} text-foreground-muted icon-base`}></i>
                </div>
                <span class="text-xs font-semibold text-foreground-strong w-20 shrink-0">{t(locale, row.nameKey)}</span>
                <span class="text-xs text-muted-foreground">{t(locale, row.descKey)}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="h-px bg-border mb-5"></div>

        <div class="flex items-center gap-3">
          <SpielOSLogo size="sm" />
          <span class="text-xs text-muted-foreground">{t(locale, "services.brief.footer")}</span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ examplesJson }}>
  (function () {
    var openBtn = document.getElementById("open-brief");
    var modal = document.getElementById("brief-modal");
    var closeBtn = document.getElementById("close-brief");
    if (!openBtn || !modal || !closeBtn) return;

    function openModal() {
      modal.removeAttribute("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal.setAttribute("hidden", "");
      document.body.style.overflow = "";
    }

    openBtn.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);
    modal.addEventListener("click", function (e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && !modal.hasAttribute("hidden")) closeModal();
    });

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      var examples = JSON.parse(examplesJson);
      var labels = ["[input]", "[source]", "[job]", "[output]", "[interface]", "[knowledge and memory]", "[rules and approvals]", "[measurable criteria]"];
      var setIdx = 0;
      var slots = modal.querySelectorAll(".brief-slot[data-bracket]");
      var total = slots.length;
      var DUR = 300;

      function fadeAll(to, dur, cb) {
        var starts = [];
        for (var i = 0; i < total; i++) starts.push(parseFloat(getComputedStyle(slots[i]).opacity));
        var t0 = performance.now();
        function tick(now) {
          var p = Math.min((now - t0) / dur, 1);
          for (var i = 0; i < total; i++) {
            slots[i].style.opacity = starts[i] + (to - starts[i]) * p;
          }
          if (p < 1) requestAnimationFrame(tick);
          else if (cb) cb();
        }
        requestAnimationFrame(tick);
      }

      function setTexts(arr) {
        for (var i = 0; i < total; i++) slots[i].textContent = arr[i];
      }

      function fillOne(idx, cb) {
        var el = slots[idx];
        var from = parseFloat(getComputedStyle(el).opacity);
        var t0 = performance.now();
        function tick(now) {
          var p = Math.min((now - t0) / DUR, 1);
          el.style.opacity = from + (0 - from) * p;
          if (p < 1) requestAnimationFrame(tick);
          else {
            el.textContent = "[" + examples[setIdx][idx] + "]";
            el.style.opacity = "0";
            requestAnimationFrame(function () {
              requestAnimationFrame(function () {
                var t1 = performance.now();
                function tick2(now) {
                  var p2 = Math.min((now - t1) / DUR, 1);
                  el.style.opacity = p2;
                  if (p2 < 1) requestAnimationFrame(tick2);
                  else if (cb) cb();
                }
                requestAnimationFrame(tick2);
              });
            });
          }
        }
        requestAnimationFrame(tick);
      }

      function fillAll(cb) {
        var i = 0;
        function next() {
          if (i < total) fillOne(i++, function () { setTimeout(next, 500); });
          else if (cb) cb();
        }
        next();
      }

      function resetAll(cb) {
        fadeAll(0, DUR, function () {
          setTexts(labels);
          fadeAll(1, DUR, cb);
        });
      }

      function loop() {
        setTimeout(function () {
          fillAll(function () {
            setTimeout(function () {
              resetAll(function () {
                setIdx = (setIdx + 1) % examples.length;
                loop();
              });
            }, 3000);
          });
        }, 3500);
      }

      loop();
    }
  })();
  </script>
</Page>
