---
import JourneySignature from "../components/JourneySignature.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import Page from "../layouts/Page.astro";
import { AUTHOR, SITE, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const steps = ["baseline", "define", "connect", "test", "deploy"];
const workflows = ["intake", "support", "reporting", "scheduling", "quality", "research"];
const goodFit = ["customers", "time", "observable", "accessible", "implementation"];
const notFit = ["prerevenue", "chatbot", "rare", "toolkit"];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", "@id": `${SITE.url}${localizePath("/services/", locale)}#service`, name: t(locale, "conversion.services.pageTitle"), description: t(locale, "conversion.services.pageDesc"), url: `${SITE.url}${localizePath("/services/", locale)}`, provider: { "@id": `${SITE.url}/#person`, name: AUTHOR.name }, serviceType: "AI Agent Implementation" },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }, { "@type": "ListItem", position: 2, name: t(locale, "nav.services"), item: `${SITE.url}${localizePath("/services/", locale)}` }] },
  ],
};
---

<Page title={t(locale, "conversion.services.pageTitle")} description={t(locale, "conversion.services.pageDesc")} locale={locale}>
  <section class="relative flex min-h-[76vh] items-center overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.04] hero-grid"></div><div class="absolute left-1/2 top-[42%] h-[32rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div><div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div><div class="absolute inset-y-0 end-0 z-0 hidden w-80 opacity-60 lg:block xl:w-96"><JourneySignature variant="hero-right" gradientId="services-hero-grad" /></div><div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up"><p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.services.hero.label")}</p><h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.services.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.services.hero.titleAccent")}</span></h1><p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.hero.body")}</p><p class="mx-auto mt-4 max-w-2xl text-xs leading-relaxed text-foreground-muted">{t(locale, "conversion.services.hero.evidence")}</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="services_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20">{t(locale, "cta.bookDiscoveryCall")}</button><a href={localizePath("/services/agent-brief/#framework", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.services.hero.secondary")}</a></div></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.brief.title")} description={t(locale, "conversion.services.brief.body")} /><p class="mx-auto -mt-8 mb-8 max-w-3xl text-center text-sm font-medium text-foreground">{t(locale, "conversion.services.brief.footer")}</p><div class="flex justify-center gap-3" data-aos="fade-up"><button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.bookDiscoveryCall")}</button><a href={localizePath("/services/agent-brief/#framework", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.services.brief.secondary")}</a></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.03] hero-grid"></div><div class="relative mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.system.title")} description={t(locale, "conversion.services.system.body")} /><ol class="service-rail relative mx-auto grid max-w-5xl gap-6 sm:grid-cols-5 sm:gap-0" data-aos="fade-up">{steps.map((step, index) => <li class="relative flex items-start gap-4 sm:flex-col sm:items-center sm:px-3 sm:text-center"><span class:list={["relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-md border bg-panel font-mono text-xs font-bold", index < 3 ? "border-primary text-primary shadow-[0_0_20px_var(--primary-soft)]" : "border-border text-muted-foreground"]}>{index + 1}</span><p class="text-xs leading-relaxed text-muted-foreground">{t(locale, `conversion.services.system.${step}`)}</p></li>)}</ol></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.workflows.title")} description={t(locale, "conversion.services.workflows.body")} /><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">{workflows.map((workflow) => <div class="flex gap-3 rounded-md border border-border bg-panel p-5"><i class="bx bx-task mt-0.5 text-primary icon-xl" aria-hidden="true"></i><p class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.workflows.${workflow}`)}</p></div>)}</div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute bottom-0 start-0 z-0 hidden w-64 h-72 opacity-50 lg:block"><JourneySignature variant="corner" gradientId="services-proof-grad" /></div><div class="relative mx-auto max-w-5xl px-6 text-center"><SectionHeader title={t(locale, "conversion.services.proof.title")} description={t(locale, "conversion.services.proof.body")} /><div class="flex flex-col justify-center gap-3 sm:flex-row" data-aos="fade-up"><a href={localizePath("/architecture/", locale)} class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "conversion.services.proof.architecture")}</a><a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.services.proof.live")}</a></div></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.fit.title")} /><div class="grid gap-6 md:grid-cols-2" data-aos="fade-up"><div class="rounded-lg border border-border bg-panel p-6"><h3 class="text-sm font-semibold text-success">{t(locale, "conversion.services.fit.good")}</h3><ul class="mt-4 space-y-3">{goodFit.map((item) => <li class="flex gap-2 text-xs leading-relaxed text-muted-foreground"><i class="bx bx-check-square mt-0.5 text-success icon-md" aria-hidden="true"></i>{t(locale, `conversion.services.fit.${item}`)}</li>)}</ul></div><div class="rounded-lg border border-border bg-panel p-6"><h3 class="text-sm font-semibold text-destructive">{t(locale, "conversion.services.fit.not")}</h3><ul class="mt-4 space-y-3">{notFit.map((item) => <li class="flex gap-2 text-xs leading-relaxed text-muted-foreground"><i class="bx bx-error mt-0.5 text-destructive icon-md" aria-hidden="true"></i>{t(locale, `conversion.services.fit.${item}`)}</li>)}</ul></div></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up"><h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.services.final.title")}</h2><p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.final.body")}</p><button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.bookDiscoveryCall")}</button></div></section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>

<style>
  .service-rail::before { content: ""; position: absolute; inset-inline-start: 1.1rem; top: 1rem; bottom: 1rem; width: 2px; background: linear-gradient(to bottom, var(--primary), var(--accent), var(--border)); }
  @media (min-width: 640px) { .service-rail::before { inset-inline: 10%; top: 1.1rem; bottom: auto; width: auto; height: 2px; background: linear-gradient(to right, var(--primary), var(--accent), var(--border)); } }
</style>
