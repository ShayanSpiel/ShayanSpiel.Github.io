---
import HomepageJourneyRail from "../components/HomepageJourneyRail.astro";
import SectionHeader from "../components/sections/SectionHeader.astro";
import Page from "../layouts/Page.astro";
import { AUTHOR, SITE, BOOKING_LINK, BOOKING_CONFIG } from "../config";
import { localizePath } from "../i18n";
import { type Locale, t } from "../i18n/translations";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const steps = ["baseline", "define", "connect", "test", "deploy"];
const workflows = ["intake", "support", "reporting", "scheduling", "quality", "research"];
const goodFit = ["customers", "time", "observable", "accessible", "implementation"];
const notFit = ["prerevenue", "chatbot", "rare", "toolkit"];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Service", "@id": `${SITE.url}${localizePath("/services/", locale)}#service`, name: t(locale, "conversion.services.pageTitle"), description: t(locale, "conversion.services.pageDesc"), url: `${SITE.url}${localizePath("/services/", locale)}`, provider: { "@id": `${SITE.url}/#person`, name: AUTHOR.name }, serviceType: "AI Agent Implementation" },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: t(locale, "nav.home"), item: `${SITE.url}${localizePath("/", locale)}` }, { "@type": "ListItem", position: 2, name: t(locale, "nav.services"), item: `${SITE.url}${localizePath("/services/", locale)}` }] },
  ],
};
---

<Page title={t(locale, "conversion.services.pageTitle")} description={t(locale, "conversion.services.pageDesc")} locale={locale}>
  <HomepageJourneyRail />
  <section class="relative flex min-h-[76vh] items-center overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.04] hero-grid"></div><div class="absolute left-1/2 top-[42%] h-[32rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div><div class="absolute left-[58%] top-[38%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div><div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up"><p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "conversion.services.hero.label")}</p><h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "conversion.services.hero.titleLead")}<br /><span class="text-primary">{t(locale, "conversion.services.hero.titleAccent")}</span></h1><p class="mx-auto mt-6 max-w-3xl text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.hero.body")}</p><p class="mx-auto mt-4 max-w-2xl text-xs leading-relaxed text-foreground-muted">{t(locale, "conversion.services.hero.evidence")}</p><div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row"><button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta data-cta-location="services_hero" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20">{t(locale, "cta.bookDiscoveryCall")}</button><a href={localizePath("/services/agent-brief/#framework", locale)} class="inline-flex items-center justify-center rounded-md border border-border bg-panel px-6 h-11 text-sm font-medium">{t(locale, "conversion.services.hero.secondary")}</a></div></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.brief.title")} description={t(locale, "conversion.services.brief.body")} /><p class="mx-auto -mt-8 mb-8 max-w-3xl text-center text-sm font-medium text-foreground">{t(locale, "conversion.services.brief.footer")}</p><div class="flex justify-center gap-3" data-aos="fade-up"><button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.bookDiscoveryCall")}</button><a href={localizePath("/services/agent-brief/#framework", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.services.brief.secondary")}</a></div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="absolute inset-0 opacity-[0.03] hero-grid"></div><div class="relative mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.system.title")} description={t(locale, "conversion.services.system.body")} /><ol class="service-rail relative mx-auto grid max-w-5xl gap-6 sm:grid-cols-5 sm:gap-0" data-aos="fade-up">{steps.map((step, index) => <li class="relative flex items-start gap-4 sm:flex-col sm:items-center sm:px-3 sm:text-center"><span class:list={["relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-md border bg-panel font-mono text-xs font-bold", index < 3 ? "border-primary text-primary shadow-[0_0_20px_var(--primary-soft)]" : "border-border text-muted-foreground"]}>{index + 1}</span><p class="text-xs leading-relaxed text-muted-foreground">{t(locale, `conversion.services.system.${step}`)}</p></li>)}</ol></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.workflows.title")} description={t(locale, "conversion.services.workflows.body")} /><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-aos="fade-up">{workflows.map((workflow, idx) => {
            const wfMeta = {
              intake: { icon: "bx-envelope", tile: "bg-primary-soft text-primary", gradient: "from-primary via-accent to-transparent" },
              support: { icon: "bx-support", tile: "bg-accent-soft text-accent", gradient: "from-accent via-purple to-transparent" },
              reporting: { icon: "bx-data", tile: "bg-purple-soft text-purple", gradient: "from-purple via-warning to-transparent" },
              scheduling: { icon: "bx-calendar", tile: "bg-warning-soft text-warning", gradient: "from-warning via-success to-transparent" },
              quality: { icon: "bx-check-shield", tile: "bg-success-soft text-success", gradient: "from-success via-primary to-transparent" },
              research: { icon: "bx-search", tile: "bg-info-soft text-info", gradient: "from-info via-accent to-transparent" },
            };
            const m = (wfMeta as any)[workflow] ?? { icon: "bx-task", tile: "bg-primary-soft text-primary", gradient: "from-primary via-accent to-transparent" };
            return (
              <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong">
                <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-80", m.gradient]} aria-hidden="true"></div>
                <div class:list={["mb-3 flex h-10 w-10 items-center justify-center rounded-md", m.tile]}><i class:list={["bx", m.icon, "icon-xl"]} aria-hidden="true"></i></div>
                <p class="text-sm leading-relaxed text-muted-foreground">{t(locale, `conversion.services.workflows.${workflow}`)}</p>
              </article>
            );
          })}</div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-5xl px-6 text-center"><SectionHeader title={t(locale, "conversion.services.proof.title")} description={t(locale, "conversion.services.proof.body")} /><div class="flex flex-col justify-center gap-3 sm:flex-row" data-aos="fade-up"><a href={localizePath("/features/", locale)} class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "conversion.services.proof.architecture")}</a><a href={localizePath("/live/", locale)} class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium">{t(locale, "conversion.services.proof.live")}</a></div></div></section>

  <section class="relative py-24 sm:py-32"><div class="mx-auto max-w-6xl px-6"><SectionHeader title={t(locale, "conversion.services.fit.title")} /><div class="grid gap-3 md:grid-cols-2" data-aos="fade-up">
        <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-success via-accent to-transparent opacity-80" aria-hidden="true"></div>
          <h3 class="text-sm font-semibold text-success flex items-center gap-2"><span class="flex h-7 w-7 items-center justify-center rounded-md bg-success-soft text-success"><i class="bx bx-check-square icon-md" aria-hidden="true"></i></span>{t(locale, "conversion.services.fit.good")}</h3>
          <ul class="mt-4 space-y-3">{goodFit.map((item) => <li class="flex gap-2.5 text-xs leading-relaxed text-muted-foreground"><i class="bx bx-check-square mt-0.5 text-success icon-md shrink-0" aria-hidden="true"></i><span>{t(locale, `conversion.services.fit.${item}`)}</span></li>)}</ul>
        </article>
        <article class="relative overflow-hidden rounded-lg border border-border bg-panel p-6 shadow-panel">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-destructive via-warning to-transparent opacity-80" aria-hidden="true"></div>
          <h3 class="text-sm font-semibold text-destructive flex items-center gap-2"><span class="flex h-7 w-7 items-center justify-center rounded-md bg-destructive-soft text-destructive"><i class="bx bx-error icon-md" aria-hidden="true"></i></span>{t(locale, "conversion.services.fit.not")}</h3>
          <ul class="mt-4 space-y-3">{notFit.map((item) => <li class="flex gap-2.5 text-xs leading-relaxed text-muted-foreground"><i class="bx bx-error mt-0.5 text-destructive icon-md shrink-0" aria-hidden="true"></i><span>{t(locale, `conversion.services.fit.${item}`)}</span></li>)}</ul>
        </article>
      </div></div></section>

  <section class="relative overflow-hidden py-24 sm:py-32"><div class="absolute inset-0 bg-panel-deep/50"></div><div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up"><h2 class="text-3xl font-bold tracking-tight text-foreground-strong sm:text-4xl">{t(locale, "conversion.services.final.title")}</h2><p class="mt-4 text-base leading-relaxed text-muted-foreground">{t(locale, "conversion.services.final.body")}</p><button type="button" data-cal-link={BOOKING_LINK} data-cal-config={JSON.stringify(BOOKING_CONFIG)} data-cal-cta class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground">{t(locale, "cta.bookDiscoveryCall")}</button></div></section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Page>

<style>
  .service-rail::before { content: ""; position: absolute; inset-inline-start: 1.1rem; top: 1rem; bottom: 1rem; width: 2px; background: linear-gradient(to bottom, var(--primary), var(--accent), var(--border)); }
  @media (min-width: 640px) { .service-rail::before { inset-inline: 10%; top: 1.1rem; bottom: auto; width: auto; height: 2px; background: linear-gradient(to right, var(--primary), var(--accent), var(--border)); } }
</style>
