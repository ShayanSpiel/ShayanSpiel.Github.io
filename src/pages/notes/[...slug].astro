---
import { getCollection, type CollectionEntry } from "astro:content";
import Page from "../../layouts/Page.astro";
import { SITE, AUTHOR } from "../../config";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.data.permalink.replace(/^\/|\/$/g, "") },
    props: { note, locale: "en" as Locale },
  }));
}

interface Props {
  note: CollectionEntry<"notes"> | CollectionEntry<"notesFa">;
  locale: Locale;
}

const { note, locale } = Astro.props;
const { Content } = await note.render();
const { title, description, date, tags, image } = note.data;

const localeCode = locale === "fa" ? "fa-IR" : "en-US";
const formattedDate = date.toLocaleDateString(localeCode, { year: "numeric", month: "long", day: "numeric" });
const isoDate = date.toISOString();

const urlPrefix = locale === "fa" ? "/fa/notes" : "/notes";
const articleUrl = `${SITE.url}${urlPrefix}${note.data.permalink}`;
const imageUrl = image && image.startsWith("http") ? image : `${SITE.url}${image || `/assets/og/${note.data.permalink.replaceAll("/", "")}.png`}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${articleUrl}#article`,
  headline: title,
  description,
  url: articleUrl,
  image: imageUrl,
  datePublished: isoDate,
  dateModified: isoDate,
  inLanguage: locale === "fa" ? "fa" : "en",
  author: {
    "@type": "Person",
    "@id": `${SITE.url}/#person`,
    name: AUTHOR.name,
    url: `${SITE.url}/founder/`,
  },
  publisher: { "@id": `${SITE.url}/#organization` },
  isPartOf: { "@id": `${SITE.url}/#website` },
  mainEntityOfPage: articleUrl,
  ...(tags.length > 0 && { keywords: tags.join(", ") }),
  ...(tags.length > 0 && { articleSection: tags[0] }),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "notes.title"), item: `${SITE.url}${localizePath("/notes/", locale)}` },
    { "@type": "ListItem", position: 3, name: title, item: articleUrl },
  ],
};
---

<Page title={title} description={description} image={image || `/assets/og/${note.data.permalink.replaceAll("/", "")}.png`} ogType="article" publishedTime={isoDate} modifiedTime={isoDate} tags={tags} locale={locale}>
  <article class="mx-auto max-w-2xl px-6 pt-8 pb-16">
    <nav class="breadcrumb" aria-label={t(locale, "notes.breadcrumbAria")}>
      <a href={localizePath("/", locale)}>{t(locale, "nav.home")}</a>
      <span class="sep" aria-hidden="true">·</span>
      <a href={localizePath("/notes/", locale)}>{t(locale, "notes.title")}</a>
      <span class="sep" aria-hidden="true">·</span>
      <span class="current" aria-current="page">{title}</span>
    </nav>

    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={isoDate}>{formattedDate}</time>
        <span class="post-meta-sep" aria-hidden="true">·</span>
        <span>{t(locale, "founder.byline", { name: AUTHOR.name })}</span>
      </div>
    </header>

    <div class="post-content">
      <Content />
    </div>

    <div class="post-end-sep" aria-hidden="true">· · ·</div>

    {tags.length > 0 && (
      <div class="post-tags" role="list" aria-label={t(locale, "notes.tagsAria")}>
        {tags.map((tag) => (
          <a href={localizePath(`/notes/?tag=${tag}`, locale)} class="tag-chip">#{tag}</a>
        ))}
      </div>
    )}
  </article>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <script>
    document.querySelectorAll('.post-content .war-reveal').forEach((el) => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(el);
    });
  </script>
</Page>
