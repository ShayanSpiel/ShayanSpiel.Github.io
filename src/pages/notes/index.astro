---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { SITE, AUTHOR } from "../../config";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const allNotes = await getCollection(locale === "fa" ? "notesFa" : "notes");
const sorted = allNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();
const categories = ["journey", "ai-agents"] as const;
const urlPrefix = locale === "fa" ? "/fa/notes" : "/notes";

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t(locale, "notes.title"),
  description: t(locale, "notes.desc"),
  url: `${SITE.url}${localizePath("/notes/", locale)}`,
  isPartOf: { "@id": `${SITE.url}/#website` },
  about: { "@id": `${SITE.url}/#person` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: sorted.map((post, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${SITE.url}${urlPrefix}${post.data.permalink}`,
      name: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
    })),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "notes.title"), item: `${SITE.url}${localizePath("/notes/", locale)}` },
  ],
};

const categoryMeta = {
  journey: {
    label: t(locale, "notes.categories.journey"),
    desc: t(locale, "notes.categories.journeyDesc"),
  },
  "ai-agents": {
    label: t(locale, "notes.categories.ai-agents"),
    desc: t(locale, "notes.categories.aiAgentsDesc"),
  },
};
const categoryMetaJson = JSON.stringify(categoryMeta);
const noResultsLabel = t(locale, "notes.noResults");

const categoryIcons: Record<string, string> = { journey: "bx-compass", "ai-agents": "bx-bot" };
const cardGradients = ["from-primary via-accent to-transparent", "from-accent via-purple to-transparent", "from-purple via-warning to-transparent", "from-warning via-success to-transparent", "from-success via-primary to-transparent"];
---

<Page
  title={`${t(locale, "notes.title")} — ${AUTHOR.name}`}
  description={t(locale, "notes.desc")}
  image="/assets/og/blog.png"
  locale={locale}
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[38%] h-[30rem] w-[46rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-15"></div>
    <div class="absolute left-[60%] top-[30%] h-64 w-64 rounded-full opacity-10" style="background: radial-gradient(closest-side, var(--accent), transparent 72%);"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "notes.label")}</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-foreground-strong sm:text-5xl leading-tightest">{t(locale, "notes.title")}</h1>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground">
        {t(locale, "notes.desc")}
      </p>
      <p class="mx-auto mt-1 max-w-xl text-sm leading-relaxed text-muted-foreground">{t(locale, "notes.desc2")}</p>
    </div>
  </section>

  <!-- Filters + Grid -->
  <section class="relative py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Stats -->
      <div class="flex items-center justify-center gap-3 mb-8" data-aos="fade-up">
        <span class="inline-flex items-center gap-2 rounded-md border border-border bg-panel px-3 py-1.5 text-xs text-muted-foreground shadow-panel">
          <i class="bx bx-file text-primary icon-sm" aria-hidden="true"></i>
          <strong id="notes-count" class="font-semibold text-foreground-strong">{sorted.length}</strong> {t(locale, "notes.stats.notes")}
        </span>
        <span class="inline-flex items-center gap-2 rounded-md border border-border bg-panel px-3 py-1.5 text-xs text-muted-foreground shadow-panel">
          <i class="bx bx-purchase-tag text-accent icon-sm" aria-hidden="true"></i>
          <strong class="font-semibold text-foreground-strong">{allTags.length}</strong> {t(locale, "notes.stats.topics")}
        </span>
        <span class="hidden sm:inline-flex items-center rounded-md border border-border bg-panel px-3 py-1.5 text-xs text-muted-foreground shadow-panel">
          {t(locale, "notes.stats.newestFirst")}
        </span>
      </div>

      <!-- Category filters -->
      <div id="category-filters" class="flex flex-wrap items-center justify-center gap-2 mb-3" role="group" aria-label={t(locale, "notes.categories.label")}>
        <button type="button" data-category="" class="inline-flex items-center gap-1.5 rounded-md px-4 py-2 text-xs font-semibold transition-all bg-primary text-primary-foreground shadow-panel hover:brightness-110">
          <i class="bx bx-grid-alt icon-sm" aria-hidden="true"></i>{t(locale, "notes.categories.all")}
        </button>
        {categories.map((cat) => (
          <button type="button" data-category={cat} class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-4 py-2 text-xs font-medium text-muted-foreground shadow-panel transition-all hover:border-border-strong hover:bg-panel-raised hover:text-foreground">
            <i class:list={["bx", categoryIcons[cat], "icon-sm"]} aria-hidden="true"></i>{t(locale, `notes.categories.${cat}`)}
          </button>
        ))}
      </div>

      <p id="category-desc" class="mx-auto max-w-xl text-center text-xs leading-relaxed text-muted-foreground mb-8 min-h-[1rem]"></p>

      <div id="notes-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((post, idx) => (
          <a
            href={localizePath(`/notes${post.data.permalink}`, locale)}
            class="post-card group relative flex flex-col overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-1 hover:border-border-strong hover:shadow-panel"
            data-category={post.data.category}
            data-tags={post.data.tags.join("|")}
            data-aos="fade-up"
          >
            <div class:list={["absolute inset-x-0 top-0 h-px bg-gradient-to-r opacity-70", cardGradients[idx % cardGradients.length]]} aria-hidden="true"></div>
            <div class="mb-3 flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1 rounded-md bg-panel-raised px-2 py-1 text-2xs font-medium text-muted-foreground border border-border">
                <i class="bx bx-calendar icon-xs" aria-hidden="true"></i>
                {post.data.date.toLocaleDateString(locale === "fa" ? "fa-IR" : "en-US", { month: "short", day: "numeric", year: "numeric" })}
              </span>
              {post.data.category && <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-primary-soft text-primary"><i class:list={["bx", categoryIcons[post.data.category] ?? "bx-file", "icon-sm"]} aria-hidden="true"></i></span>}
            </div>
            <h3 class="text-sm font-semibold leading-snug text-foreground-strong line-clamp-2 group-hover:text-primary transition-colors">{post.data.title}</h3>
            <p class="mt-2 flex-1 text-xs leading-relaxed text-muted-foreground line-clamp-3">{post.data.description}</p>
            <div class="mt-4 flex items-center justify-between gap-2">
              {post.data.tags.length > 0 ? (
                <span class="inline-flex items-center rounded-md bg-accent-soft px-2 py-1 text-2xs font-semibold uppercase tracking-widest text-accent">#{post.data.tags[0]}</span>
              ) : <span></span>}
              <span class="inline-flex items-center gap-1 text-2xs font-semibold text-primary opacity-0 transition-opacity group-hover:opacity-100">{t(locale, "common.readMore")}<i class="bx bx-chevron-right rtl-flip icon-xs" aria-hidden="true"></i></span>
            </div>
          </a>
        ))}
      </div>

      <div id="notes-empty" class="hidden rounded-xl border border-dashed border-border bg-panel/50 p-10 text-center shadow-panel">
        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-md bg-panel-raised text-muted-foreground mb-3"><i class="bx bx-search icon-xl" aria-hidden="true"></i></div>
        <p class="text-sm font-medium text-foreground-strong"></p>
        <p class="mt-1 text-xs text-muted-foreground">{t(locale, "notes.noResults")}</p>
      </div>

      {allTags.length > 0 && (
        <details id="tag-filters-details" class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-xl border border-border bg-panel shadow-panel" data-aos="fade-up">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-xs font-semibold text-foreground-strong hover:bg-panel-raised transition-colors select-none">
            <span class="inline-flex items-center gap-2"><i class="bx bx-purchase-tag text-accent icon-sm" aria-hidden="true"></i>{t(locale, "notes.browseByTopic")} ({allTags.length})</span>
            <i class="bx bx-chevron-down icon-sm text-muted-foreground" aria-hidden="true"></i>
          </summary>
          <div class="border-t border-border bg-panel-deep/30 px-5 py-4">
            <div id="tag-filters" class="flex flex-wrap gap-2">
              <button type="button" data-tag="" class="inline-flex items-center rounded-md px-3 py-1.5 text-2xs font-semibold transition-colors bg-primary text-primary-foreground">All</button>
              {allTags.map((tag) => (
                <button type="button" data-tag={tag} class="inline-flex items-center rounded-md border border-border bg-panel px-3 py-1.5 text-2xs font-medium text-muted-foreground transition-colors hover:border-border-strong hover:bg-panel-raised hover:text-foreground">#{tag}</button>
              ))}
            </div>
          </div>
        </details>
      )}
    </div>

  </section>

  <script is:inline set:html={`
    (() => {
      const categoryMeta = ${categoryMetaJson};
      const noResults = ${JSON.stringify(noResultsLabel)};

      const grid = document.getElementById("notes-grid");
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll(".post-card"));
      const emptyEl = document.getElementById("notes-empty");
      const countEl = document.getElementById("notes-count");
      const descEl = document.getElementById("category-desc");

      const activeCategory = ["bg-primary", "text-primary-foreground", "shadow-panel", "border-transparent"];
      const inactiveCategory = ["bg-panel", "text-muted-foreground", "border", "border-border", "shadow-panel", "hover:border-border-strong", "hover:bg-panel-raised", "hover:text-foreground"];
      const activeTag = ["bg-primary", "text-primary-foreground", "border-transparent"];
      const inactiveTag = ["bg-panel", "text-muted-foreground", "border", "border-border", "hover:border-border-strong", "hover:bg-panel-raised", "hover:text-foreground"];

      let category = "";
      let tag = "";

      function readParams() {
        const params = new URLSearchParams(location.search);
        category = categoryMeta[params.get("category")] ? params.get("category") : "";
        tag = params.get("tag") || "";
        if (tag && !cards.some((c) => (c.dataset.tags || "").split("|").includes(tag))) tag = "";
      }

      function syncButtons() {
        document.querySelectorAll("#category-filters [data-category]").forEach((btn) => {
          const value = btn.getAttribute("data-category") || "";
          const isActive = value === category;
          btn.classList.remove(...activeCategory, ...inactiveCategory);
          btn.classList.add(...(isActive ? activeCategory : inactiveCategory));
          btn.setAttribute("aria-pressed", String(isActive));
        });
        document.querySelectorAll("#tag-filters [data-tag]").forEach((btn) => {
          const value = btn.getAttribute("data-tag") || "";
          const isActive = value === tag;
          btn.classList.remove(...activeTag, ...inactiveTag);
          btn.classList.add(...(isActive ? activeTag : inactiveTag));
          btn.setAttribute("aria-pressed", String(isActive));
        });
      }

      function render() {
        let visible = 0;
        cards.forEach((card) => {
          const matchCategory = !category || card.dataset.category === category;
          const matchTag = !tag || (card.dataset.tags || "").split("|").includes(tag);
          const show = matchCategory && matchTag;
          card.classList.toggle("hidden", !show);
          if (show) visible++;
        });
        if (countEl) countEl.textContent = String(visible);
        if (descEl) {
          if (category && categoryMeta[category]) {
            descEl.textContent = categoryMeta[category].desc;
            descEl.classList.remove("hidden");
          } else {
            descEl.textContent = "";
            descEl.classList.add("hidden");
          }
        }
        if (emptyEl) {
          const showEmpty = visible === 0;
          emptyEl.classList.toggle("hidden", !showEmpty);
          const p = emptyEl.querySelector("p");
          if (p) p.textContent = showEmpty ? noResults : "";
        }
        syncButtons();
      }

      function apply() {
        readParams();
        render();
      }

      document.getElementById("category-filters")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-category]");
        if (!btn) return;
        const url = new URL(location.href);
        const value = btn.getAttribute("data-category") || "";
        if (value) url.searchParams.set("category", value);
        else url.searchParams.delete("category");
        history.pushState(null, "", url.toString());
        apply();
      });

      const tagFilters = document.getElementById("tag-filters");
      if (tagFilters) tagFilters.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-tag]");
        if (!btn) return;
        const url = new URL(location.href);
        const value = btn.getAttribute("data-tag") || "";
        if (value) url.searchParams.set("tag", value);
        else url.searchParams.delete("tag");
        history.pushState(null, "", url.toString());
        apply();
      });

      window.addEventListener("popstate", apply);

      apply();
    })();
  `} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
