---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { SITE, AUTHOR } from "../../config";
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const activeTag = Astro.url.searchParams.get("tag") || null;
const activeCategory = Astro.url.searchParams.get("category") || null;

const allNotes = await getCollection(locale === "fa" ? "notesFa" : "notes");
const sorted = allNotes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const filtered = sorted.filter((p) => {
  if (activeCategory && p.data.category !== activeCategory) return false;
  if (activeTag && !p.data.tags.includes(activeTag)) return false;
  return true;
});

const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();
const categories = ["journey", "ai-agents"] as const;

const urlPrefix = locale === "fa" ? "/fa/notes" : "/notes";

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: activeTag ? `#${activeTag} — ${t(locale, "notes.title")}` : t(locale, "notes.title"),
  description: activeTag
    ? `${t(locale, "notes.desc")} Filtered by #${activeTag}.`
    : t(locale, "notes.desc"),
  url: `${SITE.url}${localizePath(activeTag ? `/notes/?tag=${encodeURIComponent(activeTag)}` : "/notes/", locale)}`,
  isPartOf: { "@id": `${SITE.url}/#website` },
  about: { "@id": `${SITE.url}/#person` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: filtered.map((post, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${SITE.url}${urlPrefix}${post.data.permalink}`,
      name: post.data.title,
      description: post.data.description,
      datePublished: post.data.date.toISOString(),
    })),
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: t(locale, "notes.title"), item: `${SITE.url}${localizePath("/notes/", locale)}` },
  ],
};
---

<Page
  title={activeTag ? `#${activeTag} — ${t(locale, "notes.title")} — ${AUTHOR.name}` : `${t(locale, "notes.title")} — ${AUTHOR.name}`}
  description={activeTag ? `${t(locale, "notes.desc")} Filtered by #${activeTag}.` : t(locale, "notes.desc")}
  image="/assets/og/blog.png"
  locale={locale}
  robots={activeTag || activeCategory ? "noindex, follow" : undefined}
>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-4xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "notes.label")}</span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "notes.title")}</h1>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">
          {t(locale, "notes.desc")}
          <br />
          {t(locale, "notes.desc2")}
        </p>
      </div>

      <div class="flex items-center justify-center gap-4 mb-10 text-xs text-muted-foreground">
        <span><strong class="text-foreground-strong font-semibold">{filtered.length}</strong> {t(locale, "notes.stats.notes")}</span>
        <span class="text-border-strong" aria-hidden="true">·</span>
        <span><strong class="text-foreground-strong font-semibold">{allTags.length}</strong> {t(locale, "notes.stats.topics")}</span>
        <span class="text-border-strong" aria-hidden="true">·</span>
        <span>{t(locale, "notes.stats.newestFirst")}</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-2 mb-10" role="group" aria-label={t(locale, "notes.categories.label")}>
        <a href={localizePath("/notes/", locale)} class:list={[
          "inline-flex items-center rounded-md px-4 py-1.5 text-xs font-medium transition-colors",
          !activeCategory ? "bg-primary text-primary-foreground" : "bg-panel-raised text-muted-foreground hover:text-foreground border border-border",
        ]}>{t(locale, "notes.categories.all")}</a>
        {categories.map((cat) => (
          <a href={localizePath(`/notes/?category=${cat}`, locale)} class:list={[
            "inline-flex items-center rounded-md px-4 py-1.5 text-xs font-medium transition-colors",
            activeCategory === cat ? "bg-primary text-primary-foreground" : "bg-panel-raised text-muted-foreground hover:text-foreground border border-border",
          ]}>{t(locale, `notes.categories.${cat}`)}</a>
        ))}
      </div>

      <div class="post-grid">
        {filtered.map((post) => (
          <a href={localizePath(`/notes${post.data.permalink}`, locale)} class="post-card">
            <div class="post-card-date">
              {post.data.date.toLocaleDateString(locale === "fa" ? "fa-IR" : "en-US", { month: "short", day: "numeric", year: "numeric" })}
            </div>
            <h3 class="post-card-title">{post.data.title}</h3>
            <p class="post-card-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="post-card-cat">{post.data.tags[0]}</div>
            )}
          </a>
        ))}
      </div>

      {allTags.length > 0 && (
        <details class="mt-12" open={!!activeTag} data-aos="fade-up">
          <summary class="cursor-pointer text-xs text-muted-foreground hover:text-foreground transition-colors select-none">
            {t(locale, "notes.browseByTopic")} ({allTags.length})
          </summary>
          <div class="flex flex-wrap gap-2 mt-4">
            <a href={localizePath("/notes/", locale)} class:list={[
              "inline-flex items-center rounded-md px-3 py-1 text-2xs font-medium transition-colors",
              !activeTag ? "bg-primary text-primary-foreground" : "bg-panel-raised text-muted-foreground hover:text-foreground border border-border",
            ]}>All</a>
            {allTags.map((tag) => (
              <a href={localizePath(`/notes/?tag=${tag}`, locale)} class:list={[
                "inline-flex items-center rounded-md px-3 py-1 text-2xs font-medium transition-colors",
                activeTag === tag ? "bg-primary text-primary-foreground" : "bg-panel-raised text-muted-foreground hover:text-foreground border border-border",
              ]}>#{tag}</a>
            ))}
          </div>
        </details>
      )}
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
