---
import Page from "../layouts/Page.astro";
import { SITE, AUTHOR } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}${localizePath("/", locale)}` },
    { "@type": "ListItem", position: 2, name: "About", item: `${SITE.url}${localizePath("/about/", locale)}` },
  ],
};
---

<Page
  title={t(locale, "about.title")}
  description={t(locale, "about.desc")}
  image="/assets/og/about.png"
  locale={locale}
>
  <section class="py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <div class="text-center mb-12" data-aos="fade-up">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "about.label")}</span>
        <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "about.title")}</h1>
        <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">
          {t(locale, "about.desc")}
        </p>
      </div>

      <div data-aos="fade-up" class="prose-center">
        <p>{t(locale, "about.p1")}</p>
      </div>

      <hr class="border-t border-border my-16" />

      <div data-aos="fade-up" class="text-center mb-12">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "about.founder.label")}</span>
        <h2 class="mt-3 text-2xl sm:text-3xl font-bold text-foreground-strong tracking-tight">{t(locale, "about.founder.title")}</h2>
      </div>

      <div class="flex flex-col sm:flex-row items-start gap-8" data-aos="fade-up">
        <img src="/assets/avatars/avatar.jpg" alt={AUTHOR.name} width="120" height="120" class="rounded-lg shrink-0" loading="lazy" />
        <div>
          <p class="text-sm text-foreground leading-relaxed mb-4">
            {t(locale, "about.founder.p1")}
          </p>
          <p class="text-sm text-foreground leading-relaxed mb-4">
            {t(locale, "about.founder.p2")}
          </p>
          <p class="text-sm text-foreground leading-relaxed">
            {t(locale, "about.founder.p3")}
          </p>
          <a href={localizePath("/founder/", locale)} class="inline-flex items-center gap-1.5 text-xs text-primary font-medium mt-4 hover:opacity-80 transition-opacity">
            {t(locale, "about.founder.link")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Page>
