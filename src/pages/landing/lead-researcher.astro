---
import Page from "../../layouts/Page.astro";
import SectionHeader from "../../components/sections/SectionHeader.astro";
import { APPLY_PATH } from "../../config";
import { localizePath } from "../../i18n";
import { type Locale, t } from "../../i18n/translations";
import { brandLogo } from "../../data/brand-logos";

export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;

const REPO_URL = "https://github.com/ShayanSpiel/Lead-Researcher";
const PASTE_MSG = t(locale, "landing.lr.install.paste");

const whatCards = [
  { icon: "bx-bullseye", color: "primary", title: t(locale, "landing.lr.what.card1Title"), desc: t(locale, "landing.lr.what.card1Desc") },
  { icon: "bx-check-square", color: "success", title: t(locale, "landing.lr.what.card2Title"), desc: t(locale, "landing.lr.what.card2Desc") },
  { icon: "bx-file", color: "accent", title: t(locale, "landing.lr.what.card3Title"), desc: t(locale, "landing.lr.what.card3Desc") },
];

const whyLinks = [
  { icon: "bx-group", href: "/features/departments/", title: t(locale, "landing.lr.why.link1"), desc: t(locale, "landing.lr.why.link1Desc") },
  { icon: "bx-user", href: "/features/agents/", title: t(locale, "landing.lr.why.link2"), desc: t(locale, "landing.lr.why.link2Desc") },
  { icon: "bx-network-chart", href: "/features/workflows/", title: t(locale, "landing.lr.why.link3"), desc: t(locale, "landing.lr.why.link3Desc") },
  { icon: "bx-task", href: "/features/artifacts/", title: t(locale, "landing.lr.why.link4"), desc: t(locale, "landing.lr.why.link4Desc") },
  { icon: "bx-data", href: "/solutions/", title: t(locale, "landing.lr.why.link5"), desc: t(locale, "landing.lr.why.link5Desc") },
];


const hosts = [
  { key: "claudecode", name: "Claude Code", url: "https://claude.com/product/claude-code", desc: t(locale, "landing.lr.install.claudeDesc") },
  { key: "codex", name: "Codex CLI", url: "https://developers.openai.com/codex/cli/", desc: t(locale, "landing.lr.install.codexDesc") },
  { key: "opencode", name: "OpenCode", url: "https://opencode.ai", desc: t(locale, "landing.lr.install.opencodeDesc") },
];

/* Owner-verified outbound performance:
   - leads + emails sent from SpielOS runtime evidence (2026-08-24);
   - open/click rates as reported on the Brevo and Resend sender
     dashboards (owner-verified 2026-08-24) — the runtime snapshot
     undercounts clicks because provider link tracking is not fully
     wired into measurement yet. */
const stats: { value: string; labelKey: string; icon: string; color: string; sub?: string; subLabelKey?: string }[] = [
  { value: "3,098", labelKey: "landing.lr.stats.leadsTotal", icon: "bx-group", color: "primary" },
  { value: "2,000", labelKey: "landing.lr.stats.weekend", icon: "bx-trending-up", color: "success" },
  { value: "1,093", labelKey: "landing.lr.stats.sent", icon: "bx-send", color: "accent" },
  { value: "534", sub: "298", subLabelKey: "landing.lr.stats.clicked", labelKey: "landing.lr.stats.opened", icon: "bx-bar-chart-alt-2", color: "purple" },
];

const usage = [
  { say: t(locale, "landing.lr.use.say1"), mean: t(locale, "landing.lr.use.mean1"), icon: "bx-play" },
  { say: t(locale, "landing.lr.use.say2"), mean: t(locale, "landing.lr.use.mean2"), icon: "bx-bar-chart-alt-2" },
  { say: t(locale, "landing.lr.use.say3"), mean: t(locale, "landing.lr.use.mean3"), icon: "bx-slider" },
  { say: t(locale, "landing.lr.use.say4"), mean: t(locale, "landing.lr.use.mean4"), icon: "bx-download" },
];
---

<Page title={t(locale, "landing.lr.pageTitle")} description={t(locale, "landing.lr.pageDesc")} image="/assets/og/lead-researcher.png" locale={locale}>
  {/* ------------------------------------------------------------- hero */}
  <section class="relative flex min-h-[72vh] items-center overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
    <div class="absolute left-1/2 top-[42%] h-[32rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 glow-blob opacity-20"></div>
    <div class="relative mx-auto max-w-4xl px-6 text-center" data-aos="fade-up">
      <p class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "landing.lr.hero.label")}</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-tightest tracking-tight text-foreground-strong sm:text-6xl">{t(locale, "landing.lr.hero.titleLead")}<br /><span class="text-primary">{t(locale, "landing.lr.hero.titleAccent")}</span></h1>
      <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground">{t(locale, "landing.lr.hero.desc")}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#install" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground transition-all hover:brightness-110 active:brightness-95">
          <i class="bx bx-download icon-base me-2"></i>{t(locale, "landing.lr.hero.cta")}
        </a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium text-foreground transition-all hover:border-border-strong hover:bg-panel-raised">
          <i class="bx bx-code-alt icon-base me-2"></i>GitHub
        </a>
      </div>
      <p class="mt-5 text-xs text-muted-foreground">{t(locale, "landing.lr.hero.ctaSub")}</p>
      <p class="mt-8 text-2xs font-medium uppercase tracking-widest text-foreground-muted">{t(locale, "landing.lr.hero.trust")}</p>
    </div>
  </section>

  {/* -------------------------------------------------------- what it is */}
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "landing.lr.what.label")} title={t(locale, "landing.lr.what.title")} description={t(locale, "landing.lr.what.desc")} />
      <div class="grid gap-5 sm:grid-cols-3" data-aos="fade-up">
        {whatCards.map((card) => (
          <div class="rounded-md border border-border bg-panel p-6">
            <div class:list={["mb-4 flex h-10 w-10 items-center justify-center rounded-md", `bg-${card.color}-soft`]}>
              <i class:list={["bx icon-xl", card.icon, `text-${card.color}`]}></i>
            </div>
            <h3 class="mb-2 text-sm font-semibold text-foreground-strong">{card.title}</h3>
            <p class="text-xs leading-relaxed text-muted-foreground">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ------------------------------------------------- real numbers (proof) */}
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
    <div class="relative mx-auto max-w-6xl px-6">
      <SectionHeader label={t(locale, "landing.lr.stats.label")} title={t(locale, "landing.lr.stats.title")} description={t(locale, "landing.lr.stats.desc")} />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-aos="fade-up">
        {stats.map((stat) => (
          <div class="rounded-md border border-border bg-panel p-6 text-center shadow-panel transition-all hover:border-border-strong">
            <div class:list={["mx-auto mb-4 flex h-10 w-10 items-center justify-center rounded-md", `bg-${stat.color}-soft`]}>
              <i class:list={["bx icon-xl", stat.icon, `text-${stat.color}`]}></i>
            </div>
            <p class="text-4xl font-extrabold tracking-tight text-foreground-strong sm:text-5xl">{stat.value}</p>
            <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{t(locale, stat.labelKey)}</p>
            {stat.sub ? (
              <p class="mt-1.5 text-xs font-medium text-muted-foreground">{stat.sub} {t(locale, stat.subLabelKey ?? "")}</p>
            ) : null}
          </div>
        ))}
      </div>

      {/* keep the company-context links: where this worker lives inside SpielOS */}
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2.5" data-aos="fade-up">
        {whyLinks.map((link) => (
          <a href={localizePath(link.href, locale)} class="inline-flex items-center gap-1.5 rounded-md border border-border bg-panel px-4 py-2 text-xs font-semibold text-foreground transition-all hover:border-border-strong hover:bg-panel-raised hover:text-primary">
            <i class:list={["bx icon-sm text-primary", link.icon]}></i>{link.title}
          </a>
        ))}
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 rounded-md border border-dashed border-border px-4 py-2 text-xs font-semibold text-primary transition-all hover:border-border-strong">
          <i class="bx bx-link icon-sm"></i>{REPO_URL.replace("https://", "")}
        </a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ install */}
  <section id="install" class="relative scroll-mt-20 py-24 sm:py-32">
    <div class="mx-auto max-w-3xl px-6">
      <SectionHeader label={t(locale, "landing.lr.install.label")} title={t(locale, "landing.lr.install.title")} />

      <div class="rounded-md border border-border bg-panel p-6 shadow-panel sm:p-10" data-aos="fade-up">
        {/* step 1 */}
        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary-soft text-sm font-bold text-primary">1</span>
          <p class="pt-1 text-sm leading-relaxed text-foreground sm:text-base">{t(locale, "landing.lr.install.step1")}</p>
        </div>

        {/* step 2 */}
        <div class="mt-8 flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary-soft text-sm font-bold text-primary">2</span>
          <div class="min-w-0 flex-1">
            <p class="pt-1 text-sm font-semibold text-foreground-strong sm:text-base">{t(locale, "landing.lr.install.step2")}</p>
            <div class="mt-3 flex flex-col items-stretch overflow-hidden rounded-md border border-border-strong bg-code-block transition-colors focus-within:border-ring hover:border-ring sm:flex-row">
              <p class="min-w-0 flex-1 px-4 py-4 text-sm leading-relaxed text-foreground" dir="ltr">{PASTE_MSG}</p>
              <button
                type="button"
                data-copy-paste
                data-copy-text={PASTE_MSG}
                aria-label={t(locale, "landing.lr.install.copy")}
                class="group relative flex w-full shrink-0 cursor-pointer items-center justify-center gap-2 border-t border-border bg-panel-raised py-3 transition-all hover:bg-primary hover:text-primary-foreground sm:w-16 sm:border-t-0 sm:border-s sm:py-0"
              >
                <i class="bx bx-copy icon-xl transition-opacity data-[copied]:opacity-0"></i>
                <i class="bx bx-check icon-xl absolute text-success opacity-0 transition-opacity group-data-[copied]:opacity-100 group-hover:text-primary-foreground"></i>
              </button>
            </div>
            <p data-copied-note class="mt-2 flex items-center gap-1.5 text-xs font-medium text-success opacity-0 transition-all duration-300">
              <i class="bx bx-check-square icon-sm"></i>{t(locale, "landing.lr.install.copied")}
            </p>
          </div>
        </div>

        {/* step 3 */}
        <div class="mt-8 flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-primary-soft text-sm font-bold text-primary">3</span>
          <p class="pt-1 text-sm leading-relaxed text-foreground sm:text-base">{t(locale, "landing.lr.install.step3")}</p>
        </div>
      </div>

      {/* works with */}
      <div class="mt-10 text-center" data-aos="fade-up">
        <p class="text-2xs font-semibold uppercase tracking-widest text-muted-foreground">{t(locale, "landing.lr.install.worksWith")}</p>
        <div class="mt-4 flex flex-wrap items-stretch justify-center gap-3">
          {hosts.map((host) => (
            <a
              href={host.url}
              target="_blank"
              rel="noopener noreferrer"
              title={host.desc}
              class="flex w-36 flex-col items-center gap-2.5 rounded-md border border-border bg-panel px-4 py-5 text-center shadow-panel transition-all hover:-translate-y-0.5 hover:border-border-strong hover:bg-panel-raised"
            >
              <span class="flex h-10 w-10 items-center justify-center [&>svg]:h-10 [&>svg]:w-10" set:html={brandLogo(host.key)} />
              <span class="text-sm font-semibold text-foreground-strong">{host.name}</span>
            </a>
          ))}
        </div>
      </div>

      {/* terminal one-liner */}
      <div class="mt-10" data-aos="fade-up">
        <p class="text-xs font-medium text-muted-foreground">{t(locale, "landing.lr.install.orTerminal")}</p>
        <div class="mt-3 flex items-stretch overflow-hidden rounded-md border border-border bg-code-block transition-colors hover:border-border-strong">
          <p class="min-w-0 flex-1 truncate px-4 py-3 text-sm text-foreground" dir="ltr">{t(locale, "landing.lr.install.cmd")}</p>
          <button
            type="button"
            data-copy-paste
            data-copy-text={t(locale, "landing.lr.install.cmd")}
            aria-label={t(locale, "landing.lr.install.copy")}
            class="group relative flex w-14 shrink-0 cursor-pointer items-center justify-center border-s border-border bg-panel-raised transition-all hover:bg-primary hover:text-primary-foreground"
          >
            <i class="bx bx-copy icon-lg transition-opacity data-[copied]:opacity-0"></i>
            <i class="bx bx-check icon-lg absolute text-success opacity-0 transition-opacity group-data-[copied]:opacity-100 group-hover:text-primary-foreground"></i>
          </button>
        </div>
      </div>
    </div>
  </section>

{/* --------------------------------------------------------------- use */}
  <section class="relative overflow-hidden py-24 sm:py-32">
    <div class="absolute inset-0 bg-panel-deep/50"></div>
    <div class="relative mx-auto max-w-4xl px-6">
      <SectionHeader label={t(locale, "landing.lr.use.label")} title={t(locale, "landing.lr.use.title")} description={t(locale, "landing.lr.use.desc")} />
      <div class="space-y-3" data-aos="fade-up">
        {usage.map((row) => (
          <div class="rounded-md border border-border bg-panel p-4 sm:p-5">
            <div class="flex items-start gap-3">
              <i class:list={["bx icon-lg mt-0.5 shrink-0 text-primary", row.icon]}></i>
              <div>
                <p class="text-sm font-semibold text-foreground-strong">"{row.say}"</p>
                <p class="mt-1 text-xs text-muted-foreground">{row.mean}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 flex flex-col items-center justify-between gap-4 rounded-md border border-border bg-panel p-5 sm:flex-row" data-aos="fade-up">
        <p class="text-xs text-muted-foreground">
          {t(locale, "landing.lr.use.noAiNeeded")}
          <code class="ms-2 rounded-sm bg-code-block px-2 py-1 text-2xs text-foreground">{t(locale, "landing.lr.use.statusCmd")}</code>
        </p>
        <a href={`${REPO_URL}/blob/main/docs/LEAD-RESEARCH-METHOD.md`} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-primary hover:brightness-110">
          {t(locale, "landing.lr.use.docsLink")}<i class="bx bx-chevron-right icon-sm"></i>
        </a>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- final CTA */}
  <section class="relative py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-5 md:grid-cols-2" data-aos="fade-up">
        <div class="flex flex-col rounded-md border border-border bg-panel p-8">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-accent-soft">
            <i class="bx bx-download text-accent icon-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-foreground-strong">{t(locale, "landing.lr.end.freeTitle")}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{t(locale, "landing.lr.end.freeDesc")}</p>
          <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex h-11 items-center justify-center self-start rounded-md border border-border bg-panel-raised px-6 text-sm font-medium text-foreground transition-all hover:border-border-strong hover:bg-panel-strong">
            <i class="bx bx-code-alt icon-base me-2"></i>{t(locale, "landing.lr.end.freeCta")}
          </a>
        </div>
        <div class="flex flex-col rounded-md border border-primary/30 bg-panel-strong p-8 ring-1 ring-primary/20">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft">
            <i class="bx bx-trending-up text-primary icon-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-foreground-strong">{t(locale, "landing.lr.end.allTitle")}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{t(locale, "landing.lr.end.allDesc")}</p>
          <div class="mt-6">
            <a href={localizePath(APPLY_PATH, locale)} data-cta-location="landing_lead_researcher_footer" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground transition-all hover:brightness-110 active:brightness-95">
              {t(locale, "cta.apply")}
            </a>
            <p class="mt-2.5 text-2xs text-muted-foreground">{t(locale, "conversion.apply.microcopy")}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>

<script>
  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy-paste]").forEach((btn) => {
      if (btn.dataset.copyBound) return;
      btn.dataset.copyBound = "true";
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copyText ?? "";
        try {
          await navigator.clipboard.writeText(text);
        } catch { return; }
        btn.dataset.copied = "true";
        const note = btn.closest("div")?.parentElement?.querySelector<HTMLElement>("[data-copied-note]");
        if (note) {
          note.classList.remove("opacity-0");
          note.classList.add("opacity-100");
        }
        setTimeout(() => {
          btn.dataset.copied = "false";
          if (note) {
            note.classList.add("opacity-0");
            note.classList.remove("opacity-100");
          }
        }, 1800);
      });
    });
  }
  initCopyButtons();
  document.addEventListener("astro:page-load", initCopyButtons);
</script>
