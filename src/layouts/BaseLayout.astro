---
import "../styles/global.css";
import "../assets/fonts/fonts.css";
import "../styles/boxicons-subset.css";
import { SITE, AUTHOR, SEO, ANALYTICS, SOCIAL } from "../config";
import { type Locale, t } from "../i18n/translations";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  robots?: string;
  locale?: Locale;
  /** Skip emitting hreflang alternates (EN-only pages). */
  noAlternate?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  image = SEO.defaultImage,
  ogType = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  robots = SEO.robots,
  locale = SITE.locale as Locale,
  noAlternate = false,
} = Astro.props;

const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const imageUrl = image.startsWith("http") ? image : `${SITE.url}${image}`;
const dir = locale === "fa" ? "rtl" : "ltr";
const lang = locale === "fa" ? "fa" : "en";
const bookingEnabled = /^\/(?:fa\/)?(?:apply|contact)\/?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang={lang} dir={dir} data-theme={SITE.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content={SITE.colorScheme} />
    <meta name="robots" content={robots} />
    <link rel="author" href="/humans.txt" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={SEO.ogImageWidth} />
    <meta property="og:image:height" content={SEO.ogImageHeight} />
    <meta property="og:locale" content={lang === "fa" ? "fa_IR" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={AUTHOR.handle} />
    <meta name="twitter:creator" content={AUTHOR.handle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />

    {ogType === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === "article" && <meta property="article:author" content={AUTHOR.name} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <link rel="icon" type="image/svg+xml" href="/assets/favicons/favicon-v2.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicons/favicon-32-v2.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicons/favicon-16-v2.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicons/apple-touch-icon-v2.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/feed.xml" />

    <!-- Preload critical fonts to prevent FOUT. IRANSansX is unicode-range
         isolated to Arabic/Persian glyphs, so it is only preloaded on FA
         pages where it can actually be used. -->
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/outfit-latin.woff2" crossorigin />
    {locale === "fa" && <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/IRANSansXVF.woff2" crossorigin />}
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/jetbrains-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/boxicons.woff2" crossorigin />

    <!-- Cal.com native embed (owner directive 2026-08-23, flow.digital
         pattern): the small icon-only call CTAs on Contact and Apply are
         data-cal-link triggers that open Cal's booking embed right on the
         page. Cal's OFFICIAL loader defines window.Cal as a queue immediately
         and only then loads embed.js, so analytics can register
         bookingSuccessful before Cal finishes loading and the popup opens as
         fast as possible. There is NO custom modal wrapper. Apply remains the
         primary conversion action; booking is an optional alternative. -->
    {bookingEnabled && <link rel="preconnect" href="https://app.cal.com" crossorigin />}
    {bookingEnabled && <link rel="dns-prefetch" href="https://app.cal.com" />}
    {bookingEnabled && <script is:inline type="text/javascript">
      // @ts-nocheck — official Cal loader intentionally uses a callable queue.
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(cal, ar); }; const namespace = ar[1]; api.q = api.q || []; typeof namespace === "string" ? (cal.ns[namespace] = api) : (p(cal, api)); return; } p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
    </script>}

    <!-- hreflang alternates for i18n SEO (indexable pages only —
         noindex pages should not publish alternate clusters) -->
    {!robots.includes("noindex") && !noAlternate && (() => {
      const path = Astro.url.pathname;
      const enPath = locale === "fa" ? path.replace(/^\/fa/, "") || "/" : path;
      const faPath = locale === "fa" ? path : `/fa${path}`;
      return (
        <>
          <link rel="alternate" hreflang="en" href={`${SITE.url}${enPath}`} />
          <link rel="alternate" hreflang="fa" href={`${SITE.url}${faPath}`} />
          <link rel="alternate" hreflang="x-default" href={`${SITE.url}${enPath}`} />
        </>
      );
    })()}

    <!-- Google Search Console verification -->
    <meta name="google-site-verification" content={ANALYTICS.googleSearchConsoleVerification} />

    <script is:inline>
      (function(){
        try{
          var t=localStorage.getItem('spielos.theme');
          if(t){document.documentElement.dataset.theme=t;}
        }catch(e){}
      })();
    </script>

    <!-- GA4 command queue: defined before the deferred loader so queued commands run once gtag.js loads. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
    </script>

    <!-- Stable site entities shared by every page. Page schemas may safely
         reference these IDs without creating dangling structured-data nodes. -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": `${SITE.url}/#organization`,
          name: SITE.name,
          url: SITE.url,
          logo: { "@type": "ImageObject", url: `${SITE.url}/assets/logos/primary-transparent.svg`, width: 512, height: 512 },
          founder: { "@id": `${SITE.url}/#person` },
          sameAs: [SOCIAL.x, SOCIAL.linkedin, SOCIAL.github],
          description: SITE.description,
        },
        {
          "@type": "Person",
          "@id": `${SITE.url}/#person`,
          name: AUTHOR.name,
          url: `${SITE.url}/founder/`,
          image: `${SITE.url}/assets/avatars/avatar.jpg`,
          jobTitle: AUTHOR.jobTitle,
          sameAs: AUTHOR.sameAs,
          worksFor: { "@id": `${SITE.url}/#organization` },
        },
        {
          "@type": "WebSite",
          "@id": `${SITE.url}/#website`,
          name: SITE.name,
          url: SITE.url,
          description: locale === "fa" ? SITE.descriptionFa : SITE.description,
          inLanguage: lang,
          publisher: { "@id": `${SITE.url}/#organization` },
        },
      ],
    })} />
  </head>
  <body class="bg-background text-foreground antialiased">
    <a href="#main-content" class="sr-only skip-link">{t(locale, "common.skipToContent")}</a>
    <slot name="nav" />
    <main id="main-content">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import AOS from "aos";
      AOS.init({ duration: 550, easing: "ease-out-cubic", once: true, offset: 60 });
      AOS.refresh();
      // Arm the AOS hiding only after a successful init — see the
      // html:not(.aos-ready) failsafe in global.css.
      document.documentElement.classList.add("aos-ready");

      // Crawler-safe reveal (owner incident 2026-08-27): AOS keeps below-fold
      // [data-aos] sections at opacity:0 until they scroll into view.
      // Googlebot and other renderers often capture the page near the top and
      // never scroll every section, so their screenshots miss most of the page
      // (the "simplified / missing sections" symptom seen in Search Console
      // Live Test). Fix: force-reveal everything for crawlers immediately, and
      // for all visitors add a post-load failsafe so no section can stay
      // invisible. Human visitors still get the scroll-in animation for
      // anything they reach before the failsafe fires.
      function isCrawler() {
        try {
          return /bot|googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|sogou|exabot|facebookexternalhit|linkedinbot|twitterbot|applebot|perplexitybot|claudebot|gptbot|ccbot|bytespider|petalbot|dataforseo/i.test(navigator.userAgent || "");
        } catch (e) { return false; }
      }
      function revealAllAos() {
        document.documentElement.classList.add("aos-revealed");
      }
      if (isCrawler()) {
        revealAllAos();
      }
      // Reveal-fallback: if an animated element is already in the viewport but
      // AOS never fired (e.g. observer flakiness), force it visible so no
      // section can ever stay stuck at opacity 0.
      function revealStuck() {
        document.querySelectorAll("[data-aos]").forEach(function (el) {
          if (!el.classList.contains("aos-animate")) {
            var rect = el.getBoundingClientRect();
            var vh = window.innerHeight || document.documentElement.clientHeight;
            if (rect.top < vh && rect.bottom > 0) {
              el.classList.add("aos-animate");
            }
          }
        });
      }
      var revealQueued = false;
      function queueReveal() {
        if (revealQueued) return;
        revealQueued = true;
        requestAnimationFrame(function () {
          revealQueued = false;
          revealStuck();
        });
      }
      window.addEventListener("load", function () {
        revealStuck();
        // Post-load failsafe: guarantee the full page is visible in any render
        // (crawler or human) that does not scroll through every section.
        setTimeout(revealAllAos, 2000);
      });
      window.addEventListener("scroll", queueReveal, { passive: true });
      window.addEventListener("resize", queueReveal, { passive: true });
    </script>

    <!-- Deferred: load gtag.js + initialize PostHog unconditionally (full capture, owner directive 2026-08-18) -->
    <script is:inline define:vars={{ gaId: ANALYTICS.googleAnalyticsId, phKey: ANALYTICS.posthogApiKey, phHost: ANALYTICS.posthogApiHost }}>
      (function(){
        var started = false;
        function loadAnalytics(){
          if(started) return;
          started = true;
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: true, cookie_flags: 'SameSite=None;Secure', debug_mode: false });
          var s=document.createElement('script');
          s.async=1;
          s.src='https://www.googletagmanager.com/gtag/js?id='+gaId;
          document.head.appendChild(s);
          /* PostHog: full capture for all visitors — session replay stays ON,
             anonymous person profiles for funnel analysis on unauthenticated
             traffic, raw form inputs masked (funnel events still count
             starts/submits/successes). */
          !function(t,e){var o,n,p;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",t.getElementsByTagName("head")[0].appendChild(p);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
          posthog.init(phKey,{ api_host: phHost, person_profiles: 'always', mask_all_inputs: true });
        }
        'requestIdleCallback' in window
          ? requestIdleCallback(loadAnalytics, {timeout: 2000})
          : setTimeout(loadAnalytics, 2000);
      })();
    </script>

    <!-- Event tracking: CTA clicks, outbound links, scroll depth, form submits -->
    <script is:inline define:vars={{ contentSources: ANALYTICS.contentSources, attributionParameters: ANALYTICS.attributionParameters }}>
      (function(){
        'use strict';

        function track(eventName, params){
          params = params || {};
          var context = attribution();
          Object.keys(context).forEach(function(key){
            if(params[key] === undefined) params[key] = context[key];
          });
          if(params.page_path === undefined) params.page_path = window.location.pathname;
          if(typeof gtag === 'function'){ gtag('event', eventName, params); }
          if(typeof posthog !== 'undefined' && posthog && typeof posthog.capture === 'function'){
            posthog.capture(eventName, params);
          }
        }
        window.spielosTrack = track;

        /* ---- Successful booking (owner directive 2026-08-23): Cal reports
             bookingSuccessful on the embed. The Cal.com -> Attio sync still
             captures the booked call separately; this is the page-side funnel
             event for PostHog/GA. ---- */
        /* Only register the booking hook on pages that actually contain a
           data-cal-link trigger (Contact/Apply). Calling Cal(...) anywhere
           else would append app.cal.com/embed.js and download the embed on
           pages with zero booking buttons. */
        if(document.querySelector('[data-cal-link]') && typeof window.Cal === 'function'){
          window.Cal('on', { action: 'bookingSuccessful', callback: function () {
            track('booked_call', { page: getPage(), device: getDevice(), locale: getLocale() });
          } });
        }

        /* ---- Apply funnel (owner directive 2026-08-22): every conversion CTA
             links to /apply/. Clicks are recorded as apply_cta_clicked with
             their data-cta-location so the funnel stays measurable. ---- */
        function isApplyCta(link){
          if(!link) return false;
          return !!(link.getAttribute && link.getAttribute('data-cta-location'));
        }

        function getPage(){
          return window.location.pathname + window.location.search;
        }

        function getDevice(){
          var w = window.innerWidth;
          if(w < 768) return 'mobile';
          if(w < 1024) return 'tablet';
          return 'desktop';
        }

        function getLocale(){
          return document.documentElement.lang || 'en';
        }

        function attribution(){
          var params = new URLSearchParams(window.location.search);
          var current = { landing_path: window.location.pathname };
          attributionParameters.forEach(function(key){
            var value = (params.get(key) || '').trim().toLowerCase();
            if(value && /^[a-z0-9._-]{1,120}$/.test(value)) current[key] = value;
          });
          var hasCampaign = Object.keys(current).length > 1;
          var stored = {};
          try {
            stored = JSON.parse(sessionStorage.getItem('spielos.content-attribution') || '{}');
          } catch(err) {}
          var context = hasCampaign ? current : stored;
          if(hasCampaign){
            try { sessionStorage.setItem('spielos.content-attribution', JSON.stringify(current)); } catch(err) {}
          }
          return {
            landing_path: context.landing_path || window.location.pathname,
            source: context.utm_source || 'direct',
            medium: context.utm_medium || 'none',
            campaign: context.utm_campaign || 'none',
            content_id: context.utm_content || 'none'
          };
        }

        /* ---- CTA clicked (booking CTAs, /services/ links, primary buttons) ---- */
        document.addEventListener('click', function(e){
          var el = e.target;
          if(!el || !el.tagName) return;

          var link = el.tagName === 'A' ? el : el.closest('a');
          if(link){
            var href = link.getAttribute('href') || '';

            /* Apply funnel CTAs: any element tagged data-cta-location that
               points at the apply flow. Records the dedicated PostHog/GA event
               without blocking navigation. */
            if(isApplyCta(link) && href.indexOf('/apply/') !== -1){
              track('apply_cta_clicked', {
                page: getPage(),
                device: getDevice(),
                locale: getLocale(),
                location: link.getAttribute('data-cta-location') || 'generic',
                link_text: (link.textContent || '').trim().substring(0, 100)
              });
              return;
            }

            if(href.indexOf('/services/') !== -1){
              track('cta_clicked', {
                page: getPage(),
                device: getDevice(),
                locale: getLocale(),
                cta_type: 'services',
                link_text: (link.textContent || '').trim().substring(0, 100)
              });
            }

            /* Social icon clicks */
            if(href.indexOf('x.com') !== -1 || href.indexOf('twitter.com') !== -1 ||
               href.indexOf('linkedin.com') !== -1 || href.indexOf('github.com') !== -1){
              track('social_clicked', {
                page: getPage(),
                device: getDevice(),
                locale: getLocale(),
                platform: href.indexOf('github') !== -1 ? 'github' :
                          href.indexOf('linkedin') !== -1 ? 'linkedin' :
                          href.indexOf('x.com') !== -1 ? 'x' : 'twitter',
                url: href
              });
            }

            /* Outbound link clicks */
            try{
              var u = new URL(href, window.location.href);
              if(u.origin !== window.location.origin){
                track('outbound_link', {
                  page: getPage(),
                  device: getDevice(),
                  locale: getLocale(),
                  url: href,
                  link_text: (link.textContent || '').trim().substring(0, 100)
                });
              }
            }catch(err){}
          }

          /* Primary action buttons */
          var btn = el.tagName === 'BUTTON' ? el : el.closest('button');
          if(btn){
            var classes = btn.className || '';
            if(btn.hasAttribute('data-cal-cta')){
              track('booking_cta_clicked', {
                page: getPage(),
                device: getDevice(),
                locale: getLocale(),
                cta_type: 'book_call',
                location: btn.getAttribute('data-cta-location') || 'generic',
                link_text: (btn.textContent || '').trim().substring(0, 100)
              });
            } else if(classes.indexOf('bg-primary') !== -1){
              track('cta_clicked', {
                page: getPage(),
                device: getDevice(),
                locale: getLocale(),
                cta_type: 'primary',
                link_text: (btn.textContent || '').trim().substring(0, 100)
              });
            }
          }
        });

        /* ---- Scroll depth tracking ---- */
        (function(){
          var thresholds = [25, 50, 75, 100];
          var fired = {};
          function checkScroll(){
            var docHeight = Math.max(
              document.body.scrollHeight || 0,
              document.documentElement.scrollHeight || 0
            );
            var winHeight = window.innerHeight || document.documentElement.clientHeight;
            if(docHeight <= winHeight) return;
            var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            var percent = Math.round((scrollTop / (docHeight - winHeight)) * 100);
            thresholds.forEach(function(t){
              if(!fired[t] && percent >= t){
                fired[t] = true;
                track('scroll_depth', {
                  page: getPage(),
                  device: getDevice(),
                  locale: getLocale(),
                  depth_percent: t
                });
              }
            });
          }
          window.addEventListener('scroll', checkScroll, { passive: true });
          setTimeout(checkScroll, 1000);
        })();

        /* ---- Theme toggle tracking ---- */
        document.addEventListener('click', function(e){
          var btn = e.target.closest ? e.target.closest('#footer-theme-toggle') : null;
          if(btn){
            track('theme_toggled', {
              page: getPage(), device: getDevice(), locale: getLocale()
            });
          }
        });

        function recordContentLanding(){
          var context = attribution();
          if(contentSources.indexOf(context.source) !== -1){
            track('content_landing', { page: getPage(), device: getDevice(), locale: getLocale() });
          }
        }

        /* ---- Initialize observers after DOM ready ---- */
        if(document.readyState === 'loading'){
          document.addEventListener('DOMContentLoaded', recordContentLanding);
        }else{
          recordContentLanding();
        }
      })();
    </script>
  </body>
</html>
