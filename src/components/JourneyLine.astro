---
/**
 * JourneyLine — the homepage left-side journey rail, upgraded to the exact
 * Design department journey signature family (see JourneySignature.astro):
 * one smooth wandering goal line, dashed muted route ahead, solid primary
 * traveled fill, nodes that ride ON the path, route ending at a flat
 * bullseye. The only homepage-specific part is the scroll-driven draw of
 * the travelled fill; the geometry, nodes, and bullseye are the shared
 * signature. Hidden on mobile (< lg).
 *
 * Consolidation: thin wrapper around JourneySignature variant="rail"
 * with animation="scroll" (per-instance uid, guard getTotalLength).
 */
import JourneySignature from "./JourneySignature.astro";
---

<div class="jl-wrap" aria-hidden="true">
  <JourneySignature variant="rail" animation="scroll" />
</div>
