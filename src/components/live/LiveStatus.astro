---
import { type Locale, t } from "../../i18n/translations";

export interface Heartbeat {
  goal_id: string;
  goal_name: string;
  owner_id?: string | null;
  metric: string;
  operator: string;
  target: number | boolean | string;
  stage?: string | null;
  run_status?: string | null;
  updated_at: string;
  display_title?: string | null;
  display_title_fa?: string | null;
  business_value?: string | null;
  business_value_fa?: string | null;
}

export interface Northstar {
  goal_id: string;
  goal_name: string;
  metric: string;
  operator: string;
  target: number | boolean | string;
  goal_status: string;
  updated_at: string;
}

export interface Props {
  locale?: Locale;
  state: "running" | "resting";
  heartbeat: Heartbeat | null;
  northstar: Northstar | null;
  /** Formats the heartbeat into its readable metric target, e.g. "Reply Rate ≥ 30%". */
  heartbeatText: (hb: Heartbeat) => string;
  /** Formats the north star into its readable metric target, e.g. "Booked calls ≥ 3". */
  northstarText: (n: Northstar) => string;
}

const {
  locale = "en",
  state,
  heartbeat,
  northstar,
  heartbeatText,
  northstarText,
} = Astro.props;

const hasHeartbeat = Boolean(heartbeat);
const hasNorthstar = Boolean(northstar);

/** Metrics that read as a human result for buyers. Everything else
 *  (acceptance_tests_passed, achieved_children, ...) stays out of the
 *  buyer-facing heartbeat card. */
const USER_FACING_METRICS = new Set(["reply_rate", "booked_calls", "published_items"]);
const humanMetric = (hb: Heartbeat | null) => (hb && USER_FACING_METRICS.has(hb.metric) ? heartbeatText(hb) : "");

/** The visible title is public copy when available; otherwise a generic
 *  human phrase -- never the raw canonical goal name on a buyer card. */
const heartbeatTitle = (hb: Heartbeat | null) => {
  if (!hb) return "";
  const copy = locale === "fa" ? (hb.display_title_fa || hb.display_title) : hb.display_title;
  if (copy) return copy;
  return hb.owner_id === "system-improvement"
    ? t(locale, "live.heartbeat.systemImprovement")
    : t(locale, "live.heartbeat.businessWork");
};

/** The visible sub-line is the human result when the metric is user-facing,
 *  otherwise the public business value, otherwise empty (technical detail). */
const heartbeatBody = (hb: Heartbeat | null) => {
  const metricLine = humanMetric(hb);
  if (metricLine) return metricLine;
  if (hb) {
    const copy = locale === "fa" ? (hb.business_value_fa || hb.business_value) : hb.business_value;
    if (copy) return copy;
  }
  return "";
};
---

<!-- ONE company-heartbeat card: the north star goal centered on top, the
     current in-flight run below with a View Activity affordance on the right.
     The whole card is one clickable link to the activity timeline. The poll
     in live.astro updates the data-* fields without touching the layout. -->
<div
  id="live-status-root"
  class:list={[
    hasHeartbeat ? "live-state-running" : "live-state-resting",
  ]}
  data-live-state={state}
  data-heartbeat-state={hasHeartbeat ? "running" : "resting"}
>
  <a
    href="#live-timeline"
    data-live-card-link
    class="group relative block overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel transition-all hover:border-border-strong hover:shadow-panel sm:p-6"
  >
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>

    <!-- NORTH STAR: the single goal the whole company works toward, centered.
         Hidden by the poll when the runtime has no primary goal. -->
    <div
      id="live-northstar"
      class:list={[
        "flex flex-col items-center gap-1 text-center",
        !hasNorthstar && "hidden",
      ]}
      data-northstar-state={hasNorthstar ? "present" : "absent"}
    >
      <span class="flex h-10 w-10 items-center justify-center rounded-md bg-primary-soft text-primary" aria-hidden="true">
        <i class="bx bx-bullseye icon-xl"></i>
      </span>
      <span class="mt-0.5 text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "live.heartbeat.northstarLabel")}</span>
      <span class="block text-base font-bold leading-snug text-foreground-strong" data-northstar-goal={northstar?.goal_name ?? ""}>{northstar?.goal_name ?? ""}</span>
      <span class="block text-xs text-muted-foreground" data-northstar-metric>{hasNorthstar && northstar ? northstarText(northstar) : ""}</span>
    </div>

    <div class="my-4 h-px bg-border" aria-hidden="true"></div>

    <!-- HEARTBEAT: the current in-flight run, with the View Activity button
         on the right of the same line, vertically centered. -->
    <div class="flex items-center gap-4">
      <span
        class:list={[
          "live-hb-tile relative flex h-11 w-11 shrink-0 items-center justify-center rounded-md",
          hasHeartbeat ? "bg-success-soft text-success" : "bg-destructive-soft text-destructive",
        ]}
        aria-hidden="true"
      >
        <span class="live-hb-ring"></span>
        <i class="bx bx-run live-hb-icon icon-xl"></i>
      </span>

      <span class="min-w-0 flex-1">
        <span class="block text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "live.heartbeat.label")}</span>
        <span class="mt-1 block text-sm font-semibold leading-snug text-foreground-strong sm:text-base" data-heartbeat-goal={hasHeartbeat ? heartbeatTitle(heartbeat) : ""}>{hasHeartbeat ? heartbeatTitle(heartbeat) : ""}</span>
        <span class:list={["mt-1 block text-xs text-muted-foreground", hasHeartbeat && !heartbeatBody(heartbeat) && "hidden"]} data-heartbeat-metric={hasHeartbeat ? heartbeatBody(heartbeat) : ""}>{hasHeartbeat ? heartbeatBody(heartbeat) : ""}</span>
        <span id="live-status-resting" class:list={["mt-1 block text-xs leading-relaxed text-muted-foreground", hasHeartbeat && "hidden"]}>
          {t(locale, "live.heartbeat.resting")}
        </span>
      </span>

      <span
        data-live-view-activity
        class="ms-auto inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border bg-panel-raised px-4 py-2.5 text-xs font-semibold text-primary transition-all group-hover:border-primary group-hover:bg-primary-soft"
        aria-hidden="true"
      >
        {t(locale, "live.heartbeat.viewLog")}
        <i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i>
      </span>
    </div>
  </a>
</div>

<style>
  .live-hb-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    border: 2px solid currentColor;
    opacity: 0;
    pointer-events: none;
  }

  /* RUNNING: soft expanding ring on the tile + double-beat pulse on the icon */
  .live-state-running .live-hb-ring {
    animation: live-ring 1.8s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }
  .live-state-running .live-hb-icon {
    animation: live-beat 1.8s ease-in-out infinite;
  }
  @keyframes live-ring {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }
  @keyframes live-beat {
    0%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.14);
    }
    24% {
      transform: scale(1);
    }
    36% {
      transform: scale(1.1);
    }
    48% {
      transform: scale(1);
    }
  }

  /* RESTING: slow, calm sleeping breath (gentle scale/opacity) */
  .live-state-resting .live-hb-icon {
    animation: live-breathe 3s ease-in-out infinite;
  }
  @keyframes live-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.92);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-state-running .live-hb-ring,
    .live-state-running .live-hb-icon,
    .live-state-resting .live-hb-icon {
      animation: none;
    }
    .live-hb-ring {
      display: none;
    }
  }
</style>
