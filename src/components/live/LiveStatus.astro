---
import { type Locale, t } from "../../i18n/translations";

export interface Heartbeat {
  goal_id: string;
  goal_name: string;
  metric: string;
  operator: string;
  target: number | boolean | string;
  stage?: string | null;
  run_status?: string | null;
  updated_at: string;
}

export interface Northstar {
  goal_id: string;
  goal_name: string;
  metric: string;
  operator: string;
  target: number | boolean | string;
  goal_status: string;
  updated_at: string;
}

export interface Props {
  locale?: Locale;
  state: "running" | "resting";
  heartbeat: Heartbeat | null;
  northstar: Northstar | null;
  /** Formats the heartbeat into its readable metric target, e.g. "Reply Rate ≥ 30%". */
  heartbeatText: (hb: Heartbeat) => string;
  /** Formats the north star into its readable metric target, e.g. "Booked calls ≥ 3". */
  northstarText: (n: Northstar) => string;
  /** Localizes a goal_status into its status chip label, e.g. "Active". */
  statusText: (status: string) => string;
  /** Pre-rendered "Last activity: …" line; empty when there is no activity. */
  lastActivityText: string;
}

const {
  locale = "en",
  state,
  heartbeat,
  northstar,
  heartbeatText,
  northstarText,
  statusText,
  lastActivityText,
} = Astro.props;

const hasHeartbeat = Boolean(heartbeat);
const hasNorthstar = Boolean(northstar);
---

<!-- Company live status: the north star goal on top, and the current
     in-flight run (heartbeat) below it. Both cards link to the timeline
     below (native anchor, smooth-scrolled by the script at the bottom;
     keyboard accessible). The client poll in live.astro updates the
     data-* fields of both cards. -->
<div
  id="live-status-root"
  class:list={[
    "space-y-3",
    hasHeartbeat ? "live-state-running" : "live-state-resting",
  ]}
  data-live-state={state}
  data-heartbeat-state={hasHeartbeat ? "running" : "resting"}
>
  <!-- NORTH STAR: the primary goal the whole company works toward, shown
       even while the company is resting. Hidden by the poll when the
       runtime has no primary goal. -->
  <a
    id="live-northstar"
    href="#live-timeline"
    class:list={[
      "group relative flex flex-wrap items-center gap-x-4 gap-y-3 overflow-hidden rounded-md border border-border bg-panel p-4 text-start shadow-panel transition-all sm:p-5",
      "hover:border-border-strong hover:bg-panel-raised",
      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
      !hasNorthstar && "hidden",
    ]}
    data-northstar-state={hasNorthstar ? "present" : "absent"}
  >
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-primary-soft text-primary" aria-hidden="true">
      <i class="bx bx-bullseye icon-xl"></i>
    </span>
    <span class="min-w-0 flex-1">
      <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "live.heartbeat.northstarLabel")}</span>
      <span class="mt-1 block text-sm font-semibold leading-snug text-foreground-strong" data-northstar-goal={northstar?.goal_name ?? ""}>{northstar?.goal_name ?? ""}</span>
      <span class="mt-1 block text-xs text-muted-foreground" data-northstar-metric>{hasNorthstar && northstar ? northstarText(northstar) : ""}</span>
    </span>
    <span class:list={["inline-flex items-center gap-1.5 rounded-sm border border-border bg-panel px-2.5 py-1 text-2xs font-medium text-primary", !hasNorthstar && "hidden"]} data-northstar-status>
      <i id="live-northstar-status-icon" class="bx bx-time-five icon-sm" aria-hidden="true"></i>
      <span id="live-northstar-status-text">{hasNorthstar && northstar ? statusText(northstar.goal_status) : ""}</span>
    </span>
  </a>

  <!-- HEARTBEAT: the current in-flight run/goal. -->
  <a
    id="live-status-heartbeat"
    href="#live-timeline"
    class:list={[
      "group relative flex flex-wrap items-center gap-x-4 gap-y-3 overflow-hidden rounded-md border border-border bg-panel p-4 text-start shadow-panel transition-all sm:p-5",
      "hover:border-border-strong hover:bg-panel-raised",
      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
      hasHeartbeat ? "live-state-running" : "live-state-resting",
    ]}
  >
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80" aria-hidden="true"></div>
    <!-- Goal icon tile: green with a heartbeat ring + double-beat when a goal
         is in flight; red with a slow breathing pulse when resting. -->
    <span
      class:list={[
        "live-hb-tile relative flex h-10 w-10 shrink-0 items-center justify-center rounded-md",
        hasHeartbeat ? "bg-success-soft text-success" : "bg-destructive-soft text-destructive",
      ]}
      aria-hidden="true"
    >
      <span class="live-hb-ring"></span>
      <i class="bx bx-bullseye live-hb-icon icon-xl"></i>
    </span>

    <span class="min-w-0 flex-1">
      <span class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "live.heartbeat.label")}</span>
        <span class="inline-flex items-center gap-1.5 rounded-sm border border-border bg-panel px-2.5 py-1 text-2xs font-medium" data-live-state-label>
          <i id="live-status-state-icon" class:list={["bx", hasHeartbeat ? "bx-run text-primary" : "bx-time-five text-muted-foreground", "icon-sm"]} aria-hidden="true"></i>
          <span id="live-status-state-label-text">{t(locale, hasHeartbeat ? "live.state.running" : "live.state.resting")}</span>
        </span>
        <span id="live-status-stage" class:list={["inline-flex items-center rounded-sm border border-border bg-panel px-2.5 py-1 text-2xs font-medium text-muted-foreground", !hasHeartbeat && "hidden"]}>
          <span data-heartbeat-stage={heartbeat?.stage ?? ""}>{heartbeat?.stage ?? ""}</span>
        </span>
      </span>
      <span class="mt-2 block text-sm font-semibold leading-snug text-foreground-strong" data-heartbeat-goal={heartbeat?.goal_name ?? ""}>{heartbeat?.goal_name ?? ""}</span>
      <span class="mt-1 block text-xs text-muted-foreground" data-heartbeat-metric={hasHeartbeat && heartbeat ? heartbeatText(heartbeat) : ""}>{hasHeartbeat && heartbeat ? heartbeatText(heartbeat) : ""}</span>
      <span id="live-status-resting" class:list={["mt-1 block text-xs leading-relaxed text-muted-foreground", hasHeartbeat && "hidden"]}>
        {t(locale, "live.heartbeat.resting")}
      </span>
      <span id="live-status-activity" class:list={["mt-1 block text-xs text-muted-foreground", !lastActivityText && "hidden"]}>
        {lastActivityText}
      </span>
    </span>

    <span class="flex shrink-0 items-center gap-1 text-2xs font-medium text-muted-foreground transition-colors group-hover:text-foreground-strong">
      {t(locale, "live.heartbeat.viewLog")}
      <i class="bx bx-chevron-right rtl-flip icon-sm" aria-hidden="true"></i>
    </span>
  </a>
</div>

<style>
  .live-hb-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    border: 2px solid currentColor;
    opacity: 0;
    pointer-events: none;
  }

  /* RUNNING: soft expanding ring on the tile + double-beat pulse on the icon */
  .live-state-running .live-hb-ring {
    animation: live-ring 1.8s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }
  .live-state-running .live-hb-icon {
    animation: live-beat 1.8s ease-in-out infinite;
  }
  @keyframes live-ring {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }
  @keyframes live-beat {
    0%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.14);
    }
    24% {
      transform: scale(1);
    }
    36% {
      transform: scale(1.1);
    }
    48% {
      transform: scale(1);
    }
  }

  /* RESTING: slow, calm sleeping breath (gentle scale/opacity) */
  .live-state-resting .live-hb-icon {
    animation: live-breathe 3s ease-in-out infinite;
  }
  @keyframes live-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.92);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-state-running .live-hb-ring,
    .live-state-running .live-hb-icon,
    .live-state-resting .live-hb-icon {
      animation: none;
    }
    .live-hb-ring {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var links = document.querySelectorAll("#live-northstar, #live-status-heartbeat");
    var timelineEl = document.getElementById("live-timeline");
    if (!links.length || !timelineEl) return;
    var timeline = timelineEl as HTMLElement;
    links.forEach(function (link: Element) {
      link.addEventListener("click", function (event: Event) {
        event.preventDefault();
        timeline.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  })();
</script>