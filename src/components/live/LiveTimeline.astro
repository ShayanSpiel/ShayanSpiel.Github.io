---
import { type Locale, t } from "../../i18n/translations";

export interface LiveGoal {
  id: string;
  name: string;
  owner_id: string;
  goal_status: string;
  metric: string;
  operator: string;
  target: number | boolean | string;
  created_at: string;
  updated_at: string;
  stage?: string | null;
}

export interface Props {
  locale?: Locale;
  goals: LiveGoal[];
}

const { locale = "en", goals } = Astro.props;

const now = Date.now();
const BUSINESS_OWNERS = new Set(["director", "email", "outbound"]);

const faDigits = "۰۱۲۳۴۵۶۷۸۹";
const num = (n: number): string =>
  locale === "fa" ? String(n).replace(/\d/g, (d) => faDigits[Number(d)]) : String(n);

const typeOf = (owner: string): "business" | "improvement" =>
  BUSINESS_OWNERS.has(owner) ? "business" : "improvement";

const typeTile: Record<string, string> = {
  business: "bg-primary-soft",
  improvement: "bg-purple-soft",
};
const typeIcon: Record<string, string> = {
  business: "text-primary",
  improvement: "text-purple",
};
const nodeIcon: Record<string, { icon: string; color: string }> = {
  active: { icon: "bx-time-five", color: "text-warning" },
  achieved: { icon: "bx-check-square", color: "text-success" },
  abandoned: { icon: "bx-error", color: "text-destructive" },
};
const statusChip: Record<string, string> = {
  active: "bg-warning-soft text-warning",
  achieved: "bg-success-soft text-success",
  abandoned: "bg-destructive-soft text-destructive",
};
const statusLabel: Record<string, string> = {
  active: "live.status.active",
  achieved: "live.status.achieved",
  abandoned: "live.status.abandoned",
};

function relTime(iso: string): string {
  const diff = Math.max(0, now - new Date(iso).getTime());
  const minutes = Math.floor(diff / 60000);
  if (minutes < 1) return t(locale, "live.time.justNow");
  if (minutes < 60) return t(locale, minutes === 1 ? "live.time.minuteAgo" : "live.time.minutesAgo", { n: num(minutes) });
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return t(locale, hours === 1 ? "live.time.hourAgo" : "live.time.hoursAgo", { n: num(hours) });
  const days = Math.floor(hours / 24);
  return t(locale, days === 1 ? "live.time.dayAgo" : "live.time.daysAgo", { n: num(days) });
}

const absoluteFormatter = new Intl.DateTimeFormat(
  locale === "fa" ? "fa-IR-u-ca-gregory" : "en-US",
  { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }
);
const absTime = (iso: string): string => absoluteFormatter.format(new Date(iso));

function metricText(goal: LiveGoal): string | null {
  const target =
    typeof goal.target === "number"
      ? goal.metric === "reply_rate"
        ? `${Math.round(goal.target * 100)}%`
        : String(goal.target)
      : String(goal.target);
  const operator = goal.operator === "ge" ? "≥" : goal.operator === "le" ? "≤" : goal.operator;
  return t(locale, "live.entry.metric", { metric: goal.metric, operator, target });
}

const counts = {
  typeAll: goals.length,
  typeBusiness: goals.filter((g) => typeOf(g.owner_id) === "business").length,
  typeImprovement: goals.filter((g) => typeOf(g.owner_id) === "improvement").length,
  statusAll: goals.length,
  statusActive: goals.filter((g) => g.goal_status === "active").length,
  statusAchieved: goals.filter((g) => g.goal_status === "achieved").length,
  statusAbandoned: goals.filter((g) => g.goal_status === "abandoned").length,
};

const typePills = [
  { value: "all", labelKey: "live.filters.type.all", count: counts.typeAll },
  { value: "business", labelKey: "live.filters.type.business", count: counts.typeBusiness },
  { value: "improvement", labelKey: "live.filters.type.improvement", count: counts.typeImprovement },
];
const statusPills = [
  { value: "all", labelKey: "live.filters.status.all", count: counts.statusAll },
  { value: "active", labelKey: "live.filters.status.active", count: counts.statusActive },
  { value: "achieved", labelKey: "live.filters.status.achieved", count: counts.statusAchieved },
  { value: "abandoned", labelKey: "live.filters.status.abandoned", count: counts.statusAbandoned },
];
---

<div id="live-timeline-root">
  <!-- Filters -->
  <div class="mb-10 flex flex-col gap-4" data-aos="fade-up">
    <div class="flex flex-wrap items-center gap-2">
      <span class="me-3 text-2xs font-semibold uppercase tracking-widest text-muted-foreground">{t(locale, "live.filters.type")}</span>
      {typePills.map((pill, i) => (
        <button
          type="button"
          class:list={["filter-pill", i === 0 ? "filter-active" : "filter-inactive"]}
          data-filter-type={pill.value}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {t(locale, pill.labelKey)} <span class="opacity-80">({num(pill.count)})</span>
        </button>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="me-3 text-2xs font-semibold uppercase tracking-widest text-muted-foreground">{t(locale, "live.filters.status")}</span>
      {statusPills.map((pill, i) => (
        <button
          type="button"
          class:list={["filter-pill", i === 0 ? "filter-active" : "filter-inactive"]}
          data-filter-status={pill.value}
          aria-pressed={i === 0 ? "true" : "false"}
        >
          {t(locale, pill.labelKey)} <span class="opacity-80">({num(pill.count)})</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Timeline -->
  <ol class="live-timeline" data-aos="fade-up">
    {goals.map((goal) => {
      const type = typeOf(goal.owner_id);
      const status = goal.goal_status;
      const node = nodeIcon[status] ?? nodeIcon.active;
      const metric = metricText(goal);
      return (
        <li
          class="live-entry relative border-s-2 border-border ps-6 pb-8 last:pb-0"
          data-goal-id={goal.id}
          data-type={type}
          data-status={status}
        >
          <span class="absolute -start-2.5 top-0 flex h-5 w-5 items-center justify-center rounded-full border border-border bg-background" aria-hidden="true">
            <i class:list={["bx", node.icon, node.color, "icon-sm"]}></i>
          </span>
          <div class="rounded-md border border-border bg-panel p-5 transition-all hover:border-border-strong hover:bg-panel-raised">
            <div class="flex flex-wrap items-start gap-x-3 gap-y-2">
              <div class:list={["flex h-6 w-6 shrink-0 items-center justify-center rounded-sm", typeTile[type]]}>
                <i class:list={["bx", type === "business" ? "bx-trending-up" : "bx-slider", typeIcon[type], "icon-sm"]} aria-hidden="true"></i>
              </div>
              <h3 class="min-w-0 flex-1 text-sm font-semibold leading-snug text-foreground-strong">{goal.name}</h3>
              <time datetime={goal.created_at} class="whitespace-nowrap text-2xs text-muted-foreground">
                {relTime(goal.created_at)} · {absTime(goal.created_at)}
              </time>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-1.5">
              <span class="inline-flex items-center rounded-sm bg-primary-soft px-1.5 py-0.5 text-2xs font-medium text-primary">{goal.owner_id}</span>
              <span class:list={["inline-flex items-center rounded-sm px-1.5 py-0.5 text-2xs font-medium", statusChip[status] ?? "bg-panel-strong text-muted-foreground"]}>
                {t(locale, statusLabel[status] ?? "live.status.active")}
              </span>
              {goal.stage && (
                <span class="inline-flex items-center rounded-sm bg-panel-strong px-1.5 py-0.5 text-2xs font-medium text-muted-foreground">
                  {t(locale, "live.entry.stage", { stage: goal.stage })}
                </span>
              )}
              {metric && (
                <span class="inline-flex items-center rounded-sm border border-border bg-background px-1.5 py-0.5 font-mono text-2xs text-muted-foreground">
                  {metric}
                </span>
              )}
            </div>
          </div>
        </li>
      );
    })}
  </ol>

  <!-- Sentinel + loading indicator: reveals the remaining entries in batches of 10 -->
  <div id="live-loading" class="hidden mt-8" role="status" aria-live="polite">
    <div class="flex items-center justify-center gap-2 text-xs text-muted-foreground">
      <i class="bx bx-loader bx-spin text-primary icon-lg" aria-hidden="true"></i>
      <span>{t(locale, "live.loading")}</span>
    </div>
  </div>
  <div id="live-loaded" class="hidden mt-8">
    <div class="flex items-center justify-center gap-2 text-xs text-muted-foreground">
      <i class="bx bx-check-square text-success icon-lg" aria-hidden="true"></i>
      <span>{t(locale, "live.loaded")}</span>
    </div>
  </div>
</div>

<style>
  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    font-size: var(--font-size-xs);
    font-weight: 500;
    transition:
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }
  .filter-pill.filter-active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .filter-pill.filter-inactive {
    background: var(--panel);
    color: var(--muted-foreground);
  }
  .filter-pill.filter-inactive:hover {
    background: var(--panel-raised);
    border-color: var(--border-strong);
  }
  .live-entry--hidden {
    display: none;
  }
</style>

<script>
  (function () {
    var rootEl = document.getElementById("live-timeline-root");
    if (!rootEl) return;
    var root = rootEl as HTMLElement;
    var entries = Array.prototype.slice.call(root.querySelectorAll(".live-entry")) as Element[];
    var loading = document.getElementById("live-loading");
    var loadedNote = document.getElementById("live-loaded");
    var total = entries.length;
    var batch = 10;
    var initial = 20;
    var revealed = Math.min(initial, total);
    var filterType = "all";
    var filterStatus = "all";
    var busy = false;

    function matches(el: Element): boolean {
      if (filterType !== "all" && el.getAttribute("data-type") !== filterType) return false;
      if (filterStatus !== "all" && el.getAttribute("data-status") !== filterStatus) return false;
      return true;
    }

    function apply(): void {
      entries.forEach(function (el: Element, i: number) {
        el.classList.toggle("live-entry--hidden", !(i < revealed && matches(el)));
      });
      var done = revealed >= total;
      if (loading) loading.classList.toggle("hidden", done);
      if (loadedNote) loadedNote.classList.toggle("hidden", !done);
    }

    function revealNext(): void {
      if (busy || revealed >= total) return;
      busy = true;
      window.setTimeout(function () {
        revealed = Math.min(total, revealed + batch);
        apply();
        busy = false;
      }, 250);
    }

    // The loading indicator doubles as the scroll sentinel.
    if (loading && "IntersectionObserver" in window) {
      var io = new IntersectionObserver(
        function (observed: IntersectionObserverEntry[]) {
          if (observed.some(function (o: IntersectionObserverEntry) { return o.isIntersecting; })) revealNext();
        },
        { rootMargin: "200px 0px" }
      );
      io.observe(loading);
    }

    function selectFilter(selector: string, value: string, btn: Element): void {
      var group = root.querySelectorAll(selector);
      for (var i = 0; i < group.length; i++) {
        var b = group[i];
        var active = b === btn;
        b.classList.toggle("filter-active", active);
        b.classList.toggle("filter-inactive", !active);
        b.setAttribute("aria-pressed", active ? "true" : "false");
      }
      if (selector.indexOf("filter-type") !== -1) filterType = value;
      else filterStatus = value;
      // Filters apply to the whole log instantly, so counts stay honest.
      revealed = total;
      apply();
    }

    var typeButtons = root.querySelectorAll("[data-filter-type]");
    for (var i = 0; i < typeButtons.length; i++) {
      (function (btn: Element) {
        btn.addEventListener("click", function () {
          selectFilter("[data-filter-type]", btn.getAttribute("data-filter-type") || "all", btn);
        });
      })(typeButtons[i]);
    }
    var statusButtons = root.querySelectorAll("[data-filter-status]");
    for (var j = 0; j < statusButtons.length; j++) {
      (function (btn: Element) {
        btn.addEventListener("click", function () {
          selectFilter("[data-filter-status]", btn.getAttribute("data-filter-status") || "all", btn);
        });
      })(statusButtons[j]);
    }

    // Initial state: first 20 inline, the rest behind the sentinel.
    if (revealed < total && loading) loading.classList.remove("hidden");
    apply();
  })();
</script>
