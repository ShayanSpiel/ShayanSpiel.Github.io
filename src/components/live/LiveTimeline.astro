---
import { type Locale, t } from "../../i18n/translations";

export interface LiveGoal {
  id: string;
  name: string;
  display_title?: string;
  display_title_fa?: string;
  business_value?: string;
  business_value_fa?: string;
  owner_id: string;
  goal_status: string;
  metric: string;
  operator: string;
  target: number | boolean | string;
  created_at: string;
  updated_at: string;
  stage?: string | null;
  run_status?: string | null;
}

export interface Props { locale?: Locale; goals: LiveGoal[]; }
const { locale = "en", goals } = Astro.props;
const active = goals.filter((goal) => goal.goal_status === "active");
const business = active.filter((goal) => goal.owner_id !== "system-improvement").sort((a, b) => b.updated_at.localeCompare(a.updated_at));
const improvements = active.filter((goal) => goal.owner_id === "system-improvement").sort((a, b) => b.updated_at.localeCompare(a.updated_at));
const formatter = new Intl.DateTimeFormat(locale === "fa" ? "fa-IR-u-ca-gregory" : "en-US", { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" });
const faDigits = "۰۱۲۳۴۵۶۷۸۹";
const localNumber = (value: string) => locale === "fa" ? value.replace(/\d/g, (digit) => faDigits[Number(digit)]) : value;
const departmentKey = (owner: string) => ["director", "outbound", "email", "analytics", "content", "design", "seo"].includes(owner) ? `live.department.${owner}` : "live.department.operations";
const titleFor = (goal: LiveGoal) => locale === "fa" ? (goal.display_title_fa || goal.display_title || goal.name) : (goal.display_title || goal.name);
const valueFor = (goal: LiveGoal, improvement = false) => locale === "fa" ? (goal.business_value_fa || goal.business_value || t(locale, improvement ? "live.company.improvementWhy" : "live.company.defaultWhy")) : (goal.business_value || t(locale, improvement ? "live.company.improvementWhy" : "live.company.defaultWhy"));
const nextKey = (status?: string | null) => status === "awaiting_approval" ? "approval" : status === "blocked" ? "blocked" : status === "waiting" ? "waiting" : "continue";
const operatorText = (operator: string) => operator === "ge" ? "≥" : operator === "le" ? "≤" : operator === "eq" ? "=" : operator;
const targetText = (goal: LiveGoal) => goal.metric === "reply_rate" && typeof goal.target === "number" ? `${Math.round(goal.target * 100)}%` : String(goal.target);
---

<div id="live-company-view">
  <section aria-labelledby="business-work-heading">
    <div class="mb-6">
      <h2 id="business-work-heading" class="text-2xl font-bold tracking-tight text-foreground-strong">{t(locale, "live.company.businessTitle")}</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{t(locale, "live.company.businessDesc")}</p>
    </div>
    <ol class="live-business-timeline">
      {business.length === 0 && <p class="rounded-md border border-border bg-panel p-5 text-sm text-muted-foreground">{t(locale, "live.company.noActive")}</p>}
      {business.map((goal) => (
        <li class="live-business-entry relative border-s-2 border-border pb-7 ps-7 last:pb-0" data-aos="fade-up">
          <span class="live-timeline-node absolute -start-[9px] top-5 flex h-4 w-4 items-center justify-center rounded-full border-2 border-warning bg-background shadow-[0_0_18px_var(--warning-soft)]" aria-hidden="true"><span class="h-1.5 w-1.5 rounded-full bg-warning"></span></span>
        <article class="group relative overflow-hidden rounded-lg border border-border bg-panel p-5 shadow-panel transition-all hover:-translate-y-0.5 hover:border-border-strong sm:p-6">
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-primary via-accent to-transparent opacity-80"></div>
          <h3 class="text-lg font-semibold leading-snug text-foreground-strong">{titleFor(goal)}</h3>
          <dl class="mt-5 grid gap-4 sm:grid-cols-2">
            <div><dt class="text-2xs font-semibold uppercase tracking-wider text-foreground-muted">{t(locale, "live.company.why")}</dt><dd class="mt-1 text-xs leading-relaxed text-muted-foreground">{valueFor(goal)}</dd></div>
            <div><dt class="text-2xs font-semibold uppercase tracking-wider text-foreground-muted">{t(locale, "live.company.department")}</dt><dd class="mt-1 text-xs text-muted-foreground">{t(locale, departmentKey(goal.owner_id))}</dd></div>
            <div><dt class="text-2xs font-semibold uppercase tracking-wider text-foreground-muted">{t(locale, "live.company.status")}</dt><dd class="mt-1 text-xs text-warning">{t(locale, `live.status.${goal.goal_status}`)}</dd></div>
            <div><dt class="text-2xs font-semibold uppercase tracking-wider text-foreground-muted">{t(locale, "live.company.result")}</dt><dd class="mt-1 text-xs text-muted-foreground">{t(locale, "live.company.measuring")}</dd></div>
            <div><dt class="text-2xs font-semibold uppercase tracking-wider text-foreground-muted">{t(locale, "live.company.next")}</dt><dd class="mt-1 text-xs text-muted-foreground">{t(locale, `live.company.next.${nextKey(goal.run_status)}`)}</dd></div>
            <div><dt class="text-2xs font-semibold uppercase tracking-wider text-foreground-muted">{t(locale, "live.company.updated")}</dt><dd class="mt-1 text-xs text-muted-foreground"><time datetime={goal.updated_at}>{localNumber(formatter.format(new Date(goal.updated_at)))}</time></dd></div>
          </dl>
          <details class="mt-5 border-t border-border pt-4" data-live-system-details>
            <summary class="cursor-pointer text-xs font-semibold text-primary">{t(locale, "live.company.details")}</summary>
            <dl class="mt-4 grid gap-3 rounded-md bg-panel-raised p-4 font-mono text-2xs text-muted-foreground sm:grid-cols-2">
              <div><dt>{t(locale, "live.company.canonical")}</dt><dd class="mt-1 text-foreground">{goal.name}</dd></div>
              <div><dt>{t(locale, "live.company.identifier")}</dt><dd class="mt-1 break-all text-foreground">{goal.id}</dd></div>
              <div><dt>{t(locale, "live.company.systemState")}</dt><dd class="mt-1 text-foreground">{goal.stage || t(locale, "live.company.unknown")} · {goal.run_status || t(locale, "live.company.unknown")}</dd></div>
              <div><dt>{t(locale, "live.company.metric")}</dt><dd class="mt-1 text-foreground">{goal.metric} {operatorText(goal.operator)} {targetText(goal)}</dd></div>
            </dl>
          </details>
        </article>
        </li>
      ))}
    </ol>
  </section>

  <details class="mt-10 rounded-lg border border-border bg-panel" data-improvement-section>
    <summary class="cursor-pointer p-5 sm:p-6">
      <span class="block text-lg font-bold text-foreground-strong">{t(locale, "live.company.improvementTitle")}</span>
      <span class="mt-1 block text-xs leading-relaxed text-muted-foreground">{t(locale, "live.company.improvementDesc")}</span>
    </summary>
    <div class="space-y-4 border-t border-border p-5 sm:p-6">
      {improvements.map((goal) => (
        <article class="rounded-md border border-border bg-panel-raised p-5">
          <h3 class="text-sm font-semibold text-foreground-strong">{titleFor(goal)}</h3>
          <p class="mt-2 text-xs leading-relaxed text-muted-foreground">{valueFor(goal, true)}</p>
          <details class="mt-4" data-live-system-details><summary class="cursor-pointer text-xs font-semibold text-primary">{t(locale, "live.company.details")}</summary><div class="mt-3 rounded-md bg-background p-3 font-mono text-2xs text-muted-foreground"><p>{goal.name}</p><p class="mt-1 break-all">{goal.id}</p><p class="mt-1">{goal.stage || t(locale, "live.company.unknown")} · {goal.run_status || t(locale, "live.company.unknown")}</p></div></details>
        </article>
      ))}
    </div>
  </details>
</div>

<style>
  .live-business-entry:first-child .live-timeline-node::after {
    content: "";
    position: absolute;
    inset: -0.4rem;
    border: 1px solid var(--warning);
    border-radius: var(--radius-pill);
    animation: live-timeline-pulse 1.8s ease-out infinite;
  }
  @keyframes live-timeline-pulse {
    from { transform: scale(0.7); opacity: 0.75; }
    to { transform: scale(1.35); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-business-entry:first-child .live-timeline-node::after { animation: none; }
  }
</style>

<script>
  document.querySelectorAll("[data-live-system-details]").forEach((details) => {
    details.addEventListener("toggle", () => {
      if (!(details instanceof HTMLDetailsElement) || !details.open) return;
      const tracker = (window as typeof window & { spielosTrack?: (name: string, properties: Record<string, string>) => void }).spielosTrack;
      if (typeof tracker === "function") tracker("live_system_details_expanded", { page: window.location.pathname });
    });
  });
</script>
