---
import { type Locale, t } from "../../i18n/translations";

export interface LiveGoal {
  id: string;
  name: string;
  owner_id: string;
  goal_status: string;
  metric: string;
  operator: string;
  target: number | boolean | string;
  created_at: string;
  updated_at: string;
  stage?: string | null;
}

export interface Props {
  locale?: Locale;
  goals: LiveGoal[];
}

const { locale = "en", goals } = Astro.props;

// The timeline is a finite log split into two clearly labeled sections:
// business goals (owned by director/email/outbound) and self-improvement
// sessions (everyone else). Each section renders its newest entries inline
// (created_at DESC) and keeps the rest in the DOM hidden behind its own
// centered Show more button. A section renders only when it has entries.
const BUSINESS_OWNERS = new Set(["director", "email", "outbound"]);
const BUSINESS_INLINE = 10;
const IMPROVEMENT_INLINE = 5;

const typeOf = (owner: string): "business" | "improvement" =>
  BUSINESS_OWNERS.has(owner) ? "business" : "improvement";

const ordered = [...goals].sort((a, b) => b.created_at.localeCompare(a.created_at));

const sections = [
  {
    type: "business" as const,
    entries: ordered.filter((g) => typeOf(g.owner_id) === "business"),
    inlineCount: BUSINESS_INLINE,
    titleKey: "live.sections.business.title",
    subtitleKey: "live.sections.business.subtitle",
    countKey: "live.sections.business.count",
    showMoreId: "live-show-more-business",
  },
  {
    type: "improvement" as const,
    entries: ordered.filter((g) => typeOf(g.owner_id) === "improvement"),
    inlineCount: IMPROVEMENT_INLINE,
    titleKey: "live.sections.improvement.title",
    subtitleKey: "live.sections.improvement.subtitle",
    countKey: "live.sections.improvement.count",
    showMoreId: "live-show-more-improvement",
  },
].filter((section) => section.entries.length > 0);

const now = Date.now();

const faDigits = "۰۱۲۳۴۵۶۷۸۹";
const num = (n: number): string =>
  locale === "fa" ? String(n).replace(/\d/g, (d) => faDigits[Number(d)]) : String(n);

const typeTile: Record<string, string> = {
  business: "bg-primary-soft",
  improvement: "bg-purple-soft",
};
const typeIcon: Record<string, string> = {
  business: "text-primary",
  improvement: "text-purple",
};
const nodeIcon: Record<string, { icon: string; color: string }> = {
  active: { icon: "bx-time-five", color: "text-warning" },
  achieved: { icon: "bx-check-square", color: "text-success" },
  abandoned: { icon: "bx-error", color: "text-destructive" },
};
const statusChip: Record<string, string> = {
  active: "bg-warning-soft text-warning",
  achieved: "bg-success-soft text-success",
  abandoned: "bg-destructive-soft text-destructive",
};
const statusLabel: Record<string, string> = {
  active: "live.status.active",
  achieved: "live.status.achieved",
  abandoned: "live.status.abandoned",
};

function relTime(iso: string): string {
  const diff = Math.max(0, now - new Date(iso).getTime());
  const minutes = Math.floor(diff / 60000);
  if (minutes < 1) return t(locale, "live.time.justNow");
  if (minutes < 60) return t(locale, minutes === 1 ? "live.time.minuteAgo" : "live.time.minutesAgo", { n: num(minutes) });
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return t(locale, hours === 1 ? "live.time.hourAgo" : "live.time.hoursAgo", { n: num(hours) });
  const days = Math.floor(hours / 24);
  return t(locale, days === 1 ? "live.time.dayAgo" : "live.time.daysAgo", { n: num(days) });
}

const absoluteFormatter = new Intl.DateTimeFormat(
  locale === "fa" ? "fa-IR-u-ca-gregory" : "en-US",
  { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }
);
const absTime = (iso: string): string => absoluteFormatter.format(new Date(iso));

function metricText(goal: LiveGoal): string | null {
  const target =
    typeof goal.target === "number"
      ? goal.metric === "reply_rate"
        ? `${Math.round(goal.target * 100)}%`
        : String(goal.target)
      : String(goal.target);
  const operator = goal.operator === "ge" ? "≥" : goal.operator === "le" ? "≤" : goal.operator;
  return t(locale, "live.entry.metric", { metric: goal.metric, operator, target });
}

const counts = {
  statusAll: ordered.length,
  statusActive: ordered.filter((g) => g.goal_status === "active").length,
  statusAchieved: ordered.filter((g) => g.goal_status === "achieved").length,
  statusAbandoned: ordered.filter((g) => g.goal_status === "abandoned").length,
};

const statusPills = [
  { value: "all", labelKey: "live.filters.status.all", count: counts.statusAll },
  { value: "active", labelKey: "live.filters.status.active", count: counts.statusActive },
  { value: "achieved", labelKey: "live.filters.status.achieved", count: counts.statusAchieved },
  { value: "abandoned", labelKey: "live.filters.status.abandoned", count: counts.statusAbandoned },
];
---

<div id="live-timeline-root">
  <!-- Filters: one row, status group only (the sections separate the types) -->
  <div id="live-filters" class="mb-8 flex flex-wrap items-center gap-2" data-aos="fade-up">
    <span class="me-3 text-2xs font-semibold uppercase tracking-widest text-muted-foreground">{t(locale, "live.filters.status")}</span>
    {statusPills.map((pill, i) => (
      <button
        type="button"
        class:list={["filter-chip", i === 0 ? "filter-active" : "filter-inactive"]}
        data-filter-status={pill.value}
        aria-pressed={i === 0 ? "true" : "false"}
      >
        {t(locale, pill.labelKey)} <span class="opacity-80">({num(pill.count)})</span>
      </button>
    ))}
  </div>

  {sections.map((section) => {
    const hiddenCount = Math.max(0, section.entries.length - section.inlineCount);
    return (
      <section class="mb-10 last:mb-0" data-live-section={section.type} data-aos="fade-up">
        <div class="mb-4">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h2 class="text-lg font-bold tracking-tight text-foreground-strong">{t(locale, section.titleKey)}</h2>
            <span class="text-2xs font-medium text-muted-foreground">{t(locale, section.countKey, { count: num(section.entries.length) })}</span>
          </div>
          <p class="mt-1 max-w-2xl text-xs leading-relaxed text-muted-foreground">{t(locale, section.subtitleKey)}</p>
        </div>

        <ol class="live-timeline">
          {section.entries.map((goal, index) => {
            const status = goal.goal_status;
            const node = nodeIcon[status] ?? nodeIcon.active;
            const metric = metricText(goal);
            return (
              <li
                class:list={[
                  "live-entry relative border-s-2 border-border ps-6 pb-6 last:pb-0",
                  index >= section.inlineCount && "live-entry--hidden",
                ]}
                data-goal-id={goal.id}
                data-type={section.type}
                data-status={status}
              >
                <i class:list={["absolute -start-2.5 top-0", node.icon, node.color, "icon-sm"]} aria-hidden="true"></i>
                <div class="rounded-md border border-border bg-panel p-5 transition-all hover:border-border-strong hover:bg-panel-raised">
                  <div class="flex flex-wrap items-start gap-x-3 gap-y-2">
                    <div class:list={["flex h-6 w-6 shrink-0 items-center justify-center rounded-sm", typeTile[section.type]]}>
                      <i class:list={["bx", section.type === "business" ? "bx-trending-up" : "bx-slider", typeIcon[section.type], "icon-sm"]} aria-hidden="true"></i>
                    </div>
                    <h3 class="min-w-0 flex-1 text-sm font-semibold leading-snug text-foreground-strong">{goal.name}</h3>
                    <time datetime={goal.created_at} class="whitespace-nowrap text-2xs text-muted-foreground">
                      {relTime(goal.created_at)} · {absTime(goal.created_at)}
                    </time>
                  </div>
                  <div class="mt-3 flex flex-wrap items-center gap-1.5">
                    <span class="inline-flex items-center rounded-sm bg-primary-soft px-1.5 py-0.5 text-2xs font-medium text-primary">{goal.owner_id}</span>
                    <span class:list={["inline-flex items-center rounded-sm px-1.5 py-0.5 text-2xs font-medium", statusChip[status] ?? "bg-panel-strong text-muted-foreground"]}>
                      {t(locale, statusLabel[status] ?? "live.status.active")}
                    </span>
                    {goal.stage && (
                      <span class="inline-flex items-center rounded-sm bg-panel-strong px-1.5 py-0.5 text-2xs font-medium text-muted-foreground">
                        {t(locale, "live.entry.stage", { stage: goal.stage })}
                      </span>
                    )}
                    {metric && (
                      <span class="inline-flex items-center rounded-sm border border-border bg-background px-1.5 py-0.5 font-mono text-2xs text-muted-foreground">
                        {metric}
                      </span>
                    )}
                  </div>
                </div>
              </li>
            );
          })}
        </ol>

        <!-- Show more: reveals every remaining entry in this section, then hides itself -->
        {hiddenCount > 0 && (
          <div class="mt-8 flex justify-center">
            <button
              id={section.showMoreId}
              type="button"
              class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-panel px-6 text-sm font-medium transition-all hover:border-border-strong hover:bg-panel-raised"
            >
              {t(locale, "live.showMore")} <span class="opacity-80">({num(hiddenCount)})</span>
            </button>
          </div>
        )}
      </section>
    );
  })}
</div>

<style>
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    font-size: var(--font-size-xs);
    font-weight: 500;
    transition:
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }
  .filter-chip.filter-active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .filter-chip.filter-inactive {
    background: var(--panel);
    color: var(--muted-foreground);
  }
  .filter-chip.filter-inactive:hover {
    background: var(--panel-raised);
    border-color: var(--border-strong);
  }
  .live-entry--hidden {
    display: none;
  }
</style>

<script>
  (function () {
    var rootEl = document.getElementById("live-timeline-root");
    if (!rootEl) return;
    var root = rootEl as HTMLElement;
    var INLINE: Record<string, number> = { business: 10, improvement: 5 };
    var filterStatus = "all";
    var revealed: Record<string, boolean> = { business: false, improvement: false };

    var sections = Array.prototype.slice.call(root.querySelectorAll("[data-live-section]")).map(function (sec: Element) {
      var type = sec.getAttribute("data-live-section") || "";
      return {
        type: type,
        entries: Array.prototype.slice.call(sec.querySelectorAll(".live-entry")) as Element[],
        showMore: document.getElementById("live-show-more-" + type) as HTMLElement | null,
      };
    });

    function matches(el: Element): boolean {
      if (filterStatus !== "all" && el.getAttribute("data-status") !== filterStatus) return false;
      return true;
    }

    function apply(): void {
      sections.forEach(function (sec) {
        sec.entries.forEach(function (el: Element, i: number) {
          var visible = matches(el) && (revealed[sec.type] || filterStatus !== "all" || i < INLINE[sec.type]);
          el.classList.toggle("live-entry--hidden", !visible);
        });
        if (sec.showMore) sec.showMore.classList.toggle("hidden", revealed[sec.type]);
      });
    }

    function selectStatus(value: string, btn: Element): void {
      filterStatus = value;
      var group = root.querySelectorAll("[data-filter-status]");
      for (var k = 0; k < group.length; k++) {
        var b = group[k];
        var active = b === btn;
        b.classList.toggle("filter-active", active);
        b.classList.toggle("filter-inactive", !active);
        b.setAttribute("aria-pressed", active ? "true" : "false");
      }
      apply();
    }

    var statusButtons = root.querySelectorAll("[data-filter-status]");
    for (var j = 0; j < statusButtons.length; j++) {
      (function (btn: Element) {
        btn.addEventListener("click", function () {
          selectStatus(btn.getAttribute("data-filter-status") || "all", btn);
        });
      })(statusButtons[j]);
    }

    sections.forEach(function (sec) {
      if (sec.showMore) {
        sec.showMore.addEventListener("click", function () {
          revealed[sec.type] = true;
          apply();
        });
      }
    });

    // Initial state: inline counts applied server-side.
    apply();
  })();
</script>
