---
import { type Locale, t } from "../../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const parts = [
  { icon: "bx-network-chart", key: "architecture.map.workflow", color: "primary" },
  { icon: "bx-user", key: "architecture.map.agent", color: "accent" },
  { icon: "bx-task", key: "architecture.map.skill", color: "purple" },
  { icon: "bx-check-shield", key: "architecture.map.evals", color: "info" },
  { icon: "bx-link", key: "architecture.map.connection", color: "warning" },
  { icon: "bx-file", key: "architecture.map.artifact", color: "success" },
];
---

<div class="department-canvas relative overflow-hidden rounded-md border border-border bg-panel p-5 shadow-panel sm:p-8" data-aos="fade-up">
  <div class="absolute inset-0 opacity-[0.04] hero-grid"></div>
  <div class="absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 glow-blob opacity-10"></div>
  <div class="relative mx-auto max-w-xl text-center">
    <div class="inline-flex items-center gap-2 rounded-md border border-primary bg-primary-soft px-4 py-2.5 text-sm font-semibold text-primary shadow-[0_0_28px_var(--primary-soft)]">
      <i class="bx bx-group icon-lg" aria-hidden="true"></i>
      {t(locale, "architecture.map.department")}
    </div>
    <p class="mt-3 text-xs leading-relaxed text-muted-foreground">{t(locale, "architecture.map.departmentDesc")}</p>
  </div>
  <div class="department-branches relative mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
    {parts.map((part, index) => (
      <div class:list={["relative rounded-md border bg-panel-raised p-3 text-center transition-all hover:-translate-y-1 hover:border-border-strong", index === parts.length - 1 ? "col-span-2 sm:col-span-1" : "", index % 2 === 0 ? "border-primary/30" : "border-accent/30"]}>
        <i class:list={["bx", part.icon, `text-${part.color}`, "icon-xl"]} aria-hidden="true"></i>
        <p class="mt-2 text-2xs font-semibold text-foreground-strong">{t(locale, `${part.key}.title`)}</p>
        <p class="mt-1 text-3xs leading-relaxed text-muted-foreground">{t(locale, `${part.key}.desc`)}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .department-branches::before {
    content: "";
    position: absolute;
    inset-inline: 9%;
    top: -1.25rem;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--primary), var(--accent), transparent);
    opacity: 0.8;
  }
  .department-branches > div::before {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1px;
    height: 1.25rem;
    background: var(--border-strong);
  }
</style>
