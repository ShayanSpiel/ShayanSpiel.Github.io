---
import { type Locale } from "../../i18n/translations";
import { BOOKING_LINK, BOOKING_CONFIG } from "../../config";
import Breadcrumbs from "./Breadcrumbs.astro";

export interface Props {
  locale?: Locale;
  breadcrumbs: { label: string; href?: string }[];
  label?: string;
  title: string;
  description: string;
  cta?: { label: string; href?: string };
}

const { locale = "en", breadcrumbs, label, title, description, cta } = Astro.props;
---

<section class="relative pt-24 pb-12 sm:pt-28 sm:pb-16 overflow-hidden">
  <div class="absolute inset-0 opacity-[0.03] hero-grid"></div>
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] glow-blob opacity-10"></div>

  <div class="relative z-10 mx-auto max-w-3xl px-6 text-center">
    <Breadcrumbs items={breadcrumbs} locale={locale} />

    {label && (
      <div class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-raised px-3 py-1 mb-6" data-aos="fade-up">
        <span class="text-2xs text-muted-foreground font-medium">{label}</span>
      </div>
    )}

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground-strong tracking-tight leading-tightest" data-aos="fade-up" set:html={title} />

    <p class="mt-6 text-base text-muted-foreground max-w-2xl leading-relaxed" data-aos="fade-up">
      {description}
    </p>

    {cta && (
      <div class="mt-8 flex items-center justify-center gap-3" data-aos="fade-up">
        {cta.href ? (
          <a href={cta.href} class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
            {cta.label}
          </a>
        ) : (
          <button
            type="button"
            data-cal-link={BOOKING_LINK}
            data-cal-config={JSON.stringify(BOOKING_CONFIG)}
            data-cal-cta
            data-cta-location="feature_hero"
            class="inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20"
          >
            {cta.label}
          </button>
        )}
      </div>
    )}
  </div>
</section>
