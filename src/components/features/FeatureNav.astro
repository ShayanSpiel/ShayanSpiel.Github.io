---
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";

export interface Props {
  locale?: Locale;
  currentPath: string;
}

const { locale = "en", currentPath } = Astro.props;

function isActive(href: string): boolean {
  const localized = localizePath(href, locale);
  return currentPath === localized || currentPath.startsWith(localized + "/");
}

const tree = [
  { icon: "bx-slider", color: "primary", titleKey: "features.blocks.director.short", href: "/features/director/" },
  { icon: "bx-group", color: "accent", titleKey: "features.blocks.departments.short", href: "/features/departments/" },
  { icon: "bx-network-chart", color: "purple", titleKey: "features.blocks.workflows.short", href: "/features/workflows/" },
  { icon: "bx-user", color: "success", titleKey: "features.blocks.agents.short", href: "/features/agents/" },
  { icon: "bx-link", color: "warning", titleKey: "features.blocks.skills.short", href: "/features/skills/" },
  { icon: "bx-task", color: "info", titleKey: "features.blocks.evals.short", href: "/features/evals/" },
  { icon: "bx-globe", color: "accent", titleKey: "features.blocks.connections.short", href: "/features/connections/" },
  { icon: "bx-file", color: "primary", titleKey: "features.blocks.artifacts.short", href: "/features/artifacts/" },
];
const isRtl = locale === "fa";
---

<!-- Mobile toggle button -->
<button
  type="button"
  id="feature-nav-toggle"
  class="lg:hidden fixed bottom-6 z-50 flex h-11 w-11 items-center justify-center rounded-md bg-primary text-primary-foreground shadow-lg shadow-primary/30 hover:brightness-110 active:brightness-95 transition-all duration-300"
  style="inset-inline-end: 1.5rem;"
  aria-label={t(locale, "common.navAria")}
  aria-expanded="false"
>
  <i class="bx bx-menu icon-3xl" id="feature-nav-icon"></i>
</button>

<!-- Mobile backdrop -->
<div
  id="feature-nav-backdrop"
  class="lg:hidden fixed inset-0 z-50 bg-background/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<!-- Mobile sidebar -->
<aside
  id="feature-nav-mobile"
  class:list={[
    "lg:hidden fixed top-0 z-50 h-full w-72 bg-panel overflow-y-auto transition-transform duration-300",
    isRtl ? "right-auto left-0 border-r" : "right-0 left-auto border-l",
  ]}
  style={`border-color: var(--border); transform: ${isRtl ? 'translateX(-100%)' : 'translateX(100%)'};`}
>
  <div class="flex items-center justify-between px-5 h-16 border-b border-border">
    <a href={localizePath("/features/", locale)} class="flex items-center gap-2">
      <i class="bx bx-layer text-primary icon-lg"></i>
      <span class="text-sm font-semibold text-foreground-strong">{t(locale, "nav.features")}</span>
    </a>
    <button
      type="button"
      id="feature-nav-close"
      class="flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-panel-raised transition-colors"
      aria-label={t(locale, "common.close")}
    >
      <i class="bx bx-x icon-lg"></i>
    </button>
  </div>
  <nav class="p-4 space-y-1" aria-label={t(locale, "common.navAria")}>
    {tree.map((node) => (
      <a
        href={localizePath(node.href, locale)}
        class:list={[
          "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
          isActive(node.href) ? "bg-primary-soft text-primary font-medium" : "text-muted-foreground hover:text-foreground hover:bg-panel-raised",
        ]}
      >
        <i class={`bx ${node.icon} icon-lg`} style={`color: var(--${node.color})`}></i>
        {t(locale, node.titleKey)}
      </a>
    ))}
  </nav>
</aside>

<!-- Desktop sidebar -->
<aside
  class:list={[
    "hidden lg:block fixed top-16 z-40 w-56 h-[calc(100vh-4rem)] overflow-y-auto bg-background/80 backdrop-blur-sm",
    isRtl ? "right-0 left-auto border-l" : "left-0 right-auto border-r",
  ]}
  style="border-color: var(--border);"
>
  <nav class="p-4 space-y-1" aria-label={t(locale, "common.navAria")}>
    <a
      href={localizePath("/features/", locale)}
      class:list={[
        "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
        isActive("/features/") && !tree.some((node) => isActive(node.href))
          ? "bg-primary-soft text-primary font-medium"
          : "text-muted-foreground hover:text-foreground hover:bg-panel-raised",
      ]}
    >
      <i class="bx bx-home icon-lg"></i>
      {t(locale, "nav.features")}
    </a>
    {tree.map((node) => (
      <a
        href={localizePath(node.href, locale)}
        class:list={[
          "flex items-center gap-2.5 rounded-md px-3 py-2 text-sm transition-colors",
          isActive(node.href) ? "bg-primary-soft text-primary font-medium" : "text-muted-foreground hover:text-foreground hover:bg-panel-raised",
        ]}
      >
        <i class={`bx ${node.icon} icon-lg`} style={`color: var(--${node.color})`}></i>
        {t(locale, node.titleKey)}
      </a>
    ))}
  </nav>
</aside>

<script is:inline>
(function() {
  var toggle = document.getElementById('feature-nav-toggle');
  var mobile = document.getElementById('feature-nav-mobile');
  var backdrop = document.getElementById('feature-nav-backdrop');
  var closeBtn = document.getElementById('feature-nav-close');
  var icon = document.getElementById('feature-nav-icon');
  if (!toggle || !mobile || !backdrop || !closeBtn || !icon) return;
  var isRtl = document.documentElement.dir === 'rtl';
  var hiddenTf = isRtl ? 'translateX(-100%)' : 'translateX(100%)';
  function open() {
    mobile.style.transform = 'translateX(0)';
    backdrop.classList.remove('opacity-0', 'pointer-events-none');
    backdrop.classList.add('opacity-100', 'pointer-events-auto');
    toggle.setAttribute('aria-expanded', 'true');
    icon.className = 'bx bx-x';
    document.body.style.overflow = 'hidden';
  }
  function close() {
    mobile.style.transform = hiddenTf;
    backdrop.classList.add('opacity-0', 'pointer-events-none');
    backdrop.classList.remove('opacity-100', 'pointer-events-auto');
    toggle.setAttribute('aria-expanded', 'false');
    icon.className = 'bx bx-menu';
    document.body.style.overflow = '';
  }
  toggle.addEventListener('click', function() {
    if (mobile.style.transform === 'translateX(0)' || mobile.style.transform === '') close();
    else open();
  });
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  mobile.querySelectorAll('a').forEach(function(link) { link.addEventListener('click', close); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') close(); });
  var footer = document.querySelector('footer');
  if (footer) {
    var footerObs = new IntersectionObserver(function(entries) {
      toggle.style.opacity = entries[0].isIntersecting ? '0' : '1';
      toggle.style.pointerEvents = entries[0].isIntersecting ? 'none' : 'auto';
    }, { threshold: 0 });
    footerObs.observe(footer);
  }
})();
</script>
