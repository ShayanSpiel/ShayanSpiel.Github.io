---
import { type Locale, t } from "../../i18n/translations";
import { localizePath } from "../../i18n";
import { AGENT_BRIEFING_PATH } from "../../config";

export interface Props {
  locale?: Locale;
  title: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { locale = "en", title, description, ctaLabel, ctaHref } = Astro.props;
const href = ctaHref || localizePath(AGENT_BRIEFING_PATH, locale);
const label = ctaLabel || t(locale, "services.cta.button");
---

<section class="relative py-24 sm:py-32 overflow-hidden">
  <div class="absolute inset-0 bg-panel-deep/50"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] glow-blob opacity-10"></div>

  <div class="relative mx-auto max-w-3xl px-6 text-center" data-aos="fade-up">
    <h2 class="text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight" set:html={title} />
    {description && (
      <p class="mt-4 text-sm text-muted-foreground max-w-lg mx-auto">
        {description}
      </p>
    )}
    <a href={href} class="mt-8 inline-flex items-center justify-center rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20">
      {label}
    </a>
  </div>
</section>
