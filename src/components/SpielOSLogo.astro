---
export interface Props {
  size?: "sm" | "md";
  textClass?: string;
}

const { size = "sm", textClass = "text-sm font-semibold text-foreground-strong tracking-tight" } = Astro.props;
const boxSize = size === "sm" ? "h-6 w-6" : "h-7 w-7";
---

<div class={`flex ${boxSize} items-center justify-center rounded-sm bg-panel-raised text-foreground-strong`}>
  <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" class="h-full w-full" aria-hidden="true">
    <path d="M16 7l-12 12 6 6 3-3 3 3 3-3 3 3 6-6-12-12zM16 19l-3-3 3-3 3 3-3 3z" fill="currentColor"/>
  </svg>
</div>
<span class={textClass}>SpielOS</span>
