---
import { FOUNDER } from "../../config";
import { type Locale, t } from "../../i18n/translations";
export interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const metrics = [
  { value: `${FOUNDER.experienceYears}+`, label: t(locale, "conversion.home.trust.years") },
  { value: `${FOUNDER.productAttempts}+`, label: t(locale, "conversion.home.trust.products") },
  ...FOUNDER.proof.map((item, index) => ({ value: item.value, label: t(locale, `conversion.home.trust.proof${index + 1}`) })),
];
---
<aside id="trust-proof" class="trust-proof" aria-label={t(locale, "conversion.home.trust.label")}>
  <div class="trust-proof__heading">
    <div class="trust-proof__stars" aria-label={t(locale, "conversion.home.trust.stars")}>{[0,1,2,3,4].map(() => <i class="bx bxs-star icon-base" aria-hidden="true"></i>)}</div>
    <p>{t(locale, "conversion.home.trust.label")}</p>
    <h3 set:html={t(locale, "conversion.home.trust.title")} />
  </div>
  <blockquote>
    <i class="bx bxs-quote-alt-left icon-xl" aria-hidden="true"></i>
    <p>{t(locale, "conversion.home.trust.founderQuote")}</p>
    <footer><strong>{FOUNDER.name}</strong><span>{t(locale, "conversion.home.trust.founderRole")}</span></footer>
  </blockquote>
  <div class="trust-proof__metrics">{metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
</aside>
<style is:global>
  .trust-proof{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:1.25rem;margin-top:5rem;border-top:1px solid var(--border);padding-top:4rem}.trust-proof__heading{align-self:center}.trust-proof__stars{display:flex;gap:.2rem;color:var(--warning)}.trust-proof__heading>p{margin-top:.7rem;color:var(--warning);font-size:var(--font-size-3xs);font-weight:700;letter-spacing:.12em;text-transform:uppercase}.trust-proof__heading h3{max-width:30rem;margin-top:.6rem;color:var(--foreground-strong);font-size:var(--font-size-4xl);font-weight:800;letter-spacing:-.025em;line-height:1.05}.trust-proof blockquote{margin:0;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--panel);padding:1.5rem;box-shadow:var(--shadow-panel)}.trust-proof blockquote>i{color:var(--warning)}.trust-proof blockquote>p{margin-top:.65rem;color:var(--foreground);font-size:var(--font-size-sm);line-height:1.6}.trust-proof blockquote footer{display:flex;flex-direction:column;margin-top:1rem}.trust-proof blockquote strong{color:var(--foreground-strong);font-size:var(--font-size-xs)}.trust-proof blockquote span{color:var(--muted-foreground);font-size:var(--font-size-3xs)}.trust-proof__metrics{grid-column:1/-1;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));overflow:hidden;border:1px solid var(--border);border-radius:var(--radius-md);background:var(--panel)}.trust-proof__metrics>div{min-width:0;padding:1rem;text-align:center}.trust-proof__metrics>div+div{border-inline-start:1px solid var(--border)}.trust-proof__metrics strong,.trust-proof__metrics span{display:block}.trust-proof__metrics strong{color:var(--primary);font-size:var(--font-size-2xl);line-height:1}.trust-proof__metrics span{margin-top:.4rem;color:var(--muted-foreground);font-size:var(--font-size-3xs);line-height:1.3}@media(max-width:720px){.trust-proof{grid-template-columns:1fr;margin-top:4rem;padding-top:3rem}.trust-proof__heading{text-align:center}.trust-proof__stars{justify-content:center}.trust-proof__heading h3{margin-inline:auto;font-size:var(--font-size-3xl)}.trust-proof__metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.trust-proof__metrics>div+div{border-inline-start:0}.trust-proof__metrics>div{border-top:1px solid var(--border)}.trust-proof__metrics>div:nth-child(-n+2){border-top:0}.trust-proof__metrics>div:nth-child(even){border-inline-start:1px solid var(--border)}.trust-proof__metrics>div:last-child{grid-column:1/-1;border-inline-start:0}}
</style>
