---
/**
 * JourneyUniversal - isolated reusable journey line (legacy adapter, now fixed).
 *
 * Consolidation: JourneySignature is the canonical template. JourneyUniversal
 * is kept as a thin legacy adapter for the homepage hero import and now
 * mirrors the same contracts (0 hardcoding, tokens only). New code should
 * prefer JourneySignature with `points` + `animation` props.
 *
 * Geometry contract:
 *   points: [start, ...mids, goal] → start = points[0] (traveling party at
 *   origin), mids = points.slice(1,-1) (intermediate objectives the line
 *   passes through), goal = points.at(-1) (flat bullseye termination).
 *   Each node rides ON the path (Catmull-Rom→cubic, pure C chains,
 *   continuous tangents). Path generated via toPath().
 *
 * Animation + trigger contract (declared here + in journey-universal.css):
 *   animation="scroll" - trigger: window scroll (scrollY / (docHeight-winHeight)),
 *     how: 0% pre-filled (START_REVEAL=0) - at scroll top solid fully hidden,
 *     offset = len * (1 - p) where p=scrollY/(docH-winH), at p=1 exactly at
 *     bullseye no tail; JS per-instance uid, guard getTotalLength fallback;
 *     reduced-motion → static 70/30.
 *   animation="auto" - trigger: page load (timed CSS), how: dashed muted
 *     route fades in 0.35s, solid primary draws 5s (stroke-dasharray 100
 *     offset 100→0 with pathLength 100), nodes visible at start grey (muted)
 *     then become colored (primary) sequentially when solid hits them;
 *     delays 0.9s + idx*1.25s (goal last at 5.9s), bullseye last;
 *     tokens var(--duration)/var(--ease). Edge-anchored vertical wander (isolated hero 5-anchors, no gallery mix)
 *     for hero: points [[12,28],[210,220],[460,160],[600,390],[600,545]]
 *     in viewBox 0 0 1200 700 xMinYMin meet - [12,28] start edge-merged with left rail [100,24] as ONE
 *     (12-10=2px from left edge, 28-10=18≈24 rail y; xMinYMin pins 0,0 to container top-left so both at true viewport edge), [210,220] left side of title near edge, [460,160]
 *     top of eyebrow a little left through center (y 160 < 220 intentional:
 *     eyebrow ABOVE title so node3 above node2 creates S-wander via
 *     Catmull-Rom), [600,390] below title at center, [600,545] goal top side
 *     of CTA (545+24+8=577<700 margin). Isolated to src/components+src/pages.
 *   animation="static" - no trigger, 70% traveled solid + 30% dashed ahead.
 *
 * Reusable as background: fills parent (absolute inset 0, pointer-events none),
 * RTL-safe via single [dir="rtl"] scaleX rule (avoid double scale on
 * full-inset container). All colors/strokes from tokens, non-scaling-stroke.
 */
import "../styles/journey-universal.css";

export interface Props {
  /** Ordered points: [start, ...mids, goal] - line goes through each 1 by 1 */
  points: Array<[number, number]>;
  viewBox?: string;
  preserveAspectRatio?: string;
  /** Animation mode: scroll = rail scroll-driven, auto = timed draw, static = 70/30 */
  animation?: "scroll" | "auto" | "static";
  /** Background faded for hero (less transparent = fainter) */
  faded?: boolean;
  /** Changeable icons (boxicons) - if set, replaces dot/core */
  nodeIcon?: string;
  goalIcon?: string;
  /** Optional radii override (defaults match band/corner scale) */
  radii?: { ring: number; dot: number; goal: number; goalInner: number; core: number };
  /** Optional id for JS targeting when multiple instances */
  id?: string;
}

const {
  points,
  viewBox = "0 0 1200 700",
  preserveAspectRatio = "xMinYMin meet",
  animation = "auto",
  faded = false,
  nodeIcon,
  goalIcon,
  radii,
  id,
} = Astro.props;

if (!points || points.length < 2) {
  throw new Error("JourneyUniversal: points must have at least start and goal");
}

// Generate smooth cubic chain through points (Catmull-Rom -> Bezier)
function toPath(pts: Array<[number, number]>): string {
  let d = `M ${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[0];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] || p2;
    const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
    const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
    const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
    const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${p2[0]} ${p2[1]}`;
  }
  return d;
}

const path = toPath(points);
const nodes = points.slice(1, -1); // mids
const goal = points[points.length - 1];
const start = points[0];
const allNodes = [start, ...nodes]; // start + mids are nodes, goal is bullseye
const r = radii ?? { ring: 10, dot: 4, goal: 24, goalInner: 14, core: 6 };
const uid = id ?? `ju-${Math.random().toString(36).slice(2, 7)}`;
const isScroll = animation === "scroll";
const isAuto = animation === "auto";
---

<div
  id={uid}
  class:list={["journey-universal", `journey-universal--${animation}`, faded && "journey-universal--faded"]}
  data-animation={animation}
  aria-hidden="true"
>
  <svg class="journey-universal-svg" viewBox={viewBox} preserveAspectRatio={preserveAspectRatio} focusable="false">
    <path class="journey-universal-path" d={path} />
    <path class="journey-universal-path-fill" d={path} pathLength="100" />
    {allNodes.map(([nx, ny], idx) => (
      <g class="journey-universal-node" transform={`translate(${nx} ${ny})`}>
        <g class="ju-node-pop" style={isAuto ? `animation-delay: ${0.9 + idx * 1.25}s` : undefined}>
          <circle class="node-ring" r={r.ring} />
          {nodeIcon ? (
            <g class="node-icon-wrap"><foreignObject width="16" height="16" x="-8" y="-8"><i class={`bx ${nodeIcon} icon-sm`} style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;color:var(--primary)"></i></foreignObject></g>
          ) : (
            <circle class="node-dot" r={r.dot} />
          )}
        </g>
      </g>
    ))}
    <g class="journey-universal-goal" transform={`translate(${goal[0]} ${goal[1]})`}>
      <g class="ju-goal-pop" style={isAuto ? `animation-delay: ${0.9 + 5}s` : undefined}>
        <circle class="goal-ring" r={r.goal} />
        <circle class="goal-ring-inner" r={r.goalInner} />
        {goalIcon ? (
          <g class="goal-icon-wrap"><foreignObject width="16" height="16" x="-8" y="-8"><i class={`bx ${goalIcon} icon-sm`} style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;color:var(--primary)"></i></foreignObject></g>
        ) : (
          <circle class="goal-core" r={r.core} />
        )}
      </g>
    </g>
  </svg>
</div>

{isScroll && (
  <script is:inline define:vars={{ uid }}>
    (function(uid){
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      var root = document.getElementById(uid);
      var fill = root ? root.querySelector(".journey-universal-path-fill") : null;
      if (!root || !fill) return;
      var len = 0;
      try { len = fill.getTotalLength(); } catch(e) { len = 0; }
      if (!len || len === 0) return;
      fill.style.strokeDasharray = String(len);
      var START = 0;
      fill.style.strokeDashoffset = String(len * (1 - START));
      function tick(){
        var top = window.pageYOffset || document.documentElement.scrollTop;
        var docH = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        var winH = window.innerHeight;
        var max = docH - winH;
        if (max <= 0) return;
        var p = Math.min(top / max, 1);
        fill.style.strokeDashoffset = String(len * (1 - START) * (1 - p));
      }
      window.addEventListener("scroll", tick, {passive:true});
      window.addEventListener("resize", tick, {passive:true});
      tick();
    })(uid);
  </script>
)}
