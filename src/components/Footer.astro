---
import SocialIcons from "./SocialIcons.astro";
import SpielOSLogo from "./SpielOSLogo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { FOOTER_LINKS, SITE, THEMES } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  variant?: "default" | "showcase";
  links?: { label: string; href: string }[];
  showThemeToggle?: boolean;
  showSocial?: boolean;
  copyright?: string;
  locale?: Locale;
}

const { variant = "default", links, showThemeToggle = variant === "showcase", showSocial = variant !== "showcase", copyright, locale = "en" } = Astro.props;

const footerLinks = links || (variant === "showcase" ? FOOTER_LINKS.showcase : FOOTER_LINKS.default.map(link => {
  const key = link.label.toLowerCase().replace(/\s+/g, '');
  const translationKey = key === 'joinwaitlist' ? 'nav.joinWaitlist' : key === 'agentbrief' ? 'cta.agentBrief' : `nav.${key}`;
  return {
    href: localizePath(link.href, locale),
    label: t(locale, translationKey) || link.label,
  };
}));
const year = new Date().getFullYear();
const contactHref = localizePath("/contact/", locale);
const copyrightText = copyright || t(locale, "footer.copyright", { year });
---

<footer class:list={[
  "border-t border-border",
  locale === "fa" ? "font-iransansx" : "",
]}>
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-y-2 px-6 py-3 text-2xs text-muted-foreground sm:flex-row sm:items-center sm:gap-x-5">
    <!-- Section 1: brand -->
    <div class="flex shrink-0 items-center gap-1.5">
      <SpielOSLogo size="sm" boxClass="h-5 w-20" textClass="text-foreground-strong" />
      <span aria-hidden="true" class="text-border">·</span>
      <span>{"© " + year}</span>
    </div>

    <!-- Section 2: links -->
    <nav class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 py-1 sm:flex-1 sm:py-0">
      {footerLinks.map((link) => (
        <a href={link.href} title={link.label} class="text-2xs text-muted-foreground transition-colors hover:text-foreground">{link.label}</a>
      ))}
    </nav>

    <!-- Section 3: call │ language+theme │ social marks -->
    <div class="flex shrink-0 items-center gap-1">
      <a href={contactHref} aria-label={t(locale, "nav.contact")} title={t(locale, "nav.contact")} class="flex h-7 w-7 items-center justify-center text-muted-foreground transition-colors hover:text-foreground"><i class="bx bx-phone icon-xl" aria-hidden="true"></i></a>
      <span aria-hidden="true" class="mx-0.5 h-5 w-px bg-border"></span>
      {showThemeToggle ? <div class="flex items-center gap-0.5"><LanguageSwitcher locale={locale} /><button type="button" id="footer-theme-toggle" class="flex h-7 w-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-panel-raised hover:text-foreground" aria-label={t(locale, "common.themeToggle")} title={t(locale, "common.themeToggle")}><i class="bx bx-moon icon-xl leading-none" id="theme-icon"></i></button></div> : null}
      <span aria-hidden="true" class="mx-0.5 h-5 w-px bg-border"></span>
      {showSocial && <div class="flex items-center gap-1"><SocialIcons size="lg" show={["x", "linkedin", "github"]} /></div>}
    </div>
  </div>
</footer>

{showThemeToggle && (
  <script is:inline define:vars={{ allThemes: THEMES.all, darkThemes: THEMES.dark, defaultTheme: SITE.defaultTheme }}>
  (function() {
    var btn = document.getElementById('footer-theme-toggle');
    var icon = document.getElementById('theme-icon');
    if (!btn || !icon) return;
    function currentTheme() { return document.documentElement.dataset.theme || defaultTheme; }
    function isDark(t) { return darkThemes.indexOf(t) !== -1; }
    function updateIcon() { icon.className = isDark(currentTheme()) ? 'bx bx-moon icon-xl leading-none' : 'bx bx-sun icon-xl leading-none'; }
    btn.addEventListener('click', function() {
      var t = currentTheme();
      var next = allThemes[(allThemes.indexOf(t) + 1) % allThemes.length];
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('spielos.theme', next); } catch(e) {}
      updateIcon();
    });
    updateIcon();
  })();
  </script>
)}
