---
import SocialIcons from "./SocialIcons.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { FOOTER_LINKS, SITE, THEMES } from "../config";
import { type Locale, t } from "../i18n/translations";
import { localizePath } from "../i18n";

export interface Props {
  variant?: "default" | "showcase";
  links?: { label: string; href: string }[];
  showThemeToggle?: boolean;
  showSocial?: boolean;
  copyright?: string;
  locale?: Locale;
}

const { variant = "default", links, showThemeToggle = variant === "showcase", showSocial = variant !== "showcase", copyright, locale = "en" } = Astro.props;

const footerLinks = links || (variant === "showcase" ? FOOTER_LINKS.showcase : FOOTER_LINKS.default.map(link => {
  const key = link.label.toLowerCase().replace(/\s+/g, '');
  const translationKey = key === 'joinwaitlist' ? 'nav.joinWaitlist' : key === 'agentbrief' ? 'cta.agentBrief' : `nav.${key}`;
  return {
    href: localizePath(link.href, locale),
    label: t(locale, translationKey) || link.label,
  };
}));
const year = new Date().getFullYear();
const copyrightText = copyright || t(locale, "footer.copyright", { year });
---

<footer class:list={[
  "border-t border-border py-4",
  locale === "fa" ? "font-iransansx" : "",
]}>
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
      <div class="flex items-center gap-1.5 text-2xs text-muted-foreground">
        <span dir="ltr" class="font-sans font-semibold text-foreground-strong">{SITE.name}</span>
        <span aria-hidden="true">·</span>
        <span>{copyrightText}</span>
      </div>

      <div class="flex w-full flex-wrap items-center justify-center gap-x-4 gap-y-3 sm:w-auto sm:flex-nowrap sm:justify-end">
        <div class="flex flex-wrap items-center justify-center gap-x-1 gap-y-2">
          {footerLinks.map((link, i) => (
            <>
              {i > 0 && <span class="px-1.5 text-3xs text-muted-foreground/50" aria-hidden="true">·</span>}
              <a href={link.href} title={link.label} class="text-2xs text-muted-foreground hover:text-foreground transition-colors">{link.label}</a>
            </>
          ))}
        </div>

        <span class="hidden text-border sm:inline" aria-hidden="true">·</span>

        <div class="flex items-center gap-3">
          <LanguageSwitcher locale={locale} />
          {showThemeToggle && (
            <button
              type="button"
              id="footer-theme-toggle"
              class="flex h-6 w-6 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-panel-raised transition-colors"
              aria-label={t(locale, "common.themeToggle")}
              title={t(locale, "common.themeToggle")}
            >
              <i class="bx bx-moon icon-lg" id="theme-icon"></i>
            </button>
          )}
          {showSocial && <SocialIcons size="sm" show={["x", "github"]} />}
        </div>
      </div>
    </div>
  </div>
</footer>

{showThemeToggle && (
          <button
            type="button"
            id="footer-theme-toggle"
            class="flex h-6 w-6 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-panel-raised transition-colors"
            aria-label={t(locale, "common.themeToggle")}
            title={t(locale, "common.themeToggle")}
          >
            <i class="bx bx-moon icon-lg" id="theme-icon"></i>
          </button>
        )}
        {showSocial && <SocialIcons size="sm" show={["x", "github"]} />}
      </div>
    </div>
  </div>
</footer>

{showThemeToggle && (
  <script define:vars={{ allThemes: THEMES.all, darkThemes: THEMES.dark, defaultTheme: SITE.defaultTheme }}>
  (function() {
    var btn = document.getElementById('footer-theme-toggle');
    var icon = document.getElementById('theme-icon');
    if (!btn || !icon) return;
    function currentTheme() { return document.documentElement.dataset.theme || defaultTheme; }
    function isDark(t) { return darkThemes.indexOf(t) !== -1; }
    function updateIcon() { icon.className = isDark(currentTheme()) ? 'bx bx-moon' : 'bx bx-sun'; }
    btn.addEventListener('click', function() {
      var t = currentTheme();
      var next = allThemes[(allThemes.indexOf(t) + 1) % allThemes.length];
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('spielos.theme', next); } catch(e) {}
      updateIcon();
    });
    updateIcon();
  })();
  </script>
)}
