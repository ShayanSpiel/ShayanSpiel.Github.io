---
import { type Locale, t } from "../i18n/translations";
import { getSwitchLocaleUrl, localizePath } from "../i18n";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
// The 404 page is a single global document — switching locale there can
// only land on another missing path, so send the switcher home instead.
const is404 = /^\/(fa\/)?404\/?$/.test(Astro.url.pathname);
const switchPath = is404 ? localizePath("/", locale) : getSwitchLocaleUrl(Astro.url.pathname, locale);
const switchLabel = locale === "en" ? t(locale, "common.switchToFa") : t(locale, "common.switchToEn");
---

<a
  href={switchPath}
  class="language-switcher flex h-7 w-7 items-center justify-center rounded-md text-muted-foreground hover:text-foreground hover:bg-panel-raised transition-colors"
  aria-label={switchLabel}
>
  <i class="bx bx-world icon-lg" aria-hidden="true"></i>
</a>
