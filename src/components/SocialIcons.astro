---
import { SOCIAL, AUTHOR } from "../config";

export interface Props {
  size?: "sm" | "md";
  show?: ("x" | "linkedin" | "github" | "rss" | "email")[];
}

const { size = "sm", show = ["x", "linkedin", "github"] } = Astro.props;
const iconClass = size === "sm" ? "icon-base" : "icon-lg";
const linkClass = "text-muted-foreground hover:text-foreground transition-colors";
---

{show.includes("x") && (
  <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer me" class={linkClass} aria-label="X (Twitter)" title="X (Twitter)">
    <i class={`bx bxl-twitter ${iconClass}`} aria-hidden="true"></i>
  </a>
)}
{show.includes("linkedin") && (
  <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer me" class={linkClass} aria-label="LinkedIn" title="LinkedIn"><i class={`bx bxl-linkedin-square ${iconClass}`} aria-hidden="true"></i></a>
)}
{show.includes("github") && (
  <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer me" class={linkClass} aria-label="GitHub" title="GitHub"><i class={`bx bxl-github ${iconClass}`} aria-hidden="true"></i></a>
)}
{show.includes("rss") && (
  <a href="/feed.xml" class={linkClass} aria-label="RSS feed" title="RSS feed">
    <i class="bx bx-rss icon-sm"></i>
  </a>
)}
{show.includes("email") && (
  <a href={`mailto:${AUTHOR.email}`} class={linkClass} aria-label="Email" title="Email">
    <i class="bx bx-envelope icon-sm"></i>
  </a>
)}
