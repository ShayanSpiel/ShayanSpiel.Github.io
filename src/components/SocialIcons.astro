---
import { SOCIAL, AUTHOR } from "../config";

export interface Props {
  size?: "sm" | "md" | "lg";
  show?: ("x" | "linkedin" | "github" | "rss" | "email")[];
}

const { size = "sm", show = ["x", "linkedin", "github"] } = Astro.props;

// Icon size classes from design tokens
const iconClass = size === "sm" ? "icon-sm" : size === "lg" ? "icon-lg" : "icon-base";

// Shared container: 28px square with rounded-md border matching the design system.
const linkClass = "flex h-7 w-7 items-center justify-center rounded-md border border-border bg-panel-raised text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground";

// Brand icon maps to boxicons bxl-* classes — inherits currentColor automatically.
const brandIcon: Record<string, string> = {
  x: "bxl-twitter",
  linkedin: "bxl-linkedin",
  github: "bxl-github",
};

const brandLabel: Record<string, string> = {
  x: "X",
  linkedin: "LinkedIn",
  github: "GitHub",
};
---

{show.includes("x") && (
  <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer me" class={linkClass} aria-label={brandLabel.x} title={brandLabel.x}>
    <i class:list={["bx", brandIcon.x, iconClass]} aria-hidden="true"></i>
  </a>
)}
{show.includes("linkedin") && (
  <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer me" class={linkClass} aria-label={brandLabel.linkedin} title={brandLabel.linkedin}>
    <i class:list={["bx", brandIcon.linkedin, iconClass]} aria-hidden="true"></i>
  </a>
)}
{show.includes("github") && (
  <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer me" class={linkClass} aria-label={brandLabel.github} title={brandLabel.github}>
    <i class:list={["bx", brandIcon.github, iconClass]} aria-hidden="true"></i>
  </a>
)}
{show.includes("rss") && (
  <a href="/feed.xml" class={linkClass} aria-label="RSS feed" title="RSS feed">
    <i class="bx bx-rss icon-base" aria-hidden="true"></i>
  </a>
)}
{show.includes("email") && (
  <a href={`mailto:${AUTHOR.email}`} class={linkClass} aria-label="Email" title="Email">
    <i class="bx bx-envelope icon-base" aria-hidden="true"></i>
  </a>
)}
