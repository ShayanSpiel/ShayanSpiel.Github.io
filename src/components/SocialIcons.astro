---
import { SOCIAL, AUTHOR } from "../config";

export interface Props {
  size?: "sm" | "md";
  show?: ("x" | "linkedin" | "github" | "rss" | "email")[];
}

const { size = "sm", show = ["x", "linkedin", "github"] } = Astro.props;
// Every brand sits in an identical 20px square cell so the marks align
// optically regardless of glyph shape.
const linkClass = "flex h-5 w-5 items-center justify-center transition-colors";
const svgClass = size === "sm" ? "h-4 w-4" : "h-5 w-5";

const brands = {
  x: {
    label: "X",
    href: SOCIAL.x,
    path: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
    // Official X mark is monochrome black/white — follows the theme.
    colorClass: "text-foreground-strong hover:text-primary",
  },
  linkedin: {
    label: "LinkedIn",
    href: SOCIAL.linkedin,
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z",
    // Official LinkedIn brand blue.
    colorClass: "text-[#0A66C2] hover:text-[#0A66C2]/80",
  },
  github: {
    label: "GitHub",
    href: SOCIAL.github,
    path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
    // Official GitHub mark is monochrome — follows the theme.
    colorClass: "text-foreground-strong hover:text-primary",
  },
} as const;
---

{show.includes("x") && (
  <a href={brands.x.href} target="_blank" rel="noopener noreferrer me" class={`${linkClass} ${brands.x.colorClass}`} aria-label={brands.x.label} title={brands.x.label}>
    <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" class={svgClass} aria-hidden="true"><path d={brands.x.path}></path></svg>
  </a>
)}
{show.includes("linkedin") && (
  <a href={brands.linkedin.href} target="_blank" rel="noopener noreferrer me" class={`${linkClass} ${brands.linkedin.colorClass}`} aria-label={brands.linkedin.label} title={brands.linkedin.label}>
    <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" class={svgClass} aria-hidden="true"><path d={brands.linkedin.path}></path></svg>
  </a>
)}
{show.includes("github") && (
  <a href={brands.github.href} target="_blank" rel="noopener noreferrer me" class={`${linkClass} ${brands.github.colorClass}`} aria-label={brands.github.label} title={brands.github.label}>
    <svg width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" class={svgClass} aria-hidden="true"><path d={brands.github.path}></path></svg>
  </a>
)}
{show.includes("rss") && (
  <a href="/feed.xml" class="flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" aria-label="RSS feed" title="RSS feed">
    <i class="bx bx-rss icon-base"></i>
  </a>
)}
{show.includes("email") && (
  <a href={`mailto:${AUTHOR.email}`} class="flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" aria-label="Email" title="Email">
    <i class="bx bx-envelope icon-base"></i>
  </a>
)}
