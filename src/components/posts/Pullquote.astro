---
const { quote, text, attribution, type } = Astro.props as { quote?: string; text?: string; attribution?: string; type?: 'quote' | 'tweet' };
const pullQuote = quote ?? text;
const isTweet = type === 'tweet';
---
<div class:list={["pullquote", { "tweet-embed": isTweet }]}>
  {isTweet && (
    <div class="tweet-header">
      <i class="bx bxl-twitter icon-lg" aria-hidden="true"></i>
    </div>
  )}
  <blockquote>{pullQuote}</blockquote>
  {attribution && <cite>{attribution}</cite>}
</div>
