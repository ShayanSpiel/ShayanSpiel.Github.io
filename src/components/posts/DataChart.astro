---
export interface BarItem { label: string; value: number; display?: string; color?: string; }
export interface BarGroup { title: string; items: BarItem[]; }
export interface Props {
  label?: string;
  groups?: BarGroup[];
  items?: BarItem[];
  /** Kept for content compatibility. Published charts currently use bars only. */
  type?: "bar";
  note?: string;
  height?: number;
}

const { label, groups, items, note } = Astro.props;
const rows = groups ?? (items ? [{ title: "", items }] : []);
const maxValue = Math.max(1, ...rows.flatMap((group) => group.items.map((item) => item.value)));
const formatValue = (item: BarItem) => item.display ?? item.value.toLocaleString();
const width = (value: number) => `${Math.max(2, Math.min(100, (value / maxValue) * 100))}%`;
---

<figure class="data-chart-wrap">
  {label && <figcaption class="data-chart-label">{label}</figcaption>}
  <div class="space-y-5">
    {rows.map((group) => (
      <section aria-label={group.title || label}>
        {group.title && <h3 class="mb-2 text-2xs font-semibold text-foreground-muted">{group.title}</h3>}
        <ul class="space-y-2.5">
          {group.items.map((item) => (
            <li>
              <div class="mb-1 flex items-baseline justify-between gap-4 text-xs">
                <span class="font-medium text-muted-foreground">{item.label}</span>
                <span class="shrink-0 font-mono font-semibold text-foreground-strong">{formatValue(item)}</span>
              </div>
              <div class="h-2 overflow-hidden rounded-sm bg-panel-raised" role="img" aria-label={`${item.label}: ${formatValue(item)}`}>
                <span class="chart-bar block h-full rounded-sm" data-tone={item.color ?? "primary"} style={`width:${width(item.value)}`}></span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</figure>
{note && <p class="war-note">{note}</p>}

<style>
  .data-chart-wrap { margin: 0.5rem 0; }
  .data-chart-label { @apply mb-3 text-2xs font-semibold uppercase tracking-wider text-muted-foreground; }
  .chart-bar { background: var(--primary); }
  .chart-bar[data-tone="success"] { background: var(--success); }
  .chart-bar[data-tone="warning"] { background: var(--warning); }
  .chart-bar[data-tone="destructive"] { background: var(--destructive); }
  .chart-bar[data-tone="info"] { background: var(--info); }
  .chart-bar[data-tone="accent"] { background: var(--accent); }
  .chart-bar[data-tone="purple"] { background: var(--purple); }
  .chart-bar[data-tone="muted"] { background: var(--muted-foreground); }
</style>
