---
import Icon from "./Icon.astro";
import ShowcaseWaitlistForm from "./ShowcaseWaitlistForm.astro";
import { type Locale, t } from "../../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const slides = [
  { id: "roles", icon: "group", step: "01", title: t(locale, "waitlist.slider.roles.title"), description: t(locale, "waitlist.slider.roles.desc"), color: "var(--primary)", image: "/assets/og/waitlist.png" },
  { id: "skills", icon: "reading-glass", step: "02", title: t(locale, "waitlist.slider.skills.title"), description: t(locale, "waitlist.slider.skills.desc"), color: "var(--accent)", image: "/assets/og/waitlist-supabase.png" },
  { id: "evals", icon: "medical-flask", step: "03", title: t(locale, "waitlist.slider.evals.title"), description: t(locale, "waitlist.slider.evals.desc"), color: "var(--warning)", image: "/assets/og/waitlist.png" },
  { id: "workflows", icon: "workflow-alt", step: "04", title: t(locale, "waitlist.slider.workflows.title"), description: t(locale, "waitlist.slider.workflows.desc"), color: "var(--purple)", image: "/assets/og/waitlist-supabase.png" },
];
---

<section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-20 pb-12">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(var(--foreground) 1px, transparent 1px), linear-gradient(90deg, var(--foreground) 1px, transparent 1px); background-size: 64px 64px;"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] glow-blob opacity-20"></div>

  <div class="relative z-10 mx-auto max-w-6xl px-6 text-center flex-1 flex flex-col items-center justify-center">
    <div class="inline-flex items-center gap-2 rounded-full border border-border bg-panel-raised px-3 py-1 mb-8">
      <span class="h-1.5 w-1.5 rounded-full bg-success animate-pulse"></span>
      <span class="text-2xs text-muted-foreground font-medium">{t(locale, "waitlist.hero.badge")}</span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-foreground-strong tracking-tight leading-tightest">
      {t(locale, "waitlist.hero.title1")}<br />
      <span class="text-primary">{t(locale, "waitlist.hero.title2")}</span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
      {t(locale, "waitlist.hero.p")}
    </p>

    <div id="waitlist" class="mt-10 max-w-md mx-auto">
      <ShowcaseWaitlistForm locale={locale} />
    </div>

    <p class="mt-4 text-2xs text-muted-foreground">{t(locale, "waitlist.hero.note")}</p>

    <div class="mt-10 flex flex-col items-center gap-1 text-muted-foreground animate-bounce">
      <Icon name="chevron-down" size={20} />
    </div>
  </div>

  <!-- Slider -->
  <div class="relative z-10 mx-auto max-w-5xl px-6 w-full mt-6">
    <div class="showcase-slider relative" id="hero-slider" data-slides={JSON.stringify(slides)}>
      <div class="overflow-hidden rounded-xl border border-border shadow-panel">
        <div class="flex transition-transform duration-500 ease-out" id="slider-track">
          {slides.map((slide) => (
            <div class="flex-[0_0_100%] min-w-0 relative">
              <div class="relative aspect-[16/10] bg-panel overflow-hidden">
                <img src={slide.image} alt={slide.title} class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-panel-strong/60 to-transparent"></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Dots -->
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
        {slides.map((_, i) => (
          <button type="button" data-slide-dot={i} class="h-2 rounded-full transition-all" style={`width: ${i === 0 ? 32 : 8}px; background: ${i === 0 ? "var(--foreground)" : "color-mix(in oklab, var(--foreground) 30%, transparent)"};`} aria-label={t(locale, "waitlist.slider.aria", { n: i + 1 })}></button>
        ))}
      </div>

      <!-- Arrows -->
      <button type="button" id="slider-prev" class="absolute start-3 top-1/2 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-full bg-panel-strong/40 text-foreground backdrop-blur-sm hover:bg-panel-strong/60 transition-colors z-10" aria-label={t(locale, "waitlist.slider.prev")}>
        <Icon name="chevron-left" size={14} class="rtl-flip" />
      </button>
      <button type="button" id="slider-next" class="absolute end-3 top-1/2 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-full bg-panel-strong/40 text-foreground backdrop-blur-sm hover:bg-panel-strong/60 transition-colors z-10" aria-label={t(locale, "waitlist.slider.next")}>
        <Icon name="chevron-right" size={14} class="rtl-flip" />
      </button>
    </div>

    <!-- Slide info -->
    <div class="mt-4 flex items-center justify-center gap-3" id="slider-info">
      <span class="flex h-6 w-6 items-center justify-center rounded-md" id="slider-info-icon" style={`background: color-mix(in oklab, ${slides[0].color} 20%, transparent); color: ${slides[0].color};`}>
        <Icon name={slides[0].icon} size={14} />
      </span>
      <span class="text-xs font-semibold text-foreground-strong" id="slider-info-title">{slides[0].step}. {slides[0].title}</span>
      <span class="text-xs text-muted-foreground" id="slider-info-desc">{slides[0].description}</span>
    </div>
  </div>
</section>

<script is:inline define:vars={{ slidesData: slides }}>
(function() {
  var track = document.getElementById('slider-track');
  var dots = document.querySelectorAll('[data-slide-dot]');
  var prev = document.getElementById('slider-prev');
  var next = document.getElementById('slider-next');
  var infoIcon = document.getElementById('slider-info-icon');
  var infoTitle = document.getElementById('slider-info-title');
  var infoDesc = document.getElementById('slider-info-desc');
  if (!track) return;

  var slides = slidesData;
  var current = 0;
  var total = slides.length;
  var autoplay;
  var isRtl = document.documentElement.dir === 'rtl';

  function goTo(i) {
    current = ((i % total) + total) % total;
    var offset = isRtl ? (current * 100) : -(current * 100);
    track.style.transform = 'translateX(' + offset + '%)';
    dots.forEach(function(d, idx) {
      d.style.width = idx === current ? '32px' : '8px';
      d.style.background = idx === current ? 'var(--foreground)' : 'color-mix(in oklab, var(--foreground) 30%, transparent)';
    });
    var s = slides[current];
    infoIcon.style.background = 'color-mix(in oklab, ' + s.color + ' 20%, transparent)';
    infoIcon.style.color = s.color;
    infoTitle.textContent = s.step + '. ' + s.title;
    infoDesc.textContent = s.description;
  }

  prev.addEventListener('click', function() { goTo(current - 1); resetAutoplay(); });
  next.addEventListener('click', function() { goTo(current + 1); resetAutoplay(); });
  dots.forEach(function(d, i) { d.addEventListener('click', function() { goTo(i); resetAutoplay(); }); });

  function resetAutoplay() { clearInterval(autoplay); autoplay = setInterval(function() { goTo(current + 1); }, 5000); }
  resetAutoplay();

  var slider = document.getElementById('hero-slider');
  slider.addEventListener('mouseenter', function() { clearInterval(autoplay); });
  slider.addEventListener('mouseleave', function() { resetAutoplay(); });
})();
</script>
