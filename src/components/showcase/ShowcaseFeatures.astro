---
import Icon from "./Icon.astro";
import { type Locale, t } from "../../i18n/translations";

export interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;

const features = [
  { icon: "group", iconColor: "var(--primary)", title: t(locale, "waitlist.slider.roles.title"), desc: t(locale, "waitlist.slider.roles.desc") },
  { icon: "reading-glass", iconColor: "var(--accent)", title: t(locale, "waitlist.slider.skills.title"), desc: t(locale, "waitlist.slider.skills.desc") },
  { icon: "link", iconColor: "var(--success)", title: t(locale, "waitlist.features.integrations.title"), desc: t(locale, "waitlist.features.integrations.desc") },
  { icon: "workflow-alt", iconColor: "var(--purple)", title: t(locale, "waitlist.slider.workflows.title"), desc: t(locale, "waitlist.slider.workflows.desc") },
  { icon: "medical-flask", iconColor: "var(--warning)", title: t(locale, "waitlist.features.evalLoops.title"), desc: t(locale, "waitlist.slider.evals.desc") },
  { icon: "layers", iconColor: "var(--destructive)", title: t(locale, "waitlist.features.memory.title"), desc: t(locale, "waitlist.features.memory.desc") },
];
---

<section id="features" class="py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="text-2xs font-semibold uppercase tracking-widest text-primary">{t(locale, "waitlist.features.label")}</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground-strong tracking-tight">{t(locale, "waitlist.features.title")}</h2>
      <p class="mt-4 text-sm text-muted-foreground max-w-xl mx-auto">{t(locale, "waitlist.features.p")}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((f, i) => (
        <div class="group rounded-lg border border-border bg-panel p-5 transition-all hover:border-border-strong hover:bg-panel-raised h-full" data-aos="fade-up" data-aos-delay={String(i * 80)}>
          <div class="flex h-9 w-9 items-center justify-center rounded-lg mb-4 group-hover:scale-105 transition-transform" style={`background: color-mix(in oklab, ${f.iconColor} 15%, transparent);`}>
            <span class="shrink-0" style={`color: ${f.iconColor};`}>
              <Icon name={f.icon} size={24} />
            </span>
          </div>
          <h3 class="text-sm font-semibold text-foreground-strong mb-1.5">{f.title}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
