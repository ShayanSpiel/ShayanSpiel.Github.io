---
/**
 * JourneySignature — isolated reusable journey template family (0 hardcoding).
 *
 * Consolidation choice: JourneySignature is the single reusable template.
 * JourneyUniversal is kept as a thin legacy adapter (fixed) for the homepage
 * hero import; JourneyLine is a thin scroll-rail wrapper around
 * JourneySignature variant="rail" with animation="scroll".
 *
 * Geometry contract:
 *   points: [start, ...mids, goal]  →  start = points[0] is the traveling
 *   party at origin, mids = points.slice(1,-1) are intermediate objectives
 *   that the line passes through, goal = points.at(-1) is the flat bullseye
 *   termination. Each node rides ON the path (Catmull-Rom→cubic, pure C
 *   chains, continuous tangents).
 *   If `variant` is given (rail|hero-right|band|corner) the preset geometry
 *   is used; if `points` is given the path is generated from points via
 *   toPath(). `geometry` overrides both.
 *
 * Animation + trigger contract (declared here, implemented in CSS/JS):
 *   animation="scroll" — trigger: window scroll (scrollY / (docHeight-winHeight)),
 *     how: 0% pre-filled (START_REVEAL=0) — at scroll top solid fully hidden
 *     (only dashed muted route visible), then reveal strictly proportionally
 *     to scroll with offset = len * (1 - p) where p = scrollY/(docH-winH);
 *     at p=1 offset 0 = exactly at bullseye, no tail. JS per-instance via uid,
 *     guards getTotalLength fallback to static 70/30 if 0; reduced-motion → static 70/30.
 *   animation="auto" — trigger: page load (timed CSS), how: dashed muted route
 *     fades in 0.35s, solid primary draws 5s (stroke-dasharray:100 offset
 *     100→0 with pathLength="100"), nodes visible grey then become colored
 *     when solid hits them (sequential grey→primary), bullseye last;
 *     timing defaults use var(--duration)/var(--ease). Honor prefers-reduced-motion.
 *   animation="static" — no trigger, how: 70% traveled solid + 30% dashed route
 *     ahead (stroke-dasharray 70 100 with pathLength="100"), token-timed if needed.
 *
 * Reusable as background: component fills its parent
 * (position:absolute; inset:0; width:100%; height:100%; pointer-events:none;
 * z-index scoped), RTL-safe mirror via single [dir="rtl"] scaleX rule
 * (avoid double scale on full-inset). All colors/strokes from tokens
 * (--primary, --foreground-muted, --background) with
 * vector-effect: non-scaling-stroke, no hex.
 */
import "../styles/journey-signature.css";

export type JourneyVariant = "rail" | "hero-right" | "band" | "corner";
export type JourneyAnimation = "scroll" | "auto" | "static";

export interface JourneyGeometry {
  viewBox: string;
  /** A single smooth cubic chain; nodes and goal sit on it. */
  path: string;
  /** Node points [x, y] that ride exactly ON the path (start + joints). */
  nodes: Array<[number, number]>;
  /** Flat bullseye [x, y] — the path ends at its center. */
  goal: [number, number];
  preserveAspectRatio: string;
  /** Rendered radii per preset (user units ≈ screen px at preset scale). */
  radii: { ring: number; dot: number; goal: number; goalInner: number; core: number };
}

export interface Props {
  /** Preset geometry; ignored if `points` or `geometry` is supplied. */
  variant?: JourneyVariant;
  /** Ordered points: [start, ...mids, goal] — line goes through each exactly once. */
  points?: Array<[number, number]>;
  viewBox?: string;
  preserveAspectRatio?: string;
  /** Animation trigger: scroll=scroll-driven, auto=load draw, static=70/30. */
  animation?: JourneyAnimation;
  /** Faded background opacity for hero placements. */
  faded?: boolean;
  /** Kept for API compatibility; gradients were removed for flat primary. */
  gradientId?: string;
  /** Subtle halo on node dots only (default off — reference is flat). */
  glow?: boolean;
  /** Override the burned-in geometry for a bespoke placement. */
  geometry?: JourneyGeometry;
  /** Override radii (user units ≈ screen px at preset scale). */
  radii?: { ring: number; dot: number; goal: number; goalInner: number; core: number };
  /** Optional id for JS targeting when multiple instances. */
  id?: string;
}

function toPath(pts: Array<[number, number]>): string {
  let d = `M ${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[0];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] || p2;
    const cp1x = p1[0] + (p2[0] - p0[0]) / 6;
    const cp1y = p1[1] + (p2[1] - p0[1]) / 6;
    const cp2x = p2[0] - (p3[0] - p1[0]) / 6;
    const cp2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${p2[0]} ${p2[1]}`;
  }
  return d;
}

/* Homepage rail (viewport-fixed, ~80px wide): a gentle vertical S-wave.
   Pure C chain, vertical tangents at every joint — no kinks.
   FIX: inset so bullseye never clips the viewport. For viewBox 0 0 200 960
   with preserveAspectRatio xMidYMin slice, goal center at y=920 leaves
   outer ring (r=24) + 8px margin (920+24+8=952 < 960) so the bullseye
   is fully inside the bottom edge, even when container is position:fixed
   top:0 bottom:0. Nodes also fully inside viewBox. */
const RAIL: JourneyGeometry = {
  viewBox: "0 0 200 960",
  path:
    "M 100 24" +
    " C 100 84, 78 108, 78 174" +
    " C 78 240, 126 268, 126 340" +
    " C 126 412, 72 436, 72 508" +
    " C 72 580, 124 606, 124 676" +
    " C 124 746, 74 770, 74 840" +
    " C 74 900, 100 880, 100 920",
  nodes: [
    [100, 24],
    [78, 174],
    [126, 340],
    [72, 508],
    [124, 676],
    [74, 840],
  ],
  goal: [100, 920],
  preserveAspectRatio: "xMidYMin slice",
  radii: { ring: 10, dot: 4, goal: 24, goalInner: 14, core: 6 },
};

/* Full-extent hero sidebar: starts at the bottom-left edge and flows into
   the flat bullseye at the top-right. Every joint keeps its tangent. */
const HERO_RIGHT: JourneyGeometry = {
  viewBox: "0 0 480 900",
  path:
    "M 36 872" +
    " C 130 866, 148 770, 232 710" +
    " C 312 652, 196 585, 238 500" +
    " C 282 412, 330 372, 268 285" +
    " C 205 196, 148 178, 252 122" +
    " C 310 92, 340 78, 430 86",
  nodes: [
    [36, 872],
    [232, 710],
    [238, 500],
    [268, 285],
    [252, 122],
  ],
  goal: [430, 86],
  preserveAspectRatio: "xMidYMid meet",
  radii: { ring: 12, dot: 5, goal: 26, goalInner: 16, core: 6 },
};

/* Full-extent horizontal band: runs from the left edge into the flat
   bullseye at the right edge. Place in a full-width container with a
   ~12:1 viewBox aspect so it spans edge to edge. */
const BAND: JourneyGeometry = {
  viewBox: "0 0 1000 125",
  path:
    "M 10 84" +
    " C 100 94, 150 58, 240 54" +
    " C 330 50, 360 92, 455 96" +
    " C 550 100, 580 44, 675 46" +
    " C 770 48, 800 88, 905 84" +
    " C 945 82, 972 72, 984 58",
  nodes: [
    [10, 84],
    [240, 54],
    [455, 96],
    [675, 46],
  ],
  goal: [984, 58],
  preserveAspectRatio: "xMidYMid slice",
  radii: { ring: 7, dot: 3, goal: 13, goalInner: 8, core: 4 },
};

/* Full-extent corner surface: flows from its bottom-left into the flat
   bullseye near the top-right corner, fully inside the viewBox. */
const CORNER: JourneyGeometry = {
  viewBox: "0 0 260 420",
  path:
    "M 14 406" +
    " C 90 410, 105 340, 175 322" +
    " C 235 306, 205 225, 225 170" +
    " C 238 132, 234 96, 234 58",
  nodes: [
    [14, 406],
    [175, 322],
    [225, 170],
  ],
  goal: [234, 58],
  preserveAspectRatio: "xMidYMid meet",
  radii: { ring: 10, dot: 4, goal: 22, goalInner: 13, core: 5 },
};

const PRESETS: Record<JourneyVariant, JourneyGeometry> = {
  rail: RAIL,
  "hero-right": HERO_RIGHT,
  band: BAND,
  corner: CORNER,
};

const {
  variant = "rail",
  points,
  viewBox: viewBoxProp,
  preserveAspectRatio: parProp,
  animation: animationProp,
  faded = false,
  glow = false,
  geometry,
  radii: radiiProp,
  id,
} = Astro.props;

// Resolve animation default: rail → scroll, others → static (auto is opt-in)
let animation: JourneyAnimation;
if (animationProp) animation = animationProp;
else if (points) animation = "auto";
else animation = variant === "rail" ? "scroll" : "static";

// Resolve geometry
let g: JourneyGeometry;
let effectiveViewBox: string;
let effectivePar: string;
let effectiveRadii: { ring: number; dot: number; goal: number; goalInner: number; core: number };

if (geometry) {
  g = geometry;
  effectiveViewBox = viewBoxProp ?? g.viewBox;
  effectivePar = parProp ?? g.preserveAspectRatio;
  effectiveRadii = radiiProp ?? g.radii;
} else if (points && points.length >= 2) {
  const path = toPath(points);
  const nodesFromPoints = points.slice(0, -1); // start + mids are nodes, last is bullseye
  const goalFromPoints = points[points.length - 1] as [number, number];
  const defaultRadii = { ring: 10, dot: 4, goal: 24, goalInner: 14, core: 6 };
  g = {
    viewBox: viewBoxProp ?? "0 0 1200 700",
    path,
    nodes: nodesFromPoints,
    goal: goalFromPoints,
    preserveAspectRatio: parProp ?? "xMidYMid meet",
    radii: radiiProp ?? defaultRadii,
  };
  effectiveViewBox = g.viewBox;
  effectivePar = g.preserveAspectRatio;
  effectiveRadii = g.radii;
} else {
  g = PRESETS[variant];
  effectiveViewBox = viewBoxProp ?? g.viewBox;
  effectivePar = parProp ?? g.preserveAspectRatio;
  effectiveRadii = radiiProp ?? g.radii;
}

const { ring, dot, goal, goalInner, core } = effectiveRadii;
const isScroll = animation === "scroll";
const isAuto = animation === "auto";
// static-like: also true for non-scroll when we want 70/30; auto also starts 70/30 but animates
const usePathLength = !isScroll;
const uid = id ?? `js-${Math.random().toString(36).slice(2, 7)}`;
---

<div
  id={uid}
  class:list={[
    "journey-signature",
    `journey-variant-${variant}`,
    `journey-signature--${animation}`,
    faded && "journey-signature--faded",
    glow && "journey-signature--glow",
  ]}
  data-animation={animation}
  aria-hidden="true"
>
  <svg
    class="journey-svg"
    viewBox={effectiveViewBox}
    preserveAspectRatio={effectivePar}
    focusable="false"
  >
    <path class="journey-path" d={g.path} />
    <path
      class:list={["journey-path-fill", !isScroll && "journey-static-fill"]}
      d={g.path}
      {...(usePathLength ? { pathLength: "100" } : {})}
    />
    {g.nodes.map(([nx, ny], idx) => (
      <g class="journey-node" transform={`translate(${nx} ${ny})`}>
        <g class="journey-node-pop" style={`animation-delay: ${isAuto ? 1.55 + idx * 0.15 : 0}s`}>
          <circle class="node-ring" r={ring} />
          <circle class="node-dot" r={dot} />
        </g>
      </g>
    ))}
    <g class="journey-goal" transform={`translate(${g.goal[0]} ${g.goal[1]})`}>
      <g class="journey-goal-pop" style={isAuto ? `animation-delay: ${1.55 + g.nodes.length * 0.15 + 0.15}s` : undefined}>
        <circle class="goal-ring" r={goal} />
        <circle class="goal-ring-inner" r={goalInner} />
        <circle class="goal-core" r={core} />
      </g>
    </g>
  </svg>
</div>

{isScroll && (
  <script is:inline define:vars={{ uid }}>
    (function(uid){
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      var root = document.getElementById(uid);
      var fill = root ? root.querySelector(".journey-path-fill") : null;
      if (!root || !fill) return;
      var len = 0;
      try { len = fill.getTotalLength(); } catch(e) { len = 0; }
      if (!len || len === 0) return;
      fill.style.strokeDasharray = String(len);
      var START_REVEAL = 0;
      fill.style.strokeDashoffset = String(len * (1 - START_REVEAL));
      function tick(){
        var top = window.pageYOffset || document.documentElement.scrollTop;
        var docH = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        var winH = window.innerHeight;
        var max = docH - winH;
        if (max <= 0) return;
        var p = Math.min(top / max, 1);
        fill.style.strokeDashoffset = String(len * (1 - START_REVEAL) * (1 - p));
      }
      window.addEventListener("scroll", tick, {passive:true});
      window.addEventListener("resize", tick, {passive:true});
      tick();
    })(uid);
  </script>
)}
