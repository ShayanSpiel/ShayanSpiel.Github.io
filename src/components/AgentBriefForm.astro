---
import { FORMS } from "../config";
import { type Locale, t } from "../i18n/translations";

export interface Props {
  locale?: Locale;
  /** Unique id prefix so inline and modal instances on the same page stay distinct. */
  id?: string;
  /** Submission endpoint; defaults to the shared contact form endpoint. */
  endpoint?: string;
}

const { locale = "en", id = "agent-brief-form", endpoint = FORMS.contact } = Astro.props;
const pagePath = Astro.url.pathname;
---

<div id={id} class="agent-brief-form">
  <div class="flex items-center gap-3 mb-3">
    <div class="flex h-9 w-9 items-center justify-center rounded-md bg-primary-soft shrink-0">
      <i class="bx bx-file text-primary icon-lg"></i>
    </div>
    <h2 class="text-lg font-bold text-foreground-strong pe-10">{t(locale, "agentBrief.title")}</h2>
  </div>
  <p class="text-sm text-muted-foreground leading-relaxed mb-6">{t(locale, "agentBrief.description")}</p>

  <form
    class="space-y-5"
    method="post"
    action={endpoint}
    data-agent-brief-form
  >
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_subject" value="SpielOS Agent Brief Request" />
    <input type="hidden" name="page_path" value={pagePath} />
    <input type="hidden" name="locale" value={locale} />
    <input type="hidden" name="referrer" value="" data-agent-brief-referrer />
    <input type="hidden" name="utm_source" value="" data-agent-brief-utm="utm_source" />
    <input type="hidden" name="utm_medium" value="" data-agent-brief-utm="utm_medium" />
    <input type="hidden" name="utm_campaign" value="" data-agent-brief-utm="utm_campaign" />
    <input type="hidden" name="utm_content" value="" data-agent-brief-utm="utm_content" />

    <div>
      <label for={`${id}-name`} class="block text-xs font-medium text-foreground-strong mb-1.5">{t(locale, "agentBrief.fields.name")}</label>
      <input type="text" id={`${id}-name`} name="name" required autocomplete="name" class="w-full h-11 rounded-md border border-border bg-input px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
    </div>

    <div>
      <label for={`${id}-email`} class="block text-xs font-medium text-foreground-strong mb-1.5">{t(locale, "agentBrief.fields.email")}</label>
      <input type="email" id={`${id}-email`} name="email" required autocomplete="email" class="w-full h-11 rounded-md border border-border bg-input px-3.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring transition-colors" />
    </div>

    <div>
      <label for={`${id}-workflow`} class="block text-xs font-medium text-foreground-strong mb-1.5">{t(locale, "agentBrief.fields.business")}</label>
      <textarea id={`${id}-workflow`} name="workflow" rows="4" required placeholder={t(locale, "agentBrief.placeholder.business")} class="w-full rounded-md border border-border bg-input px-3.5 py-2.5 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring resize-y min-h-[100px] transition-colors"></textarea>
      <p class="mt-1.5 text-2xs text-muted-foreground">{t(locale, "agentBrief.helper")}</p>
    </div>

    <button type="submit" class="agent-brief-submit w-full rounded-md bg-primary text-primary-foreground px-6 h-11 text-sm font-semibold hover:brightness-110 active:brightness-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
      <span class="agent-brief-submit-text">{t(locale, "agentBrief.submit")}</span>
      <i class="agent-brief-submit-spinner bx bx-loader icon-base bx-spin" style="display:none;"></i>
    </button>

    <p class="text-2xs text-muted-foreground leading-relaxed">{t(locale, "agentBrief.trust")}</p>

    <div class="agent-brief-error hidden rounded-md bg-destructive-soft border border-destructive/20 p-3 text-xs text-destructive" role="alert">
      {t(locale, "agentBrief.error")}
    </div>
  </form>

  <div class="agent-brief-success hidden py-6 text-center" role="status" tabindex="-1">
    <div class="flex h-14 w-14 items-center justify-center rounded-md bg-success-soft mx-auto mb-5">
      <i class="bx bx-check-square text-success text-2xl"></i>
    </div>
    <h3 class="text-xl font-bold text-foreground-strong">{t(locale, "agentBrief.success.title")}</h3>
    <p class="mt-2 text-sm text-muted-foreground max-w-md mx-auto leading-relaxed">{t(locale, "agentBrief.success.body")}</p>
  </div>
</div>

<script is:inline define:vars={{ formEndpoint: endpoint, formId: id }}>
(function () {
  var root = document.getElementById(formId);
  var form = root ? root.querySelector('form[data-agent-brief-form]') : null;
  if (!root || !form || form.dataset.bound === 'true') return;
  form.dataset.bound = 'true';

  var attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

  function fillSubmissionContext() {
    var referrer = '';
    try { referrer = document.referrer || ''; } catch (e) {}
    var params = {};
    try {
      var qs = new URLSearchParams(window.location.search);
      attributionKeys.forEach(function (k) { if (qs.get(k)) params[k] = qs.get(k); });
    } catch (e) {}
    var ref = form.querySelector('[data-agent-brief-referrer]');
    if (ref) ref.value = referrer;
    attributionKeys.forEach(function (k) {
      var el = form.querySelector('[data-agent-brief-utm="' + k + '"]');
      if (el) el.value = params[k] || '';
    });
  }
  fillSubmissionContext();

  var btn = form.querySelector('.agent-brief-submit');
  var text = form.querySelector('.agent-brief-submit-text');
  var spinner = form.querySelector('.agent-brief-submit-spinner');
  var errorEl = form.querySelector('.agent-brief-error');
  var successState = root.querySelector('.agent-brief-success');
  if (!btn || !text || !spinner || !errorEl || !successState) return;

  var originalText = text.textContent;
  var locale = document.documentElement.lang || 'en';
  var page = window.location.pathname;
  var formLocation = root.closest('[role="dialog"]') ? 'modal' : 'inline';
  var started = false;

  function track(name) {
    if (typeof window.spielosTrack === 'function') {
      window.spielosTrack(name, { form_type: 'agent_brief', page: page, locale: locale, location: formLocation });
    }
  }

  function loading(on) {
    btn.disabled = on;
    btn.classList.toggle('opacity-70', on);
    btn.classList.toggle('cursor-not-allowed', on);
    spinner.style.display = on ? '' : 'none';
    text.textContent = on ? originalText + '...' : originalText;
  }

  if (formLocation === 'inline') track('lead_form_view');
  form.addEventListener('input', function () {
    if (started) return;
    started = true;
    track('lead_form_start');
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    errorEl.classList.add('hidden');
    loading(true);
    track('lead_form_submit');

    var data = {};
    new FormData(form).forEach(function (value, key) { data[key] = value; });

    fetch(formEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    }).then(function (response) {
      if (!response.ok) throw new Error('Submission failed');
      form.classList.add('hidden');
      successState.classList.remove('hidden');
      loading(false);
      track('lead_form_success');
      successState.focus({ preventScroll: true });
    }).catch(function () {
      errorEl.classList.remove('hidden');
      loading(false);
      track('lead_form_error');
      errorEl.scrollIntoView({ block: 'nearest' });
    });
  });
})();
</script>
